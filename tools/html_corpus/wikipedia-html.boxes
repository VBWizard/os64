                        span sup 460 8375 20 13
                        text "Hypertext Markup Language" 8 8373 180 16 serif 16 bold
                        text " (" 188 8373 12 16 serif 16
                        text "HTML" 200 8373 36 16 serif 16 bold
                        text ") is the standard " 236 8373 112 16 serif 16
                        text "markup language" 348 8373 112 16 serif 16 underline link 323
                        text "[" 460 8375 7 13 serif 13 underline link 324
                        text "a" 467 8375 6 13 serif 13 underline link 324
                        text "]" 473 8375 7 13 serif 13 underline link 324
                        text " for documents designed to be displayed in a" 480 8373 292 16 serif 16
                      line 8 8391 784 20 base 14
                        span a 8 8393 84 16 link 325
                        span a 348 8393 80 16 link 326
                        text "web browser" 8 8393 84 16 serif 16 underline link 325
                        text ". It defines the content and structure of " 92 8393 256 16 serif 16
                        text "web content" 348 8393 80 16 serif 16 underline link 326
                        text ". It is often assisted by technologies such as" 428 8393 296 16 serif 16
                      line 8 8411 784 20 base 14
                        span a 8 8413 152 16 link 327
                        span a 236 8413 128 16 link 328
                        span a 424 8413 68 16 link 329
                        text "Cascading Style Sheets" 8 8413 152 16 serif 16 underline link 327
                        text " (CSS) and " 160 8413 76 16 serif 16
                        text "scripting languages" 236 8413 128 16 serif 16 underline link 328
                        text " such as " 364 8413 60 16 serif 16
                        text "JavaScript" 424 8413 68 16 serif 16 underline link 329
                        text "." 492 8413 4 16 serif 16
                    block p 8 8447 784 60
                      line 8 8447 784 20 base 14
                        span a 8 8449 92 16 link 330
                        span a 316 8449 72 16 link 331
                        span a 556 8449 40 16 link 332
                        text "Web browsers" 8 8449 92 16 serif 16 underline link 330
                        text " receive HTML documents from a " 100 8449 216 16 serif 16
                        text "web server" 316 8449 72 16 serif 16 underline link 331
                        text " or from local storage and " 388 8449 168 16 serif 16
                        text "render" 556 8449 40 16 serif 16 underline link 332
                        text " the documents into" 596 8449 128 16 serif 16
                      line 8 8467 784 20 base 14
                        span a 8 8469 72 16 link 333
                        span a 384 8469 64 16 link 334
                        span a 452 8469 84 16 link 335
                        text "multimedia" 8 8469 72 16 serif 16 underline link 333
                        text " web pages. HTML describes the structure of a " 80 8469 304 16 serif 16
                        text "web page" 384 8469 64 16 serif 16 underline link 334
                        text " " 448 8469 4 16 serif 16
                        text "semantically" 452 8469 84 16 serif 16 underline link 335
                        text " and originally included cues for its" 536 8469 228 16 serif 16
                      line 8 8487 784 20 base 14
                        text "appearance." 8 8489 80 16 serif 16
                    block p 8 8523 784 140
                      line 8 8523 784 20 base 14
                        span a 8 8525 100 16 link 336
                        span a 516 8525 48 16 link 337
                        text "HTML elements" 8 8525 100 16 serif 16 underline link 336
                        text " are the building blocks of HTML pages. With HTML constructs, " 108 8525 408 16 serif 16
                        text "images" 516 8525 48 16 serif 16 underline link 337
                        text " and other objects such as" 564 8525 172 16 serif 16
                      line 8 8543 784 20 base 14
                        span a 8 8545 108 16 link 338
                        span a 616 8545 140 16 link 339
                        text "interactive forms" 8 8545 108 16 serif 16 underline link 338
                        text " may be embedded into the rendered page. HTML provides a means to create " 116 8545 500 16 serif 16
                        text "structured documents" 616 8545 140 16 serif 16 underline link 339
                        text " by" 756 8545 20 16 serif 16
                      line 8 8563 784 20 base 14
                        span a 132 8565 68 16 link 340
                        span a 492 8565 32 16 link 341
                        text "denoting structural " 8 8565 124 16 serif 16
                        text "semantics" 132 8565 68 16 serif 16 underline link 340
                        text " for text such as headings, paragraphs, lists, " 200 8565 292 16 serif 16
                        text "links" 492 8565 32 16 serif 16 underline link 341
                        text ", quotes, and other items. HTML elements" 524 8565 268 16 serif 16
                      line 8 8583 784 20 base 14
                        span i 124 8585 28 16
                        span a 248 8585 96 16 link 342
                        span span 444 8585 8 16
                        span span 452 8585 24 16
                        span span 476 8585 8 16
                        span code 444 8585 40 16
                        span span 516 8585 8 16
                        span span 524 8585 40 16
                        span span 564 8585 8 16
                        span code 516 8585 56 16
                        text "are delineated by " 8 8585 116 16 serif 16
                        text "tags" 124 8585 28 16 serif 16 italic
                        text ", written using " 152 8585 96 16 serif 16
                        text "angle brackets" 248 8585 96 16 serif 16 underline link 342
                        text ". Tags such as " 344 8585 100 16 serif 16
                        text "<" 444 8585 8 16 mono 16
                        text "img" 452 8585 24 16 mono 16
                        text ">" 476 8585 8 16 mono 16
                        text " and " 484 8585 32 16 serif 16
                        text "<" 516 8585 8 16 mono 16
                        text "input" 524 8585 40 16 mono 16
                        text ">" 564 8585 8 16 mono 16
                        text " directly introduce content into the" 572 8585 220 16 serif 16
                      line 8 8603 784 20 base 14
                        span span 172 8605 8 16
                        span span 180 8605 8 16
                        span span 188 8605 8 16
                        span code 172 8605 24 16
                        span span 420 8605 16 16
                        span span 436 8605 8 16
                        span span 444 8605 8 16
                        span code 420 8605 32 16
                        text "page. Other tags such as " 8 8605 164 16 serif 16
                        text "<" 172 8605 8 16 mono 16
                        text "p" 180 8605 8 16 mono 16
                        text ">" 188 8605 8 16 mono 16
                        text " and its corresponding closing tag " 196 8605 224 16 serif 16
                        text "</" 420 8605 16 16 mono 16
                        text "p" 436 8605 8 16 mono 16
                        text ">" 444 8605 8 16 mono 16
                        text " surround and provide information about document" 452 8605 324 16 serif 16
                      line 8 8623 784 20 base 14
                        span a 272 8625 60 16 link 343
                        text "text and may include sub-element tags. " 8 8625 264 16 serif 16
                        text "Browsers" 272 8625 60 16 serif 16 underline link 343
                        text " do not display the HTML tags, but use them to interpret the content of" 332 8625 448 16 serif 16
                      line 8 8643 784 20 base 14
                        text "the page." 8 8645 60 16 serif 16
                    block p 8 8679 784 80
                      line 8 8679 784 20 base 14
                        span a 264 8681 120 16 link 344
                        span a 444 8681 68 16 link 345
                        text "HTML can embed programs written in a " 8 8681 256 16 serif 16
                        text "scripting language" 264 8681 120 16 serif 16 underline link 344
                        text " such as " 384 8681 60 16 serif 16
                        text "JavaScript" 444 8681 68 16 serif 16 underline link 345
                        text ", which affects the behavior and content of" 512 8681 276 16 serif 16
                      line 8 8699 784 20 base 14
                        span a 504 8701 180 16 link 346
                        text "web pages. The inclusion of CSS defines the look and layout of content. The " 8 8701 496 16 serif 16
                        text "World Wide Web Consortium" 504 8701 180 16 serif 16 underline link 346
                        text " (W3C), former" 684 8701 96 16 serif 16
                      line 8 8719 784 20 base 14
                        span a 624 8721 24 16 link 347
                        text "maintainer of the HTML and current maintainer of the CSS standards, has encouraged the use of " 8 8721 616 16 serif 16
                        text "CSS" 624 8721 24 16 serif 16 underline link 347
                        text " over explicit" 648 8721 84 16 serif 16
                      line 8 8739 784 20 base 14
                        span span 144 8741 68 16
                        span span 212 8741 0 16
                        span span 212 8741 4 16
                        span span 216 8743 7 13
                        span span 258 8743 7 13
