                          text ">" 716 23820 8 16 mono 16
                          text " for" 724 23820 20 16 serif 16
                        line 48 23838 744 20 base 14
                          text "italics)." 48 23840 52 16 serif 16
                        marker "• " 36 23820 12 16
                      block li 48 23858 744 40
                        line 48 23858 744 20 base 14
                          text "As a great deal of the information in HTML documents is not in the layout, the model has been criticized for its" 48 23860 708 16 serif 16
                        line 48 23878 744 20 base 14
