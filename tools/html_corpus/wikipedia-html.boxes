                          text "''content''" 168 14423 88 16 mono 16
                          text "</" 256 14423 16 16 mono 16
                          text "tag" 272 14423 24 16 mono 16
                          text ">" 296 14423 8 16 mono 16
                          text ". Some HTML elements are defined as " 304 14423 248 16 serif 16
