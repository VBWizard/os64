                        text "100" 357 23650 16 13 serif 13 underline link 659
                        text "]" 373 23650 6 13 serif 13 underline link 659
                        text " primarily because of the low quality of the generated code;" 379 23648 384 16 serif 16
                      line 8 23666 784 20 base 14
                        span a 376 23668 68 16 link 660
                        span i 500 23668 208 16
                        span span 720 23670 7 13
                        span span 740 23670 6 13
