                                span span 595 23490 168 16
                                span span 595 23490 168 16
                                span span 423 23490 352 16
                                span span 763 23490 12 16
                                text "This article " 55 23490 76 16 serif 16
                                text "is missing information" 131 23490 144 16 serif 16 bold
                                text " about contenteditable." 275 23490 148 16 serif 16
                                text " Please expand the article " 423 23490 172 16 serif 16
                                text "by making an edit request" 595 23490 168 16 serif 16 underline link 652
                                text "to" 763 23490 12 16 serif 16
                              line 55 23508 734 20 base 14
                                span span 55 23510 152 16
                                span a 423 23510 60 16 link 653
                                span span 55 23510 432 16
                                span span 499 23510 84 16
                                span i 491 23510 100 16
                                span span 491 23510 100 16
                                text "include this information" 55 23510 152 16 serif 16
                                text ". Further details may exist on the " 207 23510 216 16 serif 16
                                text "talk page" 423 23510 60 16 serif 16 underline link 653
                                text "." 483 23510 4 16 serif 16
                                text " " 487 23510 4 16 serif 16
