                    block p 8 23550 784 80
                      line 8 23550 784 20 base 14
                        span a 8 23552 64 16 link 654
                        span i 132 23552 192 16
                        text "WYSIWYG" 8 23552 64 16 serif 16 underline link 654
                        text " editors (" 72 23552 60 16 serif 16
                        text "what you see is what you get" 132 23552 192 16 serif 16 italic
                        text "), are HTML editors in which the user lays out everything as it is to" 324 23552 432 16 serif 16
                      line 8 23570 784 20 base 14
                        span a 256 23572 152 16 link 655
                        span a 516 23572 128 16 link 656
                        span a 752 23572 32 16 link 657
                        text "appear in the HTML document using a " 8 23572 248 16 serif 16
                        text "graphical user interface" 256 23572 152 16 serif 16 underline link 655
                        text " (GUI), such as " 408 23572 108 16 serif 16
                        text "Microsoft FrontPage" 516 23572 128 16 serif 16 underline link 656
                        text ", often similar to " 644 23572 108 16 serif 16
                        text "word" 752 23572 32 16 serif 16 underline link 657
                      line 8 23590 784 20 base 14
                        span a 8 23592 72 16 link 657
                        text "processors" 8 23592 72 16 serif 16 underline link 657
                        text ". The editor renders the document rather than showing the code, so authors do not require extensive" 80 23592 644 16 serif 16
                      line 8 23610 784 20 base 14
                        text "knowledge of HTML." 8 23612 132 16 serif 16
                    block p 8 23646 784 40
                      line 8 23646 784 20 base 14
