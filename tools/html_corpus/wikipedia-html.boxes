                          span a 92 19859 76 16 link 618
                          text "Main article: " 8 19859 84 16 serif 16
                          text "HTML email" 92 19859 76 16 serif 16 underline link 618
                      block p 8 19893 784 120
                        line 8 19893 784 20 base 14
                          span a 708 19895 60 16 link 619
                          text "Most graphical email clients allow the use of a subset of HTML (often ill-defined) to provide formatting and " 8 19895 700 16 serif 16
                          text "semantic" 708 19895 60 16 serif 16 underline link 619
                        line 8 19913 784 20 base 14
                          span a 180 19915 60 16 link 620
                          text "markup not available with " 8 19915 172 16 serif 16
                          text "plain text" 180 19915 60 16 serif 16 underline link 620
                          text ". This may include typographic information like colored headings, emphasized and" 240 19915 536 16 serif 16
                        line 8 19933 784 20 base 14
                          span a 496 19935 24 16 link 621
                          text "quoted text, inline images and diagrams. Many such clients include both a " 8 19935 488 16 serif 16
                          text "GUI" 496 19935 24 16 serif 16 underline link 621
                          text " editor for composing HTML e-mail" 520 19935 224 16 serif 16
                        line 8 19953 784 20 base 14
                          text "messages and a rendering engine for displaying them. Use of HTML in e-mail is criticized by some because of" 8 19955 716 16 serif 16
                        line 8 19973 784 20 base 14
                          span a 340 19975 56 16 link 622
                          text "compatibility issues, because it can help disguise " 8 19975 332 16 serif 16
                          text "phishing" 340 19975 56 16 serif 16 underline link 622
                          text " attacks, because of accessibility issues for blind or visually" 396 19975 396 16 serif 16
                        line 8 19993 784 20 base 14
                          span a 276 19995 36 16 link 623
                          text "impaired people, because it can confuse " 8 19995 268 16 serif 16
                          text "spam" 276 19995 36 16 serif 16 underline link 623
                          text " filters and because the message size is larger than plain text." 312 19995 404 16 serif 16
                    block section 8 20032 784 83
                      block div 8 20032 784 24
                        block h3 8 20032 784 24
                          line 8 20032 784 24 base 17
                            text "Naming conventions" 8 20034 157 19 serif 19 bold
                      block p 8 20075 784 40
                        line 8 20075 784 20 base 14
                          span a 132 20077 124 16 link 624
                          span a 280 20077 28 16 link 625
                          span kbd 440 20077 40 16
                          span kbd 704 20077 32 16
                          text "The most common " 8 20077 124 16 serif 16
                          text "filename extension" 132 20077 124 16 serif 16 underline link 624
                          text " for " 256 20077 24 16 serif 16
                          text "files" 280 20077 28 16 serif 16 underline link 625
                          text " containing HTML is " 308 20077 132 16 serif 16
                          text ".html" 440 20077 40 16 mono 16
                          text ". A common abbreviation of this is " 480 20077 224 16 serif 16
                          text ".htm" 704 20077 32 16 mono 16
                          text ", which" 736 20077 48 16 serif 16
                        line 8 20095 784 20 base 14
                          span a 448 20097 76 16 link 626
                          span span 528 20099 7 13
                          span span 548 20099 6 13
                          span span 528 20099 26 13
                          span a 528 20099 26 13 link 627
                          span sup 528 20099 26 13
                          text "originated because some operating systems limit file extensions to " 8 20097 440 16 serif 16
                          text "three letters" 448 20097 76 16 serif 16 underline link 626
                          text "." 524 20097 4 16 serif 16
                          text "[" 528 20099 7 13 serif 13 underline link 627
                          text "94" 535 20099 13 13 serif 13 underline link 627
                          text "]" 548 20099 6 13 serif 13 underline link 627
                    block section 8 20133 784 199
                      block div 8 20133 784 24
                        block h3 8 20133 784 24
                          line 8 20133 784 24 base 17
                            text "HTML Application" 8 20136 133 19 serif 19 bold
                      block div 8 20176 784 20
                        line 8 20176 784 20 base 14
                          span a 92 20178 112 16 link 628
                          text "Main article: " 8 20178 84 16 serif 16
                          text "HTML Application" 92 20178 112 16 serif 16 underline link 628
                      block p 8 20212 784 120
                        line 8 20212 784 20 base 14
                          span kbd 276 20214 32 16
                          span a 348 20214 124 16 link 629
                          text "An HTML Application (HTA; file extension " 8 20214 268 16 serif 16
                          text ".hta" 276 20214 32 16 mono 16
                          text ") is a " 308 20214 40 16 serif 16
                          text "Microsoft Windows" 348 20214 124 16 serif 16 underline link 629
                          text " application that uses HTML and Dynamic HTML" 472 20214 308 16 serif 16
                        line 8 20232 784 20 base 14
                          span a 36 20234 52 16 link 630
                          text "in a " 8 20234 28 16 serif 16
                          text "browser" 36 20234 52 16 serif 16 underline link 630
                          text " to provide the application's graphical interface. A regular HTML file is confined to the security model of the" 88 20234 688 16 serif 16
                        line 8 20252 784 20 base 14
                          span a 8 20254 152 16 link 631
                          span a 700 20254 80 16 link 632
                          text "web browser's security" 8 20254 152 16 serif 16 underline link 631
                          text ", communicating only to web servers and manipulating only web page objects and " 160 20254 540 16 serif 16
                          text "site cookies" 700 20254 80 16 serif 16 underline link 632
                          text "." 780 20254 4 16 serif 16
                        line 8 20272 784 20 base 14
                          text "An HTA runs as a fully trusted application and therefore has more privileges, like creation/editing/removal of files and" 8 20274 760 16 serif 16
                        line 8 20292 784 20 base 14
                          span a 8 20294 116 16 link 633
                          text "Windows Registry" 8 20294 116 16 serif 16 underline link 633
                          text " entries. Because they operate outside the browser's security model, HTAs cannot be executed via" 124 20294 636 16 serif 16
                        line 8 20312 784 20 base 14
                          span a 296 20314 24 16 link 634
                          text "HTTP, but must be downloaded (just like an " 8 20314 288 16 serif 16
                          text "EXE" 296 20314 24 16 serif 16 underline link 634
                          text " file) and executed from local file system." 320 20314 272 16 serif 16
                  block section 8 20352 784 2938
                    block div 8 20352 784 30
                      block h2 8 20352 784 30
                        line 8 20352 784 30 base 21
                          text "HTML4 variations" 8 20355 168 24 serif 24 bold
                    block p 8 20402 784 160
                      line 8 20402 784 20 base 14
                        text "Since its inception, HTML and its associated protocols gained acceptance relatively quickly. However, no clear" 8 20404 720 16 serif 16
                      line 8 20422 784 20 base 14
                        text "standards existed in the early years of the language. Though its creators originally conceived of HTML as a semantic" 8 20424 756 16 serif 16
                      line 8 20442 784 20 base 14
                        span span 268 20446 7 13
                        span span 288 20446 6 13
                        span span 268 20446 26 13
                        span a 268 20446 26 13 link 635
                        span sup 268 20446 26 13
                        text "language devoid of presentation details," 8 20444 260 16 serif 16
                        text "[" 268 20446 7 13 serif 13 underline link 635
                        text "95" 275 20446 13 13 serif 13 underline link 635
                        text "]" 288 20446 6 13 serif 13 underline link 635
                        text " practical uses pushed many presentational elements and attributes into the" 294 20444 492 16 serif 16
                      line 8 20462 784 20 base 14
                        text "language, driven largely by the various browser vendors. The latest standards surrounding HTML reflect efforts to" 8 20464 728 16 serif 16
                      line 8 20482 784 20 base 14
                        span span 416 20486 7 13
                        span span 436 20486 6 13
                        span span 416 20486 26 13
                        span a 416 20486 26 13 link 636
                        span sup 416 20486 26 13
                        text "overcome the sometimes chaotic development of the language" 8 20484 408 16 serif 16
                        text "[" 416 20486 7 13 serif 13 underline link 636
                        text "96" 423 20486 13 13 serif 13 underline link 636
                        text "]" 436 20486 6 13 serif 13 underline link 636
                        text " and to create a rational foundation for building both" 442 20484 332 16 serif 16
                      line 8 20502 784 20 base 14
                        span a 648 20504 28 16 link 637
                        text "meaningful and well-presented documents. To return HTML to its role as a semantic language, the " 8 20504 640 16 serif 16
                        text "W3C" 648 20504 28 16 serif 16 underline link 637
                        text " has developed" 676 20504 100 16 serif 16
                      line 8 20522 784 20 base 14
                        span a 172 20524 24 16 link 638
                        span a 228 20524 24 16 link 639
                        text "style languages such as " 8 20524 164 16 serif 16
                        text "CSS" 172 20524 24 16 serif 16 underline link 638
                        text " and " 196 20524 32 16 serif 16
                        text "XSL" 228 20524 24 16 serif 16 underline link 639
                        text " to shoulder the burden of presentation. In conjunction, the HTML specification has" 252 20524 536 16 serif 16
                      line 8 20542 784 20 base 14
                        text "slowly reined in the presentational elements." 8 20544 292 16 serif 16
                    block p 8 20578 784 60
                      line 8 20578 784 20 base 14
                        text "There are two axes differentiating various variations of HTML as currently specified: SGML-based HTML versus" 8 20580 716 16 serif 16
                      line 8 20598 784 20 base 14
                        text "XML-based HTML (referred to as XHTML) on one axis, and strict versus transitional (loose) versus frameset on the other" 8 20600 784 16 serif 16
                      line 8 20618 784 20 base 14
                        text "axis." 8 20620 32 16 serif 16
                    block section 8 20656 784 1067
                      block div 8 20656 784 24
                        block h3 8 20656 784 24
                          line 8 20656 784 24 base 17
                            text "SGML-based versus XML-based HTML" 8 20659 299 19 serif 19 bold
                      block p 8 20699 784 120
                        line 8 20699 784 20 base 14
                          span span 180 20703 7 13
                          span span 187 20703 35 13
                          span a 187 20703 35 13 link 640
                          span i 187 20703 35 13
                          span span 222 20703 7 13
                          span sup 180 20703 49 13
                          text "One difference in the latest" 8 20701 172 16 serif 16
                          text "[" 180 20703 7 13 serif 13
                          text "when?" 187 20703 35 13 serif 13 italic underline link 640
                          text "]" 222 20703 7 13 serif 13
                          text " HTML specifications lies in the distinction between the SGML-based specification" 229 20701 536 16 serif 16
                        line 8 20719 784 20 base 14
                          span a 540 20721 44 16 link 641
                          text "and the XML-based specification. The XML-based specification is usually called " 8 20721 532 16 serif 16
                          text "XHTML" 540 20721 44 16 serif 16 underline link 641
                          text " to distinguish it clearly from the" 584 20721 208 16 serif 16
                        line 8 20739 784 20 base 14
                          text "more traditional definition. However, the root element name continues to be \"html\" even in the XHTML-specified HTML." 8 20741 768 16 serif 16
                        line 8 20759 784 20 base 14
                          text "The W3C intended XHTML 1.0 to be identical to HTML 4.01 except where limitations of XML over the more complex SGML" 8 20761 768 16 serif 16
                        line 8 20779 784 20 base 14
                          text "require workarounds. Because XHTML and HTML are closely related, they are sometimes documented in parallel. In such" 8 20781 784 16 serif 16
                        line 8 20799 784 20 base 14
                          span a 204 20801 152 16 link 642
                          text "circumstances, some authors " 8 20801 196 16 serif 16
                          text "conflate the two names" 204 20801 152 16 serif 16 underline link 642
                          text " as (X)HTML or X(HTML)." 356 20801 168 16 serif 16
                      block p 8 20835 784 20
                        line 8 20835 784 20 base 14
                          text "Like HTML 4.01, XHTML 1.0 has three sub-specifications: strict, transitional, and frameset." 8 20837 576 16 serif 16
                      block p 8 20871 784 160
                        line 8 20871 784 20 base 14
                          text "Aside from the different opening declarations for a document, the differences between an HTML 4.01 and XHTML 1.0" 8 20873 736 16 serif 16
                        line 8 20891 784 20 base 14
                          text "document—in each of the corresponding DTDs—are largely syntactic. The underlying syntax of HTML allows many" 8 20893 728 16 serif 16
                        line 8 20911 784 20 base 14
                          text "shortcuts that XHTML does not, such as elements with optional opening or closing tags, and even empty elements which" 8 20913 784 16 serif 16
                        line 8 20931 784 20 base 14
                          text "must not have an end tag. By contrast, XHTML requires all elements to have an opening tag and a closing tag. XHTML," 8 20933 760 16 serif 16
                        line 8 20951 784 20 base 14
                          text "however, also introduces a new shortcut: an XHTML tag may be opened and closed within the same tag, by including a" 8 20953 772 16 serif 16
                        line 8 20971 784 20 base 14
                          span span 268 20973 8 16
                          span span 276 20973 16 16
                          span span 292 20973 16 16
                          span code 268 20973 40 16
                          text "slash before the end of the tag like this: " 8 20973 260 16 serif 16
                          text "<" 268 20973 8 16 mono 16
                          text "br" 276 20973 16 16 mono 16
                          text "/>" 292 20973 16 16 mono 16
                          text ". The introduction of this shorthand, which is not used in the SGML" 308 20973 428 16 serif 16
                        line 8 20991 784 20 base 14
                          text "declaration for HTML 4.01, may confuse earlier software unfamiliar with this new convention. A fix for this is remove the" 8 20993 768 16 serif 16
                        line 8 21011 784 20 base 14
                          span span 348 21013 8 16
                          span span 356 21013 16 16
                          span span 372 21013 8 16
                          span code 348 21013 32 16
                          span span 384 21015 7 13
                          span span 404 21015 6 13
                          span span 384 21015 26 13
                          span a 384 21015 26 13 link 643
                          span sup 384 21015 26 13
                          text "slash preceding the closing angle bracket, as such: " 8 21013 340 16 serif 16
                          text "<" 348 21013 8 16 mono 16
                          text "br" 356 21013 16 16 mono 16
                          text ">" 372 21013 8 16 mono 16
                          text "." 380 21013 4 16 serif 16
                          text "[" 384 21015 7 13 serif 13 underline link 643
                          text "97" 391 21015 13 13 serif 13 underline link 643
                          text "]" 404 21015 6 13 serif 13 underline link 643
                      block p 8 21047 784 60
                        line 8 21047 784 20 base 14
                          text "To understand the subtle differences between HTML and XHTML, consider the transformation of a valid and well-formed" 8 21049 772 16 serif 16
                        line 8 21067 784 20 base 14
                          text "XHTML 1.0 document that adheres to Appendix C (see below) into a valid HTML 4.01 document. Making this translation" 8 21069 764 16 serif 16
                        line 8 21087 784 20 base 14
                          text "requires the following steps:" 8 21089 184 16 serif 16
                      block ol 8 21123 784 160
                        block li 48 21123 744 40
                          line 48 21123 744 20 base 14
                            span code 360 21125 32 16
                            span code 596 21125 64 16
                            text "The language for an element is specified with a " 48 21125 312 16 serif 16
                            text "lang" 360 21125 32 16 mono 16
                            text " attribute rather than the XHTML " 392 21125 204 16 serif 16
                            text "xml:lang" 596 21125 64 16 mono 16
                            text " attribute. XHTML" 660 21125 108 16 serif 16
                          line 48 21143 744 20 base 14
                            text "uses XML's built-in language-defining functionality attribute." 48 21145 396 16 serif 16
                          marker "1. " 36 21125 12 16
                        block li 48 21163 744 20
                          line 48 21163 744 20 base 14
                            span code 248 21165 72 16
                            text "Remove the XML namespace (" 48 21165 200 16 serif 16
                            text "xmlns=URI" 248 21165 72 16 mono 16
                            text "). HTML has no facilities for namespaces." 320 21165 272 16 serif 16
                          marker "2. " 32 21165 16 16
                        block li 48 21183 744 20
                          line 48 21183 744 20 base 14
                            text "Change the document type declaration from XHTML 1.0 to HTML 4.01." 48 21185 436 16 serif 16
                          marker "3. " 32 21185 16 16
                        block li 48 21203 744 20
                          line 48 21203 744 20 base 14
                            span span 420 21205 304 16
                            span code 420 21205 304 16
                            text "If present, remove the XML declaration. Typically this is: " 48 21205 372 16 serif 16
                            text "<?xml version=\"1.0\" encoding=\"utf-8\"?>" 420 21205 304 16 mono 16
                            text "." 724 21205 4 16 serif 16
                          marker "4. " 32 21205 16 16
                        block li 48 21223 744 40
                          line 48 21223 744 20 base 14
                            span code 360 21225 72 16
                            text "Ensure that the document's MIME type is set to " 48 21225 312 16 serif 16
                            text "text/html" 360 21225 72 16 mono 16
                            text ". For both HTML and XHTML, this comes from the HTTP" 432 21225 348 16 serif 16
                          line 48 21243 744 20 base 14
                            span code 48 21245 96 16
                            text "Content-Type" 48 21245 96 16 mono 16
                            text " header sent by the server." 144 21245 172 16 serif 16
                          marker "5. " 32 21225 16 16
                        block li 48 21263 744 20
                          line 48 21263 744 20 base 14
                            span span 528 21265 8 16
                            span span 536 21265 16 16
                            span span 552 21265 16 16
                            span code 528 21265 40 16
                            span span 588 21265 8 16
                            span span 596 21265 16 16
                            span span 612 21265 8 16
                            span code 588 21265 32 16
                            text "Change the XML empty-element syntax to an HTML style empty element (" 48 21265 480 16 serif 16
                            text "<" 528 21265 8 16 mono 16
                            text "br" 536 21265 16 16 mono 16
                            text "/>" 552 21265 16 16 mono 16
                            text " to " 568 21265 20 16 serif 16
                            text "<" 588 21265 8 16 mono 16
                            text "br" 596 21265 16 16 mono 16
                            text ">" 612 21265 8 16 mono 16
                            text ")." 620 21265 12 16 serif 16
                          marker "6. " 32 21265 16 16
                      block p 8 21299 784 80
                        line 8 21299 784 20 base 14
                          text "Those are the main changes necessary to translate a document from XHTML 1.0 to HTML 4.01. To translate from HTML to" 8 21301 768 16 serif 16
                        line 8 21319 784 20 base 14
                          text "XHTML would also require the addition of any omitted opening or closing tags. Whether coding in HTML or XHTML it may" 8 21321 772 16 serif 16
                        line 8 21339 784 20 base 14
                          text "just be best to always include the optional tags within an HTML document rather than remembering which tags can be" 8 21341 764 16 serif 16
                        line 8 21359 784 20 base 14
                          text "omitted." 8 21361 52 16 serif 16
                      block p 8 21395 784 40
                        line 8 21395 784 20 base 14
                          text "A well-formed XHTML document adheres to all the syntax requirements of XML. A valid document adheres to the content" 8 21397 776 16 serif 16
                        line 8 21415 784 20 base 14
                          text "specification for XHTML, which describes the document structure." 8 21417 424 16 serif 16
                      block p 8 21451 784 40
                        line 8 21451 784 20 base 14
                          span span 652 21455 7 13
                          span span 672 21455 6 13
                          span span 652 21455 26 13
                          span a 652 21455 26 13 link 644
                          span sup 652 21455 26 13
                          text "The W3C recommends several conventions to ensure an easy migration between HTML and XHTML." 8 21453 644 16 serif 16
                          text "[" 652 21455 7 13 serif 13 underline link 644
                          text "98" 659 21455 13 13 serif 13 underline link 644
                          text "]" 672 21455 6 13 serif 13 underline link 644
                          text " The following" 678 21453 92 16 serif 16
                        line 8 21471 784 20 base 14
                          text "steps can be applied to XHTML 1.0 documents only:" 8 21473 332 16 serif 16
                      block ul 8 21507 784 100
                        block li 48 21507 744 20
                          line 48 21507 744 20 base 14
                            span code 136 21509 64 16
                            span code 232 21509 32 16
                            text "Include both " 48 21509 88 16 serif 16
                            text "xml:lang" 136 21509 64 16 mono 16
                            text " and " 200 21509 32 16 serif 16
                            text "lang" 232 21509 32 16 mono 16
                            text " attributes on any elements assigning language." 264 21509 312 16 serif 16
                          marker "• " 36 21509 12 16
                        block li 48 21527 744 20
                          line 48 21527 744 20 base 14
                            text "Use the empty-element syntax only for elements specified as empty in HTML." 48 21529 504 16 serif 16
                          marker "• " 36 21529 12 16
                        block li 48 21547 744 20
                          line 48 21547 744 20 base 14
                            span span 456 21549 8 16
                            span span 464 21549 16 16
                            span span 480 21549 8 16
                            span code 456 21549 32 16
                            span span 560 21549 8 16
                            span span 568 21549 16 16
                            span span 584 21549 16 16
                            span code 560 21549 40 16
                            text "Remove the closing slash in empty-element tags: for example " 48 21549 408 16 serif 16
                            text "<" 456 21549 8 16 mono 16
                            text "br" 464 21549 16 16 mono 16
                            text ">" 480 21549 8 16 mono 16
                            text " instead of " 488 21549 72 16 serif 16
                            text "<" 560 21549 8 16 mono 16
                            text "br" 568 21549 16 16 mono 16
                            text "/>" 584 21549 16 16 mono 16
                            text "." 600 21549 4 16 serif 16
                          marker "• " 36 21549 12 16
                        block li 48 21567 744 20
                          line 48 21567 744 20 base 14
                            span code 644 21569 0 16
                            span span 676 21569 8 16
                            span span 684 21569 24 16
                            span span 716 21569 16 16
                            span code 676 21569 56 16
                            text "Include explicit close tags for elements that permit content but are left empty (for example, " 48 21569 596 16 serif 16
                            text ", not " 644 21569 32 16 serif 16
                            text "<" 676 21569 8 16 mono 16
                            text "div" 684 21569 24 16 mono 16
                            text " " 708 21569 8 16 mono 16
                            text "/>" 716 21569 16 16 mono 16
                            text ")." 732 21569 12 16 serif 16
                          marker "• " 36 21569 12 16
                        block li 48 21587 744 20
                          line 48 21587 744 20 base 14
                            text "Omit the XML declaration." 48 21589 164 16 serif 16
                          marker "• " 36 21589 12 16
                      block p 8 21623 784 100
                        line 8 21623 784 20 base 14
                          text "By carefully following the W3C's compatibility guidelines, a user agent should be able to interpret the document equally" 8 21625 772 16 serif 16
                        line 8 21643 784 20 base 14
                          text "as HTML or XHTML. For documents that are XHTML 1.0 and have been made compatible in this way, the W3C permits them" 8 21645 784 16 serif 16
                        line 8 21663 784 20 base 14
                          span code 244 21665 72 16
                          span a 320 21665 72 16 link 645
                          span code 552 21665 168 16
                          text "to be served either as HTML (with a " 8 21665 236 16 serif 16
                          text "text/html" 244 21665 72 16 mono 16
                          text " " 316 21665 4 16 serif 16
                          text "MIME type" 320 21665 72 16 serif 16 underline link 645
                          text "), or as XHTML (with an " 392 21665 160 16 serif 16
                          text "application/xhtml+xml" 552 21665 168 16 mono 16
                          text " or" 720 21665 16 16 serif 16
                        line 8 21683 784 20 base 14
                          span code 8 21685 120 16
                          text "application/xml" 8 21685 120 16 mono 16
                          text " MIME type). When delivered as XHTML, browsers should use an XML parser, which adheres strictly" 128 21685 652 16 serif 16
                        line 8 21703 784 20 base 14
                          text "to the XML specifications for parsing the document's contents." 8 21705 404 16 serif 16
                    block section 8 21741 784 1051
                      block div 8 21741 784 24
                        block h3 8 21741 784 24
                          line 8 21741 784 24 base 17
                            text "Transitional versus strict" 8 21744 190 19 serif 19 bold
                      block p 8 21784 784 140
                        line 8 21784 784 20 base 14
                          text "HTML 4 defined three different versions of the language: Strict, Transitional (once called Loose), and Frameset. The Strict" 8 21786 784 16 serif 16
                        line 8 21804 784 20 base 14
                          text "version is intended for new documents and is considered best practice, while the Transitional and Frameset versions" 8 21806 760 16 serif 16
                        line 8 21824 784 20 base 14
                          text "were developed to make it easier to transition documents that conformed to older HTML specifications or did not conform" 8 21826 780 16 serif 16
                        line 8 21844 784 20 base 14
                          text "to any specification to a version of HTML 4. The Transitional and Frameset versions allow for presentational markup," 8 21846 752 16 serif 16
                        line 8 21864 784 20 base 14
                          span a 312 21866 152 16 link 646
                          text "which is omitted in the Strict version. Instead, " 8 21866 304 16 serif 16
                          text "cascading style sheets" 312 21866 152 16 serif 16 underline link 646
                          text " are encouraged to improve the presentation of" 464 21866 300 16 serif 16
                        line 8 21884 784 20 base 14
                          text "HTML documents. Because XHTML 1 only defines an XML syntax for the language defined by HTML 4, the same" 8 21886 716 16 serif 16
                        line 8 21904 784 20 base 14
                          text "differences apply to XHTML 1 as well." 8 21906 240 16 serif 16
                      block p 8 21940 784 20
                        line 8 21940 784 20 base 14
                          text "The Transitional version allows the following parts of the vocabulary, which are not included in the Strict version:" 8 21942 732 16 serif 16
                      block ul 8 21976 784 760
                        block li 48 21976 744 40
                          block anon 48 21976 744 20
                            line 48 21976 744 20 base 14
                              text "A looser content model" 48 21978 148 16 serif 16
                          block ul 48 21996 744 20
                            block li 88 21996 704 20
                              line 88 21996 704 20 base 14
                                span code 440 21998 32 16
                                span code 480 21998 80 16
                                span code 568 21998 32 16
                                span code 608 21998 64 16
                                span code 704 21998 64 16
                                text "Inline elements and plain text are allowed directly in: " 88 21998 352 16 serif 16
                                text "body" 440 21998 32 16 mono 16
                                text ", " 472 21998 8 16 serif 16
                                text "blockquote" 480 21998 80 16 mono 16
                                text ", " 560 21998 8 16 serif 16
                                text "form" 568 21998 32 16 mono 16
                                text ", " 600 21998 8 16 serif 16
                                text "noscript" 608 21998 64 16 mono 16
                                text " and " 672 21998 32 16 serif 16
                                text "noframes" 704 21998 64 16 mono 16
                              marker "◦ " 76 21998 12 16
                          marker "• " 36 21978 12 16
                        block li 48 22016 744 120
                          block anon 48 22016 744 20
                            line 48 22016 744 20 base 14
                              text "Presentation related elements" 48 22018 192 16 serif 16
                          block ul 48 22036 744 100
                            block li 88 22036 704 20
                              line 88 22036 704 20 base 14
                                span code 160 22038 8 16
                                text "underline (" 88 22038 72 16 serif 16
                                text "u" 160 22038 8 16 mono 16
                                text ") (Deprecated. can confuse a visitor with a hyperlink.)" 168 22038 356 16 serif 16
                              marker "◦ " 76 22038 12 16
                            block li 88 22056 704 20
                              line 88 22056 704 20 base 14
