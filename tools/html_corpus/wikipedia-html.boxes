                        span sup 265 8743 19 13
                        text "presentational HTML " 8 8741 136 16 serif 16
                        text "since 1997" 144 8741 68 16 serif 16
                        text "." 212 8741 4 16 serif 16
                        text "[" 216 8743 7 13 serif 13 underline link 348
                        text "update" 223 8743 35 13 serif 13 underline link 348
