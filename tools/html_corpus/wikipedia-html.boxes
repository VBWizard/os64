                    block section 8 17996 784 102
                      block div 8 17996 784 23
                        block h3 8 17996 784 23
                          line 8 17996 784 23 base 16
                            text "Data types" 8 17998 81 19 serif 19 bold
                      block p 8 18038 784 60
                        line 8 18038 784 20 base 14
                          span a 152 18040 68 16 link 569
                          text "HTML defines several " 8 18040 144 16 serif 16
                          text "data types" 152 18040 68 16 serif 16 underline link 569
                          text " for element content, such as script data and stylesheet data, and a plethora of types for" 220 18040 568 16 serif 16
                        line 8 18058 784 20 base 14
                          span a 264 18060 32 16 link 570
                          text "attribute values, including IDs, names, " 8 18060 256 16 serif 16
                          text "URIs" 264 18060 32 16 serif 16 underline link 570
                          text ", numbers, units of length, languages, media descriptors, colors, character" 296 18060 480 16 serif 16
                        line 8 18078 784 20 base 14
                          text "encodings, dates and times, and so on. All of these data types are specializations of character data." 8 18080 648 16 serif 16
                    block section 8 18117 784 474
                      block div 8 18117 784 24
                        block h3 8 18117 784 24
                          line 8 18117 784 24 base 16
                            text "Document type declaration" 8 18119 204 19 serif 19 bold
                      block p 8 18159 784 40
                        line 8 18159 784 20 base 14
                          span a 296 18161 172 16 link 571
                          text "HTML documents are required to start with a " 8 18161 288 16 serif 16
                          text "document type declaration" 296 18161 172 16 serif 16 underline link 571
                          text " (informally, a \"doctype\"). In browsers, the" 468 18161 288 16 serif 16
                        line 8 18179 784 20 base 14
                          span a 472 18181 80 16 link 572
                          text "doctype helps to define the rendering mode—particularly whether to use " 8 18181 464 16 serif 16
                          text "quirks mode" 472 18181 80 16 serif 16 underline link 572
                          text "." 552 18181 4 16 serif 16
                      block p 8 18215 784 80
                        line 8 18215 784 20 base 14
                          text "The original purpose of the doctype was to enable the parsing and validation of HTML documents by SGML tools based" 8 18217 768 16 serif 16
                        line 8 18235 784 20 base 14
                          span a 52 18237 160 16 link 573
                          text "on the " 8 18237 44 16 serif 16
                          text "document type definition" 52 18237 160 16 serif 16 underline link 573
                          text " (DTD). The DTD to which the DOCTYPE refers contains a machine-readable grammar" 212 18237 544 16 serif 16
                        line 8 18255 784 20 base 14
                          text "specifying the permitted and prohibited content for a document conforming to such a DTD. Browsers, on the other hand, do" 8 18257 784 16 serif 16
                        line 8 18275 784 20 base 14
                          text "not implement HTML as an application of SGML and as consequence do not read the DTD." 8 18277 576 16 serif 16
                      block p 8 18311 784 20
                        line 8 18311 784 20 base 14
                          span a 8 18313 44 16 link 574
                          span span 632 18316 7 13
                          span span 652 18316 6 13
                          span span 632 18316 26 13
                          span a 632 18316 26 13 link 575
                          span sup 632 18316 26 13
                          text "HTML5" 8 18313 44 16 serif 16 underline link 574
                          text " does not define a DTD; therefore, in HTML5 the doctype declaration is simpler and shorter:" 52 18313 580 16 serif 16
                          text "[" 632 18316 7 13 serif 13 underline link 575
                          text "84" 639 18316 13 13 serif 13 underline link 575
                          text "]" 652 18316 6 13 serif 13 underline link 575
                      block div 8 18347 784 20
                        block pre 8 18347 784 20
                          line 8 18347 784 20 base 14
                            span span 8 18349 0 16
                            span span 8 18349 72 16
                            span span 88 18349 32 16
                            span span 120 18349 8 16
                            text "<!DOCTYPE" 8 18349 72 16 mono 16
                            text " " 80 18349 8 16 mono 16
                            text "html" 88 18349 32 16 mono 16
                            text ">" 120 18349 8 16 mono 16
                      block p 8 18383 784 20
                        line 8 18383 784 20 base 14
                          text "An example of an HTML 4 doctype" 8 18385 220 16 serif 16
                      block div 8 18419 784 20
                        block pre 8 18419 784 20
                          line 8 18419 784 20 base 14
                            span span 8 18421 0 16
                            span span 8 18421 72 16
                            span span 88 18421 32 16
                            span span 128 18421 48 16
                            span span 184 18421 216 16
                            span span 408 18421 320 16
                            span span 728 18421 8 16
                            text "<!DOCTYPE" 8 18421 72 16 mono 16
                            text " " 80 18421 8 16 mono 16
                            text "HTML" 88 18421 32 16 mono 16
                            text " " 120 18421 8 16 mono 16
                            text "PUBLIC" 128 18421 48 16 mono 16
                            text " " 176 18421 8 16 mono 16
                            text "\"-//W3C//DTD HTML 4.01//EN\"" 184 18421 216 16 mono 16
                            text " " 400 18421 8 16 mono 16
                            text "\"https://www.w3.org/TR/html4/strict.dtd\"" 408 18421 320 16 mono 16
                            text ">" 728 18421 8 16 mono 16
                      block p 8 18455 784 60
                        line 8 18455 784 20 base 14
                          text "This declaration references the DTD for the \"strict\" version of HTML 4.01. SGML-based validators read the DTD in order to" 8 18457 772 16 serif 16
                        line 8 18475 784 20 base 14
                          text "properly parse the document and to perform validation. In modern browsers, a valid doctype activates standards mode" 8 18477 768 16 serif 16
                        line 8 18495 784 20 base 14
                          span a 104 18497 80 16 link 576
                          text "as opposed to " 8 18497 96 16 serif 16
                          text "quirks mode" 104 18497 80 16 serif 16 underline link 576
                          text "." 184 18497 4 16 serif 16
                      block p 8 18531 784 60
                        line 8 18531 784 20 base 14
                          span a 428 18533 128 16 link 577
                          text "In addition, HTML 4.01 provides Transitional and Frameset DTDs, " 8 18533 420 16 serif 16
                          text "as explained below" 428 18533 128 16 serif 16 underline link 577
                          text ". The transitional type is the most" 556 18533 216 16 serif 16
                        line 8 18551 784 20 base 14
                          text "inclusive, incorporating current tags as well as older or \"deprecated\" tags, with the Strict DTD excluding deprecated tags." 8 18553 784 16 serif 16
                        line 8 18571 784 20 base 14
                          span span 732 18576 7 13
                          span span 752 18576 6 13
                          span span 732 18576 26 13
                          span a 732 18576 26 13 link 578
                          span sup 732 18576 26 13
                          text "The frameset has all tags necessary to make frames on a page along with the tags included in transitional type." 8 18573 724 16 serif 16
                          text "[" 732 18576 7 13 serif 13 underline link 578
                          text "85" 739 18576 13 13 serif 13 underline link 578
                          text "]" 752 18576 6 13 serif 13 underline link 578
                  block section 8 18611 784 706
                    block div 8 18611 784 30
                      block h2 8 18611 784 30
                        line 8 18611 784 30 base 21
                          text "Semantic HTML" 8 18614 150 24 serif 24 bold
                    block div 8 18661 784 20
                      line 8 18661 784 20 base 14
                        span a 92 18663 100 16 link 579
                        text "Main article: " 8 18663 84 16 serif 16
                        text "Semantic HTML" 92 18663 100 16 serif 16 underline link 579
                    block p 8 18697 784 100
                      line 8 18697 784 20 base 14
                        text "Semantic HTML is a way of writing HTML that emphasizes the meaning of the encoded information over its presentation" 8 18699 772 16 serif 16
                      line 8 18717 784 20 base 14
                        span span 420 18721 7 13
                        span span 440 18721 6 13
                        span span 420 18721 26 13
                        span a 420 18721 26 13 link 580
                        span sup 420 18721 26 13
                        text "(look). HTML has included semantic markup from its inception," 8 18719 412 16 serif 16
                        text "[" 420 18721 7 13 serif 13 underline link 580
                        text "86" 427 18721 13 13 serif 13 underline link 580
                        text "]" 440 18721 6 13 serif 13 underline link 580
                        text " but has also included presentational markup, such" 446 18719 332 16 serif 16
                      line 8 18737 784 20 base 14
                        span span 28 18739 8 16
                        span span 68 18739 8 16
                        span code 28 18739 48 16
                        span span 84 18739 8 16
                        span span 100 18739 8 16
                        span code 84 18739 24 16
                        span span 144 18739 8 16
                        span span 200 18739 8 16
                        span code 144 18739 64 16
                        span a 504 18739 84 16 link 581
                        text "as " 8 18739 20 16 serif 16
                        text "<" 28 18739 8 16 mono 16
                        text "font" 36 18739 32 16 mono 16
                        text ">" 68 18739 8 16 mono 16
                        text ", " 76 18739 8 16 serif 16
                        text "<" 84 18739 8 16 mono 16
                        text "i" 92 18739 8 16 mono 16
                        text ">" 100 18739 8 16 mono 16
                        text ", and " 108 18739 36 16 serif 16
                        text "<" 144 18739 8 16 mono 16
                        text "center" 152 18739 48 16 mono 16
                        text ">" 200 18739 8 16 mono 16
                        text " tags. There are also the semantically neutral " 208 18739 296 16 serif 16
                        text "div and span" 504 18739 84 16 serif 16 underline link 581
                        text " tags. Since the late 1990s," 588 18739 172 16 serif 16
                      line 8 18757 784 20 base 14
                        span a 48 18759 152 16 link 582
                        text "when " 8 18759 40 16 serif 16
                        text "Cascading Style Sheets" 48 18759 152 16 serif 16 underline link 582
                        text " were beginning to work in most browsers, web authors have been encouraged to avoid the" 200 18759 592 16 serif 16
                      line 8 18777 784 20 base 14
                        span a 360 18779 248 16 link 583
                        span span 612 18781 7 13
                        span span 632 18781 6 13
                        span span 612 18781 26 13
                        span a 612 18781 26 13 link 584
                        span sup 612 18781 26 13
                        text "use of presentational HTML markup with a view to the " 8 18779 352 16 serif 16
                        text "separation of content and presentation" 360 18779 248 16 serif 16 underline link 583
                        text "." 608 18779 4 16 serif 16
                        text "[" 612 18781 7 13 serif 13 underline link 584
                        text "87" 619 18781 13 13 serif 13 underline link 584
                        text "]" 632 18781 6 13 serif 13 underline link 584
                    block p 8 18813 784 140
                      line 8 18813 784 20 base 14
                        span a 188 18815 92 16 link 585
                        span a 288 18815 108 16 link 586
                        text "In a 2001 discussion of the " 8 18815 180 16 serif 16
                        text "Semantic Web" 188 18815 92 16 serif 16 underline link 585
                        text ", " 280 18815 8 16 serif 16
                        text "Tim Berners-Lee" 288 18815 108 16 serif 16 underline link 586
                        text " and others gave examples of ways in which intelligent" 396 18815 360 16 serif 16
                      line 8 18833 784 20 base 14
                        text "software \"agents\" may one day automatically crawl the web and find, filter, and correlate previously unrelated," 8 18835 720 16 serif 16
                      line 8 18853 784 20 base 14
                        span span 308 18857 7 13
                        span span 328 18857 6 13
                        span span 308 18857 26 13
                        span a 308 18857 26 13 link 587
                        span sup 308 18857 26 13
                        span span 630 18857 7 13
                        span span 637 18857 35 13
                        span a 637 18857 35 13 link 588
                        span i 637 18857 35 13
                        span span 672 18857 7 13
                        span sup 630 18857 49 13
                        text "published facts for the benefit of human users." 8 18855 300 16 serif 16
                        text "[" 308 18857 7 13 serif 13 underline link 587
                        text "88" 315 18857 13 13 serif 13 underline link 587
                        text "]" 328 18857 6 13 serif 13 underline link 587
                        text " Such agents are not commonplace even now" 334 18855 296 16 serif 16
                        text "[" 630 18857 7 13 serif 13
                        text "when?" 637 18857 35 13 serif 13 italic underline link 588
                        text "]" 672 18857 7 13 serif 13
                        text ", but some of the" 679 18855 108 16 serif 16
                      line 8 18873 784 20 base 14
                        span a 64 18875 52 16 link 589
                        span a 124 18875 60 16 link 590
                        span a 216 18875 176 16 link 591
                        span span 536 18877 7 13
                        span span 543 18877 81 13
                        span a 543 18877 81 13 link 592
                        span i 543 18877 81 13
                        span span 624 18877 6 13
                        span sup 536 18877 94 13
                        text "ideas of " 8 18875 56 16 serif 16
                        text "Web 2.0" 64 18875 52 16 serif 16 underline link 589
                        text ", " 116 18875 8 16 serif 16
                        text "mashups" 124 18875 60 16 serif 16 underline link 590
                        text " and " 184 18875 32 16 serif 16
                        text "price comparison websites" 216 18875 176 16 serif 16 underline link 591
                        text " may be coming close" 392 18875 144 16 serif 16
                        text "[" 536 18877 7 13 serif 13
                        text "citation needed" 543 18877 81 13 serif 13 italic underline link 592
                        text "]" 624 18877 6 13 serif 13
                        text ". The main difference" 630 18875 136 16 serif 16
                      line 8 18893 784 20 base 14
                        span a 700 18895 76 16 link 593
                        text "between these web application hybrids and Berners-Lee's semantic agents lies in the fact that the current " 8 18895 692 16 serif 16
                        text "aggregation" 700 18895 76 16 serif 16 underline link 593
                      line 8 18913 784 20 base 14
                        span a 368 18915 104 16 link 594
                        text "and hybridization of information is usually designed by " 8 18915 360 16 serif 16
                        text "web developers" 368 18915 104 16 serif 16 underline link 594
                        text ", who already know the web locations and the" 472 18915 300 16 serif 16
                      line 8 18933 784 20 base 14
                        span a 8 18935 96 16 link 595
                        text "API semantics" 8 18935 96 16 serif 16 underline link 595
                        text " of the specific data they wish to mash, compare and combine." 104 18935 408 16 serif 16
                    block p 8 18969 784 80
                      line 8 18969 784 20 base 14
                        text "An important type of web agent that does crawl and read web pages automatically, without prior knowledge of what it" 8 18971 760 16 serif 16
                      line 8 18989 784 20 base 14
                        span a 120 18991 80 16 link 596
                        text "might find, is the " 8 18991 112 16 serif 16
                        text "web crawler" 120 18991 80 16 serif 16 underline link 596
                        text " or search-engine spider. These software agents are dependent on the semantic clarity of" 200 18991 580 16 serif 16
                      line 8 19009 784 20 base 14
                        span a 380 19011 68 16 link 597
                        text "web pages they find as they use various techniques and " 8 19011 372 16 serif 16
                        text "algorithms" 380 19011 68 16 serif 16 underline link 597
                        text " to read and index millions of web pages a day and" 448 19011 332 16 serif 16
                      line 8 19029 784 20 base 14
                        span a 164 19031 104 16 link 598
                        text "provide web users with " 8 19031 156 16 serif 16
                        text "search facilities" 164 19031 104 16 serif 16 underline link 598
                        text " without which the World Wide Web's usefulness would be greatly reduced." 268 19031 488 16 serif 16
                    block p 8 19065 784 80
                      line 8 19065 784 20 base 14
                        text "In order for search engine spiders to be able to rate the significance of pieces of text they find in HTML documents, and" 8 19067 772 16 serif 16
                      line 8 19085 784 20 base 14
                        text "also for those creating mashups and other hybrids as well as for more automated agents as they are developed, the" 8 19087 748 16 serif 16
                      line 8 19105 784 20 base 14
                        text "semantic structures that exist in HTML need to be widely and uniformly applied to bring out the meaning of the published" 8 19107 780 16 serif 16
                      line 8 19125 784 20 base 14
                        span span 36 19129 7 13
                        span span 56 19129 6 13
                        span span 36 19129 26 13
                        span a 36 19129 26 13 link 599
                        span sup 36 19129 26 13
                        text "text." 8 19127 28 16 serif 16
                        text "[" 36 19129 7 13 serif 13 underline link 599
                        text "89" 43 19129 13 13 serif 13 underline link 599
                        text "]" 56 19129 6 13 serif 13 underline link 599
                    block p 8 19161 784 60
                      line 8 19161 784 20 base 14
                        span a 212 19163 72 16 link 600
                        span a 420 19163 44 16 link 601
                        text "Presentational markup tags are " 8 19163 204 16 serif 16
                        text "deprecated" 212 19163 72 16 serif 16 underline link 600
                        text " in current HTML and " 284 19163 136 16 serif 16
                        text "XHTML" 420 19163 44 16 serif 16 underline link 601
                        text " recommendations. The majority of presentational" 464 19163 320 16 serif 16
                      line 8 19181 784 20 base 14
                        text "features from previous versions of HTML are no longer allowed as they lead to poorer accessibility, higher cost of site" 8 19183 760 16 serif 16
                      line 8 19201 784 20 base 14
                        span span 276 19205 7 13
                        span span 296 19205 6 13
                        span span 276 19205 26 13
                        span a 276 19205 26 13 link 602
                        span sup 276 19205 26 13
                        text "maintenance, and larger document sizes." 8 19203 268 16 serif 16
                        text "[" 276 19205 7 13 serif 13 underline link 602
                        text "90" 283 19205 13 13 serif 13 underline link 602
                        text "]" 296 19205 6 13 serif 13 underline link 602
                    block p 8 19237 784 80
                      line 8 19237 784 20 base 14
                        span a 268 19239 84 16 link 603
                        span a 548 19239 168 16 link 604
                        text "Good semantic HTML also improves the " 8 19239 260 16 serif 16
                        text "accessibility" 268 19239 84 16 serif 16 underline link 603
                        text " of web documents (see also " 352 19239 196 16 serif 16
                        text "Web Content Accessibility" 548 19239 168 16 serif 16 underline link 604
                      line 8 19257 784 20 base 14
                        span a 8 19259 68 16 link 604
                        text "Guidelines" 8 19259 68 16 serif 16 underline link 604
                        text "). For example, when a screen reader or audio browser can correctly ascertain the structure of a document, it" 76 19259 704 16 serif 16
                      line 8 19277 784 20 base 14
                        text "will not waste the visually impaired user's time by reading out repeated or irrelevant information when it has been" 8 19279 736 16 serif 16
                      line 8 19297 784 20 base 14
                        text "marked up correctly." 8 19299 132 16 serif 16
                  block section 8 19337 784 995
                    block div 8 19337 784 30
                      block h2 8 19337 784 30
                        line 8 19337 784 30 base 21
                          text "Delivery" 8 19340 78 24 serif 24 bold
                    block p 8 19387 784 40
                      line 8 19387 784 20 base 14
                        text "HTML documents can be delivered by the same means as any other computer file. However, they are most often" 8 19389 724 16 serif 16
                      line 8 19407 784 20 base 14
                        span a 132 19409 32 16 link 605
                        span a 212 19409 72 16 link 606
                        span a 324 19409 36 16 link 607
                        text "delivered either by " 8 19409 124 16 serif 16
                        text "HTTP" 132 19409 32 16 serif 16 underline link 605
                        text " from a " 164 19409 48 16 serif 16
                        text "web server" 212 19409 72 16 serif 16 underline link 606
                        text " or by " 284 19409 40 16 serif 16
                        text "email" 324 19409 36 16 serif 16 underline link 607
                        text "." 360 19409 4 16 serif 16
                    block section 8 19446 784 350
                      block div 8 19446 784 23
                        block h3 8 19446 784 23
                          line 8 19446 784 23 base 16
                            text "HTTP" 8 19448 38 19 serif 19 bold
                      block div 8 19488 784 20
                        line 8 19488 784 20 base 14
                          span a 92 19490 32 16 link 608
                          text "Main article: " 8 19490 84 16 serif 16
                          text "HTTP" 92 19490 32 16 serif 16 underline link 608
                      block p 8 19524 784 100
                        line 8 19524 784 20 base 14
                          span a 36 19526 104 16 link 609
                          text "The " 8 19526 28 16 serif 16
                          text "World Wide Web" 36 19526 104 16 serif 16 underline link 609
                          text " is composed primarily of HTML documents transmitted from web servers to web browsers using the" 140 19526 648 16 serif 16
                        line 8 19544 784 20 base 14
                          span a 8 19546 172 16 link 610
                          text "Hypertext Transfer Protocol" 8 19546 172 16 serif 16 underline link 610
                          text " (HTTP). However, HTTP is used to serve images, sound, and other content, in addition to" 180 19546 576 16 serif 16
                        line 8 19564 784 20 base 14
                          text "HTML. To allow the web browser to know how to handle each document it receives, other information is transmitted" 8 19566 748 16 serif 16
                        line 8 19584 784 20 base 14
                          span a 208 19586 64 16 link 611
                          span a 412 19586 72 16 link 612
                          span kbd 528 19586 72 16
                          text "along with the document. This " 8 19586 200 16 serif 16
                          text "meta data" 208 19586 64 16 serif 16 underline link 611
                          text " usually includes the " 272 19586 140 16 serif 16
                          text "MIME type" 412 19586 72 16 serif 16 underline link 612
                          text " (e.g., " 484 19586 44 16 serif 16
                          text "text/html" 528 19586 72 16 mono 16
                          text " or" 600 19586 16 16 serif 16
                        line 8 19604 784 20 base 14
                          span kbd 8 19606 168 16
                          span a 404 19606 188 16 link 613
                          text "application/xhtml+xml" 8 19606 168 16 mono 16
                          text ") and the character encoding (see " 176 19606 228 16 serif 16
                          text "Character encodings in HTML" 404 19606 188 16 serif 16 underline link 613
                          text ")." 592 19606 12 16 serif 16
                      block p 8 19640 784 80
                        line 8 19640 784 20 base 14
                          text "In modern browsers, the MIME type that is sent with the HTML document may affect how the document is initially" 8 19642 740 16 serif 16
                        line 8 19660 784 20 base 14
                          span a 492 19662 80 16 link 614
                          text "interpreted. A document sent with the XHTML MIME type is expected to be " 8 19662 484 16 serif 16
                          text "well-formed" 492 19662 80 16 serif 16 underline link 614
                          text " XML; syntax errors may cause" 572 19662 200 16 serif 16
                        line 8 19680 784 20 base 14
                          text "the browser to fail to render it. The same document sent with the HTML MIME type might be displayed successfully" 8 19682 748 16 serif 16
                        line 8 19700 784 20 base 14
                          text "since some browsers are more lenient with HTML." 8 19702 324 16 serif 16
                      block p 8 19736 784 60
                        line 8 19736 784 20 base 14
                          text "The W3C recommendations state that XHTML 1.0 documents that follow guidelines set forth in the recommendation's" 8 19738 748 16 serif 16
                        line 8 19756 784 20 base 14
                          span span 340 19760 7 13
                          span span 356 19760 7 13
                          span span 340 19760 23 13
                          span a 340 19760 23 13 link 615
                          span sup 340 19760 23 13
                          span span 719 19760 6 13
                          span span 738 19760 7 13
                          span span 719 19760 26 13
                          span a 719 19760 26 13 link 616
                          span sup 719 19760 26 13
                          text "Appendix C may be labeled with either MIME Type." 8 19758 332 16 serif 16
                          text "[" 340 19760 7 13 serif 13 underline link 615
                          text "91" 347 19760 9 13 serif 13 underline link 615
                          text "]" 356 19760 7 13 serif 13 underline link 615
                          text " XHTML 1.1 also states that XHTML 1.1 documents should" 363 19758 356 16 serif 16
                          text "[" 719 19760 6 13 serif 13 underline link 616
                          text "92" 725 19760 13 13 serif 13 underline link 616
                          text "]" 738 19760 7 13 serif 13 underline link 616
                          text " be" 745 19758 20 16 serif 16
                        line 8 19776 784 20 base 14
                          span span 208 19780 7 13
                          span span 228 19780 6 13
                          span span 208 19780 26 13
                          span a 208 19780 26 13 link 617
                          span sup 208 19780 26 13
                          text "labeled with either MIME type." 8 19778 200 16 serif 16
                          text "[" 208 19780 7 13 serif 13 underline link 617
                          text "93" 215 19780 13 13 serif 13 underline link 617
                          text "]" 228 19780 6 13 serif 13 underline link 617
                    block section 8 19815 784 198
                      block div 8 19815 784 24
                        block h3 8 19815 784 24
                          line 8 19815 784 24 base 16
                            text "HTML e-mail" 8 19817 100 19 serif 19 bold
                      block div 8 19857 784 20
