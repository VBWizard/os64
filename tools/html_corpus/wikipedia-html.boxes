                        block figcaption 48 9139 704 20
                          line 48 9139 704 20 base 14
                            span a 48 9141 108 16 link 351
                            text "Tim Berners-Lee" 48 9141 108 16 serif 16 underline link 351
                            text " in April 2009" 156 9141 84 16 serif 16
                      block p 8 9175 784 120
                        line 8 9175 784 20 base 14
                          span a 88 9177 60 16 link 352
                          span a 152 9177 108 16 link 353
                          span a 364 9177 32 16 link 354
                          span a 568 9177 56 16 link 355
                          text "In 1980, the " 8 9177 80 16 serif 16
                          text "physicist" 88 9177 60 16 serif 16 underline link 352
                          text " " 148 9177 4 16 serif 16
                          text "Tim Berners-Lee" 152 9177 108 16 serif 16 underline link 353
                          text ", a contractor at " 260 9177 104 16 serif 16
                          text "CERN" 364 9177 32 16 serif 16 underline link 354
                          text ", proposed and prototyped " 396 9177 172 16 serif 16
                          text "ENQUIRE" 568 9177 56 16 serif 16 underline link 355
                          text ", a system for CERN" 624 9177 124 16 serif 16
                        line 8 9195 784 20 base 14
                          span a 604 9197 52 16 link 356
                          span a 708 9197 60 16 link 357
                          text "researchers to use and share documents. In 1989, Berners-Lee wrote a memo proposing an " 8 9197 596 16 serif 16
                          text "Internet" 604 9197 52 16 serif 16 underline link 356
                          text "-based " 656 9197 52 16 serif 16
                          text "hypertext" 708 9197 60 16 serif 16 underline link 357
                        line 8 9215 784 20 base 14
                          span span 60 9219 7 13
                          span span 73 9219 7 13
                          span span 60 9219 20 13
                          span a 60 9219 20 13 link 358
                          span sup 60 9219 20 13
                          text "system." 8 9217 52 16 serif 16
                          text "[" 60 9219 7 13 serif 13 underline link 358
                          text "4" 67 9219 6 13 serif 13 underline link 358
                          text "]" 73 9219 7 13 serif 13 underline link 358
                          text " Berners-Lee specified HTML and wrote the browser and server software in late 1990. That year, Berners-Lee" 80 9217 700 16 serif 16
                        line 8 9235 784 20 base 14
                          span a 72 9237 88 16 link 359
                          span a 224 9237 92 16 link 360
                          text "and CERN " 8 9237 64 16 serif 16
                          text "data systems" 72 9237 88 16 serif 16 underline link 359
                          text " engineer " 160 9237 64 16 serif 16
                          text "Robert Cailliau" 224 9237 92 16 serif 16 underline link 360
                          text " collaborated on a joint request for funding, but the project was not" 316 9237 428 16 serif 16
                        line 8 9255 784 20 base 14
                          text "formally adopted by CERN. In his personal notes of 1990, Berners-Lee listed \"some of the many areas in which hypertext" 8 9257 780 16 serif 16
                        line 8 9275 784 20 base 14
                          span a 92 9277 88 16 link 361
                          span span 288 9279 7 13
                          span span 301 9279 7 13
                          span span 288 9279 20 13
                          span a 288 9279 20 13 link 362
                          span sup 288 9279 20 13
                          text "is used\"; an " 8 9277 84 16 serif 16
                          text "encyclopedia" 92 9277 88 16 serif 16 underline link 361
                          text " is the first entry." 180 9277 108 16 serif 16
                          text "[" 288 9279 7 13 serif 13 underline link 362
                          text "5" 295 9279 6 13 serif 13 underline link 362
                          text "]" 301 9279 7 13 serif 13 underline link 362
                      block p 8 9311 784 80
                        line 8 9311 784 20 base 14
                          span span 564 9315 7 13
                          span span 577 9315 7 13
                          span span 564 9315 20 13
                          span a 564 9315 20 13 link 363
                          span sup 564 9315 20 13
                          text "The first publicly available description of HTML was a document called \"HTML Tags\"," 8 9313 556 16 serif 16
                          text "[" 564 9315 7 13 serif 13 underline link 363
                          text "6" 571 9315 6 13 serif 13 underline link 363
                          text "]" 577 9315 7 13 serif 13 underline link 363
                          text " first mentioned on the Internet" 584 9313 200 16 serif 16
                        line 8 9331 784 20 base 14
                          span span 212 9335 7 13
                          span span 225 9335 7 13
                          span span 212 9335 20 13
                          span a 212 9335 20 13 link 364
                          span sup 212 9335 20 13
                          span span 232 9335 6 13
                          span span 245 9335 6 13
                          span span 232 9335 19 13
                          span a 232 9335 19 13 link 365
                          span sup 232 9335 19 13
                          text "by Tim Berners-Lee in late 1991." 8 9333 204 16 serif 16
                          text "[" 212 9335 7 13 serif 13 underline link 364
                          text "7" 219 9335 6 13 serif 13 underline link 364
                          text "]" 225 9335 7 13 serif 13 underline link 364
                          text "[" 232 9335 6 13 serif 13 underline link 365
                          text "8" 238 9335 7 13 serif 13 underline link 365
                          text "]" 245 9335 6 13 serif 13 underline link 365
                          text " It describes 18 elements comprising the initial, relatively simple design of HTML." 251 9333 528 16 serif 16
                        line 8 9351 784 20 base 14
                          span a 416 9353 72 16 link 366
                          span a 580 9353 188 16 link 367
                          text "Except for the hyperlink tag, these were strongly influenced by " 8 9353 408 16 serif 16
                          text "CERN SGML" 416 9353 72 16 serif 16 underline link 366
                          text ", an in-house " 488 9353 92 16 serif 16
                          text "Standard Generalized Markup" 580 9353 188 16 serif 16 underline link 367
                        line 8 9371 784 20 base 14
                          span a 8 9373 64 16 link 367
                          span span 680 9375 7 13
                          span span 693 9375 7 13
                          span span 680 9375 20 13
                          span a 680 9375 20 13 link 368
                          span sup 680 9375 20 13
                          text "Language" 8 9373 64 16 serif 16 underline link 367
                          text " (SGML)-based documentation format at CERN. Eleven of these elements still exist in HTML 4." 72 9373 608 16 serif 16
                          text "[" 680 9375 7 13 serif 13 underline link 368
                          text "9" 687 9375 6 13 serif 13 underline link 368
                          text "]" 693 9375 7 13 serif 13 underline link 368
                      block p 8 9407 784 180
                        line 8 9407 784 20 base 14
                          span a 76 9409 112 16 link 369
                          span a 220 9409 92 16 link 370
                          span a 444 9409 60 16 link 371
                          text "HTML is a " 8 9409 68 16 serif 16
                          text "markup language" 76 9409 112 16 serif 16 underline link 369
                          text " that " 188 9409 32 16 serif 16
                          text "web browsers" 220 9409 92 16 serif 16 underline link 370
                          text " use to interpret and " 312 9409 132 16 serif 16
                          text "compose" 444 9409 60 16 serif 16 underline link 371
                          text " text, images, and other material into visible" 504 9409 284 16 serif 16
                        line 8 9427 784 20 base 14
                          text "or audible web pages. Default characteristics for every item of HTML markup are defined in the browser, and these" 8 9429 736 16 serif 16
                        line 8 9447 784 20 base 14
                          span a 584 9449 24 16 link 372
                          text "characteristics can be altered or enhanced by the web page designer's additional use of " 8 9449 576 16 serif 16
                          text "CSS" 584 9449 24 16 serif 16 underline link 372
                          text ". Many of the text elements" 608 9449 176 16 serif 16
                        line 8 9467 784 20 base 14
                          span i 364 9469 176 16
                          text "are mentioned in the 1988 ISO technical report TR 9537 " 8 9469 356 16 serif 16
                          text "Techniques for using SGML" 364 9469 176 16 serif 16 italic
                          text ", which describes the features of early" 540 9469 248 16 serif 16
                        line 8 9487 784 20 base 14
                          span a 340 9489 116 16 link 373
                          span a 692 9489 32 16 link 374
                          text "text formatting languages such as that used by the " 8 9489 332 16 serif 16
                          text "RUNOFF command" 340 9489 116 16 serif 16 underline link 373
                          text " developed in the early 1960s for the " 456 9489 236 16 serif 16
                          text "CTSS" 692 9489 32 16 serif 16 underline link 374
                        line 8 9507 784 20 base 14
                          text "(Compatible Time-Sharing System) operating system. These formatting commands were derived from the commands" 8 9509 760 16 serif 16
                        line 8 9527 784 20 base 14
                          text "used by typesetters to manually format documents. However, the SGML concept of generalized markup is based on" 8 9529 744 16 serif 16
                        line 8 9547 784 20 base 14
                          text "elements (nested annotated ranges with attributes) rather than merely print effects, with separate structure and markup." 8 9549 776 16 serif 16
                        line 8 9567 784 20 base 14
                          text "HTML has been progressively moved in this direction with CSS." 8 9569 408 16 serif 16
                      block p 8 9603 784 140
                        line 8 9603 784 20 base 14
                          span a 656 9605 132 16 link 375
                          text "Berners-Lee considered HTML to be an application of SGML. It was formally defined as such by the " 8 9605 648 16 serif 16
                          text "Internet Engineering" 656 9605 132 16 serif 16 underline link 375
                        line 8 9623 784 20 base 14
                          span a 8 9625 72 16 link 375
                          text "Task Force" 8 9625 72 16 serif 16 underline link 375
                          text " (IETF) with the mid-1993 publication of the first proposal for an HTML specification, the \"Hypertext Markup" 80 9625 696 16 serif 16
                        line 8 9643 784 20 base 14
                          span a 140 9645 84 16 link 376
                          span a 360 9645 84 16 link 377
                          span a 616 9645 160 16 link 378
                          text "Language (HTML)\" " 8 9645 132 16 serif 16
                          text "Internet Draft" 140 9645 84 16 serif 16 underline link 376
                          text " by Berners-Lee and " 224 9645 136 16 serif 16
                          text "Dan Connolly" 360 9645 84 16 serif 16 underline link 377
                          text ", which included an SGML " 444 9645 172 16 serif 16
                          text "document type definition" 616 9645 160 16 serif 16 underline link 378
                          text " to" 776 9645 16 16 serif 16
                        line 8 9663 784 20 base 14
                          span span 124 9667 7 13
                          span span 140 9667 7 13
                          span span 124 9667 23 13
                          span a 124 9667 23 13 link 379
                          span sup 124 9667 23 13
                          span span 147 9667 6 13
                          span span 160 9667 6 13
                          span span 147 9667 19 13
                          span a 147 9667 19 13 link 380
                          span sup 147 9667 19 13
                          span a 698 9665 84 16 link 381
                          text "define the syntax." 8 9665 116 16 serif 16
                          text "[" 124 9667 7 13 serif 13 underline link 379
                          text "10" 131 9667 9 13 serif 13 underline link 379
                          text "]" 140 9667 7 13 serif 13 underline link 379
                          text "[" 147 9667 6 13 serif 13 underline link 380
                          text "11" 153 9667 7 13 serif 13 underline link 380
                          text "]" 160 9667 6 13 serif 13 underline link 380
                          text " The draft expired after six months, but was notable for its acknowledgment of the " 166 9665 532 16 serif 16
                          text "NCSA Mosaic" 698 9665 84 16 serif 16 underline link 381
                        line 8 9683 784 20 base 14
                          text "browser's custom tag for embedding in-line images, reflecting the IETF's philosophy of basing standards on successful" 8 9685 780 16 serif 16
                        line 8 9703 784 20 base 14
                          span a 148 9705 84 16 link 382
                          text "prototypes. Similarly, " 8 9705 140 16 serif 16
                          text "Dave Raggett" 148 9705 84 16 serif 16 underline link 382
                          text "'s competing Internet Draft, \"HTML+ (Hypertext Markup Format)\", from late 1993," 232 9705 520 16 serif 16
                        line 8 9723 784 20 base 14
                          span span 560 9727 7 13
                          span span 576 9727 7 13
                          span span 560 9727 23 13
                          span a 560 9727 23 13 link 383
                          span sup 560 9727 23 13
                          text "suggested standardizing already-implemented features like tables and fill-out forms." 8 9725 552 16 serif 16
                          text "[" 560 9727 7 13 serif 13 underline link 383
                          text "12" 567 9727 9 13 serif 13 underline link 383
                          text "]" 576 9727 7 13 serif 13 underline link 383
                      block p 8 9759 784 60
                        line 8 9759 784 20 base 14
                          text "After the HTML and HTML+ drafts expired in early 1994, the IETF created an HTML Working Group. In 1995, this working" 8 9761 760 16 serif 16
                        line 8 9779 784 20 base 14
                          text "group completed \"HTML 2.0\", the first HTML specification intended to be treated as a standard against which future" 8 9781 744 16 serif 16
                        line 8 9799 784 20 base 14
                          span span 232 9803 7 13
                          span span 248 9803 7 13
                          span span 232 9803 23 13
                          span a 232 9803 23 13 link 384
                          span sup 232 9803 23 13
                          text "implementations should be based." 8 9801 224 16 serif 16
                          text "[" 232 9803 7 13 serif 13 underline link 384
                          text "13" 239 9803 9 13 serif 13 underline link 384
                          text "]" 248 9803 7 13 serif 13 underline link 384
                      block p 8 9835 784 120
                        line 8 9835 784 20 base 14
                          span span 584 9837 68 16
                          span span 652 9837 0 16
                          span span 652 9837 4 16
                          span span 656 9839 7 13
                          span span 698 9839 7 13
                          span a 656 9839 49 13 link 385
                          span sup 656 9839 49 13
                          span span 705 9837 0 16
                          text "Further development under the auspices of the IETF was stalled by competing interests. " 8 9837 576 16 serif 16
                          text "Since 1996" 584 9837 68 16 serif 16
                          text "," 652 9837 4 16 serif 16
                          text "[" 656 9839 7 13 serif 13 underline link 385
                          text "update" 663 9839 35 13 serif 13 underline link 385
                          text "]" 698 9839 7 13 serif 13 underline link 385
                          text " the HTML" 705 9837 64 16 serif 16
                        line 8 9855 784 20 base 14
                          span a 600 9857 180 16 link 386
                          text "specifications have been maintained, with input from commercial software vendors, by the " 8 9857 592 16 serif 16
                          text "World Wide Web Consortium" 600 9857 180 16 serif 16 underline link 386
                        line 8 9875 784 20 base 14
                          span span 56 9879 7 13
                          span span 72 9879 7 13
                          span span 56 9879 23 13
                          span a 56 9879 23 13 link 387
                          span sup 56 9879 23 13
                          span a 411 9877 24 16 link 388
                          span a 443 9877 24 16 link 389
                          text "(W3C)." 8 9877 48 16 serif 16
                          text "[" 56 9879 7 13 serif 13 underline link 387
                          text "14" 63 9879 9 13 serif 13 underline link 387
                          text "]" 72 9879 7 13 serif 13 underline link 387
                          text " In 2000, HTML became an international standard (" 79 9877 332 16 serif 16
                          text "ISO" 411 9877 24 16 serif 16 underline link 388
                          text "/" 435 9877 8 16 serif 16
                          text "IEC" 443 9877 24 16 serif 16 underline link 389
                          text " 15445:2000). HTML 4.01 was published in late" 467 9877 300 16 serif 16
                        line 8 9895 784 20 base 14
                          span a 616 9897 168 16 link 390
                          text "1999, with further errata published through 2001. In 2004, development began on HTML5 in the " 8 9897 608 16 serif 16
                          text "Web Hypertext Application" 616 9897 168 16 serif 16 underline link 390
                        line 8 9915 784 20 base 14
                          span a 8 9917 172 16 link 390
                          text "Technology Working Group" 8 9917 172 16 serif 16 underline link 390
                          text " (WHATWG), which became a joint deliverable with the W3C in 2008, and was completed and" 180 9917 604 16 serif 16
                        line 8 9935 784 20 base 14
                          span span 220 9939 7 13
                          span span 236 9939 7 13
                          span span 220 9939 23 13
                          span a 220 9939 23 13 link 391
                          span sup 220 9939 23 13
                          text "standardized on 28 October 2014." 8 9937 212 16 serif 16
                          text "[" 220 9939 7 13 serif 13 underline link 391
                          text "15" 227 9939 9 13 serif 13 underline link 391
                          text "]" 236 9939 7 13 serif 13 underline link 391
