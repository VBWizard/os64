                    block p 8 8395 784 60
                      line 8 8395 784 20 base 14
                        span b 8 8397 180 16
                        span b 200 8397 36 16
                        span a 348 8397 112 16 link 323
                        span span 460 8399 7 13
                        span span 473 8399 7 13
                        span span 460 8399 20 13
                        span a 460 8399 20 13 link 324
                        span sup 460 8399 20 13
                        text "Hypertext Markup Language" 8 8397 180 16 serif 16 bold
                        text " (" 188 8397 12 16 serif 16
                        text "HTML" 200 8397 36 16 serif 16 bold
                        text ") is the standard " 236 8397 112 16 serif 16
                        text "markup language" 348 8397 112 16 serif 16 underline link 323
                        text "[" 460 8399 7 13 serif 13 underline link 324
                        text "a" 467 8399 6 13 serif 13 underline link 324
                        text "]" 473 8399 7 13 serif 13 underline link 324
                        text " for documents designed to be displayed in a" 480 8397 292 16 serif 16
                      line 8 8415 784 20 base 14
                        span a 8 8417 84 16 link 325
                        span a 348 8417 80 16 link 326
                        text "web browser" 8 8417 84 16 serif 16 underline link 325
                        text ". It defines the content and structure of " 92 8417 256 16 serif 16
                        text "web content" 348 8417 80 16 serif 16 underline link 326
                        text ". It is often assisted by technologies such as" 428 8417 296 16 serif 16
                      line 8 8435 784 20 base 14
                        span a 8 8437 152 16 link 327
                        span a 236 8437 128 16 link 328
                        span a 424 8437 68 16 link 329
                        text "Cascading Style Sheets" 8 8437 152 16 serif 16 underline link 327
                        text " (CSS) and " 160 8437 76 16 serif 16
                        text "scripting languages" 236 8437 128 16 serif 16 underline link 328
                        text " such as " 364 8437 60 16 serif 16
                        text "JavaScript" 424 8437 68 16 serif 16 underline link 329
                        text "." 492 8437 4 16 serif 16
                    block p 8 8471 784 60
                      line 8 8471 784 20 base 14
                        span a 8 8473 92 16 link 330
                        span a 316 8473 72 16 link 331
                        span a 556 8473 40 16 link 332
                        text "Web browsers" 8 8473 92 16 serif 16 underline link 330
                        text " receive HTML documents from a " 100 8473 216 16 serif 16
                        text "web server" 316 8473 72 16 serif 16 underline link 331
                        text " or from local storage and " 388 8473 168 16 serif 16
                        text "render" 556 8473 40 16 serif 16 underline link 332
                        text " the documents into" 596 8473 128 16 serif 16
                      line 8 8491 784 20 base 14
                        span a 8 8493 72 16 link 333
                        span a 384 8493 64 16 link 334
                        span a 452 8493 84 16 link 335
                        text "multimedia" 8 8493 72 16 serif 16 underline link 333
                        text " web pages. HTML describes the structure of a " 80 8493 304 16 serif 16
                        text "web page" 384 8493 64 16 serif 16 underline link 334
                        text " " 448 8493 4 16 serif 16
                        text "semantically" 452 8493 84 16 serif 16 underline link 335
                        text " and originally included cues for its" 536 8493 228 16 serif 16
                      line 8 8511 784 20 base 14
                        text "appearance." 8 8513 80 16 serif 16
                    block p 8 8547 784 140
                      line 8 8547 784 20 base 14
                        span a 8 8549 100 16 link 336
                        span a 516 8549 48 16 link 337
                        text "HTML elements" 8 8549 100 16 serif 16 underline link 336
                        text " are the building blocks of HTML pages. With HTML constructs, " 108 8549 408 16 serif 16
                        text "images" 516 8549 48 16 serif 16 underline link 337
                        text " and other objects such as" 564 8549 172 16 serif 16
                      line 8 8567 784 20 base 14
                        span a 8 8569 108 16 link 338
                        span a 616 8569 140 16 link 339
                        text "interactive forms" 8 8569 108 16 serif 16 underline link 338
                        text " may be embedded into the rendered page. HTML provides a means to create " 116 8569 500 16 serif 16
                        text "structured documents" 616 8569 140 16 serif 16 underline link 339
                        text " by" 756 8569 20 16 serif 16
                      line 8 8587 784 20 base 14
                        span a 132 8589 68 16 link 340
                        span a 492 8589 32 16 link 341
                        text "denoting structural " 8 8589 124 16 serif 16
                        text "semantics" 132 8589 68 16 serif 16 underline link 340
                        text " for text such as headings, paragraphs, lists, " 200 8589 292 16 serif 16
                        text "links" 492 8589 32 16 serif 16 underline link 341
                        text ", quotes, and other items. HTML elements" 524 8589 268 16 serif 16
                      line 8 8607 784 20 base 14
                        span i 124 8609 28 16
                        span a 248 8609 96 16 link 342
                        span span 444 8609 8 16
                        span span 452 8609 24 16
                        span span 476 8609 8 16
                        span code 444 8609 40 16
                        span span 516 8609 8 16
                        span span 524 8609 40 16
                        span span 564 8609 8 16
                        span code 516 8609 56 16
                        text "are delineated by " 8 8609 116 16 serif 16
                        text "tags" 124 8609 28 16 serif 16 italic
                        text ", written using " 152 8609 96 16 serif 16
                        text "angle brackets" 248 8609 96 16 serif 16 underline link 342
                        text ". Tags such as " 344 8609 100 16 serif 16
                        text "<" 444 8609 8 16 mono 16
                        text "img" 452 8609 24 16 mono 16
                        text ">" 476 8609 8 16 mono 16
                        text " and " 484 8609 32 16 serif 16
                        text "<" 516 8609 8 16 mono 16
                        text "input" 524 8609 40 16 mono 16
                        text ">" 564 8609 8 16 mono 16
                        text " directly introduce content into the" 572 8609 220 16 serif 16
                      line 8 8627 784 20 base 14
                        span span 172 8629 8 16
                        span span 180 8629 8 16
                        span span 188 8629 8 16
                        span code 172 8629 24 16
                        span span 420 8629 16 16
                        span span 436 8629 8 16
                        span span 444 8629 8 16
                        span code 420 8629 32 16
                        text "page. Other tags such as " 8 8629 164 16 serif 16
                        text "<" 172 8629 8 16 mono 16
                        text "p" 180 8629 8 16 mono 16
                        text ">" 188 8629 8 16 mono 16
                        text " and its corresponding closing tag " 196 8629 224 16 serif 16
                        text "</" 420 8629 16 16 mono 16
                        text "p" 436 8629 8 16 mono 16
                        text ">" 444 8629 8 16 mono 16
                        text " surround and provide information about document" 452 8629 324 16 serif 16
                      line 8 8647 784 20 base 14
                        span a 272 8649 60 16 link 343
                        text "text and may include sub-element tags. " 8 8649 264 16 serif 16
                        text "Browsers" 272 8649 60 16 serif 16 underline link 343
                        text " do not display the HTML tags, but use them to interpret the content of" 332 8649 448 16 serif 16
                      line 8 8667 784 20 base 14
                        text "the page." 8 8669 60 16 serif 16
                    block p 8 8703 784 80
                      line 8 8703 784 20 base 14
                        span a 264 8705 120 16 link 344
                        span a 444 8705 68 16 link 345
                        text "HTML can embed programs written in a " 8 8705 256 16 serif 16
                        text "scripting language" 264 8705 120 16 serif 16 underline link 344
                        text " such as " 384 8705 60 16 serif 16
                        text "JavaScript" 444 8705 68 16 serif 16 underline link 345
                        text ", which affects the behavior and content of" 512 8705 276 16 serif 16
                      line 8 8723 784 20 base 14
                        span a 504 8725 180 16 link 346
                        text "web pages. The inclusion of CSS defines the look and layout of content. The " 8 8725 496 16 serif 16
                        text "World Wide Web Consortium" 504 8725 180 16 serif 16 underline link 346
                        text " (W3C), former" 684 8725 96 16 serif 16
                      line 8 8743 784 20 base 14
                        span a 624 8745 24 16 link 347
                        text "maintainer of the HTML and current maintainer of the CSS standards, has encouraged the use of " 8 8745 616 16 serif 16
                        text "CSS" 624 8745 24 16 serif 16 underline link 347
                        text " over explicit" 648 8745 84 16 serif 16
                      line 8 8763 784 20 base 14
                        span span 144 8765 68 16
                        span span 212 8765 0 16
                        span span 212 8765 4 16
                        span span 216 8767 7 13
                        span span 258 8767 7 13
                        span a 216 8767 49 13 link 348
                        span sup 216 8767 49 13
                        span span 265 8765 0 16
                        span span 265 8767 6 13
                        span span 278 8767 6 13
                        span span 265 8767 19 13
                        span a 265 8767 19 13 link 349
                        span sup 265 8767 19 13
                        text "presentational HTML " 8 8765 136 16 serif 16
                        text "since 1997" 144 8765 68 16 serif 16
                        text "." 212 8765 4 16 serif 16
                        text "[" 216 8767 7 13 serif 13 underline link 348
                        text "update" 223 8767 35 13 serif 13 underline link 348
                        text "]" 258 8767 7 13 serif 13 underline link 348
                        text "[" 265 8767 6 13 serif 13 underline link 349
                        text "3" 271 8767 7 13 serif 13 underline link 349
                        text "]" 278 8767 6 13 serif 13 underline link 349
                  block section 8 8803 784 4276
