                                span span 763 23514 12 16
                                text "This article " 55 23514 76 16 serif 16
                                text "is missing information" 131 23514 144 16 serif 16 bold
                                text " about contenteditable." 275 23514 148 16 serif 16
                                text " Please expand the article " 423 23514 172 16 serif 16
                                text "by making an edit request" 595 23514 168 16 serif 16 underline link 652
                                text "to" 763 23514 12 16 serif 16
                              line 55 23532 734 20 base 14
