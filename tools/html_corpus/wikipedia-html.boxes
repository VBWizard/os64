                    block section 8 17972 784 102
                      block div 8 17972 784 23
                        block h3 8 17972 784 23
                          line 8 17972 784 23 base 16
                            text "Data types" 8 17974 81 19 serif 19 bold
                      block p 8 18014 784 60
                        line 8 18014 784 20 base 14
                          span a 152 18016 68 16 link 569
                          text "HTML defines several " 8 18016 144 16 serif 16
                          text "data types" 152 18016 68 16 serif 16 underline link 569
                          text " for element content, such as script data and stylesheet data, and a plethora of types for" 220 18016 568 16 serif 16
                        line 8 18034 784 20 base 14
                          span a 264 18036 32 16 link 570
                          text "attribute values, including IDs, names, " 8 18036 256 16 serif 16
                          text "URIs" 264 18036 32 16 serif 16 underline link 570
                          text ", numbers, units of length, languages, media descriptors, colors, character" 296 18036 480 16 serif 16
                        line 8 18054 784 20 base 14
                          text "encodings, dates and times, and so on. All of these data types are specializations of character data." 8 18056 648 16 serif 16
                    block section 8 18093 784 474
                      block div 8 18093 784 24
                        block h3 8 18093 784 24
                          line 8 18093 784 24 base 16
                            text "Document type declaration" 8 18095 204 19 serif 19 bold
                      block p 8 18135 784 40
                        line 8 18135 784 20 base 14
                          span a 296 18137 172 16 link 571
                          text "HTML documents are required to start with a " 8 18137 288 16 serif 16
                          text "document type declaration" 296 18137 172 16 serif 16 underline link 571
                          text " (informally, a \"doctype\"). In browsers, the" 468 18137 288 16 serif 16
                        line 8 18155 784 20 base 14
                          span a 472 18157 80 16 link 572
                          text "doctype helps to define the rendering mode—particularly whether to use " 8 18157 464 16 serif 16
                          text "quirks mode" 472 18157 80 16 serif 16 underline link 572
                          text "." 552 18157 4 16 serif 16
                      block p 8 18191 784 80
                        line 8 18191 784 20 base 14
                          text "The original purpose of the doctype was to enable the parsing and validation of HTML documents by SGML tools based" 8 18193 768 16 serif 16
                        line 8 18211 784 20 base 14
                          span a 52 18213 160 16 link 573
                          text "on the " 8 18213 44 16 serif 16
                          text "document type definition" 52 18213 160 16 serif 16 underline link 573
                          text " (DTD). The DTD to which the DOCTYPE refers contains a machine-readable grammar" 212 18213 544 16 serif 16
                        line 8 18231 784 20 base 14
                          text "specifying the permitted and prohibited content for a document conforming to such a DTD. Browsers, on the other hand, do" 8 18233 784 16 serif 16
                        line 8 18251 784 20 base 14
                          text "not implement HTML as an application of SGML and as consequence do not read the DTD." 8 18253 576 16 serif 16
                      block p 8 18287 784 20
                        line 8 18287 784 20 base 14
                          span a 8 18289 44 16 link 574
                          span span 632 18292 7 13
                          span span 652 18292 6 13
                          span span 632 18292 26 13
                          span a 632 18292 26 13 link 575
                          span sup 632 18292 26 13
                          text "HTML5" 8 18289 44 16 serif 16 underline link 574
                          text " does not define a DTD; therefore, in HTML5 the doctype declaration is simpler and shorter:" 52 18289 580 16 serif 16
                          text "[" 632 18292 7 13 serif 13 underline link 575
                          text "84" 639 18292 13 13 serif 13 underline link 575
                          text "]" 652 18292 6 13 serif 13 underline link 575
                      block div 8 18323 784 20
                        block pre 8 18323 784 20
                          line 8 18323 784 20 base 14
                            span span 8 18325 0 16
                            span span 8 18325 72 16
                            span span 88 18325 32 16
                            span span 120 18325 8 16
                            text "<!DOCTYPE" 8 18325 72 16 mono 16
                            text " " 80 18325 8 16 mono 16
                            text "html" 88 18325 32 16 mono 16
                            text ">" 120 18325 8 16 mono 16
                      block p 8 18359 784 20
                        line 8 18359 784 20 base 14
                          text "An example of an HTML 4 doctype" 8 18361 220 16 serif 16
                      block div 8 18395 784 20
                        block pre 8 18395 784 20
                          line 8 18395 784 20 base 14
                            span span 8 18397 0 16
                            span span 8 18397 72 16
                            span span 88 18397 32 16
                            span span 128 18397 48 16
                            span span 184 18397 216 16
                            span span 408 18397 320 16
                            span span 728 18397 8 16
                            text "<!DOCTYPE" 8 18397 72 16 mono 16
                            text " " 80 18397 8 16 mono 16
                            text "HTML" 88 18397 32 16 mono 16
                            text " " 120 18397 8 16 mono 16
                            text "PUBLIC" 128 18397 48 16 mono 16
                            text " " 176 18397 8 16 mono 16
                            text "\"-//W3C//DTD HTML 4.01//EN\"" 184 18397 216 16 mono 16
                            text " " 400 18397 8 16 mono 16
                            text "\"https://www.w3.org/TR/html4/strict.dtd\"" 408 18397 320 16 mono 16
                            text ">" 728 18397 8 16 mono 16
                      block p 8 18431 784 60
                        line 8 18431 784 20 base 14
                          text "This declaration references the DTD for the \"strict\" version of HTML 4.01. SGML-based validators read the DTD in order to" 8 18433 772 16 serif 16
                        line 8 18451 784 20 base 14
                          text "properly parse the document and to perform validation. In modern browsers, a valid doctype activates standards mode" 8 18453 768 16 serif 16
                        line 8 18471 784 20 base 14
                          span a 104 18473 80 16 link 576
                          text "as opposed to " 8 18473 96 16 serif 16
                          text "quirks mode" 104 18473 80 16 serif 16 underline link 576
                          text "." 184 18473 4 16 serif 16
                      block p 8 18507 784 60
                        line 8 18507 784 20 base 14
                          span a 428 18509 128 16 link 577
                          text "In addition, HTML 4.01 provides Transitional and Frameset DTDs, " 8 18509 420 16 serif 16
                          text "as explained below" 428 18509 128 16 serif 16 underline link 577
                          text ". The transitional type is the most" 556 18509 216 16 serif 16
                        line 8 18527 784 20 base 14
                          text "inclusive, incorporating current tags as well as older or \"deprecated\" tags, with the Strict DTD excluding deprecated tags." 8 18529 784 16 serif 16
                        line 8 18547 784 20 base 14
                          span span 732 18552 7 13
                          span span 752 18552 6 13
                          span span 732 18552 26 13
                          span a 732 18552 26 13 link 578
                          span sup 732 18552 26 13
                          text "The frameset has all tags necessary to make frames on a page along with the tags included in transitional type." 8 18549 724 16 serif 16
                          text "[" 732 18552 7 13 serif 13 underline link 578
                          text "85" 739 18552 13 13 serif 13 underline link 578
                          text "]" 752 18552 6 13 serif 13 underline link 578
                  block section 8 18587 784 706
                    block div 8 18587 784 30
                      block h2 8 18587 784 30
                        line 8 18587 784 30 base 21
                          text "Semantic HTML" 8 18590 150 24 serif 24 bold
                    block div 8 18637 784 20
                      line 8 18637 784 20 base 14
                        span a 92 18639 100 16 link 579
                        text "Main article: " 8 18639 84 16 serif 16
                        text "Semantic HTML" 92 18639 100 16 serif 16 underline link 579
                    block p 8 18673 784 100
                      line 8 18673 784 20 base 14
                        text "Semantic HTML is a way of writing HTML that emphasizes the meaning of the encoded information over its presentation" 8 18675 772 16 serif 16
                      line 8 18693 784 20 base 14
                        span span 420 18697 7 13
                        span span 440 18697 6 13
                        span span 420 18697 26 13
                        span a 420 18697 26 13 link 580
                        span sup 420 18697 26 13
                        text "(look). HTML has included semantic markup from its inception," 8 18695 412 16 serif 16
                        text "[" 420 18697 7 13 serif 13 underline link 580
                        text "86" 427 18697 13 13 serif 13 underline link 580
                        text "]" 440 18697 6 13 serif 13 underline link 580
                        text " but has also included presentational markup, such" 446 18695 332 16 serif 16
                      line 8 18713 784 20 base 14
                        span span 28 18715 8 16
                        span span 68 18715 8 16
                        span code 28 18715 48 16
                        span span 84 18715 8 16
                        span span 100 18715 8 16
                        span code 84 18715 24 16
                        span span 144 18715 8 16
                        span span 200 18715 8 16
                        span code 144 18715 64 16
                        span a 504 18715 84 16 link 581
                        text "as " 8 18715 20 16 serif 16
                        text "<" 28 18715 8 16 mono 16
                        text "font" 36 18715 32 16 mono 16
                        text ">" 68 18715 8 16 mono 16
                        text ", " 76 18715 8 16 serif 16
                        text "<" 84 18715 8 16 mono 16
                        text "i" 92 18715 8 16 mono 16
                        text ">" 100 18715 8 16 mono 16
                        text ", and " 108 18715 36 16 serif 16
                        text "<" 144 18715 8 16 mono 16
                        text "center" 152 18715 48 16 mono 16
                        text ">" 200 18715 8 16 mono 16
                        text " tags. There are also the semantically neutral " 208 18715 296 16 serif 16
                        text "div and span" 504 18715 84 16 serif 16 underline link 581
                        text " tags. Since the late 1990s," 588 18715 172 16 serif 16
                      line 8 18733 784 20 base 14
                        span a 48 18735 152 16 link 582
                        text "when " 8 18735 40 16 serif 16
                        text "Cascading Style Sheets" 48 18735 152 16 serif 16 underline link 582
                        text " were beginning to work in most browsers, web authors have been encouraged to avoid the" 200 18735 592 16 serif 16
                      line 8 18753 784 20 base 14
                        span a 360 18755 248 16 link 583
                        span span 612 18757 7 13
                        span span 632 18757 6 13
                        span span 612 18757 26 13
                        span a 612 18757 26 13 link 584
                        span sup 612 18757 26 13
                        text "use of presentational HTML markup with a view to the " 8 18755 352 16 serif 16
                        text "separation of content and presentation" 360 18755 248 16 serif 16 underline link 583
                        text "." 608 18755 4 16 serif 16
                        text "[" 612 18757 7 13 serif 13 underline link 584
                        text "87" 619 18757 13 13 serif 13 underline link 584
                        text "]" 632 18757 6 13 serif 13 underline link 584
                    block p 8 18789 784 140
                      line 8 18789 784 20 base 14
                        span a 188 18791 92 16 link 585
                        span a 288 18791 108 16 link 586
                        text "In a 2001 discussion of the " 8 18791 180 16 serif 16
                        text "Semantic Web" 188 18791 92 16 serif 16 underline link 585
                        text ", " 280 18791 8 16 serif 16
                        text "Tim Berners-Lee" 288 18791 108 16 serif 16 underline link 586
                        text " and others gave examples of ways in which intelligent" 396 18791 360 16 serif 16
                      line 8 18809 784 20 base 14
                        text "software \"agents\" may one day automatically crawl the web and find, filter, and correlate previously unrelated," 8 18811 720 16 serif 16
                      line 8 18829 784 20 base 14
                        span span 308 18833 7 13
                        span span 328 18833 6 13
                        span span 308 18833 26 13
                        span a 308 18833 26 13 link 587
                        span sup 308 18833 26 13
                        span span 630 18833 7 13
                        span span 637 18833 35 13
                        span a 637 18833 35 13 link 588
                        span i 637 18833 35 13
                        span span 672 18833 7 13
                        span sup 630 18833 49 13
                        text "published facts for the benefit of human users." 8 18831 300 16 serif 16
                        text "[" 308 18833 7 13 serif 13 underline link 587
                        text "88" 315 18833 13 13 serif 13 underline link 587
                        text "]" 328 18833 6 13 serif 13 underline link 587
                        text " Such agents are not commonplace even now" 334 18831 296 16 serif 16
                        text "[" 630 18833 7 13 serif 13
                        text "when?" 637 18833 35 13 serif 13 italic underline link 588
                        text "]" 672 18833 7 13 serif 13
                        text ", but some of the" 679 18831 108 16 serif 16
                      line 8 18849 784 20 base 14
                        span a 64 18851 52 16 link 589
                        span a 124 18851 60 16 link 590
                        span a 216 18851 176 16 link 591
                        span span 536 18853 7 13
                        span span 543 18853 81 13
                        span a 543 18853 81 13 link 592
                        span i 543 18853 81 13
                        span span 624 18853 6 13
                        span sup 536 18853 94 13
                        text "ideas of " 8 18851 56 16 serif 16
                        text "Web 2.0" 64 18851 52 16 serif 16 underline link 589
                        text ", " 116 18851 8 16 serif 16
                        text "mashups" 124 18851 60 16 serif 16 underline link 590
                        text " and " 184 18851 32 16 serif 16
                        text "price comparison websites" 216 18851 176 16 serif 16 underline link 591
                        text " may be coming close" 392 18851 144 16 serif 16
                        text "[" 536 18853 7 13 serif 13
                        text "citation needed" 543 18853 81 13 serif 13 italic underline link 592
                        text "]" 624 18853 6 13 serif 13
                        text ". The main difference" 630 18851 136 16 serif 16
                      line 8 18869 784 20 base 14
                        span a 700 18871 76 16 link 593
                        text "between these web application hybrids and Berners-Lee's semantic agents lies in the fact that the current " 8 18871 692 16 serif 16
                        text "aggregation" 700 18871 76 16 serif 16 underline link 593
                      line 8 18889 784 20 base 14
                        span a 368 18891 104 16 link 594
                        text "and hybridization of information is usually designed by " 8 18891 360 16 serif 16
                        text "web developers" 368 18891 104 16 serif 16 underline link 594
                        text ", who already know the web locations and the" 472 18891 300 16 serif 16
                      line 8 18909 784 20 base 14
                        span a 8 18911 96 16 link 595
                        text "API semantics" 8 18911 96 16 serif 16 underline link 595
                        text " of the specific data they wish to mash, compare and combine." 104 18911 408 16 serif 16
                    block p 8 18945 784 80
                      line 8 18945 784 20 base 14
                        text "An important type of web agent that does crawl and read web pages automatically, without prior knowledge of what it" 8 18947 760 16 serif 16
                      line 8 18965 784 20 base 14
                        span a 120 18967 80 16 link 596
                        text "might find, is the " 8 18967 112 16 serif 16
                        text "web crawler" 120 18967 80 16 serif 16 underline link 596
                        text " or search-engine spider. These software agents are dependent on the semantic clarity of" 200 18967 580 16 serif 16
                      line 8 18985 784 20 base 14
                        span a 380 18987 68 16 link 597
                        text "web pages they find as they use various techniques and " 8 18987 372 16 serif 16
                        text "algorithms" 380 18987 68 16 serif 16 underline link 597
                        text " to read and index millions of web pages a day and" 448 18987 332 16 serif 16
                      line 8 19005 784 20 base 14
                        span a 164 19007 104 16 link 598
                        text "provide web users with " 8 19007 156 16 serif 16
                        text "search facilities" 164 19007 104 16 serif 16 underline link 598
                        text " without which the World Wide Web's usefulness would be greatly reduced." 268 19007 488 16 serif 16
                    block p 8 19041 784 80
                      line 8 19041 784 20 base 14
                        text "In order for search engine spiders to be able to rate the significance of pieces of text they find in HTML documents, and" 8 19043 772 16 serif 16
                      line 8 19061 784 20 base 14
                        text "also for those creating mashups and other hybrids as well as for more automated agents as they are developed, the" 8 19063 748 16 serif 16
                      line 8 19081 784 20 base 14
                        text "semantic structures that exist in HTML need to be widely and uniformly applied to bring out the meaning of the published" 8 19083 780 16 serif 16
                      line 8 19101 784 20 base 14
                        span span 36 19105 7 13
                        span span 56 19105 6 13
                        span span 36 19105 26 13
                        span a 36 19105 26 13 link 599
                        span sup 36 19105 26 13
                        text "text." 8 19103 28 16 serif 16
                        text "[" 36 19105 7 13 serif 13 underline link 599
                        text "89" 43 19105 13 13 serif 13 underline link 599
                        text "]" 56 19105 6 13 serif 13 underline link 599
                    block p 8 19137 784 60
                      line 8 19137 784 20 base 14
                        span a 212 19139 72 16 link 600
                        span a 420 19139 44 16 link 601
                        text "Presentational markup tags are " 8 19139 204 16 serif 16
                        text "deprecated" 212 19139 72 16 serif 16 underline link 600
                        text " in current HTML and " 284 19139 136 16 serif 16
                        text "XHTML" 420 19139 44 16 serif 16 underline link 601
                        text " recommendations. The majority of presentational" 464 19139 320 16 serif 16
                      line 8 19157 784 20 base 14
                        text "features from previous versions of HTML are no longer allowed as they lead to poorer accessibility, higher cost of site" 8 19159 760 16 serif 16
                      line 8 19177 784 20 base 14
                        span span 276 19181 7 13
                        span span 296 19181 6 13
                        span span 276 19181 26 13
                        span a 276 19181 26 13 link 602
                        span sup 276 19181 26 13
                        text "maintenance, and larger document sizes." 8 19179 268 16 serif 16
                        text "[" 276 19181 7 13 serif 13 underline link 602
                        text "90" 283 19181 13 13 serif 13 underline link 602
                        text "]" 296 19181 6 13 serif 13 underline link 602
                    block p 8 19213 784 80
                      line 8 19213 784 20 base 14
                        span a 268 19215 84 16 link 603
                        span a 548 19215 168 16 link 604
                        text "Good semantic HTML also improves the " 8 19215 260 16 serif 16
                        text "accessibility" 268 19215 84 16 serif 16 underline link 603
                        text " of web documents (see also " 352 19215 196 16 serif 16
                        text "Web Content Accessibility" 548 19215 168 16 serif 16 underline link 604
                      line 8 19233 784 20 base 14
                        span a 8 19235 68 16 link 604
                        text "Guidelines" 8 19235 68 16 serif 16 underline link 604
                        text "). For example, when a screen reader or audio browser can correctly ascertain the structure of a document, it" 76 19235 704 16 serif 16
                      line 8 19253 784 20 base 14
                        text "will not waste the visually impaired user's time by reading out repeated or irrelevant information when it has been" 8 19255 736 16 serif 16
                      line 8 19273 784 20 base 14
                        text "marked up correctly." 8 19275 132 16 serif 16
                  block section 8 19313 784 995
                    block div 8 19313 784 30
                      block h2 8 19313 784 30
                        line 8 19313 784 30 base 21
                          text "Delivery" 8 19316 78 24 serif 24 bold
                    block p 8 19363 784 40
                      line 8 19363 784 20 base 14
                        text "HTML documents can be delivered by the same means as any other computer file. However, they are most often" 8 19365 724 16 serif 16
                      line 8 19383 784 20 base 14
                        span a 132 19385 32 16 link 605
                        span a 212 19385 72 16 link 606
                        span a 324 19385 36 16 link 607
                        text "delivered either by " 8 19385 124 16 serif 16
                        text "HTTP" 132 19385 32 16 serif 16 underline link 605
                        text " from a " 164 19385 48 16 serif 16
                        text "web server" 212 19385 72 16 serif 16 underline link 606
                        text " or by " 284 19385 40 16 serif 16
                        text "email" 324 19385 36 16 serif 16 underline link 607
                        text "." 360 19385 4 16 serif 16
                    block section 8 19422 784 350
                      block div 8 19422 784 23
                        block h3 8 19422 784 23
                          line 8 19422 784 23 base 16
                            text "HTTP" 8 19424 38 19 serif 19 bold
                      block div 8 19464 784 20
                        line 8 19464 784 20 base 14
                          span a 92 19466 32 16 link 608
                          text "Main article: " 8 19466 84 16 serif 16
                          text "HTTP" 92 19466 32 16 serif 16 underline link 608
                      block p 8 19500 784 100
                        line 8 19500 784 20 base 14
                          span a 36 19502 104 16 link 609
                          text "The " 8 19502 28 16 serif 16
                          text "World Wide Web" 36 19502 104 16 serif 16 underline link 609
                          text " is composed primarily of HTML documents transmitted from web servers to web browsers using the" 140 19502 648 16 serif 16
                        line 8 19520 784 20 base 14
                          span a 8 19522 172 16 link 610
                          text "Hypertext Transfer Protocol" 8 19522 172 16 serif 16 underline link 610
                          text " (HTTP). However, HTTP is used to serve images, sound, and other content, in addition to" 180 19522 576 16 serif 16
                        line 8 19540 784 20 base 14
                          text "HTML. To allow the web browser to know how to handle each document it receives, other information is transmitted" 8 19542 748 16 serif 16
                        line 8 19560 784 20 base 14
                          span a 208 19562 64 16 link 611
                          span a 412 19562 72 16 link 612
                          span kbd 528 19562 72 16
                          text "along with the document. This " 8 19562 200 16 serif 16
                          text "meta data" 208 19562 64 16 serif 16 underline link 611
                          text " usually includes the " 272 19562 140 16 serif 16
                          text "MIME type" 412 19562 72 16 serif 16 underline link 612
                          text " (e.g., " 484 19562 44 16 serif 16
                          text "text/html" 528 19562 72 16 mono 16
                          text " or" 600 19562 16 16 serif 16
                        line 8 19580 784 20 base 14
                          span kbd 8 19582 168 16
                          span a 404 19582 188 16 link 613
                          text "application/xhtml+xml" 8 19582 168 16 mono 16
                          text ") and the character encoding (see " 176 19582 228 16 serif 16
                          text "Character encodings in HTML" 404 19582 188 16 serif 16 underline link 613
                          text ")." 592 19582 12 16 serif 16
                      block p 8 19616 784 80
                        line 8 19616 784 20 base 14
                          text "In modern browsers, the MIME type that is sent with the HTML document may affect how the document is initially" 8 19618 740 16 serif 16
                        line 8 19636 784 20 base 14
                          span a 492 19638 80 16 link 614
                          text "interpreted. A document sent with the XHTML MIME type is expected to be " 8 19638 484 16 serif 16
                          text "well-formed" 492 19638 80 16 serif 16 underline link 614
                          text " XML; syntax errors may cause" 572 19638 200 16 serif 16
                        line 8 19656 784 20 base 14
                          text "the browser to fail to render it. The same document sent with the HTML MIME type might be displayed successfully" 8 19658 748 16 serif 16
                        line 8 19676 784 20 base 14
                          text "since some browsers are more lenient with HTML." 8 19678 324 16 serif 16
                      block p 8 19712 784 60
                        line 8 19712 784 20 base 14
                          text "The W3C recommendations state that XHTML 1.0 documents that follow guidelines set forth in the recommendation's" 8 19714 748 16 serif 16
                        line 8 19732 784 20 base 14
                          span span 340 19736 7 13
                          span span 356 19736 7 13
                          span span 340 19736 23 13
                          span a 340 19736 23 13 link 615
                          span sup 340 19736 23 13
                          span span 719 19736 6 13
                          span span 738 19736 7 13
                          span span 719 19736 26 13
                          span a 719 19736 26 13 link 616
                          span sup 719 19736 26 13
                          text "Appendix C may be labeled with either MIME Type." 8 19734 332 16 serif 16
                          text "[" 340 19736 7 13 serif 13 underline link 615
                          text "91" 347 19736 9 13 serif 13 underline link 615
                          text "]" 356 19736 7 13 serif 13 underline link 615
                          text " XHTML 1.1 also states that XHTML 1.1 documents should" 363 19734 356 16 serif 16
                          text "[" 719 19736 6 13 serif 13 underline link 616
                          text "92" 725 19736 13 13 serif 13 underline link 616
                          text "]" 738 19736 7 13 serif 13 underline link 616
                          text " be" 745 19734 20 16 serif 16
                        line 8 19752 784 20 base 14
                          span span 208 19756 7 13
                          span span 228 19756 6 13
                          span span 208 19756 26 13
                          span a 208 19756 26 13 link 617
                          span sup 208 19756 26 13
                          text "labeled with either MIME type." 8 19754 200 16 serif 16
                          text "[" 208 19756 7 13 serif 13 underline link 617
                          text "93" 215 19756 13 13 serif 13 underline link 617
                          text "]" 228 19756 6 13 serif 13 underline link 617
                    block section 8 19791 784 198
                      block div 8 19791 784 24
                        block h3 8 19791 784 24
                          line 8 19791 784 24 base 16
                            text "HTML e-mail" 8 19793 100 19 serif 19 bold
                      block div 8 19833 784 20
                        line 8 19833 784 20 base 14
                          span a 92 19835 76 16 link 618
                          text "Main article: " 8 19835 84 16 serif 16
                          text "HTML email" 92 19835 76 16 serif 16 underline link 618
                      block p 8 19869 784 120
                        line 8 19869 784 20 base 14
                          span a 708 19871 60 16 link 619
                          text "Most graphical email clients allow the use of a subset of HTML (often ill-defined) to provide formatting and " 8 19871 700 16 serif 16
                          text "semantic" 708 19871 60 16 serif 16 underline link 619
                        line 8 19889 784 20 base 14
                          span a 180 19891 60 16 link 620
                          text "markup not available with " 8 19891 172 16 serif 16
                          text "plain text" 180 19891 60 16 serif 16 underline link 620
                          text ". This may include typographic information like colored headings, emphasized and" 240 19891 536 16 serif 16
                        line 8 19909 784 20 base 14
                          span a 496 19911 24 16 link 621
                          text "quoted text, inline images and diagrams. Many such clients include both a " 8 19911 488 16 serif 16
                          text "GUI" 496 19911 24 16 serif 16 underline link 621
                          text " editor for composing HTML e-mail" 520 19911 224 16 serif 16
                        line 8 19929 784 20 base 14
                          text "messages and a rendering engine for displaying them. Use of HTML in e-mail is criticized by some because of" 8 19931 716 16 serif 16
                        line 8 19949 784 20 base 14
                          span a 340 19951 56 16 link 622
                          text "compatibility issues, because it can help disguise " 8 19951 332 16 serif 16
                          text "phishing" 340 19951 56 16 serif 16 underline link 622
                          text " attacks, because of accessibility issues for blind or visually" 396 19951 396 16 serif 16
                        line 8 19969 784 20 base 14
                          span a 276 19971 36 16 link 623
                          text "impaired people, because it can confuse " 8 19971 268 16 serif 16
                          text "spam" 276 19971 36 16 serif 16 underline link 623
                          text " filters and because the message size is larger than plain text." 312 19971 404 16 serif 16
                    block section 8 20008 784 83
                      block div 8 20008 784 24
                        block h3 8 20008 784 24
                          line 8 20008 784 24 base 17
                            text "Naming conventions" 8 20010 157 19 serif 19 bold
                      block p 8 20051 784 40
                        line 8 20051 784 20 base 14
                          span a 132 20053 124 16 link 624
                          span a 280 20053 28 16 link 625
                          span kbd 440 20053 40 16
                          span kbd 704 20053 32 16
                          text "The most common " 8 20053 124 16 serif 16
                          text "filename extension" 132 20053 124 16 serif 16 underline link 624
                          text " for " 256 20053 24 16 serif 16
                          text "files" 280 20053 28 16 serif 16 underline link 625
                          text " containing HTML is " 308 20053 132 16 serif 16
                          text ".html" 440 20053 40 16 mono 16
                          text ". A common abbreviation of this is " 480 20053 224 16 serif 16
                          text ".htm" 704 20053 32 16 mono 16
                          text ", which" 736 20053 48 16 serif 16
                        line 8 20071 784 20 base 14
                          span a 448 20073 76 16 link 626
                          span span 528 20075 7 13
                          span span 548 20075 6 13
                          span span 528 20075 26 13
                          span a 528 20075 26 13 link 627
                          span sup 528 20075 26 13
                          text "originated because some operating systems limit file extensions to " 8 20073 440 16 serif 16
                          text "three letters" 448 20073 76 16 serif 16 underline link 626
                          text "." 524 20073 4 16 serif 16
                          text "[" 528 20075 7 13 serif 13 underline link 627
                          text "94" 535 20075 13 13 serif 13 underline link 627
                          text "]" 548 20075 6 13 serif 13 underline link 627
                    block section 8 20109 784 199
                      block div 8 20109 784 24
                        block h3 8 20109 784 24
                          line 8 20109 784 24 base 17
                            text "HTML Application" 8 20112 133 19 serif 19 bold
                      block div 8 20152 784 20
                        line 8 20152 784 20 base 14
                          span a 92 20154 112 16 link 628
                          text "Main article: " 8 20154 84 16 serif 16
                          text "HTML Application" 92 20154 112 16 serif 16 underline link 628
                      block p 8 20188 784 120
                        line 8 20188 784 20 base 14
                          span kbd 276 20190 32 16
                          span a 348 20190 124 16 link 629
                          text "An HTML Application (HTA; file extension " 8 20190 268 16 serif 16
                          text ".hta" 276 20190 32 16 mono 16
                          text ") is a " 308 20190 40 16 serif 16
                          text "Microsoft Windows" 348 20190 124 16 serif 16 underline link 629
                          text " application that uses HTML and Dynamic HTML" 472 20190 308 16 serif 16
                        line 8 20208 784 20 base 14
                          span a 36 20210 52 16 link 630
                          text "in a " 8 20210 28 16 serif 16
                          text "browser" 36 20210 52 16 serif 16 underline link 630
                          text " to provide the application's graphical interface. A regular HTML file is confined to the security model of the" 88 20210 688 16 serif 16
                        line 8 20228 784 20 base 14
                          span a 8 20230 152 16 link 631
                          span a 700 20230 80 16 link 632
                          text "web browser's security" 8 20230 152 16 serif 16 underline link 631
                          text ", communicating only to web servers and manipulating only web page objects and " 160 20230 540 16 serif 16
                          text "site cookies" 700 20230 80 16 serif 16 underline link 632
                          text "." 780 20230 4 16 serif 16
                        line 8 20248 784 20 base 14
                          text "An HTA runs as a fully trusted application and therefore has more privileges, like creation/editing/removal of files and" 8 20250 760 16 serif 16
                        line 8 20268 784 20 base 14
                          span a 8 20270 116 16 link 633
                          text "Windows Registry" 8 20270 116 16 serif 16 underline link 633
                          text " entries. Because they operate outside the browser's security model, HTAs cannot be executed via" 124 20270 636 16 serif 16
                        line 8 20288 784 20 base 14
                          span a 296 20290 24 16 link 634
                          text "HTTP, but must be downloaded (just like an " 8 20290 288 16 serif 16
                          text "EXE" 296 20290 24 16 serif 16 underline link 634
                          text " file) and executed from local file system." 320 20290 272 16 serif 16
                  block section 8 20328 784 2938
                    block div 8 20328 784 30
                      block h2 8 20328 784 30
                        line 8 20328 784 30 base 21
                          text "HTML4 variations" 8 20331 168 24 serif 24 bold
                    block p 8 20378 784 160
                      line 8 20378 784 20 base 14
                        text "Since its inception, HTML and its associated protocols gained acceptance relatively quickly. However, no clear" 8 20380 720 16 serif 16
                      line 8 20398 784 20 base 14
                        text "standards existed in the early years of the language. Though its creators originally conceived of HTML as a semantic" 8 20400 756 16 serif 16
                      line 8 20418 784 20 base 14
                        span span 268 20422 7 13
                        span span 288 20422 6 13
                        span span 268 20422 26 13
                        span a 268 20422 26 13 link 635
                        span sup 268 20422 26 13
                        text "language devoid of presentation details," 8 20420 260 16 serif 16
                        text "[" 268 20422 7 13 serif 13 underline link 635
                        text "95" 275 20422 13 13 serif 13 underline link 635
                        text "]" 288 20422 6 13 serif 13 underline link 635
                        text " practical uses pushed many presentational elements and attributes into the" 294 20420 492 16 serif 16
                      line 8 20438 784 20 base 14
                        text "language, driven largely by the various browser vendors. The latest standards surrounding HTML reflect efforts to" 8 20440 728 16 serif 16
                      line 8 20458 784 20 base 14
                        span span 416 20462 7 13
                        span span 436 20462 6 13
                        span span 416 20462 26 13
                        span a 416 20462 26 13 link 636
                        span sup 416 20462 26 13
                        text "overcome the sometimes chaotic development of the language" 8 20460 408 16 serif 16
                        text "[" 416 20462 7 13 serif 13 underline link 636
                        text "96" 423 20462 13 13 serif 13 underline link 636
                        text "]" 436 20462 6 13 serif 13 underline link 636
                        text " and to create a rational foundation for building both" 442 20460 332 16 serif 16
                      line 8 20478 784 20 base 14
                        span a 648 20480 28 16 link 637
                        text "meaningful and well-presented documents. To return HTML to its role as a semantic language, the " 8 20480 640 16 serif 16
                        text "W3C" 648 20480 28 16 serif 16 underline link 637
                        text " has developed" 676 20480 100 16 serif 16
                      line 8 20498 784 20 base 14
                        span a 172 20500 24 16 link 638
                        span a 228 20500 24 16 link 639
                        text "style languages such as " 8 20500 164 16 serif 16
                        text "CSS" 172 20500 24 16 serif 16 underline link 638
                        text " and " 196 20500 32 16 serif 16
                        text "XSL" 228 20500 24 16 serif 16 underline link 639
                        text " to shoulder the burden of presentation. In conjunction, the HTML specification has" 252 20500 536 16 serif 16
                      line 8 20518 784 20 base 14
                        text "slowly reined in the presentational elements." 8 20520 292 16 serif 16
                    block p 8 20554 784 60
                      line 8 20554 784 20 base 14
                        text "There are two axes differentiating various variations of HTML as currently specified: SGML-based HTML versus" 8 20556 716 16 serif 16
                      line 8 20574 784 20 base 14
                        text "XML-based HTML (referred to as XHTML) on one axis, and strict versus transitional (loose) versus frameset on the other" 8 20576 784 16 serif 16
                      line 8 20594 784 20 base 14
                        text "axis." 8 20596 32 16 serif 16
                    block section 8 20632 784 1067
                      block div 8 20632 784 24
                        block h3 8 20632 784 24
                          line 8 20632 784 24 base 17
                            text "SGML-based versus XML-based HTML" 8 20635 299 19 serif 19 bold
                      block p 8 20675 784 120
                        line 8 20675 784 20 base 14
                          span span 180 20679 7 13
                          span span 187 20679 35 13
                          span a 187 20679 35 13 link 640
                          span i 187 20679 35 13
                          span span 222 20679 7 13
                          span sup 180 20679 49 13
                          text "One difference in the latest" 8 20677 172 16 serif 16
                          text "[" 180 20679 7 13 serif 13
                          text "when?" 187 20679 35 13 serif 13 italic underline link 640
                          text "]" 222 20679 7 13 serif 13
                          text " HTML specifications lies in the distinction between the SGML-based specification" 229 20677 536 16 serif 16
                        line 8 20695 784 20 base 14
                          span a 540 20697 44 16 link 641
                          text "and the XML-based specification. The XML-based specification is usually called " 8 20697 532 16 serif 16
                          text "XHTML" 540 20697 44 16 serif 16 underline link 641
                          text " to distinguish it clearly from the" 584 20697 208 16 serif 16
                        line 8 20715 784 20 base 14
                          text "more traditional definition. However, the root element name continues to be \"html\" even in the XHTML-specified HTML." 8 20717 768 16 serif 16
                        line 8 20735 784 20 base 14
                          text "The W3C intended XHTML 1.0 to be identical to HTML 4.01 except where limitations of XML over the more complex SGML" 8 20737 768 16 serif 16
                        line 8 20755 784 20 base 14
                          text "require workarounds. Because XHTML and HTML are closely related, they are sometimes documented in parallel. In such" 8 20757 784 16 serif 16
                        line 8 20775 784 20 base 14
                          span a 204 20777 152 16 link 642
                          text "circumstances, some authors " 8 20777 196 16 serif 16
                          text "conflate the two names" 204 20777 152 16 serif 16 underline link 642
                          text " as (X)HTML or X(HTML)." 356 20777 168 16 serif 16
                      block p 8 20811 784 20
                        line 8 20811 784 20 base 14
                          text "Like HTML 4.01, XHTML 1.0 has three sub-specifications: strict, transitional, and frameset." 8 20813 576 16 serif 16
                      block p 8 20847 784 160
                        line 8 20847 784 20 base 14
                          text "Aside from the different opening declarations for a document, the differences between an HTML 4.01 and XHTML 1.0" 8 20849 736 16 serif 16
                        line 8 20867 784 20 base 14
                          text "document—in each of the corresponding DTDs—are largely syntactic. The underlying syntax of HTML allows many" 8 20869 728 16 serif 16
                        line 8 20887 784 20 base 14
                          text "shortcuts that XHTML does not, such as elements with optional opening or closing tags, and even empty elements which" 8 20889 784 16 serif 16
                        line 8 20907 784 20 base 14
                          text "must not have an end tag. By contrast, XHTML requires all elements to have an opening tag and a closing tag. XHTML," 8 20909 760 16 serif 16
                        line 8 20927 784 20 base 14
                          text "however, also introduces a new shortcut: an XHTML tag may be opened and closed within the same tag, by including a" 8 20929 772 16 serif 16
                        line 8 20947 784 20 base 14
                          span span 268 20949 8 16
                          span span 276 20949 16 16
                          span span 292 20949 16 16
                          span code 268 20949 40 16
                          text "slash before the end of the tag like this: " 8 20949 260 16 serif 16
                          text "<" 268 20949 8 16 mono 16
                          text "br" 276 20949 16 16 mono 16
                          text "/>" 292 20949 16 16 mono 16
                          text ". The introduction of this shorthand, which is not used in the SGML" 308 20949 428 16 serif 16
                        line 8 20967 784 20 base 14
                          text "declaration for HTML 4.01, may confuse earlier software unfamiliar with this new convention. A fix for this is remove the" 8 20969 768 16 serif 16
                        line 8 20987 784 20 base 14
                          span span 348 20989 8 16
                          span span 356 20989 16 16
                          span span 372 20989 8 16
                          span code 348 20989 32 16
                          span span 384 20991 7 13
                          span span 404 20991 6 13
                          span span 384 20991 26 13
                          span a 384 20991 26 13 link 643
                          span sup 384 20991 26 13
                          text "slash preceding the closing angle bracket, as such: " 8 20989 340 16 serif 16
                          text "<" 348 20989 8 16 mono 16
                          text "br" 356 20989 16 16 mono 16
                          text ">" 372 20989 8 16 mono 16
                          text "." 380 20989 4 16 serif 16
                          text "[" 384 20991 7 13 serif 13 underline link 643
                          text "97" 391 20991 13 13 serif 13 underline link 643
                          text "]" 404 20991 6 13 serif 13 underline link 643
                      block p 8 21023 784 60
                        line 8 21023 784 20 base 14
                          text "To understand the subtle differences between HTML and XHTML, consider the transformation of a valid and well-formed" 8 21025 772 16 serif 16
                        line 8 21043 784 20 base 14
                          text "XHTML 1.0 document that adheres to Appendix C (see below) into a valid HTML 4.01 document. Making this translation" 8 21045 764 16 serif 16
                        line 8 21063 784 20 base 14
                          text "requires the following steps:" 8 21065 184 16 serif 16
                      block ol 8 21099 784 160
                        block li 48 21099 744 40
                          line 48 21099 744 20 base 14
                            span code 360 21101 32 16
                            span code 596 21101 64 16
                            text "The language for an element is specified with a " 48 21101 312 16 serif 16
                            text "lang" 360 21101 32 16 mono 16
                            text " attribute rather than the XHTML " 392 21101 204 16 serif 16
                            text "xml:lang" 596 21101 64 16 mono 16
                            text " attribute. XHTML" 660 21101 108 16 serif 16
                          line 48 21119 744 20 base 14
                            text "uses XML's built-in language-defining functionality attribute." 48 21121 396 16 serif 16
                          marker "1. " 36 21101 12 16
                        block li 48 21139 744 20
                          line 48 21139 744 20 base 14
                            span code 248 21141 72 16
                            text "Remove the XML namespace (" 48 21141 200 16 serif 16
                            text "xmlns=URI" 248 21141 72 16 mono 16
                            text "). HTML has no facilities for namespaces." 320 21141 272 16 serif 16
                          marker "2. " 32 21141 16 16
                        block li 48 21159 744 20
                          line 48 21159 744 20 base 14
                            text "Change the document type declaration from XHTML 1.0 to HTML 4.01." 48 21161 436 16 serif 16
                          marker "3. " 32 21161 16 16
                        block li 48 21179 744 20
                          line 48 21179 744 20 base 14
                            span span 420 21181 304 16
                            span code 420 21181 304 16
                            text "If present, remove the XML declaration. Typically this is: " 48 21181 372 16 serif 16
                            text "<?xml version=\"1.0\" encoding=\"utf-8\"?>" 420 21181 304 16 mono 16
                            text "." 724 21181 4 16 serif 16
                          marker "4. " 32 21181 16 16
                        block li 48 21199 744 40
                          line 48 21199 744 20 base 14
                            span code 360 21201 72 16
                            text "Ensure that the document's MIME type is set to " 48 21201 312 16 serif 16
                            text "text/html" 360 21201 72 16 mono 16
                            text ". For both HTML and XHTML, this comes from the HTTP" 432 21201 348 16 serif 16
                          line 48 21219 744 20 base 14
                            span code 48 21221 96 16
                            text "Content-Type" 48 21221 96 16 mono 16
                            text " header sent by the server." 144 21221 172 16 serif 16
                          marker "5. " 32 21201 16 16
                        block li 48 21239 744 20
                          line 48 21239 744 20 base 14
                            span span 528 21241 8 16
                            span span 536 21241 16 16
                            span span 552 21241 16 16
                            span code 528 21241 40 16
                            span span 588 21241 8 16
                            span span 596 21241 16 16
                            span span 612 21241 8 16
                            span code 588 21241 32 16
                            text "Change the XML empty-element syntax to an HTML style empty element (" 48 21241 480 16 serif 16
                            text "<" 528 21241 8 16 mono 16
                            text "br" 536 21241 16 16 mono 16
                            text "/>" 552 21241 16 16 mono 16
                            text " to " 568 21241 20 16 serif 16
                            text "<" 588 21241 8 16 mono 16
                            text "br" 596 21241 16 16 mono 16
                            text ">" 612 21241 8 16 mono 16
                            text ")." 620 21241 12 16 serif 16
                          marker "6. " 32 21241 16 16
                      block p 8 21275 784 80
                        line 8 21275 784 20 base 14
                          text "Those are the main changes necessary to translate a document from XHTML 1.0 to HTML 4.01. To translate from HTML to" 8 21277 768 16 serif 16
                        line 8 21295 784 20 base 14
                          text "XHTML would also require the addition of any omitted opening or closing tags. Whether coding in HTML or XHTML it may" 8 21297 772 16 serif 16
                        line 8 21315 784 20 base 14
                          text "just be best to always include the optional tags within an HTML document rather than remembering which tags can be" 8 21317 764 16 serif 16
                        line 8 21335 784 20 base 14
                          text "omitted." 8 21337 52 16 serif 16
                      block p 8 21371 784 40
                        line 8 21371 784 20 base 14
                          text "A well-formed XHTML document adheres to all the syntax requirements of XML. A valid document adheres to the content" 8 21373 776 16 serif 16
                        line 8 21391 784 20 base 14
                          text "specification for XHTML, which describes the document structure." 8 21393 424 16 serif 16
                      block p 8 21427 784 40
                        line 8 21427 784 20 base 14
                          span span 652 21431 7 13
                          span span 672 21431 6 13
                          span span 652 21431 26 13
                          span a 652 21431 26 13 link 644
                          span sup 652 21431 26 13
                          text "The W3C recommends several conventions to ensure an easy migration between HTML and XHTML." 8 21429 644 16 serif 16
                          text "[" 652 21431 7 13 serif 13 underline link 644
                          text "98" 659 21431 13 13 serif 13 underline link 644
                          text "]" 672 21431 6 13 serif 13 underline link 644
                          text " The following" 678 21429 92 16 serif 16
                        line 8 21447 784 20 base 14
                          text "steps can be applied to XHTML 1.0 documents only:" 8 21449 332 16 serif 16
                      block ul 8 21483 784 100
                        block li 48 21483 744 20
                          line 48 21483 744 20 base 14
                            span code 136 21485 64 16
                            span code 232 21485 32 16
                            text "Include both " 48 21485 88 16 serif 16
                            text "xml:lang" 136 21485 64 16 mono 16
                            text " and " 200 21485 32 16 serif 16
                            text "lang" 232 21485 32 16 mono 16
                            text " attributes on any elements assigning language." 264 21485 312 16 serif 16
                          marker "• " 36 21485 12 16
                        block li 48 21503 744 20
                          line 48 21503 744 20 base 14
                            text "Use the empty-element syntax only for elements specified as empty in HTML." 48 21505 504 16 serif 16
                          marker "• " 36 21505 12 16
                        block li 48 21523 744 20
                          line 48 21523 744 20 base 14
                            span span 456 21525 8 16
                            span span 464 21525 16 16
                            span span 480 21525 8 16
                            span code 456 21525 32 16
                            span span 560 21525 8 16
                            span span 568 21525 16 16
                            span span 584 21525 16 16
                            span code 560 21525 40 16
                            text "Remove the closing slash in empty-element tags: for example " 48 21525 408 16 serif 16
                            text "<" 456 21525 8 16 mono 16
                            text "br" 464 21525 16 16 mono 16
                            text ">" 480 21525 8 16 mono 16
                            text " instead of " 488 21525 72 16 serif 16
                            text "<" 560 21525 8 16 mono 16
                            text "br" 568 21525 16 16 mono 16
                            text "/>" 584 21525 16 16 mono 16
                            text "." 600 21525 4 16 serif 16
                          marker "• " 36 21525 12 16
                        block li 48 21543 744 20
                          line 48 21543 744 20 base 14
                            span code 644 21545 0 16
                            span span 676 21545 8 16
                            span span 684 21545 24 16
                            span span 716 21545 16 16
                            span code 676 21545 56 16
                            text "Include explicit close tags for elements that permit content but are left empty (for example, " 48 21545 596 16 serif 16
                            text ", not " 644 21545 32 16 serif 16
                            text "<" 676 21545 8 16 mono 16
                            text "div" 684 21545 24 16 mono 16
                            text " " 708 21545 8 16 mono 16
                            text "/>" 716 21545 16 16 mono 16
                            text ")." 732 21545 12 16 serif 16
                          marker "• " 36 21545 12 16
                        block li 48 21563 744 20
                          line 48 21563 744 20 base 14
                            text "Omit the XML declaration." 48 21565 164 16 serif 16
                          marker "• " 36 21565 12 16
                      block p 8 21599 784 100
                        line 8 21599 784 20 base 14
                          text "By carefully following the W3C's compatibility guidelines, a user agent should be able to interpret the document equally" 8 21601 772 16 serif 16
                        line 8 21619 784 20 base 14
                          text "as HTML or XHTML. For documents that are XHTML 1.0 and have been made compatible in this way, the W3C permits them" 8 21621 784 16 serif 16
                        line 8 21639 784 20 base 14
                          span code 244 21641 72 16
                          span a 320 21641 72 16 link 645
                          span code 552 21641 168 16
                          text "to be served either as HTML (with a " 8 21641 236 16 serif 16
                          text "text/html" 244 21641 72 16 mono 16
                          text " " 316 21641 4 16 serif 16
                          text "MIME type" 320 21641 72 16 serif 16 underline link 645
                          text "), or as XHTML (with an " 392 21641 160 16 serif 16
                          text "application/xhtml+xml" 552 21641 168 16 mono 16
                          text " or" 720 21641 16 16 serif 16
                        line 8 21659 784 20 base 14
                          span code 8 21661 120 16
                          text "application/xml" 8 21661 120 16 mono 16
                          text " MIME type). When delivered as XHTML, browsers should use an XML parser, which adheres strictly" 128 21661 652 16 serif 16
                        line 8 21679 784 20 base 14
                          text "to the XML specifications for parsing the document's contents." 8 21681 404 16 serif 16
                    block section 8 21717 784 1051
                      block div 8 21717 784 24
                        block h3 8 21717 784 24
                          line 8 21717 784 24 base 17
                            text "Transitional versus strict" 8 21720 190 19 serif 19 bold
                      block p 8 21760 784 140
                        line 8 21760 784 20 base 14
                          text "HTML 4 defined three different versions of the language: Strict, Transitional (once called Loose), and Frameset. The Strict" 8 21762 784 16 serif 16
                        line 8 21780 784 20 base 14
                          text "version is intended for new documents and is considered best practice, while the Transitional and Frameset versions" 8 21782 760 16 serif 16
                        line 8 21800 784 20 base 14
                          text "were developed to make it easier to transition documents that conformed to older HTML specifications or did not conform" 8 21802 780 16 serif 16
                        line 8 21820 784 20 base 14
                          text "to any specification to a version of HTML 4. The Transitional and Frameset versions allow for presentational markup," 8 21822 752 16 serif 16
                        line 8 21840 784 20 base 14
                          span a 312 21842 152 16 link 646
                          text "which is omitted in the Strict version. Instead, " 8 21842 304 16 serif 16
                          text "cascading style sheets" 312 21842 152 16 serif 16 underline link 646
                          text " are encouraged to improve the presentation of" 464 21842 300 16 serif 16
                        line 8 21860 784 20 base 14
                          text "HTML documents. Because XHTML 1 only defines an XML syntax for the language defined by HTML 4, the same" 8 21862 716 16 serif 16
                        line 8 21880 784 20 base 14
                          text "differences apply to XHTML 1 as well." 8 21882 240 16 serif 16
                      block p 8 21916 784 20
                        line 8 21916 784 20 base 14
                          text "The Transitional version allows the following parts of the vocabulary, which are not included in the Strict version:" 8 21918 732 16 serif 16
                      block ul 8 21952 784 760
                        block li 48 21952 744 40
                          block anon 48 21952 744 20
                            line 48 21952 744 20 base 14
                              text "A looser content model" 48 21954 148 16 serif 16
                          block ul 48 21972 744 20
                            block li 88 21972 704 20
                              line 88 21972 704 20 base 14
                                span code 440 21974 32 16
                                span code 480 21974 80 16
                                span code 568 21974 32 16
                                span code 608 21974 64 16
                                span code 704 21974 64 16
                                text "Inline elements and plain text are allowed directly in: " 88 21974 352 16 serif 16
                                text "body" 440 21974 32 16 mono 16
                                text ", " 472 21974 8 16 serif 16
                                text "blockquote" 480 21974 80 16 mono 16
                                text ", " 560 21974 8 16 serif 16
                                text "form" 568 21974 32 16 mono 16
                                text ", " 600 21974 8 16 serif 16
                                text "noscript" 608 21974 64 16 mono 16
                                text " and " 672 21974 32 16 serif 16
                                text "noframes" 704 21974 64 16 mono 16
                              marker "◦ " 76 21974 12 16
                          marker "• " 36 21954 12 16
