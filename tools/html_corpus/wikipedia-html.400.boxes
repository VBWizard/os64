                          text "é" 360 22805 8 16 mono 16
                          text "), a" 368 22805 24 16 serif 16
                        line 8 22823 384 20 base 14
                          text "character typically found only on Western European and" 8 22825 360 16 serif 16
                        line 8 22843 384 20 base 14
                          text "South American keyboards, can be written in any HTML" 8 22845 356 16 serif 16
                        line 8 22863 384 20 base 14
                          span span 224 22865 8 16
                          span code 224 22865 64 16
                          text "document as the entity reference " 8 22865 216 16 serif 16
