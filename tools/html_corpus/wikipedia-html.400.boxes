                    block section 8 23424 384 162
                      block div 8 23424 384 23
                        block h3 8 23424 384 23
                          line 8 23424 384 23 base 16
                            text "Data types" 8 23426 81 19 serif 19 bold
                      block p 8 23466 384 120
                        line 8 23466 384 20 base 14
                          span a 152 23468 68 16 link 569
                          text "HTML defines several " 8 23468 144 16 serif 16
                          text "data types" 152 23468 68 16 serif 16 underline link 569
                          text " for element content, such" 220 23468 168 16 serif 16
                        line 8 23486 384 20 base 14
                          text "as script data and stylesheet data, and a plethora of types" 8 23488 376 16 serif 16
                        line 8 23506 384 20 base 14
                          span a 284 23508 32 16 link 570
                          text "for attribute values, including IDs, names, " 8 23508 276 16 serif 16
                          text "URIs" 284 23508 32 16 serif 16 underline link 570
                          text ", numbers," 316 23508 68 16 serif 16
                        line 8 23526 384 20 base 14
                          text "units of length, languages, media descriptors, colors," 8 23528 344 16 serif 16
                        line 8 23546 384 20 base 14
                          text "character encodings, dates and times, and so on. All of" 8 23548 356 16 serif 16
                        line 8 23566 384 20 base 14
                          text "these data types are specializations of character data." 8 23568 352 16 serif 16
                    block section 8 23605 384 734
                      block div 8 23605 384 24
                        block h3 8 23605 384 24
                          line 8 23605 384 24 base 16
                            text "Document type declaration" 8 23607 204 19 serif 19 bold
                      block p 8 23647 384 80
                        line 8 23647 384 20 base 14
                          span a 296 23649 96 16 link 571
                          text "HTML documents are required to start with a " 8 23649 288 16 serif 16
                          text "document type" 296 23649 96 16 serif 16 underline link 571
                        line 8 23667 384 20 base 14
                          span a 8 23669 72 16 link 571
                          text "declaration" 8 23669 72 16 serif 16 underline link 571
                          text " (informally, a \"doctype\"). In browsers, the" 80 23669 288 16 serif 16
                        line 8 23687 384 20 base 14
                          text "doctype helps to define the rendering mode—particularly" 8 23689 360 16 serif 16
                        line 8 23707 384 20 base 14
                          span a 108 23709 80 16 link 572
                          text "whether to use " 8 23709 100 16 serif 16
                          text "quirks mode" 108 23709 80 16 serif 16 underline link 572
                          text "." 188 23709 4 16 serif 16
                      block p 8 23743 384 160
                        line 8 23743 384 20 base 14
                          text "The original purpose of the doctype was to enable the" 8 23745 348 16 serif 16
                        line 8 23763 384 20 base 14
                          text "parsing and validation of HTML documents by SGML tools" 8 23765 372 16 serif 16
                        line 8 23783 384 20 base 14
                          span a 96 23785 160 16 link 573
                          text "based on the " 8 23785 88 16 serif 16
                          text "document type definition" 96 23785 160 16 serif 16 underline link 573
                          text " (DTD). The DTD to" 256 23785 120 16 serif 16
                        line 8 23803 384 20 base 14
                          text "which the DOCTYPE refers contains a machine-readable" 8 23805 360 16 serif 16
                        line 8 23823 384 20 base 14
                          text "grammar specifying the permitted and prohibited content for" 8 23825 384 16 serif 16
                        line 8 23843 384 20 base 14
                          text "a document conforming to such a DTD. Browsers, on the" 8 23845 360 16 serif 16
                        line 8 23863 384 20 base 14
                          text "other hand, do not implement HTML as an application of" 8 23865 360 16 serif 16
                        line 8 23883 384 20 base 14
                          text "SGML and as consequence do not read the DTD." 8 23885 308 16 serif 16
                      block p 8 23919 384 40
                        line 8 23919 384 20 base 14
                          span a 8 23921 44 16 link 574
                          text "HTML5" 8 23921 44 16 serif 16 underline link 574
                          text " does not define a DTD; therefore, in HTML5 the" 52 23921 300 16 serif 16
                        line 8 23939 384 20 base 14
                          span span 284 23944 7 13
                          span span 304 23944 6 13
                          span span 284 23944 26 13
                          span a 284 23944 26 13 link 575
                          span sup 284 23944 26 13
                          text "doctype declaration is simpler and shorter:" 8 23941 276 16 serif 16
                          text "[" 284 23944 7 13 serif 13 underline link 575
                          text "84" 291 23944 13 13 serif 13 underline link 575
                          text "]" 304 23944 6 13 serif 13 underline link 575
