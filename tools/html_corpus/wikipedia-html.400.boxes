                          text "report TR 9537 " 8 10311 96 16 serif 16
                          text "Techniques for using SGML" 104 10311 176 16 serif 16 italic
                          text ", which" 280 10311 48 16 serif 16
                        line 8 10329 384 20 base 14
                          text "describes the features of early text formatting languages" 8 10331 364 16 serif 16
                        line 8 10349 384 20 base 14
                          span a 172 10351 116 16 link 373
                          text "such as that used by the " 8 10351 164 16 serif 16
                          text "RUNOFF command" 172 10351 116 16 serif 16 underline link 373
                          text " developed in" 288 10351 88 16 serif 16
                        line 8 10369 384 20 base 14
                          span a 152 10371 32 16 link 374
                          text "the early 1960s for the " 8 10371 144 16 serif 16
                          text "CTSS" 152 10371 32 16 serif 16 underline link 374
                          text " (Compatible Time-Sharing" 184 10371 176 16 serif 16
                        line 8 10389 384 20 base 14
                          text "System) operating system. These formatting commands" 8 10391 364 16 serif 16
                        line 8 10409 384 20 base 14
                          text "were derived from the commands used by typesetters to" 8 10411 364 16 serif 16
                        line 8 10429 384 20 base 14
                          text "manually format documents. However, the SGML concept of" 8 10431 384 16 serif 16
                        line 8 10449 384 20 base 14
                          text "generalized markup is based on elements (nested" 8 10451 328 16 serif 16
                        line 8 10469 384 20 base 14
                          text "annotated ranges with attributes) rather than merely print" 8 10471 368 16 serif 16
                        line 8 10489 384 20 base 14
                          text "effects, with separate structure and markup. HTML has" 8 10491 352 16 serif 16
                        line 8 10509 384 20 base 14
                          text "been progressively moved in this direction with CSS." 8 10511 340 16 serif 16
                      block p 8 10545 384 300
                        line 8 10545 384 20 base 14
                          text "Berners-Lee considered HTML to be an application of" 8 10547 344 16 serif 16
                        line 8 10565 384 20 base 14
                          span a 308 10567 52 16 link 375
                          text "SGML. It was formally defined as such by the " 8 10567 300 16 serif 16
                          text "Internet" 308 10567 52 16 serif 16 underline link 375
                        line 8 10585 384 20 base 14
                          span a 8 10587 152 16 link 375
                          text "Engineering Task Force" 8 10587 152 16 serif 16 underline link 375
                          text " (IETF) with the mid-1993" 160 10587 172 16 serif 16
                        line 8 10605 384 20 base 14
                          text "publication of the first proposal for an HTML specification," 8 10607 372 16 serif 16
                        line 8 10625 384 20 base 14
                          span a 288 10627 84 16 link 376
                          text "the \"Hypertext Markup Language (HTML)\" " 8 10627 280 16 serif 16
                          text "Internet Draft" 288 10627 84 16 serif 16 underline link 376
                          text " by" 372 10627 20 16 serif 16
                        line 8 10645 384 20 base 14
                          span a 120 10647 84 16 link 377
                          text "Berners-Lee and " 8 10647 112 16 serif 16
                          text "Dan Connolly" 120 10647 84 16 serif 16 underline link 377
                          text ", which included an SGML" 204 10647 168 16 serif 16
                        line 8 10665 384 20 base 14
                          span a 8 10667 160 16 link 378
                          span span 304 10669 7 13
                          span span 320 10669 7 13
                          span span 304 10669 23 13
                          span a 304 10669 23 13 link 379
                          span sup 304 10669 23 13
                          span span 327 10669 6 13
                          span span 340 10669 6 13
                          span span 327 10669 19 13
                          span a 327 10669 19 13 link 380
                          span sup 327 10669 19 13
                          text "document type definition" 8 10667 160 16 serif 16 underline link 378
                          text " to define the syntax." 168 10667 136 16 serif 16
                          text "[" 304 10669 7 13 serif 13 underline link 379
                          text "10" 311 10669 9 13 serif 13 underline link 379
                          text "]" 320 10669 7 13 serif 13 underline link 379
                          text "[" 327 10669 6 13 serif 13 underline link 380
                          text "11" 333 10669 7 13 serif 13 underline link 380
                          text "]" 340 10669 6 13 serif 13 underline link 380
                          text " The" 346 10667 28 16 serif 16
                        line 8 10685 384 20 base 14
                          text "draft expired after six months, but was notable for its" 8 10687 340 16 serif 16
                        line 8 10705 384 20 base 14
                          span a 164 10707 84 16 link 381
                          text "acknowledgment of the " 8 10707 156 16 serif 16
                          text "NCSA Mosaic" 164 10707 84 16 serif 16 underline link 381
                          text " browser's custom tag" 248 10707 144 16 serif 16
                        line 8 10725 384 20 base 14
                          text "for embedding in-line images, reflecting the IETF's" 8 10727 332 16 serif 16
                        line 8 10745 384 20 base 14
                          text "philosophy of basing standards on successful prototypes." 8 10747 376 16 serif 16
                        line 8 10765 384 20 base 14
                          span a 72 10767 84 16 link 382
                          text "Similarly, " 8 10767 64 16 serif 16
                          text "Dave Raggett" 72 10767 84 16 serif 16 underline link 382
                          text "'s competing Internet Draft, \"HTML+" 156 10767 232 16 serif 16
                        line 8 10785 384 20 base 14
                          text "(Hypertext Markup Format)\", from late 1993, suggested" 8 10787 356 16 serif 16
                        line 8 10805 384 20 base 14
                          text "standardizing already-implemented features like tables" 8 10807 360 16 serif 16
                        line 8 10825 384 20 base 14
                          span span 124 10829 7 13
                          span span 140 10829 7 13
                          span span 124 10829 23 13
                          span a 124 10829 23 13 link 383
                          span sup 124 10829 23 13
                          text "and fill-out forms." 8 10827 116 16 serif 16
                          text "[" 124 10829 7 13 serif 13 underline link 383
                          text "12" 131 10829 9 13 serif 13 underline link 383
                          text "]" 140 10829 7 13 serif 13 underline link 383
                      block p 8 10861 384 100
                        line 8 10861 384 20 base 14
                          text "After the HTML and HTML+ drafts expired in early 1994, the" 8 10863 372 16 serif 16
                        line 8 10881 384 20 base 14
                          text "IETF created an HTML Working Group. In 1995, this working" 8 10883 384 16 serif 16
                        line 8 10901 384 20 base 14
                          text "group completed \"HTML 2.0\", the first HTML specification" 8 10903 372 16 serif 16
                        line 8 10921 384 20 base 14
                          text "intended to be treated as a standard against which future" 8 10923 368 16 serif 16
                        line 8 10941 384 20 base 14
                          span span 232 10945 7 13
                          span span 248 10945 7 13
                          span span 232 10945 23 13
                          span a 232 10945 23 13 link 384
                          span sup 232 10945 23 13
                          text "implementations should be based." 8 10943 224 16 serif 16
                          text "[" 232 10945 7 13 serif 13 underline link 384
                          text "13" 239 10945 9 13 serif 13 underline link 384
                          text "]" 248 10945 7 13 serif 13 underline link 384
                      block p 8 10977 384 240
                        line 8 10977 384 20 base 14
                          text "Further development under the auspices of the IETF was" 8 10979 368 16 serif 16
                        line 8 10997 384 20 base 14
                          span span 212 10999 68 16
                          span span 280 10999 0 16
                          span span 280 10999 4 16
                          span span 284 11001 7 13
                          span span 326 11001 7 13
                          span a 284 11001 49 13 link 385
                          span sup 284 11001 49 13
                          span span 333 10999 0 16
                          text "stalled by competing interests. " 8 10999 204 16 serif 16
                          text "Since 1996" 212 10999 68 16 serif 16
                          text "," 280 10999 4 16 serif 16
                          text "[" 284 11001 7 13 serif 13 underline link 385
                          text "update" 291 11001 35 13 serif 13 underline link 385
                          text "]" 326 11001 7 13 serif 13 underline link 385
                          text " the" 333 10999 24 16 serif 16
                        line 8 11017 384 20 base 14
                          text "HTML specifications have been maintained, with input from" 8 11019 384 16 serif 16
                        line 8 11037 384 20 base 14
                          span a 252 11039 104 16 link 386
                          text "commercial software vendors, by the " 8 11039 244 16 serif 16
                          text "World Wide Web" 252 11039 104 16 serif 16 underline link 386
                        line 8 11057 384 20 base 14
                          span a 8 11059 72 16 link 386
                          span span 132 11061 7 13
                          span span 148 11061 7 13
                          span span 132 11061 23 13
                          span a 132 11061 23 13 link 387
                          span sup 132 11061 23 13
                          text "Consortium" 8 11059 72 16 serif 16 underline link 386
                          text " (W3C)." 80 11059 52 16 serif 16
                          text "[" 132 11061 7 13 serif 13 underline link 387
                          text "14" 139 11061 9 13 serif 13 underline link 387
                          text "]" 148 11061 7 13 serif 13 underline link 387
                          text " In 2000, HTML became an" 155 11059 176 16 serif 16
                        line 8 11077 384 20 base 14
                          span a 160 11079 24 16 link 388
                          span a 192 11079 24 16 link 389
                          text "international standard (" 8 11079 152 16 serif 16
                          text "ISO" 160 11079 24 16 serif 16 underline link 388
                          text "/" 184 11079 8 16 serif 16
                          text "IEC" 192 11079 24 16 serif 16 underline link 389
                          text " 15445:2000). HTML 4.01" 216 11079 156 16 serif 16
                        line 8 11097 384 20 base 14
                          text "was published in late 1999, with further errata published" 8 11099 360 16 serif 16
                        line 8 11117 384 20 base 14
                          text "through 2001. In 2004, development began on HTML5 in the" 8 11119 384 16 serif 16
                        line 8 11137 384 20 base 14
                          span a 8 11139 344 16 link 390
                          text "Web Hypertext Application Technology Working Group" 8 11139 344 16 serif 16 underline link 390
                        line 8 11157 384 20 base 14
                          text "(WHATWG), which became a joint deliverable with the W3C" 8 11159 384 16 serif 16
                        line 8 11177 384 20 base 14
                          text "in 2008, and was completed and standardized on 28" 8 11179 340 16 serif 16
                        line 8 11197 384 20 base 14
                          span span 92 11201 7 13
                          span span 108 11201 7 13
                          span span 92 11201 23 13
                          span a 92 11201 23 13 link 391
                          span sup 92 11201 23 13
