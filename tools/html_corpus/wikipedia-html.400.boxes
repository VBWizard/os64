                          cell td 54 32640 336 102
                            block div 55 32641 334 100
                              line 55 32641 334 20 base 14
                                span b 131 32643 144 16
                                text "This article " 55 32643 76 16 serif 16
                                text "is missing information" 131 32643 144 16 serif 16 bold
                                text " about" 275 32643 40 16 serif 16
                              line 55 32661 334 20 base 14
                                span span 159 32663 188 16
                                span span 331 32663 16 16
                                span span 331 32663 16 16
                                span a 331 32663 16 16 link 652
                                text "contenteditable." 55 32663 104 16 serif 16
                                text " Please expand the article " 159 32663 172 16 serif 16
                                text "by" 331 32663 16 16 serif 16 underline link 652
                              line 55 32681 334 20 base 14
                                span a 55 32683 148 16 link 652
                                span span 55 32683 148 16
                                span span 55 32683 148 16
                                span span 203 32683 168 16
                                span span 55 32683 320 16
                                text "making an edit request" 55 32683 148 16 serif 16 underline link 652
                                text "to include this information" 203 32683 168 16 serif 16
                                text "." 371 32683 4 16 serif 16
                              line 55 32701 334 20 base 14
                                span a 263 32703 60 16 link 653
                                span span 55 32703 272 16
                                text "Further details may exist on the " 55 32703 208 16 serif 16
                                text "talk page" 263 32703 60 16 serif 16 underline link 653
                                text "." 323 32703 4 16 serif 16
                              line 55 32721 334 20 base 14
                                span span 63 32723 84 16
