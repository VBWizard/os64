                    block p 8 32760 384 140
                      line 8 32760 384 20 base 14
                        span a 8 32762 64 16 link 654
                        span i 132 32762 192 16
                        text "WYSIWYG" 8 32762 64 16 serif 16 underline link 654
                        text " editors (" 72 32762 60 16 serif 16
                        text "what you see is what you get" 132 32762 192 16 serif 16 italic
                        text "), are" 324 32762 36 16 serif 16
                      line 8 32780 384 20 base 14
                        text "HTML editors in which the user lays out everything as it is" 8 32782 376 16 serif 16
                      line 8 32800 384 20 base 14
                        span a 272 32802 92 16 link 655
                        text "to appear in the HTML document using a " 8 32802 264 16 serif 16
                        text "graphical user" 272 32802 92 16 serif 16 underline link 655
                      line 8 32820 384 20 base 14
                        span a 8 32822 56 16 link 655
                        span a 172 32822 128 16 link 656
                        text "interface" 8 32822 56 16 serif 16 underline link 655
                        text " (GUI), such as " 64 32822 108 16 serif 16
                        text "Microsoft FrontPage" 172 32822 128 16 serif 16 underline link 656
                        text ", often similar" 300 32822 88 16 serif 16
                      line 8 32840 384 20 base 14
                        span a 24 32842 108 16 link 657
                        text "to " 8 32842 16 16 serif 16
                        text "word processors" 24 32842 108 16 serif 16 underline link 657
                        text ". The editor renders the document rather" 132 32842 256 16 serif 16
                      line 8 32860 384 20 base 14
                        text "than showing the code, so authors do not require extensive" 8 32862 384 16 serif 16
                      line 8 32880 384 20 base 14
                        text "knowledge of HTML." 8 32882 132 16 serif 16
                    block p 8 32916 384 80
                      line 8 32916 384 20 base 14
                        span span 324 32920 7 13
                        span span 344 32920 6 13
                        span span 324 32920 26 13
                        span a 324 32920 26 13 link 658
                        span sup 324 32920 26 13
                        span span 350 32920 7 13
                        span span 373 32920 6 13
                        span span 350 32920 29 13
                        span a 350 32920 29 13 link 659
                        span sup 350 32920 29 13
                        text "The WYSIWYG editing model has been criticized," 8 32918 316 16 serif 16
                        text "[" 324 32920 7 13 serif 13 underline link 658
                        text "99" 331 32920 13 13 serif 13 underline link 658
                        text "]" 344 32920 6 13 serif 13 underline link 658
                        text "[" 350 32920 7 13 serif 13 underline link 659
                        text "100" 357 32920 16 13 serif 13 underline link 659
                        text "]" 373 32920 6 13 serif 13 underline link 659
                      line 8 32936 384 20 base 14
                        text "primarily because of the low quality of the generated code;" 8 32938 380 16 serif 16
                      line 8 32956 384 20 base 14
                        text "there are various developers advocating a change to the" 8 32958 364 16 serif 16
                      line 8 32976 384 20 base 14
                        span a 8 32978 68 16 link 660
                        span i 132 32978 208 16
                        span span 352 32980 7 13
                        span span 372 32980 6 13
                        span span 352 32980 26 13
                        span a 352 32980 26 13 link 661
                        span sup 352 32980 26 13
                        text "WYSIWYM" 8 32978 68 16 serif 16 underline link 660
                        text " model (" 76 32978 56 16 serif 16
                        text "what you see is what you mean" 132 32978 208 16 serif 16 italic
                        text ")." 340 32978 12 16 serif 16
                        text "[" 352 32980 7 13 serif 13 underline link 661
                        text "101" 359 32980 13 13 serif 13 underline link 661
                        text "]" 372 32980 6 13 serif 13 underline link 661
                    block p 8 33012 384 40
                      line 8 33012 384 20 base 14
                        text "WYSIWYG editors remain a controversial topic because of" 8 33014 372 16 serif 16
                      line 8 33032 384 20 base 14
                        text "their perceived flaws such as:" 8 33034 196 16 serif 16
                    block ul 8 33068 384 240
                      block li 48 33068 344 60
                        line 48 33068 344 20 base 14
                          text "Relying mainly on the layout as opposed to meaning," 48 33070 344 16 serif 16
                        line 48 33088 344 20 base 14
                          text "often using markup that does not convey the" 48 33090 288 16 serif 16
                        line 48 33108 344 20 base 14
                          span span 356 33112 7 13
                          span span 379 33112 6 13
                          span span 356 33112 29 13
                          span a 356 33112 29 13 link 662
                          span sup 356 33112 29 13
                          text "intended meaning but simply copies the layout." 48 33110 308 16 serif 16
                          text "[" 356 33112 7 13 serif 13 underline link 662
                          text "102" 363 33112 16 13 serif 13 underline link 662
                          text "]" 379 33112 6 13 serif 13 underline link 662
                        marker "• " 36 33070 12 16
                      block li 48 33128 344 60
                        line 48 33128 344 20 base 14
                          text "Often producing extremely verbose and redundant" 48 33130 320 16 serif 16
                        line 48 33148 344 20 base 14
                          text "code that fails to make use of the cascading nature" 48 33150 332 16 serif 16
                        line 48 33168 344 20 base 14
                          span a 132 33170 24 16 link 663
                          text "of HTML and " 48 33170 84 16 serif 16
                          text "CSS" 132 33170 24 16 serif 16 underline link 663
                          text "." 156 33170 4 16 serif 16
                        marker "• " 36 33130 12 16
                      block li 48 33188 344 60
                        line 48 33188 344 20 base 14
                          span a 352 33190 20 16 link 664
                          text "Often producing ungrammatical markup, called " 48 33190 304 16 serif 16
                          text "tag" 352 33190 20 16 serif 16 underline link 664
                        line 48 33208 344 20 base 14
                          span a 48 33210 32 16 link 664
                          text "soup" 48 33210 32 16 serif 16 underline link 664
                          text " or semantically incorrect markup (such as" 80 33210 280 16 serif 16
                        line 48 33228 344 20 base 14
                          span span 48 33230 8 16
                          span span 56 33230 16 16
                          span span 72 33230 8 16
                          span code 48 33230 32 16
                          text "<" 48 33230 8 16 mono 16
                          text "em" 56 33230 16 16 mono 16
                          text ">" 72 33230 8 16 mono 16
                          text " for italics)." 80 33230 76 16 serif 16
                        marker "• " 36 33190 12 16
                      block li 48 33248 344 60
                        line 48 33248 344 20 base 14
                          text "As a great deal of the information in HTML documents" 48 33250 344 16 serif 16
                        line 48 33268 344 20 base 14
                          text "is not in the layout, the model has been criticized for" 48 33270 340 16 serif 16
                        line 48 33288 344 20 base 14
                          span span 312 33292 7 13
                          span span 335 33292 6 13
                          span span 312 33292 29 13
                          span a 312 33292 29 13 link 665
                          span sup 312 33292 29 13
                          text "its \"what you see is all you get\"-nature." 48 33290 264 16 serif 16
                          text "[" 312 33292 7 13 serif 13 underline link 665
                          text "103" 319 33292 16 13 serif 13 underline link 665
                          text "]" 335 33292 6 13 serif 13 underline link 665
                        marker "• " 36 33250 12 16
