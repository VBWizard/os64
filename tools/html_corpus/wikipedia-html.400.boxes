                            text "<!DOCTYPE" 8 24073 72 16 mono 16
                            text " " 80 24073 8 16 mono 16
                            text "HTML" 88 24073 32 16 mono 16
                            text " " 120 24073 8 16 mono 16
                            text "PUBLIC" 128 24073 48 16 mono 16
                            text " " 176 24073 8 16 mono 16
                            text "\"-//W3C//DTD HTML 4.01//EN\"" 184 24073 216 16 mono 16
                            text " " 400 24073 8 16 mono 16
                            text "\"https://www.w3.org/TR/html4/strict.dtd\"" 408 24073 320 16 mono 16
                            text ">" 728 24073 8 16 mono 16
                      block p 8 24107 384 100
                        line 8 24107 384 20 base 14
                          text "This declaration references the DTD for the \"strict\" version" 8 24109 376 16 serif 16
                        line 8 24127 384 20 base 14
                          text "of HTML 4.01. SGML-based validators read the DTD in order" 8 24129 376 16 serif 16
                        line 8 24147 384 20 base 14
                          text "to properly parse the document and to perform validation." 8 24149 368 16 serif 16
                        line 8 24167 384 20 base 14
                          text "In modern browsers, a valid doctype activates standards" 8 24169 372 16 serif 16
                        line 8 24187 384 20 base 14
                          span a 144 24189 80 16 link 576
                          text "mode as opposed to " 8 24189 136 16 serif 16
                          text "quirks mode" 144 24189 80 16 serif 16 underline link 576
                          text "." 224 24189 4 16 serif 16
                      block p 8 24223 384 140
                        line 8 24223 384 20 base 14
                          text "In addition, HTML 4.01 provides Transitional and Frameset" 8 24225 376 16 serif 16
                        line 8 24243 384 20 base 14
                          span a 48 24245 128 16 link 577
                          text "DTDs, " 8 24245 40 16 serif 16
                          text "as explained below" 48 24245 128 16 serif 16 underline link 577
                          text ". The transitional type is the most" 176 24245 216 16 serif 16
                        line 8 24263 384 20 base 14
                          text "inclusive, incorporating current tags as well as older or" 8 24265 356 16 serif 16
                        line 8 24283 384 20 base 14
                          text "\"deprecated\" tags, with the Strict DTD excluding" 8 24285 312 16 serif 16
                        line 8 24303 384 20 base 14
                          text "deprecated tags. The frameset has all tags necessary to" 8 24305 364 16 serif 16
                        line 8 24323 384 20 base 14
                          text "make frames on a page along with the tags included in" 8 24325 356 16 serif 16
                        line 8 24343 384 20 base 14
                          span span 116 24348 7 13
                          span span 136 24348 6 13
                          span span 116 24348 26 13
                          span a 116 24348 26 13 link 578
                          span sup 116 24348 26 13
                          text "transitional type." 8 24345 108 16 serif 16
                          text "[" 116 24348 7 13 serif 13 underline link 578
                          text "85" 123 24348 13 13 serif 13 underline link 578
                          text "]" 136 24348 6 13 serif 13 underline link 578
                  block section 8 24383 384 1266
                    block div 8 24383 384 30
                      block h2 8 24383 384 30
                        line 8 24383 384 30 base 21
                          text "Semantic HTML" 8 24386 150 24 serif 24 bold
                    block div 8 24433 384 20
                      line 8 24433 384 20 base 14
                        span a 92 24435 100 16 link 579
                        text "Main article: " 8 24435 84 16 serif 16
                        text "Semantic HTML" 92 24435 100 16 serif 16 underline link 579
                    block p 8 24469 384 220
                      line 8 24469 384 20 base 14
                        text "Semantic HTML is a way of writing HTML that emphasizes" 8 24471 376 16 serif 16
                      line 8 24489 384 20 base 14
                        text "the meaning of the encoded information over its" 8 24491 308 16 serif 16
                      line 8 24509 384 20 base 14
                        text "presentation (look). HTML has included semantic markup" 8 24511 376 16 serif 16
                      line 8 24529 384 20 base 14
                        span span 124 24533 7 13
                        span span 144 24533 6 13
                        span span 124 24533 26 13
                        span a 124 24533 26 13 link 580
                        span sup 124 24533 26 13
                        text "from its inception," 8 24531 116 16 serif 16
                        text "[" 124 24533 7 13 serif 13 underline link 580
                        text "86" 131 24533 13 13 serif 13 underline link 580
                        text "]" 144 24533 6 13 serif 13 underline link 580
                        text " but has also included presentational" 150 24531 240 16 serif 16
                      line 8 24549 384 20 base 14
                        span span 120 24551 8 16
                        span span 160 24551 8 16
                        span code 120 24551 48 16
                        span span 176 24551 8 16
                        span span 192 24551 8 16
                        span code 176 24551 24 16
                        span span 236 24551 8 16
                        span span 292 24551 8 16
                        span code 236 24551 64 16
                        text "markup, such as " 8 24551 112 16 serif 16
                        text "<" 120 24551 8 16 mono 16
                        text "font" 128 24551 32 16 mono 16
                        text ">" 160 24551 8 16 mono 16
                        text ", " 168 24551 8 16 serif 16
                        text "<" 176 24551 8 16 mono 16
                        text "i" 184 24551 8 16 mono 16
                        text ">" 192 24551 8 16 mono 16
                        text ", and " 200 24551 36 16 serif 16
                        text "<" 236 24551 8 16 mono 16
                        text "center" 244 24551 48 16 mono 16
                        text ">" 292 24551 8 16 mono 16
                        text " tags. There" 300 24551 76 16 serif 16
                      line 8 24569 384 20 base 14
                        span a 224 24571 84 16 link 581
                        text "are also the semantically neutral " 8 24571 216 16 serif 16
                        text "div and span" 224 24571 84 16 serif 16 underline link 581
                        text " tags. Since" 308 24571 76 16 serif 16
                      line 8 24589 384 20 base 14
                        span a 144 24591 152 16 link 582
                        text "the late 1990s, when " 8 24591 136 16 serif 16
                        text "Cascading Style Sheets" 144 24591 152 16 serif 16 underline link 582
                        text " were" 296 24591 36 16 serif 16
                      line 8 24609 384 20 base 14
                        text "beginning to work in most browsers, web authors have" 8 24611 356 16 serif 16
                      line 8 24629 384 20 base 14
                        text "been encouraged to avoid the use of presentational HTML" 8 24631 372 16 serif 16
                      line 8 24649 384 20 base 14
                        span a 180 24651 164 16 link 583
                        text "markup with a view to the " 8 24651 172 16 serif 16
                        text "separation of content and" 180 24651 164 16 serif 16 underline link 583
                      line 8 24669 384 20 base 14
                        span a 8 24671 80 16 link 583
                        span span 92 24673 7 13
                        span span 112 24673 6 13
                        span span 92 24673 26 13
                        span a 92 24673 26 13 link 584
                        span sup 92 24673 26 13
                        text "presentation" 8 24671 80 16 serif 16 underline link 583
                        text "." 88 24671 4 16 serif 16
                        text "[" 92 24673 7 13 serif 13 underline link 584
                        text "87" 99 24673 13 13 serif 13 underline link 584
                        text "]" 112 24673 6 13 serif 13 underline link 584
                    block p 8 24705 384 300
                      line 8 24705 384 20 base 14
                        span a 188 24707 92 16 link 585
                        span a 288 24707 24 16 link 586
                        text "In a 2001 discussion of the " 8 24707 180 16 serif 16
                        text "Semantic Web" 188 24707 92 16 serif 16 underline link 585
                        text ", " 280 24707 8 16 serif 16
                        text "Tim" 288 24707 24 16 serif 16 underline link 586
                      line 8 24725 384 20 base 14
                        span a 8 24727 80 16 link 586
                        text "Berners-Lee" 8 24727 80 16 serif 16 underline link 586
                        text " and others gave examples of ways in which" 88 24727 292 16 serif 16
                      line 8 24745 384 20 base 14
                        text "intelligent software \"agents\" may one day automatically" 8 24747 368 16 serif 16
                      line 8 24765 384 20 base 14
                        text "crawl the web and find, filter, and correlate previously" 8 24767 348 16 serif 16
                      line 8 24785 384 20 base 14
                        text "unrelated, published facts for the benefit of human" 8 24787 324 16 serif 16
                      line 8 24805 384 20 base 14
                        span span 48 24809 7 13
                        span span 68 24809 6 13
                        span span 48 24809 26 13
                        span a 48 24809 26 13 link 587
                        span sup 48 24809 26 13
                        text "users." 8 24807 40 16 serif 16
                        text "[" 48 24809 7 13 serif 13 underline link 587
                        text "88" 55 24809 13 13 serif 13 underline link 587
                        text "]" 68 24809 6 13 serif 13 underline link 587
                        text " Such agents are not commonplace even" 74 24807 264 16 serif 16
                      line 8 24825 384 20 base 14
                        span span 36 24829 7 13
                        span span 43 24829 35 13
                        span a 43 24829 35 13 link 588
                        span i 43 24829 35 13
                        span span 78 24829 7 13
                        span sup 36 24829 49 13
                        span a 253 24827 52 16 link 589
                        span a 313 24827 60 16 link 590
                        text "now" 8 24827 28 16 serif 16
                        text "[" 36 24829 7 13 serif 13
                        text "when?" 43 24829 35 13 serif 13 italic underline link 588
                        text "]" 78 24829 7 13 serif 13
                        text ", but some of the ideas of " 85 24827 168 16 serif 16
                        text "Web 2.0" 253 24827 52 16 serif 16 underline link 589
                        text ", " 305 24827 8 16 serif 16
                        text "mashups" 313 24827 60 16 serif 16 underline link 590
                      line 8 24845 384 20 base 14
                        span a 36 24847 176 16 link 591
                        text "and " 8 24847 28 16 serif 16
                        text "price comparison websites" 36 24847 176 16 serif 16 underline link 591
                        text " may be coming" 212 24847 104 16 serif 16
                      line 8 24865 384 20 base 14
                        span span 44 24869 7 13
                        span span 51 24869 81 13
                        span a 51 24869 81 13 link 592
                        span i 51 24869 81 13
                        span span 132 24869 6 13
                        span sup 44 24869 94 13
                        text "close" 8 24867 36 16 serif 16
                        text "[" 44 24869 7 13 serif 13
                        text "citation needed" 51 24869 81 13 serif 13 italic underline link 592
                        text "]" 132 24869 6 13 serif 13
                        text ". The main difference between these" 138 24867 236 16 serif 16
                      line 8 24885 384 20 base 14
                        text "web application hybrids and Berners-Lee's semantic" 8 24887 344 16 serif 16
                      line 8 24905 384 20 base 14
                        span a 252 24907 76 16 link 593
                        text "agents lies in the fact that the current " 8 24907 244 16 serif 16
                        text "aggregation" 252 24907 76 16 serif 16 underline link 593
                        text " and" 328 24907 28 16 serif 16
                      line 8 24925 384 20 base 14
                        span a 340 24927 28 16 link 594
                        text "hybridization of information is usually designed by " 8 24927 332 16 serif 16
                        text "web" 340 24927 28 16 serif 16 underline link 594
                      line 8 24945 384 20 base 14
                        span a 8 24947 72 16 link 594
                        text "developers" 8 24947 72 16 serif 16 underline link 594
                        text ", who already know the web locations and the" 80 24947 300 16 serif 16
                      line 8 24965 384 20 base 14
                        span a 8 24967 96 16 link 595
                        text "API semantics" 8 24967 96 16 serif 16 underline link 595
                        text " of the specific data they wish to mash," 104 24967 256 16 serif 16
                      line 8 24985 384 20 base 14
                        text "compare and combine." 8 24987 148 16 serif 16
                    block p 8 25021 384 180
                      line 8 25021 384 20 base 14
                        text "An important type of web agent that does crawl and read" 8 25023 364 16 serif 16
                      line 8 25041 384 20 base 14
                        text "web pages automatically, without prior knowledge of what" 8 25043 380 16 serif 16
                      line 8 25061 384 20 base 14
                        span a 132 25063 80 16 link 596
                        text "it might find, is the " 8 25063 124 16 serif 16
                        text "web crawler" 132 25063 80 16 serif 16 underline link 596
                        text " or search-engine spider." 212 25063 164 16 serif 16
                      line 8 25081 384 20 base 14
                        text "These software agents are dependent on the semantic" 8 25083 352 16 serif 16
                      line 8 25101 384 20 base 14
                        text "clarity of web pages they find as they use various" 8 25103 324 16 serif 16
                      line 8 25121 384 20 base 14
                        span a 112 25123 68 16 link 597
                        text "techniques and " 8 25123 104 16 serif 16
                        text "algorithms" 112 25123 68 16 serif 16 underline link 597
                        text " to read and index millions of" 180 25123 188 16 serif 16
                      line 8 25141 384 20 base 14
                        span a 308 25143 44 16 link 598
                        text "web pages a day and provide web users with " 8 25143 300 16 serif 16
                        text "search" 308 25143 44 16 serif 16 underline link 598
                      line 8 25161 384 20 base 14
                        span a 8 25163 56 16 link 598
                        text "facilities" 8 25163 56 16 serif 16 underline link 598
                        text " without which the World Wide Web's usefulness" 64 25163 316 16 serif 16
                      line 8 25181 384 20 base 14
                        text "would be greatly reduced." 8 25183 168 16 serif 16
                    block p 8 25217 384 140
                      line 8 25217 384 20 base 14
                        text "In order for search engine spiders to be able to rate the" 8 25219 356 16 serif 16
                      line 8 25237 384 20 base 14
                        text "significance of pieces of text they find in HTML documents," 8 25239 384 16 serif 16
                      line 8 25257 384 20 base 14
                        text "and also for those creating mashups and other hybrids as" 8 25259 372 16 serif 16
                      line 8 25277 384 20 base 14
                        text "well as for more automated agents as they are developed," 8 25279 376 16 serif 16
                      line 8 25297 384 20 base 14
                        text "the semantic structures that exist in HTML need to be" 8 25299 344 16 serif 16
                      line 8 25317 384 20 base 14
                        text "widely and uniformly applied to bring out the meaning of" 8 25319 364 16 serif 16
                      line 8 25337 384 20 base 14
                        span span 128 25341 7 13
                        span span 148 25341 6 13
                        span span 128 25341 26 13
                        span a 128 25341 26 13 link 599
                        span sup 128 25341 26 13
                        text "the published text." 8 25339 120 16 serif 16
                        text "[" 128 25341 7 13 serif 13 underline link 599
                        text "89" 135 25341 13 13 serif 13 underline link 599
                        text "]" 148 25341 6 13 serif 13 underline link 599
                    block p 8 25373 384 120
                      line 8 25373 384 20 base 14
                        span a 212 25375 72 16 link 600
                        text "Presentational markup tags are " 8 25375 204 16 serif 16
                        text "deprecated" 212 25375 72 16 serif 16 underline link 600
                        text " in current HTML" 284 25375 104 16 serif 16
                      line 8 25393 384 20 base 14
                        span a 36 25395 44 16 link 601
                        text "and " 8 25395 28 16 serif 16
                        text "XHTML" 36 25395 44 16 serif 16 underline link 601
                        text " recommendations. The majority of" 80 25395 224 16 serif 16
                      line 8 25413 384 20 base 14
                        text "presentational features from previous versions of HTML are" 8 25415 380 16 serif 16
                      line 8 25433 384 20 base 14
                        text "no longer allowed as they lead to poorer accessibility," 8 25435 352 16 serif 16
                      line 8 25453 384 20 base 14
                        text "higher cost of site maintenance, and larger document" 8 25455 344 16 serif 16
                      line 8 25473 384 20 base 14
                        span span 48 25477 7 13
                        span span 68 25477 6 13
                        span span 48 25477 26 13
                        span a 48 25477 26 13 link 602
                        span sup 48 25477 26 13
                        text "sizes." 8 25475 40 16 serif 16
                        text "[" 48 25477 7 13 serif 13 underline link 602
                        text "90" 55 25477 13 13 serif 13 underline link 602
                        text "]" 68 25477 6 13 serif 13 underline link 602
                    block p 8 25509 384 140
                      line 8 25509 384 20 base 14
                        span a 268 25511 84 16 link 603
                        text "Good semantic HTML also improves the " 8 25511 260 16 serif 16
                        text "accessibility" 268 25511 84 16 serif 16 underline link 603
                        text " of" 352 25511 16 16 serif 16
                      line 8 25529 384 20 base 14
                        span a 184 25531 168 16 link 604
                        text "web documents (see also " 8 25531 176 16 serif 16
                        text "Web Content Accessibility" 184 25531 168 16 serif 16 underline link 604
                      line 8 25549 384 20 base 14
                        span a 8 25551 68 16 link 604
                        text "Guidelines" 8 25551 68 16 serif 16 underline link 604
                        text "). For example, when a screen reader or audio" 76 25551 300 16 serif 16
                      line 8 25569 384 20 base 14
                        text "browser can correctly ascertain the structure of a" 8 25571 316 16 serif 16
                      line 8 25589 384 20 base 14
                        text "document, it will not waste the visually impaired user's" 8 25591 360 16 serif 16
                      line 8 25609 384 20 base 14
                        text "time by reading out repeated or irrelevant information when" 8 25611 380 16 serif 16
                      line 8 25629 384 20 base 14
                        text "it has been marked up correctly." 8 25631 208 16 serif 16
                  block section 8 25669 384 1535
                    block div 8 25669 384 30
                      block h2 8 25669 384 30
                        line 8 25669 384 30 base 21
                          text "Delivery" 8 25672 78 24 serif 24 bold
                    block p 8 25719 384 60
                      line 8 25719 384 20 base 14
                        text "HTML documents can be delivered by the same means as" 8 25721 376 16 serif 16
                      line 8 25739 384 20 base 14
                        text "any other computer file. However, they are most often" 8 25741 344 16 serif 16
                      line 8 25759 384 20 base 14
                        span a 132 25761 32 16 link 605
                        span a 212 25761 72 16 link 606
                        span a 324 25761 36 16 link 607
                        text "delivered either by " 8 25761 124 16 serif 16
                        text "HTTP" 132 25761 32 16 serif 16 underline link 605
                        text " from a " 164 25761 48 16 serif 16
                        text "web server" 212 25761 72 16 serif 16 underline link 606
                        text " or by " 284 25761 40 16 serif 16
                        text "email" 324 25761 36 16 serif 16 underline link 607
                        text "." 360 25761 4 16 serif 16
                    block section 8 25798 384 550
                      block div 8 25798 384 23
                        block h3 8 25798 384 23
                          line 8 25798 384 23 base 16
                            text "HTTP" 8 25800 38 19 serif 19 bold
                      block div 8 25840 384 20
                        line 8 25840 384 20 base 14
                          span a 92 25842 32 16 link 608
                          text "Main article: " 8 25842 84 16 serif 16
                          text "HTTP" 92 25842 32 16 serif 16 underline link 608
                      block p 8 25876 384 200
                        line 8 25876 384 20 base 14
                          span a 36 25878 104 16 link 609
                          text "The " 8 25878 28 16 serif 16
                          text "World Wide Web" 36 25878 104 16 serif 16 underline link 609
                          text " is composed primarily of HTML" 140 25878 204 16 serif 16
                        line 8 25896 384 20 base 14
                          text "documents transmitted from web servers to web browsers" 8 25898 376 16 serif 16
                        line 8 25916 384 20 base 14
                          span a 72 25918 172 16 link 610
                          text "using the " 8 25918 64 16 serif 16
                          text "Hypertext Transfer Protocol" 72 25918 172 16 serif 16 underline link 610
                          text " (HTTP). However," 244 25918 120 16 serif 16
                        line 8 25936 384 20 base 14
                          text "HTTP is used to serve images, sound, and other content, in" 8 25938 380 16 serif 16
                        line 8 25956 384 20 base 14
                          text "addition to HTML. To allow the web browser to know how" 8 25958 372 16 serif 16
                        line 8 25976 384 20 base 14
                          text "to handle each document it receives, other information is" 8 25978 368 16 serif 16
                        line 8 25996 384 20 base 14
                          span a 284 25998 64 16 link 611
                          text "transmitted along with the document. This " 8 25998 276 16 serif 16
                          text "meta data" 284 25998 64 16 serif 16 underline link 611
                        line 8 26016 384 20 base 14
                          span a 144 26018 72 16 link 612
                          span kbd 260 26018 72 16
                          text "usually includes the " 8 26018 136 16 serif 16
                          text "MIME type" 144 26018 72 16 serif 16 underline link 612
                          text " (e.g., " 216 26018 44 16 serif 16
                          text "text/html" 260 26018 72 16 mono 16
                          text " or" 332 26018 16 16 serif 16
                        line 8 26036 384 20 base 14
                          span kbd 8 26038 168 16
                          text "application/xhtml+xml" 8 26038 168 16 mono 16
                          text ") and the character encoding" 176 26038 188 16 serif 16
                        line 8 26056 384 20 base 14
                          span a 44 26058 188 16 link 613
                          text "(see " 8 26058 36 16 serif 16
                          text "Character encodings in HTML" 44 26058 188 16 serif 16 underline link 613
                          text ")." 232 26058 12 16 serif 16
                      block p 8 26092 384 140
                        line 8 26092 384 20 base 14
                          text "In modern browsers, the MIME type that is sent with the" 8 26094 368 16 serif 16
                        line 8 26112 384 20 base 14
                          text "HTML document may affect how the document is initially" 8 26114 368 16 serif 16
                        line 8 26132 384 20 base 14
                          text "interpreted. A document sent with the XHTML MIME type is" 8 26134 380 16 serif 16
                        line 8 26152 384 20 base 14
                          span a 108 26154 80 16 link 614
                          text "expected to be " 8 26154 100 16 serif 16
                          text "well-formed" 108 26154 80 16 serif 16 underline link 614
                          text " XML; syntax errors may cause" 188 26154 200 16 serif 16
                        line 8 26172 384 20 base 14
                          text "the browser to fail to render it. The same document sent" 8 26174 360 16 serif 16
                        line 8 26192 384 20 base 14
                          text "with the HTML MIME type might be displayed successfully" 8 26194 384 16 serif 16
                        line 8 26212 384 20 base 14
                          text "since some browsers are more lenient with HTML." 8 26214 324 16 serif 16
                      block p 8 26248 384 100
                        line 8 26248 384 20 base 14
                          text "The W3C recommendations state that XHTML 1.0 documents" 8 26250 384 16 serif 16
                        line 8 26268 384 20 base 14
                          text "that follow guidelines set forth in the recommendation's" 8 26270 360 16 serif 16
                        line 8 26288 384 20 base 14
                          span span 340 26292 7 13
                          span span 356 26292 7 13
                          span span 340 26292 23 13
                          span a 340 26292 23 13 link 615
                          span sup 340 26292 23 13
                          text "Appendix C may be labeled with either MIME Type." 8 26290 332 16 serif 16
                          text "[" 340 26292 7 13 serif 13 underline link 615
                          text "91" 347 26292 9 13 serif 13 underline link 615
                          text "]" 356 26292 7 13 serif 13 underline link 615
                        line 8 26308 384 20 base 14
                          span span 360 26312 7 13
                          span span 380 26312 6 13
                          span span 360 26312 26 13
                          span a 360 26312 26 13 link 616
                          span sup 360 26312 26 13
                          text "XHTML 1.1 also states that XHTML 1.1 documents should" 8 26310 352 16 serif 16
                          text "[" 360 26312 7 13 serif 13 underline link 616
                          text "92" 367 26312 13 13 serif 13 underline link 616
                          text "]" 380 26312 6 13 serif 13 underline link 616
                        line 8 26328 384 20 base 14
                          span span 228 26332 7 13
                          span span 248 26332 6 13
                          span span 228 26332 26 13
                          span a 228 26332 26 13 link 617
                          span sup 228 26332 26 13
                          text "be labeled with either MIME type." 8 26330 220 16 serif 16
                          text "[" 228 26332 7 13 serif 13 underline link 617
                          text "93" 235 26332 13 13 serif 13 underline link 617
                          text "]" 248 26332 6 13 serif 13 underline link 617
                    block section 8 26367 384 338
                      block div 8 26367 384 24
                        block h3 8 26367 384 24
                          line 8 26367 384 24 base 16
                            text "HTML e-mail" 8 26369 100 19 serif 19 bold
                      block div 8 26409 384 20
                        line 8 26409 384 20 base 14
                          span a 92 26411 76 16 link 618
                          text "Main article: " 8 26411 84 16 serif 16
                          text "HTML email" 92 26411 76 16 serif 16 underline link 618
                      block p 8 26445 384 260
                        line 8 26445 384 20 base 14
                          text "Most graphical email clients allow the use of a subset of" 8 26447 368 16 serif 16
                        line 8 26465 384 20 base 14
                          text "HTML (often ill-defined) to provide formatting and" 8 26467 324 16 serif 16
                        line 8 26485 384 20 base 14
                          span a 8 26487 60 16 link 619
                          span a 244 26487 60 16 link 620
                          text "semantic" 8 26487 60 16 serif 16 underline link 619
                          text " markup not available with " 68 26487 176 16 serif 16
                          text "plain text" 244 26487 60 16 serif 16 underline link 620
                          text ". This may" 304 26487 68 16 serif 16
                        line 8 26505 384 20 base 14
                          text "include typographic information like colored headings," 8 26507 352 16 serif 16
                        line 8 26525 384 20 base 14
                          text "emphasized and quoted text, inline images and diagrams." 8 26527 376 16 serif 16
                        line 8 26545 384 20 base 14
                          span a 228 26547 24 16 link 621
                          text "Many such clients include both a " 8 26547 220 16 serif 16
                          text "GUI" 228 26547 24 16 serif 16 underline link 621
                          text " editor for composing" 252 26547 136 16 serif 16
                        line 8 26565 384 20 base 14
                          text "HTML e-mail messages and a rendering engine for" 8 26567 328 16 serif 16
                        line 8 26585 384 20 base 14
                          text "displaying them. Use of HTML in e-mail is criticized by" 8 26587 356 16 serif 16
                        line 8 26605 384 20 base 14
                          text "some because of compatibility issues, because it can help" 8 26607 384 16 serif 16
                        line 8 26625 384 20 base 14
                          span a 68 26627 56 16 link 622
                          text "disguise " 8 26627 60 16 serif 16
                          text "phishing" 68 26627 56 16 serif 16 underline link 622
                          text " attacks, because of accessibility issues" 124 26627 268 16 serif 16
                        line 8 26645 384 20 base 14
                          text "for blind or visually impaired people, because it can" 8 26647 336 16 serif 16
                        line 8 26665 384 20 base 14
                          span a 64 26667 36 16 link 623
                          text "confuse " 8 26667 56 16 serif 16
                          text "spam" 64 26667 36 16 serif 16 underline link 623
                          text " filters and because the message size is" 100 26667 264 16 serif 16
                        line 8 26685 384 20 base 14
                          text "larger than plain text." 8 26687 136 16 serif 16
                    block section 8 26724 384 123
                      block div 8 26724 384 24
                        block h3 8 26724 384 24
                          line 8 26724 384 24 base 17
                            text "Naming conventions" 8 26726 157 19 serif 19 bold
                      block p 8 26767 384 80
                        line 8 26767 384 20 base 14
                          span a 132 26769 124 16 link 624
                          span a 280 26769 28 16 link 625
                          text "The most common " 8 26769 124 16 serif 16
                          text "filename extension" 132 26769 124 16 serif 16 underline link 624
                          text " for " 256 26769 24 16 serif 16
                          text "files" 280 26769 28 16 serif 16 underline link 625
                          text " containing" 308 26769 72 16 serif 16
                        line 8 26787 384 20 base 14
                          span kbd 64 26789 40 16
                          span kbd 328 26789 32 16
                          text "HTML is " 8 26789 56 16 serif 16
                          text ".html" 64 26789 40 16 mono 16
                          text ". A common abbreviation of this is " 104 26789 224 16 serif 16
                          text ".htm" 328 26789 32 16 mono 16
                          text "," 360 26789 4 16 serif 16
                        line 8 26807 384 20 base 14
                          text "which originated because some operating systems limit" 8 26809 364 16 serif 16
                        line 8 26827 384 20 base 14
                          span a 124 26829 76 16 link 626
                          span span 204 26831 7 13
                          span span 224 26831 6 13
                          span span 204 26831 26 13
                          span a 204 26831 26 13 link 627
                          span sup 204 26831 26 13
                          text "file extensions to " 8 26829 116 16 serif 16
                          text "three letters" 124 26829 76 16 serif 16 underline link 626
                          text "." 200 26829 4 16 serif 16
                          text "[" 204 26831 7 13 serif 13 underline link 627
                          text "94" 211 26831 13 13 serif 13 underline link 627
                          text "]" 224 26831 6 13 serif 13 underline link 627
                    block section 8 26865 384 339
                      block div 8 26865 384 24
                        block h3 8 26865 384 24
                          line 8 26865 384 24 base 17
                            text "HTML Application" 8 26868 133 19 serif 19 bold
                      block div 8 26908 384 20
                        line 8 26908 384 20 base 14
                          span a 92 26910 112 16 link 628
                          text "Main article: " 8 26910 84 16 serif 16
                          text "HTML Application" 92 26910 112 16 serif 16 underline link 628
                      block p 8 26944 384 260
                        line 8 26944 384 20 base 14
                          span kbd 276 26946 32 16
                          text "An HTML Application (HTA; file extension " 8 26946 268 16 serif 16
                          text ".hta" 276 26946 32 16 mono 16
                          text ") is a" 308 26946 36 16 serif 16
                        line 8 26964 384 20 base 14
                          span a 8 26966 124 16 link 629
                          text "Microsoft Windows" 8 26966 124 16 serif 16 underline link 629
                          text " application that uses HTML and" 132 26966 208 16 serif 16
                        line 8 26984 384 20 base 14
                          span a 136 26986 52 16 link 630
                          text "Dynamic HTML in a " 8 26986 128 16 serif 16
                          text "browser" 136 26986 52 16 serif 16 underline link 630
                          text " to provide the application's" 188 26986 180 16 serif 16
                        line 8 27004 384 20 base 14
                          text "graphical interface. A regular HTML file is confined to the" 8 27006 364 16 serif 16
                        line 8 27024 384 20 base 14
                          span a 148 27026 152 16 link 631
                          text "security model of the " 8 27026 140 16 serif 16
                          text "web browser's security" 148 27026 152 16 serif 16 underline link 631
                          text "," 300 27026 4 16 serif 16
                        line 8 27044 384 20 base 14
                          text "communicating only to web servers and manipulating only" 8 27046 380 16 serif 16
                        line 8 27064 384 20 base 14
                          span a 156 27066 80 16 link 632
                          text "web page objects and " 8 27066 148 16 serif 16
                          text "site cookies" 156 27066 80 16 serif 16 underline link 632
                          text ". An HTA runs as a fully" 236 27066 148 16 serif 16
                        line 8 27084 384 20 base 14
                          text "trusted application and therefore has more privileges, like" 8 27086 372 16 serif 16
                        line 8 27104 384 20 base 14
                          span a 252 27106 116 16 link 633
                          text "creation/editing/removal of files and " 8 27106 244 16 serif 16
                          text "Windows Registry" 252 27106 116 16 serif 16 underline link 633
                        line 8 27124 384 20 base 14
                          text "entries. Because they operate outside the browser's" 8 27126 336 16 serif 16
                        line 8 27144 384 20 base 14
                          text "security model, HTAs cannot be executed via HTTP, but" 8 27146 356 16 serif 16
                        line 8 27164 384 20 base 14
                          span a 232 27166 24 16 link 634
                          text "must be downloaded (just like an " 8 27166 224 16 serif 16
                          text "EXE" 232 27166 24 16 serif 16 underline link 634
                          text " file) and executed" 256 27166 124 16 serif 16
                        line 8 27184 384 20 base 14
                          text "from local file system." 8 27186 144 16 serif 16
                  block section 8 27224 384 5158
                    block div 8 27224 384 30
                      block h2 8 27224 384 30
                        line 8 27224 384 30 base 21
                          text "HTML4 variations" 8 27227 168 24 serif 24 bold
                    block p 8 27274 384 320
                      line 8 27274 384 20 base 14
                        text "Since its inception, HTML and its associated protocols" 8 27276 352 16 serif 16
                      line 8 27294 384 20 base 14
                        text "gained acceptance relatively quickly. However, no clear" 8 27296 364 16 serif 16
                      line 8 27314 384 20 base 14
                        text "standards existed in the early years of the language." 8 27316 340 16 serif 16
                      line 8 27334 384 20 base 14
                        text "Though its creators originally conceived of HTML as a" 8 27336 348 16 serif 16
                      line 8 27354 384 20 base 14
                        span span 332 27358 7 13
                        span span 352 27358 6 13
                        span span 332 27358 26 13
                        span a 332 27358 26 13 link 635
                        span sup 332 27358 26 13
                        text "semantic language devoid of presentation details," 8 27356 324 16 serif 16
                        text "[" 332 27358 7 13 serif 13 underline link 635
                        text "95" 339 27358 13 13 serif 13 underline link 635
                        text "]" 352 27358 6 13 serif 13 underline link 635
                      line 8 27374 384 20 base 14
                        text "practical uses pushed many presentational elements and" 8 27376 372 16 serif 16
                      line 8 27394 384 20 base 14
                        text "attributes into the language, driven largely by the various" 8 27396 368 16 serif 16
                      line 8 27414 384 20 base 14
                        text "browser vendors. The latest standards surrounding HTML" 8 27416 368 16 serif 16
                      line 8 27434 384 20 base 14
                        text "reflect efforts to overcome the sometimes chaotic" 8 27436 320 16 serif 16
                      line 8 27454 384 20 base 14
                        span span 196 27458 7 13
                        span span 216 27458 6 13
                        span span 196 27458 26 13
                        span a 196 27458 26 13 link 636
                        span sup 196 27458 26 13
                        text "development of the language" 8 27456 188 16 serif 16
                        text "[" 196 27458 7 13 serif 13 underline link 636
                        text "96" 203 27458 13 13 serif 13 underline link 636
                        text "]" 216 27458 6 13 serif 13 underline link 636
                        text " and to create a rational" 222 27456 152 16 serif 16
                      line 8 27474 384 20 base 14
                        text "foundation for building both meaningful and well-presented" 8 27476 384 16 serif 16
                      line 8 27494 384 20 base 14
                        text "documents. To return HTML to its role as a semantic" 8 27496 336 16 serif 16
                      line 8 27514 384 20 base 14
                        span a 100 27516 28 16 link 637
                        text "language, the " 8 27516 92 16 serif 16
                        text "W3C" 100 27516 28 16 serif 16 underline link 637
                        text " has developed style languages such as" 128 27516 264 16 serif 16
                      line 8 27534 384 20 base 14
                        span a 8 27536 24 16 link 638
                        span a 64 27536 24 16 link 639
                        text "CSS" 8 27536 24 16 serif 16 underline link 638
                        text " and " 32 27536 32 16 serif 16
                        text "XSL" 64 27536 24 16 serif 16 underline link 639
                        text " to shoulder the burden of presentation. In" 88 27536 272 16 serif 16
                      line 8 27554 384 20 base 14
                        text "conjunction, the HTML specification has slowly reined in" 8 27556 368 16 serif 16
                      line 8 27574 384 20 base 14
                        text "the presentational elements." 8 27576 184 16 serif 16
                    block p 8 27610 384 100
                      line 8 27610 384 20 base 14
                        text "There are two axes differentiating various variations of" 8 27612 352 16 serif 16
                      line 8 27630 384 20 base 14
                        text "HTML as currently specified: SGML-based HTML versus" 8 27632 360 16 serif 16
                      line 8 27650 384 20 base 14
                        text "XML-based HTML (referred to as XHTML) on one axis, and" 8 27652 380 16 serif 16
                      line 8 27670 384 20 base 14
                        text "strict versus transitional (loose) versus frameset on the" 8 27672 364 16 serif 16
                      line 8 27690 384 20 base 14
                        text "other axis." 8 27692 68 16 serif 16
                    block section 8 27728 384 1947
                      block div 8 27728 384 24
                        block h3 8 27728 384 24
                          line 8 27728 384 24 base 17
                            text "SGML-based versus XML-based HTML" 8 27731 299 19 serif 19 bold
                      block p 8 27771 384 260
                        line 8 27771 384 20 base 14
                          span span 180 27775 7 13
                          span span 187 27775 35 13
                          span a 187 27775 35 13 link 640
                          span i 187 27775 35 13
                          span span 222 27775 7 13
                          span sup 180 27775 49 13
                          text "One difference in the latest" 8 27773 172 16 serif 16
                          text "[" 180 27775 7 13 serif 13
                          text "when?" 187 27775 35 13 serif 13 italic underline link 640
                          text "]" 222 27775 7 13 serif 13
                          text " HTML specifications" 229 27773 136 16 serif 16
                        line 8 27791 384 20 base 14
                          text "lies in the distinction between the SGML-based" 8 27793 308 16 serif 16
                        line 8 27811 384 20 base 14
                          text "specification and the XML-based specification. The" 8 27813 336 16 serif 16
                        line 8 27831 384 20 base 14
                          span a 288 27833 44 16 link 641
                          text "XML-based specification is usually called " 8 27833 280 16 serif 16
                          text "XHTML" 288 27833 44 16 serif 16 underline link 641
                          text " to" 332 27833 16 16 serif 16
                        line 8 27851 384 20 base 14
                          text "distinguish it clearly from the more traditional definition." 8 27853 360 16 serif 16
                        line 8 27871 384 20 base 14
                          text "However, the root element name continues to be \"html\"" 8 27873 360 16 serif 16
                        line 8 27891 384 20 base 14
                          text "even in the XHTML-specified HTML. The W3C intended" 8 27893 352 16 serif 16
                        line 8 27911 384 20 base 14
                          text "XHTML 1.0 to be identical to HTML 4.01 except where" 8 27913 336 16 serif 16
                        line 8 27931 384 20 base 14
                          text "limitations of XML over the more complex SGML require" 8 27933 356 16 serif 16
                        line 8 27951 384 20 base 14
                          text "workarounds. Because XHTML and HTML are closely" 8 27953 340 16 serif 16
                        line 8 27971 384 20 base 14
                          text "related, they are sometimes documented in parallel. In" 8 27973 356 16 serif 16
                        line 8 27991 384 20 base 14
                          span a 240 27993 152 16 link 642
                          text "such circumstances, some authors " 8 27993 232 16 serif 16
                          text "conflate the two names" 240 27993 152 16 serif 16 underline link 642
                        line 8 28011 384 20 base 14
                          text "as (X)HTML or X(HTML)." 8 28013 164 16 serif 16
                      block p 8 28047 384 40
                        line 8 28047 384 20 base 14
                          text "Like HTML 4.01, XHTML 1.0 has three sub-specifications:" 8 28049 364 16 serif 16
                        line 8 28067 384 20 base 14
                          text "strict, transitional, and frameset." 8 28069 208 16 serif 16
                      block p 8 28103 384 320
                        line 8 28103 384 20 base 14
                          text "Aside from the different opening declarations for a" 8 28105 320 16 serif 16
                        line 8 28123 384 20 base 14
                          text "document, the differences between an HTML 4.01 and" 8 28125 344 16 serif 16
                        line 8 28143 384 20 base 14
                          text "XHTML 1.0 document—in each of the corresponding" 8 28145 324 16 serif 16
                        line 8 28163 384 20 base 14
                          text "DTDs—are largely syntactic. The underlying syntax of HTML" 8 28165 380 16 serif 16
                        line 8 28183 384 20 base 14
                          text "allows many shortcuts that XHTML does not, such as" 8 28185 344 16 serif 16
                        line 8 28203 384 20 base 14
                          text "elements with optional opening or closing tags, and even" 8 28205 372 16 serif 16
                        line 8 28223 384 20 base 14
                          text "empty elements which must not have an end tag. By" 8 28225 340 16 serif 16
                        line 8 28243 384 20 base 14
                          text "contrast, XHTML requires all elements to have an opening" 8 28245 372 16 serif 16
                        line 8 28263 384 20 base 14
                          text "tag and a closing tag. XHTML, however, also introduces a" 8 28265 372 16 serif 16
                        line 8 28283 384 20 base 14
                          text "new shortcut: an XHTML tag may be opened and closed" 8 28285 360 16 serif 16
                        line 8 28303 384 20 base 14
                          text "within the same tag, by including a slash before the end of" 8 28305 380 16 serif 16
                        line 8 28323 384 20 base 14
                          span span 116 28325 8 16
                          span span 124 28325 16 16
                          span span 140 28325 16 16
                          span code 116 28325 40 16
                          text "the tag like this: " 8 28325 108 16 serif 16
                          text "<" 116 28325 8 16 mono 16
                          text "br" 124 28325 16 16 mono 16
                          text "/>" 140 28325 16 16 mono 16
                          text ". The introduction of this shorthand," 156 28325 228 16 serif 16
                        line 8 28343 384 20 base 14
                          text "which is not used in the SGML declaration for HTML 4.01," 8 28345 364 16 serif 16
                        line 8 28363 384 20 base 14
                          text "may confuse earlier software unfamiliar with this new" 8 28365 348 16 serif 16
                        line 8 28383 384 20 base 14
                          text "convention. A fix for this is remove the slash preceding the" 8 28385 380 16 serif 16
                        line 8 28403 384 20 base 14
                          span span 216 28405 8 16
                          span span 224 28405 16 16
                          span span 240 28405 8 16
                          span code 216 28405 32 16
                          span span 252 28407 7 13
                          span span 272 28407 6 13
                          span span 252 28407 26 13
                          span a 252 28407 26 13 link 643
                          span sup 252 28407 26 13
                          text "closing angle bracket, as such: " 8 28405 208 16 serif 16
                          text "<" 216 28405 8 16 mono 16
                          text "br" 224 28405 16 16 mono 16
                          text ">" 240 28405 8 16 mono 16
                          text "." 248 28405 4 16 serif 16
                          text "[" 252 28407 7 13 serif 13 underline link 643
                          text "97" 259 28407 13 13 serif 13 underline link 643
                          text "]" 272 28407 6 13 serif 13 underline link 643
                      block p 8 28439 384 100
                        line 8 28439 384 20 base 14
                          text "To understand the subtle differences between HTML and" 8 28441 364 16 serif 16
                        line 8 28459 384 20 base 14
                          text "XHTML, consider the transformation of a valid and" 8 28461 320 16 serif 16
                        line 8 28479 384 20 base 14
                          text "well-formed XHTML 1.0 document that adheres to Appendix" 8 28481 380 16 serif 16
                        line 8 28499 384 20 base 14
                          text "C (see below) into a valid HTML 4.01 document. Making" 8 28501 364 16 serif 16
                        line 8 28519 384 20 base 14
                          text "this translation requires the following steps:" 8 28521 284 16 serif 16
                      block ol 8 28555 384 340
                        block li 48 28555 344 80
                          line 48 28555 344 20 base 14
                            span code 360 28557 32 16
                            text "The language for an element is specified with a " 48 28557 312 16 serif 16
                            text "lang" 360 28557 32 16 mono 16
                          line 48 28575 344 20 base 14
                            span code 248 28577 64 16
                            text "attribute rather than the XHTML " 48 28577 200 16 serif 16
                            text "xml:lang" 248 28577 64 16 mono 16
                            text " attribute." 312 28577 60 16 serif 16
                          line 48 28595 344 20 base 14
                            text "XHTML uses XML's built-in language-defining" 48 28597 300 16 serif 16
                          line 48 28615 344 20 base 14
                            text "functionality attribute." 48 28617 140 16 serif 16
                          marker "1. " 36 28557 12 16
                        block li 48 28635 344 40
                          line 48 28635 344 20 base 14
                            span code 248 28637 72 16
                            text "Remove the XML namespace (" 48 28637 200 16 serif 16
                            text "xmlns=URI" 248 28637 72 16 mono 16
                            text "). HTML" 320 28637 52 16 serif 16
                          line 48 28655 344 20 base 14
                            text "has no facilities for namespaces." 48 28657 216 16 serif 16
                          marker "2. " 32 28637 16 16
                        block li 48 28675 344 40
                          line 48 28675 344 20 base 14
                            text "Change the document type declaration from XHTML" 48 28677 328 16 serif 16
                          line 48 28695 344 20 base 14
                            text "1.0 to HTML 4.01." 48 28697 104 16 serif 16
                          marker "3. " 32 28677 16 16
                        block li 48 28715 344 60
                          line 48 28715 344 20 base 14
                            text "If present, remove the XML declaration. Typically" 48 28717 320 16 serif 16
                          line 48 28735 344 20 base 14
                            span code 96 28737 152 16
                            span span 96 28737 152 16
                            text "this is: " 48 28737 48 16 serif 16
                            text "<?xml version=\"1.0\"" 96 28737 152 16 mono 16
                          line 48 28755 344 20 base 14
                            span span 48 28757 144 16
                            span code 48 28757 144 16
                            text "encoding=\"utf-8\"?>" 48 28757 144 16 mono 16
                            text "." 192 28757 4 16 serif 16
                          marker "4. " 32 28717 16 16
                        block li 48 28775 344 80
                          line 48 28775 344 20 base 14
                            text "Ensure that the document's MIME type is set to" 48 28777 308 16 serif 16
                          line 48 28795 344 20 base 14
                            span code 48 28797 72 16
                            text "text/html" 48 28797 72 16 mono 16
                            text ". For both HTML and XHTML, this comes" 120 28797 256 16 serif 16
                          line 48 28815 344 20 base 14
                            span code 140 28817 96 16
                            text "from the HTTP " 48 28817 92 16 serif 16
                            text "Content-Type" 140 28817 96 16 mono 16
                            text " header sent by the" 236 28817 124 16 serif 16
                          line 48 28835 344 20 base 14
                            text "server." 48 28837 44 16 serif 16
                          marker "5. " 32 28777 16 16
                        block li 48 28855 344 40
                          line 48 28855 344 20 base 14
                            text "Change the XML empty-element syntax to an HTML" 48 28857 332 16 serif 16
                          line 48 28875 344 20 base 14
                            span span 192 28877 8 16
                            span span 200 28877 16 16
                            span span 216 28877 16 16
                            span code 192 28877 40 16
                            span span 252 28877 8 16
                            span span 260 28877 16 16
                            span span 276 28877 8 16
                            span code 252 28877 32 16
                            text "style empty element (" 48 28877 144 16 serif 16
                            text "<" 192 28877 8 16 mono 16
                            text "br" 200 28877 16 16 mono 16
                            text "/>" 216 28877 16 16 mono 16
                            text " to " 232 28877 20 16 serif 16
                            text "<" 252 28877 8 16 mono 16
                            text "br" 260 28877 16 16 mono 16
                            text ">" 276 28877 8 16 mono 16
                            text ")." 284 28877 12 16 serif 16
                          marker "6. " 32 28857 16 16
                      block p 8 28911 384 140
                        line 8 28911 384 20 base 14
                          text "Those are the main changes necessary to translate a" 8 28913 344 16 serif 16
                        line 8 28931 384 20 base 14
                          text "document from XHTML 1.0 to HTML 4.01. To translate from" 8 28933 364 16 serif 16
                        line 8 28951 384 20 base 14
                          text "HTML to XHTML would also require the addition of any" 8 28953 348 16 serif 16
                        line 8 28971 384 20 base 14
                          text "omitted opening or closing tags. Whether coding in HTML or" 8 28973 384 16 serif 16
                        line 8 28991 384 20 base 14
                          text "XHTML it may just be best to always include the optional" 8 28993 368 16 serif 16
                        line 8 29011 384 20 base 14
                          text "tags within an HTML document rather than remembering" 8 29013 360 16 serif 16
                        line 8 29031 384 20 base 14
                          text "which tags can be omitted." 8 29033 176 16 serif 16
                      block p 8 29067 384 80
                        line 8 29067 384 20 base 14
                          text "A well-formed XHTML document adheres to all the syntax" 8 29069 372 16 serif 16
                        line 8 29087 384 20 base 14
                          text "requirements of XML. A valid document adheres to the" 8 29089 348 16 serif 16
                        line 8 29107 384 20 base 14
                          text "content specification for XHTML, which describes the" 8 29109 344 16 serif 16
                        line 8 29127 384 20 base 14
                          text "document structure." 8 29129 128 16 serif 16
                      block p 8 29163 384 80
                        line 8 29163 384 20 base 14
                          text "The W3C recommends several conventions to ensure an" 8 29165 364 16 serif 16
                        line 8 29183 384 20 base 14
                          span span 284 29187 7 13
                          span span 304 29187 6 13
                          span span 284 29187 26 13
                          span a 284 29187 26 13 link 644
                          span sup 284 29187 26 13
                          text "easy migration between HTML and XHTML." 8 29185 276 16 serif 16
                          text "[" 284 29187 7 13 serif 13 underline link 644
                          text "98" 291 29187 13 13 serif 13 underline link 644
                          text "]" 304 29187 6 13 serif 13 underline link 644
                          text " The" 310 29185 28 16 serif 16
                        line 8 29203 384 20 base 14
                          text "following steps can be applied to XHTML 1.0 documents" 8 29205 360 16 serif 16
                        line 8 29223 384 20 base 14
                          text "only:" 8 29225 32 16 serif 16
                      block ul 8 29259 384 200
                        block li 48 29259 344 40
                          line 48 29259 344 20 base 14
                            span code 136 29261 64 16
                            span code 232 29261 32 16
                            text "Include both " 48 29261 88 16 serif 16
                            text "xml:lang" 136 29261 64 16 mono 16
                            text " and " 200 29261 32 16 serif 16
                            text "lang" 232 29261 32 16 mono 16
                            text " attributes on any" 264 29261 112 16 serif 16
                          line 48 29279 344 20 base 14
                            text "elements assigning language." 48 29281 196 16 serif 16
                          marker "• " 36 29261 12 16
                        block li 48 29299 344 40
                          line 48 29299 344 20 base 14
                            text "Use the empty-element syntax only for elements" 48 29301 316 16 serif 16
                          line 48 29319 344 20 base 14
                            text "specified as empty in HTML." 48 29321 184 16 serif 16
                          marker "• " 36 29301 12 16
                        block li 48 29339 344 40
                          line 48 29339 344 20 base 14
                            text "Remove the closing slash in empty-element tags: for" 48 29341 344 16 serif 16
                          line 48 29359 344 20 base 14
                            span span 108 29361 8 16
                            span span 116 29361 16 16
                            span span 132 29361 8 16
                            span code 108 29361 32 16
                            span span 212 29361 8 16
                            span span 220 29361 16 16
                            span span 236 29361 16 16
                            span code 212 29361 40 16
                            text "example " 48 29361 60 16 serif 16
                            text "<" 108 29361 8 16 mono 16
                            text "br" 116 29361 16 16 mono 16
                            text ">" 132 29361 8 16 mono 16
                            text " instead of " 140 29361 72 16 serif 16
                            text "<" 212 29361 8 16 mono 16
                            text "br" 220 29361 16 16 mono 16
                            text "/>" 236 29361 16 16 mono 16
                            text "." 252 29361 4 16 serif 16
                          marker "• " 36 29341 12 16
                        block li 48 29379 344 60
                          line 48 29379 344 20 base 14
                            text "Include explicit close tags for elements that permit" 48 29381 332 16 serif 16
                          line 48 29399 344 20 base 14
                            span code 308 29401 0 16
                            span span 340 29401 8 16
                            span span 348 29401 24 16
                            span code 340 29401 32 16
                            text "content but are left empty (for example, " 48 29401 260 16 serif 16
                            text ", not " 308 29401 32 16 serif 16
                            text "<" 340 29401 8 16 mono 16
                            text "div" 348 29401 24 16 mono 16
                          line 48 29419 344 20 base 14
                            span span 48 29421 16 16
                            span code 48 29421 16 16
                            text "/>" 48 29421 16 16 mono 16
                            text ")." 64 29421 12 16 serif 16
                          marker "• " 36 29381 12 16
                        block li 48 29439 344 20
                          line 48 29439 344 20 base 14
                            text "Omit the XML declaration." 48 29441 164 16 serif 16
                          marker "• " 36 29441 12 16
                      block p 8 29475 384 200
                        line 8 29475 384 20 base 14
                          text "By carefully following the W3C's compatibility guidelines, a" 8 29477 384 16 serif 16
                        line 8 29495 384 20 base 14
                          text "user agent should be able to interpret the document equally" 8 29497 384 16 serif 16
                        line 8 29515 384 20 base 14
                          text "as HTML or XHTML. For documents that are XHTML 1.0 and" 8 29517 372 16 serif 16
                        line 8 29535 384 20 base 14
                          text "have been made compatible in this way, the W3C permits" 8 29537 372 16 serif 16
                        line 8 29555 384 20 base 14
                          span code 280 29557 72 16
                          text "them to be served either as HTML (with a " 8 29557 272 16 serif 16
                          text "text/html" 280 29557 72 16 mono 16
                        line 8 29575 384 20 base 14
                          span a 8 29577 72 16 link 645
                          text "MIME type" 8 29577 72 16 serif 16 underline link 645
                          text "), or as XHTML (with an" 80 29577 156 16 serif 16
                        line 8 29595 384 20 base 14
                          span code 8 29597 168 16
                          span code 196 29597 120 16
                          text "application/xhtml+xml" 8 29597 168 16 mono 16
                          text " or " 176 29597 20 16 serif 16
                          text "application/xml" 196 29597 120 16 mono 16
                          text " MIME" 316 29597 44 16 serif 16
                        line 8 29615 384 20 base 14
                          text "type). When delivered as XHTML, browsers should use an" 8 29617 376 16 serif 16
                        line 8 29635 384 20 base 14
                          text "XML parser, which adheres strictly to the XML" 8 29637 296 16 serif 16
                        line 8 29655 384 20 base 14
                          text "specifications for parsing the document's contents." 8 29657 332 16 serif 16
                    block section 8 29693 384 1871
                      block div 8 29693 384 24
                        block h3 8 29693 384 24
                          line 8 29693 384 24 base 17
                            text "Transitional versus strict" 8 29696 190 19 serif 19 bold
                      block p 8 29736 384 280
                        line 8 29736 384 20 base 14
                          text "HTML 4 defined three different versions of the language:" 8 29738 360 16 serif 16
                        line 8 29756 384 20 base 14
                          text "Strict, Transitional (once called Loose), and Frameset. The" 8 29758 384 16 serif 16
                        line 8 29776 384 20 base 14
                          text "Strict version is intended for new documents and is" 8 29778 332 16 serif 16
                        line 8 29796 384 20 base 14
                          text "considered best practice, while the Transitional and" 8 29798 336 16 serif 16
                        line 8 29816 384 20 base 14
                          text "Frameset versions were developed to make it easier to" 8 29818 356 16 serif 16
                        line 8 29836 384 20 base 14
                          text "transition documents that conformed to older HTML" 8 29838 328 16 serif 16
                        line 8 29856 384 20 base 14
                          text "specifications or did not conform to any specification to a" 8 29858 372 16 serif 16
                        line 8 29876 384 20 base 14
                          text "version of HTML 4. The Transitional and Frameset versions" 8 29878 380 16 serif 16
                        line 8 29896 384 20 base 14
                          text "allow for presentational markup, which is omitted in the" 8 29898 360 16 serif 16
                        line 8 29916 384 20 base 14
                          span a 160 29918 152 16 link 646
                          text "Strict version. Instead, " 8 29918 152 16 serif 16
                          text "cascading style sheets" 160 29918 152 16 serif 16 underline link 646
                          text " are" 312 29918 24 16 serif 16
                        line 8 29936 384 20 base 14
                          text "encouraged to improve the presentation of HTML" 8 29938 312 16 serif 16
                        line 8 29956 384 20 base 14
                          text "documents. Because XHTML 1 only defines an XML syntax" 8 29958 376 16 serif 16
                        line 8 29976 384 20 base 14
                          text "for the language defined by HTML 4, the same differences" 8 29978 372 16 serif 16
                        line 8 29996 384 20 base 14
                          text "apply to XHTML 1 as well." 8 29998 164 16 serif 16
                      block p 8 30032 384 40
                        line 8 30032 384 20 base 14
                          text "The Transitional version allows the following parts of the" 8 30034 368 16 serif 16
                        line 8 30052 384 20 base 14
                          text "vocabulary, which are not included in the Strict version:" 8 30054 360 16 serif 16
