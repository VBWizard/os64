                    block section 8 23448 384 162
                      block div 8 23448 384 23
                        block h3 8 23448 384 23
                          line 8 23448 384 23 base 16
                            text "Data types" 8 23450 81 19 serif 19 bold
                      block p 8 23490 384 120
                        line 8 23490 384 20 base 14
                          span a 152 23492 68 16 link 569
                          text "HTML defines several " 8 23492 144 16 serif 16
                          text "data types" 152 23492 68 16 serif 16 underline link 569
                          text " for element content, such" 220 23492 168 16 serif 16
                        line 8 23510 384 20 base 14
                          text "as script data and stylesheet data, and a plethora of types" 8 23512 376 16 serif 16
                        line 8 23530 384 20 base 14
                          span a 284 23532 32 16 link 570
                          text "for attribute values, including IDs, names, " 8 23532 276 16 serif 16
                          text "URIs" 284 23532 32 16 serif 16 underline link 570
                          text ", numbers," 316 23532 68 16 serif 16
                        line 8 23550 384 20 base 14
                          text "units of length, languages, media descriptors, colors," 8 23552 344 16 serif 16
                        line 8 23570 384 20 base 14
                          text "character encodings, dates and times, and so on. All of" 8 23572 356 16 serif 16
                        line 8 23590 384 20 base 14
                          text "these data types are specializations of character data." 8 23592 352 16 serif 16
                    block section 8 23629 384 734
                      block div 8 23629 384 24
                        block h3 8 23629 384 24
                          line 8 23629 384 24 base 16
                            text "Document type declaration" 8 23631 204 19 serif 19 bold
                      block p 8 23671 384 80
                        line 8 23671 384 20 base 14
                          span a 296 23673 96 16 link 571
                          text "HTML documents are required to start with a " 8 23673 288 16 serif 16
                          text "document type" 296 23673 96 16 serif 16 underline link 571
                        line 8 23691 384 20 base 14
                          span a 8 23693 72 16 link 571
                          text "declaration" 8 23693 72 16 serif 16 underline link 571
                          text " (informally, a \"doctype\"). In browsers, the" 80 23693 288 16 serif 16
                        line 8 23711 384 20 base 14
                          text "doctype helps to define the rendering mode—particularly" 8 23713 360 16 serif 16
                        line 8 23731 384 20 base 14
                          span a 108 23733 80 16 link 572
                          text "whether to use " 8 23733 100 16 serif 16
                          text "quirks mode" 108 23733 80 16 serif 16 underline link 572
                          text "." 188 23733 4 16 serif 16
                      block p 8 23767 384 160
                        line 8 23767 384 20 base 14
                          text "The original purpose of the doctype was to enable the" 8 23769 348 16 serif 16
                        line 8 23787 384 20 base 14
                          text "parsing and validation of HTML documents by SGML tools" 8 23789 372 16 serif 16
                        line 8 23807 384 20 base 14
                          span a 96 23809 160 16 link 573
                          text "based on the " 8 23809 88 16 serif 16
                          text "document type definition" 96 23809 160 16 serif 16 underline link 573
                          text " (DTD). The DTD to" 256 23809 120 16 serif 16
                        line 8 23827 384 20 base 14
                          text "which the DOCTYPE refers contains a machine-readable" 8 23829 360 16 serif 16
                        line 8 23847 384 20 base 14
                          text "grammar specifying the permitted and prohibited content for" 8 23849 384 16 serif 16
                        line 8 23867 384 20 base 14
                          text "a document conforming to such a DTD. Browsers, on the" 8 23869 360 16 serif 16
                        line 8 23887 384 20 base 14
                          text "other hand, do not implement HTML as an application of" 8 23889 360 16 serif 16
                        line 8 23907 384 20 base 14
                          text "SGML and as consequence do not read the DTD." 8 23909 308 16 serif 16
                      block p 8 23943 384 40
                        line 8 23943 384 20 base 14
                          span a 8 23945 44 16 link 574
                          text "HTML5" 8 23945 44 16 serif 16 underline link 574
                          text " does not define a DTD; therefore, in HTML5 the" 52 23945 300 16 serif 16
                        line 8 23963 384 20 base 14
                          span span 284 23968 7 13
                          span span 304 23968 6 13
                          span span 284 23968 26 13
                          span a 284 23968 26 13 link 575
                          span sup 284 23968 26 13
                          text "doctype declaration is simpler and shorter:" 8 23965 276 16 serif 16
                          text "[" 284 23968 7 13 serif 13 underline link 575
                          text "84" 291 23968 13 13 serif 13 underline link 575
                          text "]" 304 23968 6 13 serif 13 underline link 575
