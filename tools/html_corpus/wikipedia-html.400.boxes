                            span span 184 24049 216 16
                            span span 408 24049 320 16
                            span span 728 24049 8 16
                            text "<!DOCTYPE" 8 24049 72 16 mono 16
                            text " " 80 24049 8 16 mono 16
                            text "HTML" 88 24049 32 16 mono 16
                            text " " 120 24049 8 16 mono 16
                            text "PUBLIC" 128 24049 48 16 mono 16
                            text " " 176 24049 8 16 mono 16
                            text "\"-//W3C//DTD HTML 4.01//EN\"" 184 24049 216 16 mono 16
                            text " " 400 24049 8 16 mono 16
                            text "\"https://www.w3.org/TR/html4/strict.dtd\"" 408 24049 320 16 mono 16
                            text ">" 728 24049 8 16 mono 16
                      block p 8 24083 384 100
                        line 8 24083 384 20 base 14
                          text "This declaration references the DTD for the \"strict\" version" 8 24085 376 16 serif 16
                        line 8 24103 384 20 base 14
                          text "of HTML 4.01. SGML-based validators read the DTD in order" 8 24105 376 16 serif 16
                        line 8 24123 384 20 base 14
                          text "to properly parse the document and to perform validation." 8 24125 368 16 serif 16
                        line 8 24143 384 20 base 14
                          text "In modern browsers, a valid doctype activates standards" 8 24145 372 16 serif 16
                        line 8 24163 384 20 base 14
                          span a 144 24165 80 16 link 576
                          text "mode as opposed to " 8 24165 136 16 serif 16
                          text "quirks mode" 144 24165 80 16 serif 16 underline link 576
                          text "." 224 24165 4 16 serif 16
                      block p 8 24199 384 140
                        line 8 24199 384 20 base 14
                          text "In addition, HTML 4.01 provides Transitional and Frameset" 8 24201 376 16 serif 16
                        line 8 24219 384 20 base 14
                          span a 48 24221 128 16 link 577
                          text "DTDs, " 8 24221 40 16 serif 16
                          text "as explained below" 48 24221 128 16 serif 16 underline link 577
                          text ". The transitional type is the most" 176 24221 216 16 serif 16
                        line 8 24239 384 20 base 14
                          text "inclusive, incorporating current tags as well as older or" 8 24241 356 16 serif 16
                        line 8 24259 384 20 base 14
                          text "\"deprecated\" tags, with the Strict DTD excluding" 8 24261 312 16 serif 16
                        line 8 24279 384 20 base 14
                          text "deprecated tags. The frameset has all tags necessary to" 8 24281 364 16 serif 16
                        line 8 24299 384 20 base 14
                          text "make frames on a page along with the tags included in" 8 24301 356 16 serif 16
                        line 8 24319 384 20 base 14
                          span span 116 24324 7 13
                          span span 136 24324 6 13
                          span span 116 24324 26 13
                          span a 116 24324 26 13 link 578
                          span sup 116 24324 26 13
                          text "transitional type." 8 24321 108 16 serif 16
                          text "[" 116 24324 7 13 serif 13 underline link 578
                          text "85" 123 24324 13 13 serif 13 underline link 578
                          text "]" 136 24324 6 13 serif 13 underline link 578
                  block section 8 24359 384 1266
                    block div 8 24359 384 30
                      block h2 8 24359 384 30
                        line 8 24359 384 30 base 21
                          text "Semantic HTML" 8 24362 150 24 serif 24 bold
                    block div 8 24409 384 20
                      line 8 24409 384 20 base 14
                        span a 92 24411 100 16 link 579
                        text "Main article: " 8 24411 84 16 serif 16
                        text "Semantic HTML" 92 24411 100 16 serif 16 underline link 579
                    block p 8 24445 384 220
                      line 8 24445 384 20 base 14
                        text "Semantic HTML is a way of writing HTML that emphasizes" 8 24447 376 16 serif 16
                      line 8 24465 384 20 base 14
                        text "the meaning of the encoded information over its" 8 24467 308 16 serif 16
                      line 8 24485 384 20 base 14
                        text "presentation (look). HTML has included semantic markup" 8 24487 376 16 serif 16
                      line 8 24505 384 20 base 14
                        span span 124 24509 7 13
                        span span 144 24509 6 13
                        span span 124 24509 26 13
                        span a 124 24509 26 13 link 580
                        span sup 124 24509 26 13
                        text "from its inception," 8 24507 116 16 serif 16
                        text "[" 124 24509 7 13 serif 13 underline link 580
                        text "86" 131 24509 13 13 serif 13 underline link 580
                        text "]" 144 24509 6 13 serif 13 underline link 580
                        text " but has also included presentational" 150 24507 240 16 serif 16
                      line 8 24525 384 20 base 14
                        span span 120 24527 8 16
                        span span 160 24527 8 16
                        span code 120 24527 48 16
                        span span 176 24527 8 16
                        span span 192 24527 8 16
                        span code 176 24527 24 16
                        span span 236 24527 8 16
                        span span 292 24527 8 16
                        span code 236 24527 64 16
                        text "markup, such as " 8 24527 112 16 serif 16
                        text "<" 120 24527 8 16 mono 16
                        text "font" 128 24527 32 16 mono 16
                        text ">" 160 24527 8 16 mono 16
                        text ", " 168 24527 8 16 serif 16
                        text "<" 176 24527 8 16 mono 16
                        text "i" 184 24527 8 16 mono 16
                        text ">" 192 24527 8 16 mono 16
                        text ", and " 200 24527 36 16 serif 16
                        text "<" 236 24527 8 16 mono 16
                        text "center" 244 24527 48 16 mono 16
                        text ">" 292 24527 8 16 mono 16
                        text " tags. There" 300 24527 76 16 serif 16
                      line 8 24545 384 20 base 14
                        span a 224 24547 84 16 link 581
                        text "are also the semantically neutral " 8 24547 216 16 serif 16
                        text "div and span" 224 24547 84 16 serif 16 underline link 581
                        text " tags. Since" 308 24547 76 16 serif 16
                      line 8 24565 384 20 base 14
                        span a 144 24567 152 16 link 582
                        text "the late 1990s, when " 8 24567 136 16 serif 16
                        text "Cascading Style Sheets" 144 24567 152 16 serif 16 underline link 582
                        text " were" 296 24567 36 16 serif 16
                      line 8 24585 384 20 base 14
                        text "beginning to work in most browsers, web authors have" 8 24587 356 16 serif 16
                      line 8 24605 384 20 base 14
                        text "been encouraged to avoid the use of presentational HTML" 8 24607 372 16 serif 16
                      line 8 24625 384 20 base 14
                        span a 180 24627 164 16 link 583
                        text "markup with a view to the " 8 24627 172 16 serif 16
                        text "separation of content and" 180 24627 164 16 serif 16 underline link 583
                      line 8 24645 384 20 base 14
                        span a 8 24647 80 16 link 583
                        span span 92 24649 7 13
                        span span 112 24649 6 13
                        span span 92 24649 26 13
                        span a 92 24649 26 13 link 584
                        span sup 92 24649 26 13
                        text "presentation" 8 24647 80 16 serif 16 underline link 583
                        text "." 88 24647 4 16 serif 16
                        text "[" 92 24649 7 13 serif 13 underline link 584
                        text "87" 99 24649 13 13 serif 13 underline link 584
                        text "]" 112 24649 6 13 serif 13 underline link 584
                    block p 8 24681 384 300
                      line 8 24681 384 20 base 14
                        span a 188 24683 92 16 link 585
                        span a 288 24683 24 16 link 586
                        text "In a 2001 discussion of the " 8 24683 180 16 serif 16
                        text "Semantic Web" 188 24683 92 16 serif 16 underline link 585
                        text ", " 280 24683 8 16 serif 16
                        text "Tim" 288 24683 24 16 serif 16 underline link 586
                      line 8 24701 384 20 base 14
                        span a 8 24703 80 16 link 586
                        text "Berners-Lee" 8 24703 80 16 serif 16 underline link 586
                        text " and others gave examples of ways in which" 88 24703 292 16 serif 16
                      line 8 24721 384 20 base 14
                        text "intelligent software \"agents\" may one day automatically" 8 24723 368 16 serif 16
                      line 8 24741 384 20 base 14
                        text "crawl the web and find, filter, and correlate previously" 8 24743 348 16 serif 16
                      line 8 24761 384 20 base 14
                        text "unrelated, published facts for the benefit of human" 8 24763 324 16 serif 16
                      line 8 24781 384 20 base 14
                        span span 48 24785 7 13
                        span span 68 24785 6 13
                        span span 48 24785 26 13
                        span a 48 24785 26 13 link 587
                        span sup 48 24785 26 13
                        text "users." 8 24783 40 16 serif 16
                        text "[" 48 24785 7 13 serif 13 underline link 587
                        text "88" 55 24785 13 13 serif 13 underline link 587
                        text "]" 68 24785 6 13 serif 13 underline link 587
                        text " Such agents are not commonplace even" 74 24783 264 16 serif 16
                      line 8 24801 384 20 base 14
                        span span 36 24805 7 13
                        span span 43 24805 35 13
                        span a 43 24805 35 13 link 588
                        span i 43 24805 35 13
                        span span 78 24805 7 13
                        span sup 36 24805 49 13
                        span a 253 24803 52 16 link 589
                        span a 313 24803 60 16 link 590
                        text "now" 8 24803 28 16 serif 16
                        text "[" 36 24805 7 13 serif 13
                        text "when?" 43 24805 35 13 serif 13 italic underline link 588
                        text "]" 78 24805 7 13 serif 13
                        text ", but some of the ideas of " 85 24803 168 16 serif 16
                        text "Web 2.0" 253 24803 52 16 serif 16 underline link 589
                        text ", " 305 24803 8 16 serif 16
                        text "mashups" 313 24803 60 16 serif 16 underline link 590
                      line 8 24821 384 20 base 14
                        span a 36 24823 176 16 link 591
                        text "and " 8 24823 28 16 serif 16
                        text "price comparison websites" 36 24823 176 16 serif 16 underline link 591
                        text " may be coming" 212 24823 104 16 serif 16
                      line 8 24841 384 20 base 14
                        span span 44 24845 7 13
                        span span 51 24845 81 13
                        span a 51 24845 81 13 link 592
                        span i 51 24845 81 13
                        span span 132 24845 6 13
                        span sup 44 24845 94 13
                        text "close" 8 24843 36 16 serif 16
                        text "[" 44 24845 7 13 serif 13
                        text "citation needed" 51 24845 81 13 serif 13 italic underline link 592
                        text "]" 132 24845 6 13 serif 13
                        text ". The main difference between these" 138 24843 236 16 serif 16
                      line 8 24861 384 20 base 14
                        text "web application hybrids and Berners-Lee's semantic" 8 24863 344 16 serif 16
                      line 8 24881 384 20 base 14
                        span a 252 24883 76 16 link 593
                        text "agents lies in the fact that the current " 8 24883 244 16 serif 16
                        text "aggregation" 252 24883 76 16 serif 16 underline link 593
                        text " and" 328 24883 28 16 serif 16
                      line 8 24901 384 20 base 14
                        span a 340 24903 28 16 link 594
                        text "hybridization of information is usually designed by " 8 24903 332 16 serif 16
                        text "web" 340 24903 28 16 serif 16 underline link 594
                      line 8 24921 384 20 base 14
                        span a 8 24923 72 16 link 594
                        text "developers" 8 24923 72 16 serif 16 underline link 594
                        text ", who already know the web locations and the" 80 24923 300 16 serif 16
                      line 8 24941 384 20 base 14
                        span a 8 24943 96 16 link 595
                        text "API semantics" 8 24943 96 16 serif 16 underline link 595
                        text " of the specific data they wish to mash," 104 24943 256 16 serif 16
                      line 8 24961 384 20 base 14
                        text "compare and combine." 8 24963 148 16 serif 16
                    block p 8 24997 384 180
                      line 8 24997 384 20 base 14
                        text "An important type of web agent that does crawl and read" 8 24999 364 16 serif 16
                      line 8 25017 384 20 base 14
                        text "web pages automatically, without prior knowledge of what" 8 25019 380 16 serif 16
                      line 8 25037 384 20 base 14
                        span a 132 25039 80 16 link 596
                        text "it might find, is the " 8 25039 124 16 serif 16
                        text "web crawler" 132 25039 80 16 serif 16 underline link 596
                        text " or search-engine spider." 212 25039 164 16 serif 16
                      line 8 25057 384 20 base 14
                        text "These software agents are dependent on the semantic" 8 25059 352 16 serif 16
                      line 8 25077 384 20 base 14
                        text "clarity of web pages they find as they use various" 8 25079 324 16 serif 16
                      line 8 25097 384 20 base 14
                        span a 112 25099 68 16 link 597
                        text "techniques and " 8 25099 104 16 serif 16
                        text "algorithms" 112 25099 68 16 serif 16 underline link 597
                        text " to read and index millions of" 180 25099 188 16 serif 16
                      line 8 25117 384 20 base 14
                        span a 308 25119 44 16 link 598
                        text "web pages a day and provide web users with " 8 25119 300 16 serif 16
                        text "search" 308 25119 44 16 serif 16 underline link 598
                      line 8 25137 384 20 base 14
                        span a 8 25139 56 16 link 598
                        text "facilities" 8 25139 56 16 serif 16 underline link 598
                        text " without which the World Wide Web's usefulness" 64 25139 316 16 serif 16
                      line 8 25157 384 20 base 14
                        text "would be greatly reduced." 8 25159 168 16 serif 16
                    block p 8 25193 384 140
                      line 8 25193 384 20 base 14
                        text "In order for search engine spiders to be able to rate the" 8 25195 356 16 serif 16
                      line 8 25213 384 20 base 14
                        text "significance of pieces of text they find in HTML documents," 8 25215 384 16 serif 16
                      line 8 25233 384 20 base 14
                        text "and also for those creating mashups and other hybrids as" 8 25235 372 16 serif 16
                      line 8 25253 384 20 base 14
                        text "well as for more automated agents as they are developed," 8 25255 376 16 serif 16
                      line 8 25273 384 20 base 14
                        text "the semantic structures that exist in HTML need to be" 8 25275 344 16 serif 16
                      line 8 25293 384 20 base 14
                        text "widely and uniformly applied to bring out the meaning of" 8 25295 364 16 serif 16
                      line 8 25313 384 20 base 14
                        span span 128 25317 7 13
                        span span 148 25317 6 13
                        span span 128 25317 26 13
                        span a 128 25317 26 13 link 599
                        span sup 128 25317 26 13
                        text "the published text." 8 25315 120 16 serif 16
                        text "[" 128 25317 7 13 serif 13 underline link 599
                        text "89" 135 25317 13 13 serif 13 underline link 599
                        text "]" 148 25317 6 13 serif 13 underline link 599
                    block p 8 25349 384 120
                      line 8 25349 384 20 base 14
                        span a 212 25351 72 16 link 600
                        text "Presentational markup tags are " 8 25351 204 16 serif 16
                        text "deprecated" 212 25351 72 16 serif 16 underline link 600
                        text " in current HTML" 284 25351 104 16 serif 16
                      line 8 25369 384 20 base 14
                        span a 36 25371 44 16 link 601
                        text "and " 8 25371 28 16 serif 16
                        text "XHTML" 36 25371 44 16 serif 16 underline link 601
                        text " recommendations. The majority of" 80 25371 224 16 serif 16
                      line 8 25389 384 20 base 14
                        text "presentational features from previous versions of HTML are" 8 25391 380 16 serif 16
                      line 8 25409 384 20 base 14
                        text "no longer allowed as they lead to poorer accessibility," 8 25411 352 16 serif 16
                      line 8 25429 384 20 base 14
                        text "higher cost of site maintenance, and larger document" 8 25431 344 16 serif 16
                      line 8 25449 384 20 base 14
                        span span 48 25453 7 13
                        span span 68 25453 6 13
                        span span 48 25453 26 13
                        span a 48 25453 26 13 link 602
                        span sup 48 25453 26 13
                        text "sizes." 8 25451 40 16 serif 16
                        text "[" 48 25453 7 13 serif 13 underline link 602
                        text "90" 55 25453 13 13 serif 13 underline link 602
                        text "]" 68 25453 6 13 serif 13 underline link 602
                    block p 8 25485 384 140
                      line 8 25485 384 20 base 14
                        span a 268 25487 84 16 link 603
                        text "Good semantic HTML also improves the " 8 25487 260 16 serif 16
                        text "accessibility" 268 25487 84 16 serif 16 underline link 603
                        text " of" 352 25487 16 16 serif 16
                      line 8 25505 384 20 base 14
                        span a 184 25507 168 16 link 604
                        text "web documents (see also " 8 25507 176 16 serif 16
                        text "Web Content Accessibility" 184 25507 168 16 serif 16 underline link 604
                      line 8 25525 384 20 base 14
                        span a 8 25527 68 16 link 604
                        text "Guidelines" 8 25527 68 16 serif 16 underline link 604
                        text "). For example, when a screen reader or audio" 76 25527 300 16 serif 16
                      line 8 25545 384 20 base 14
                        text "browser can correctly ascertain the structure of a" 8 25547 316 16 serif 16
                      line 8 25565 384 20 base 14
                        text "document, it will not waste the visually impaired user's" 8 25567 360 16 serif 16
                      line 8 25585 384 20 base 14
                        text "time by reading out repeated or irrelevant information when" 8 25587 380 16 serif 16
                      line 8 25605 384 20 base 14
                        text "it has been marked up correctly." 8 25607 208 16 serif 16
                  block section 8 25645 384 1535
                    block div 8 25645 384 30
                      block h2 8 25645 384 30
                        line 8 25645 384 30 base 21
                          text "Delivery" 8 25648 78 24 serif 24 bold
                    block p 8 25695 384 60
                      line 8 25695 384 20 base 14
                        text "HTML documents can be delivered by the same means as" 8 25697 376 16 serif 16
                      line 8 25715 384 20 base 14
                        text "any other computer file. However, they are most often" 8 25717 344 16 serif 16
                      line 8 25735 384 20 base 14
                        span a 132 25737 32 16 link 605
                        span a 212 25737 72 16 link 606
                        span a 324 25737 36 16 link 607
                        text "delivered either by " 8 25737 124 16 serif 16
                        text "HTTP" 132 25737 32 16 serif 16 underline link 605
                        text " from a " 164 25737 48 16 serif 16
                        text "web server" 212 25737 72 16 serif 16 underline link 606
                        text " or by " 284 25737 40 16 serif 16
                        text "email" 324 25737 36 16 serif 16 underline link 607
                        text "." 360 25737 4 16 serif 16
                    block section 8 25774 384 550
                      block div 8 25774 384 23
                        block h3 8 25774 384 23
                          line 8 25774 384 23 base 16
                            text "HTTP" 8 25776 38 19 serif 19 bold
                      block div 8 25816 384 20
                        line 8 25816 384 20 base 14
                          span a 92 25818 32 16 link 608
                          text "Main article: " 8 25818 84 16 serif 16
                          text "HTTP" 92 25818 32 16 serif 16 underline link 608
                      block p 8 25852 384 200
                        line 8 25852 384 20 base 14
                          span a 36 25854 104 16 link 609
                          text "The " 8 25854 28 16 serif 16
                          text "World Wide Web" 36 25854 104 16 serif 16 underline link 609
                          text " is composed primarily of HTML" 140 25854 204 16 serif 16
                        line 8 25872 384 20 base 14
                          text "documents transmitted from web servers to web browsers" 8 25874 376 16 serif 16
                        line 8 25892 384 20 base 14
                          span a 72 25894 172 16 link 610
                          text "using the " 8 25894 64 16 serif 16
                          text "Hypertext Transfer Protocol" 72 25894 172 16 serif 16 underline link 610
                          text " (HTTP). However," 244 25894 120 16 serif 16
                        line 8 25912 384 20 base 14
                          text "HTTP is used to serve images, sound, and other content, in" 8 25914 380 16 serif 16
                        line 8 25932 384 20 base 14
                          text "addition to HTML. To allow the web browser to know how" 8 25934 372 16 serif 16
                        line 8 25952 384 20 base 14
                          text "to handle each document it receives, other information is" 8 25954 368 16 serif 16
                        line 8 25972 384 20 base 14
                          span a 284 25974 64 16 link 611
                          text "transmitted along with the document. This " 8 25974 276 16 serif 16
                          text "meta data" 284 25974 64 16 serif 16 underline link 611
                        line 8 25992 384 20 base 14
                          span a 144 25994 72 16 link 612
                          span kbd 260 25994 72 16
                          text "usually includes the " 8 25994 136 16 serif 16
                          text "MIME type" 144 25994 72 16 serif 16 underline link 612
                          text " (e.g., " 216 25994 44 16 serif 16
                          text "text/html" 260 25994 72 16 mono 16
                          text " or" 332 25994 16 16 serif 16
                        line 8 26012 384 20 base 14
                          span kbd 8 26014 168 16
                          text "application/xhtml+xml" 8 26014 168 16 mono 16
                          text ") and the character encoding" 176 26014 188 16 serif 16
                        line 8 26032 384 20 base 14
                          span a 44 26034 188 16 link 613
                          text "(see " 8 26034 36 16 serif 16
                          text "Character encodings in HTML" 44 26034 188 16 serif 16 underline link 613
                          text ")." 232 26034 12 16 serif 16
                      block p 8 26068 384 140
                        line 8 26068 384 20 base 14
                          text "In modern browsers, the MIME type that is sent with the" 8 26070 368 16 serif 16
                        line 8 26088 384 20 base 14
                          text "HTML document may affect how the document is initially" 8 26090 368 16 serif 16
                        line 8 26108 384 20 base 14
                          text "interpreted. A document sent with the XHTML MIME type is" 8 26110 380 16 serif 16
                        line 8 26128 384 20 base 14
                          span a 108 26130 80 16 link 614
                          text "expected to be " 8 26130 100 16 serif 16
                          text "well-formed" 108 26130 80 16 serif 16 underline link 614
                          text " XML; syntax errors may cause" 188 26130 200 16 serif 16
                        line 8 26148 384 20 base 14
                          text "the browser to fail to render it. The same document sent" 8 26150 360 16 serif 16
                        line 8 26168 384 20 base 14
                          text "with the HTML MIME type might be displayed successfully" 8 26170 384 16 serif 16
                        line 8 26188 384 20 base 14
                          text "since some browsers are more lenient with HTML." 8 26190 324 16 serif 16
                      block p 8 26224 384 100
                        line 8 26224 384 20 base 14
                          text "The W3C recommendations state that XHTML 1.0 documents" 8 26226 384 16 serif 16
                        line 8 26244 384 20 base 14
                          text "that follow guidelines set forth in the recommendation's" 8 26246 360 16 serif 16
                        line 8 26264 384 20 base 14
                          span span 340 26268 7 13
                          span span 356 26268 7 13
                          span span 340 26268 23 13
                          span a 340 26268 23 13 link 615
                          span sup 340 26268 23 13
                          text "Appendix C may be labeled with either MIME Type." 8 26266 332 16 serif 16
                          text "[" 340 26268 7 13 serif 13 underline link 615
                          text "91" 347 26268 9 13 serif 13 underline link 615
                          text "]" 356 26268 7 13 serif 13 underline link 615
                        line 8 26284 384 20 base 14
                          span span 360 26288 7 13
                          span span 380 26288 6 13
                          span span 360 26288 26 13
                          span a 360 26288 26 13 link 616
                          span sup 360 26288 26 13
                          text "XHTML 1.1 also states that XHTML 1.1 documents should" 8 26286 352 16 serif 16
                          text "[" 360 26288 7 13 serif 13 underline link 616
                          text "92" 367 26288 13 13 serif 13 underline link 616
                          text "]" 380 26288 6 13 serif 13 underline link 616
                        line 8 26304 384 20 base 14
                          span span 228 26308 7 13
                          span span 248 26308 6 13
                          span span 228 26308 26 13
                          span a 228 26308 26 13 link 617
                          span sup 228 26308 26 13
                          text "be labeled with either MIME type." 8 26306 220 16 serif 16
                          text "[" 228 26308 7 13 serif 13 underline link 617
                          text "93" 235 26308 13 13 serif 13 underline link 617
                          text "]" 248 26308 6 13 serif 13 underline link 617
                    block section 8 26343 384 338
                      block div 8 26343 384 24
                        block h3 8 26343 384 24
                          line 8 26343 384 24 base 16
                            text "HTML e-mail" 8 26345 100 19 serif 19 bold
                      block div 8 26385 384 20
                        line 8 26385 384 20 base 14
                          span a 92 26387 76 16 link 618
                          text "Main article: " 8 26387 84 16 serif 16
                          text "HTML email" 92 26387 76 16 serif 16 underline link 618
                      block p 8 26421 384 260
                        line 8 26421 384 20 base 14
                          text "Most graphical email clients allow the use of a subset of" 8 26423 368 16 serif 16
                        line 8 26441 384 20 base 14
                          text "HTML (often ill-defined) to provide formatting and" 8 26443 324 16 serif 16
                        line 8 26461 384 20 base 14
                          span a 8 26463 60 16 link 619
                          span a 244 26463 60 16 link 620
                          text "semantic" 8 26463 60 16 serif 16 underline link 619
                          text " markup not available with " 68 26463 176 16 serif 16
                          text "plain text" 244 26463 60 16 serif 16 underline link 620
                          text ". This may" 304 26463 68 16 serif 16
                        line 8 26481 384 20 base 14
                          text "include typographic information like colored headings," 8 26483 352 16 serif 16
                        line 8 26501 384 20 base 14
                          text "emphasized and quoted text, inline images and diagrams." 8 26503 376 16 serif 16
                        line 8 26521 384 20 base 14
                          span a 228 26523 24 16 link 621
                          text "Many such clients include both a " 8 26523 220 16 serif 16
                          text "GUI" 228 26523 24 16 serif 16 underline link 621
                          text " editor for composing" 252 26523 136 16 serif 16
                        line 8 26541 384 20 base 14
                          text "HTML e-mail messages and a rendering engine for" 8 26543 328 16 serif 16
                        line 8 26561 384 20 base 14
                          text "displaying them. Use of HTML in e-mail is criticized by" 8 26563 356 16 serif 16
                        line 8 26581 384 20 base 14
                          text "some because of compatibility issues, because it can help" 8 26583 384 16 serif 16
                        line 8 26601 384 20 base 14
                          span a 68 26603 56 16 link 622
                          text "disguise " 8 26603 60 16 serif 16
                          text "phishing" 68 26603 56 16 serif 16 underline link 622
                          text " attacks, because of accessibility issues" 124 26603 268 16 serif 16
                        line 8 26621 384 20 base 14
                          text "for blind or visually impaired people, because it can" 8 26623 336 16 serif 16
                        line 8 26641 384 20 base 14
                          span a 64 26643 36 16 link 623
                          text "confuse " 8 26643 56 16 serif 16
                          text "spam" 64 26643 36 16 serif 16 underline link 623
                          text " filters and because the message size is" 100 26643 264 16 serif 16
                        line 8 26661 384 20 base 14
                          text "larger than plain text." 8 26663 136 16 serif 16
                    block section 8 26700 384 123
                      block div 8 26700 384 24
                        block h3 8 26700 384 24
                          line 8 26700 384 24 base 17
                            text "Naming conventions" 8 26702 157 19 serif 19 bold
                      block p 8 26743 384 80
                        line 8 26743 384 20 base 14
                          span a 132 26745 124 16 link 624
                          span a 280 26745 28 16 link 625
                          text "The most common " 8 26745 124 16 serif 16
                          text "filename extension" 132 26745 124 16 serif 16 underline link 624
                          text " for " 256 26745 24 16 serif 16
                          text "files" 280 26745 28 16 serif 16 underline link 625
                          text " containing" 308 26745 72 16 serif 16
                        line 8 26763 384 20 base 14
                          span kbd 64 26765 40 16
                          span kbd 328 26765 32 16
                          text "HTML is " 8 26765 56 16 serif 16
                          text ".html" 64 26765 40 16 mono 16
                          text ". A common abbreviation of this is " 104 26765 224 16 serif 16
                          text ".htm" 328 26765 32 16 mono 16
                          text "," 360 26765 4 16 serif 16
                        line 8 26783 384 20 base 14
                          text "which originated because some operating systems limit" 8 26785 364 16 serif 16
                        line 8 26803 384 20 base 14
                          span a 124 26805 76 16 link 626
                          span span 204 26807 7 13
                          span span 224 26807 6 13
                          span span 204 26807 26 13
                          span a 204 26807 26 13 link 627
                          span sup 204 26807 26 13
                          text "file extensions to " 8 26805 116 16 serif 16
                          text "three letters" 124 26805 76 16 serif 16 underline link 626
                          text "." 200 26805 4 16 serif 16
                          text "[" 204 26807 7 13 serif 13 underline link 627
                          text "94" 211 26807 13 13 serif 13 underline link 627
                          text "]" 224 26807 6 13 serif 13 underline link 627
                    block section 8 26841 384 339
                      block div 8 26841 384 24
                        block h3 8 26841 384 24
                          line 8 26841 384 24 base 17
                            text "HTML Application" 8 26844 133 19 serif 19 bold
                      block div 8 26884 384 20
                        line 8 26884 384 20 base 14
                          span a 92 26886 112 16 link 628
                          text "Main article: " 8 26886 84 16 serif 16
                          text "HTML Application" 92 26886 112 16 serif 16 underline link 628
                      block p 8 26920 384 260
                        line 8 26920 384 20 base 14
                          span kbd 276 26922 32 16
                          text "An HTML Application (HTA; file extension " 8 26922 268 16 serif 16
                          text ".hta" 276 26922 32 16 mono 16
                          text ") is a" 308 26922 36 16 serif 16
                        line 8 26940 384 20 base 14
                          span a 8 26942 124 16 link 629
                          text "Microsoft Windows" 8 26942 124 16 serif 16 underline link 629
                          text " application that uses HTML and" 132 26942 208 16 serif 16
                        line 8 26960 384 20 base 14
                          span a 136 26962 52 16 link 630
                          text "Dynamic HTML in a " 8 26962 128 16 serif 16
                          text "browser" 136 26962 52 16 serif 16 underline link 630
                          text " to provide the application's" 188 26962 180 16 serif 16
                        line 8 26980 384 20 base 14
                          text "graphical interface. A regular HTML file is confined to the" 8 26982 364 16 serif 16
                        line 8 27000 384 20 base 14
                          span a 148 27002 152 16 link 631
                          text "security model of the " 8 27002 140 16 serif 16
                          text "web browser's security" 148 27002 152 16 serif 16 underline link 631
                          text "," 300 27002 4 16 serif 16
                        line 8 27020 384 20 base 14
                          text "communicating only to web servers and manipulating only" 8 27022 380 16 serif 16
                        line 8 27040 384 20 base 14
                          span a 156 27042 80 16 link 632
                          text "web page objects and " 8 27042 148 16 serif 16
                          text "site cookies" 156 27042 80 16 serif 16 underline link 632
                          text ". An HTA runs as a fully" 236 27042 148 16 serif 16
                        line 8 27060 384 20 base 14
                          text "trusted application and therefore has more privileges, like" 8 27062 372 16 serif 16
                        line 8 27080 384 20 base 14
                          span a 252 27082 116 16 link 633
                          text "creation/editing/removal of files and " 8 27082 244 16 serif 16
                          text "Windows Registry" 252 27082 116 16 serif 16 underline link 633
                        line 8 27100 384 20 base 14
                          text "entries. Because they operate outside the browser's" 8 27102 336 16 serif 16
                        line 8 27120 384 20 base 14
                          text "security model, HTAs cannot be executed via HTTP, but" 8 27122 356 16 serif 16
                        line 8 27140 384 20 base 14
                          span a 232 27142 24 16 link 634
                          text "must be downloaded (just like an " 8 27142 224 16 serif 16
                          text "EXE" 232 27142 24 16 serif 16 underline link 634
                          text " file) and executed" 256 27142 124 16 serif 16
                        line 8 27160 384 20 base 14
                          text "from local file system." 8 27162 144 16 serif 16
                  block section 8 27200 384 5158
                    block div 8 27200 384 30
                      block h2 8 27200 384 30
                        line 8 27200 384 30 base 21
                          text "HTML4 variations" 8 27203 168 24 serif 24 bold
                    block p 8 27250 384 320
                      line 8 27250 384 20 base 14
                        text "Since its inception, HTML and its associated protocols" 8 27252 352 16 serif 16
                      line 8 27270 384 20 base 14
                        text "gained acceptance relatively quickly. However, no clear" 8 27272 364 16 serif 16
                      line 8 27290 384 20 base 14
                        text "standards existed in the early years of the language." 8 27292 340 16 serif 16
                      line 8 27310 384 20 base 14
                        text "Though its creators originally conceived of HTML as a" 8 27312 348 16 serif 16
                      line 8 27330 384 20 base 14
                        span span 332 27334 7 13
                        span span 352 27334 6 13
                        span span 332 27334 26 13
                        span a 332 27334 26 13 link 635
                        span sup 332 27334 26 13
                        text "semantic language devoid of presentation details," 8 27332 324 16 serif 16
                        text "[" 332 27334 7 13 serif 13 underline link 635
                        text "95" 339 27334 13 13 serif 13 underline link 635
                        text "]" 352 27334 6 13 serif 13 underline link 635
                      line 8 27350 384 20 base 14
                        text "practical uses pushed many presentational elements and" 8 27352 372 16 serif 16
                      line 8 27370 384 20 base 14
                        text "attributes into the language, driven largely by the various" 8 27372 368 16 serif 16
                      line 8 27390 384 20 base 14
                        text "browser vendors. The latest standards surrounding HTML" 8 27392 368 16 serif 16
                      line 8 27410 384 20 base 14
                        text "reflect efforts to overcome the sometimes chaotic" 8 27412 320 16 serif 16
                      line 8 27430 384 20 base 14
                        span span 196 27434 7 13
                        span span 216 27434 6 13
                        span span 196 27434 26 13
                        span a 196 27434 26 13 link 636
                        span sup 196 27434 26 13
                        text "development of the language" 8 27432 188 16 serif 16
                        text "[" 196 27434 7 13 serif 13 underline link 636
                        text "96" 203 27434 13 13 serif 13 underline link 636
                        text "]" 216 27434 6 13 serif 13 underline link 636
                        text " and to create a rational" 222 27432 152 16 serif 16
                      line 8 27450 384 20 base 14
                        text "foundation for building both meaningful and well-presented" 8 27452 384 16 serif 16
                      line 8 27470 384 20 base 14
                        text "documents. To return HTML to its role as a semantic" 8 27472 336 16 serif 16
                      line 8 27490 384 20 base 14
                        span a 100 27492 28 16 link 637
                        text "language, the " 8 27492 92 16 serif 16
                        text "W3C" 100 27492 28 16 serif 16 underline link 637
                        text " has developed style languages such as" 128 27492 264 16 serif 16
                      line 8 27510 384 20 base 14
                        span a 8 27512 24 16 link 638
                        span a 64 27512 24 16 link 639
                        text "CSS" 8 27512 24 16 serif 16 underline link 638
                        text " and " 32 27512 32 16 serif 16
                        text "XSL" 64 27512 24 16 serif 16 underline link 639
                        text " to shoulder the burden of presentation. In" 88 27512 272 16 serif 16
                      line 8 27530 384 20 base 14
                        text "conjunction, the HTML specification has slowly reined in" 8 27532 368 16 serif 16
                      line 8 27550 384 20 base 14
                        text "the presentational elements." 8 27552 184 16 serif 16
                    block p 8 27586 384 100
                      line 8 27586 384 20 base 14
                        text "There are two axes differentiating various variations of" 8 27588 352 16 serif 16
                      line 8 27606 384 20 base 14
                        text "HTML as currently specified: SGML-based HTML versus" 8 27608 360 16 serif 16
                      line 8 27626 384 20 base 14
                        text "XML-based HTML (referred to as XHTML) on one axis, and" 8 27628 380 16 serif 16
                      line 8 27646 384 20 base 14
                        text "strict versus transitional (loose) versus frameset on the" 8 27648 364 16 serif 16
                      line 8 27666 384 20 base 14
                        text "other axis." 8 27668 68 16 serif 16
                    block section 8 27704 384 1947
                      block div 8 27704 384 24
                        block h3 8 27704 384 24
                          line 8 27704 384 24 base 17
                            text "SGML-based versus XML-based HTML" 8 27707 299 19 serif 19 bold
                      block p 8 27747 384 260
                        line 8 27747 384 20 base 14
                          span span 180 27751 7 13
                          span span 187 27751 35 13
                          span a 187 27751 35 13 link 640
                          span i 187 27751 35 13
                          span span 222 27751 7 13
                          span sup 180 27751 49 13
                          text "One difference in the latest" 8 27749 172 16 serif 16
                          text "[" 180 27751 7 13 serif 13
                          text "when?" 187 27751 35 13 serif 13 italic underline link 640
                          text "]" 222 27751 7 13 serif 13
                          text " HTML specifications" 229 27749 136 16 serif 16
                        line 8 27767 384 20 base 14
                          text "lies in the distinction between the SGML-based" 8 27769 308 16 serif 16
                        line 8 27787 384 20 base 14
                          text "specification and the XML-based specification. The" 8 27789 336 16 serif 16
                        line 8 27807 384 20 base 14
                          span a 288 27809 44 16 link 641
                          text "XML-based specification is usually called " 8 27809 280 16 serif 16
                          text "XHTML" 288 27809 44 16 serif 16 underline link 641
                          text " to" 332 27809 16 16 serif 16
                        line 8 27827 384 20 base 14
                          text "distinguish it clearly from the more traditional definition." 8 27829 360 16 serif 16
                        line 8 27847 384 20 base 14
                          text "However, the root element name continues to be \"html\"" 8 27849 360 16 serif 16
                        line 8 27867 384 20 base 14
                          text "even in the XHTML-specified HTML. The W3C intended" 8 27869 352 16 serif 16
                        line 8 27887 384 20 base 14
                          text "XHTML 1.0 to be identical to HTML 4.01 except where" 8 27889 336 16 serif 16
                        line 8 27907 384 20 base 14
                          text "limitations of XML over the more complex SGML require" 8 27909 356 16 serif 16
                        line 8 27927 384 20 base 14
                          text "workarounds. Because XHTML and HTML are closely" 8 27929 340 16 serif 16
                        line 8 27947 384 20 base 14
                          text "related, they are sometimes documented in parallel. In" 8 27949 356 16 serif 16
                        line 8 27967 384 20 base 14
                          span a 240 27969 152 16 link 642
                          text "such circumstances, some authors " 8 27969 232 16 serif 16
                          text "conflate the two names" 240 27969 152 16 serif 16 underline link 642
                        line 8 27987 384 20 base 14
                          text "as (X)HTML or X(HTML)." 8 27989 164 16 serif 16
                      block p 8 28023 384 40
                        line 8 28023 384 20 base 14
                          text "Like HTML 4.01, XHTML 1.0 has three sub-specifications:" 8 28025 364 16 serif 16
                        line 8 28043 384 20 base 14
                          text "strict, transitional, and frameset." 8 28045 208 16 serif 16
                      block p 8 28079 384 320
                        line 8 28079 384 20 base 14
                          text "Aside from the different opening declarations for a" 8 28081 320 16 serif 16
                        line 8 28099 384 20 base 14
                          text "document, the differences between an HTML 4.01 and" 8 28101 344 16 serif 16
                        line 8 28119 384 20 base 14
                          text "XHTML 1.0 document—in each of the corresponding" 8 28121 324 16 serif 16
                        line 8 28139 384 20 base 14
                          text "DTDs—are largely syntactic. The underlying syntax of HTML" 8 28141 380 16 serif 16
                        line 8 28159 384 20 base 14
                          text "allows many shortcuts that XHTML does not, such as" 8 28161 344 16 serif 16
                        line 8 28179 384 20 base 14
                          text "elements with optional opening or closing tags, and even" 8 28181 372 16 serif 16
                        line 8 28199 384 20 base 14
                          text "empty elements which must not have an end tag. By" 8 28201 340 16 serif 16
                        line 8 28219 384 20 base 14
                          text "contrast, XHTML requires all elements to have an opening" 8 28221 372 16 serif 16
                        line 8 28239 384 20 base 14
                          text "tag and a closing tag. XHTML, however, also introduces a" 8 28241 372 16 serif 16
                        line 8 28259 384 20 base 14
                          text "new shortcut: an XHTML tag may be opened and closed" 8 28261 360 16 serif 16
                        line 8 28279 384 20 base 14
                          text "within the same tag, by including a slash before the end of" 8 28281 380 16 serif 16
                        line 8 28299 384 20 base 14
                          span span 116 28301 8 16
                          span span 124 28301 16 16
                          span span 140 28301 16 16
                          span code 116 28301 40 16
                          text "the tag like this: " 8 28301 108 16 serif 16
                          text "<" 116 28301 8 16 mono 16
                          text "br" 124 28301 16 16 mono 16
                          text "/>" 140 28301 16 16 mono 16
                          text ". The introduction of this shorthand," 156 28301 228 16 serif 16
                        line 8 28319 384 20 base 14
                          text "which is not used in the SGML declaration for HTML 4.01," 8 28321 364 16 serif 16
                        line 8 28339 384 20 base 14
                          text "may confuse earlier software unfamiliar with this new" 8 28341 348 16 serif 16
                        line 8 28359 384 20 base 14
                          text "convention. A fix for this is remove the slash preceding the" 8 28361 380 16 serif 16
                        line 8 28379 384 20 base 14
                          span span 216 28381 8 16
                          span span 224 28381 16 16
                          span span 240 28381 8 16
                          span code 216 28381 32 16
                          span span 252 28383 7 13
                          span span 272 28383 6 13
                          span span 252 28383 26 13
                          span a 252 28383 26 13 link 643
                          span sup 252 28383 26 13
                          text "closing angle bracket, as such: " 8 28381 208 16 serif 16
                          text "<" 216 28381 8 16 mono 16
                          text "br" 224 28381 16 16 mono 16
                          text ">" 240 28381 8 16 mono 16
                          text "." 248 28381 4 16 serif 16
                          text "[" 252 28383 7 13 serif 13 underline link 643
                          text "97" 259 28383 13 13 serif 13 underline link 643
                          text "]" 272 28383 6 13 serif 13 underline link 643
                      block p 8 28415 384 100
                        line 8 28415 384 20 base 14
                          text "To understand the subtle differences between HTML and" 8 28417 364 16 serif 16
                        line 8 28435 384 20 base 14
                          text "XHTML, consider the transformation of a valid and" 8 28437 320 16 serif 16
                        line 8 28455 384 20 base 14
                          text "well-formed XHTML 1.0 document that adheres to Appendix" 8 28457 380 16 serif 16
                        line 8 28475 384 20 base 14
                          text "C (see below) into a valid HTML 4.01 document. Making" 8 28477 364 16 serif 16
                        line 8 28495 384 20 base 14
                          text "this translation requires the following steps:" 8 28497 284 16 serif 16
                      block ol 8 28531 384 340
                        block li 48 28531 344 80
                          line 48 28531 344 20 base 14
                            span code 360 28533 32 16
                            text "The language for an element is specified with a " 48 28533 312 16 serif 16
                            text "lang" 360 28533 32 16 mono 16
                          line 48 28551 344 20 base 14
                            span code 248 28553 64 16
                            text "attribute rather than the XHTML " 48 28553 200 16 serif 16
                            text "xml:lang" 248 28553 64 16 mono 16
                            text " attribute." 312 28553 60 16 serif 16
                          line 48 28571 344 20 base 14
                            text "XHTML uses XML's built-in language-defining" 48 28573 300 16 serif 16
                          line 48 28591 344 20 base 14
                            text "functionality attribute." 48 28593 140 16 serif 16
                          marker "1. " 36 28533 12 16
                        block li 48 28611 344 40
                          line 48 28611 344 20 base 14
                            span code 248 28613 72 16
                            text "Remove the XML namespace (" 48 28613 200 16 serif 16
                            text "xmlns=URI" 248 28613 72 16 mono 16
                            text "). HTML" 320 28613 52 16 serif 16
                          line 48 28631 344 20 base 14
                            text "has no facilities for namespaces." 48 28633 216 16 serif 16
                          marker "2. " 32 28613 16 16
                        block li 48 28651 344 40
                          line 48 28651 344 20 base 14
                            text "Change the document type declaration from XHTML" 48 28653 328 16 serif 16
                          line 48 28671 344 20 base 14
                            text "1.0 to HTML 4.01." 48 28673 104 16 serif 16
                          marker "3. " 32 28653 16 16
                        block li 48 28691 344 60
                          line 48 28691 344 20 base 14
                            text "If present, remove the XML declaration. Typically" 48 28693 320 16 serif 16
                          line 48 28711 344 20 base 14
                            span code 96 28713 152 16
                            span span 96 28713 152 16
                            text "this is: " 48 28713 48 16 serif 16
                            text "<?xml version=\"1.0\"" 96 28713 152 16 mono 16
                          line 48 28731 344 20 base 14
                            span span 48 28733 144 16
                            span code 48 28733 144 16
                            text "encoding=\"utf-8\"?>" 48 28733 144 16 mono 16
                            text "." 192 28733 4 16 serif 16
                          marker "4. " 32 28693 16 16
                        block li 48 28751 344 80
                          line 48 28751 344 20 base 14
                            text "Ensure that the document's MIME type is set to" 48 28753 308 16 serif 16
                          line 48 28771 344 20 base 14
                            span code 48 28773 72 16
                            text "text/html" 48 28773 72 16 mono 16
                            text ". For both HTML and XHTML, this comes" 120 28773 256 16 serif 16
                          line 48 28791 344 20 base 14
                            span code 140 28793 96 16
                            text "from the HTTP " 48 28793 92 16 serif 16
                            text "Content-Type" 140 28793 96 16 mono 16
                            text " header sent by the" 236 28793 124 16 serif 16
                          line 48 28811 344 20 base 14
                            text "server." 48 28813 44 16 serif 16
                          marker "5. " 32 28753 16 16
                        block li 48 28831 344 40
                          line 48 28831 344 20 base 14
                            text "Change the XML empty-element syntax to an HTML" 48 28833 332 16 serif 16
                          line 48 28851 344 20 base 14
                            span span 192 28853 8 16
                            span span 200 28853 16 16
                            span span 216 28853 16 16
                            span code 192 28853 40 16
                            span span 252 28853 8 16
                            span span 260 28853 16 16
                            span span 276 28853 8 16
                            span code 252 28853 32 16
                            text "style empty element (" 48 28853 144 16 serif 16
                            text "<" 192 28853 8 16 mono 16
                            text "br" 200 28853 16 16 mono 16
                            text "/>" 216 28853 16 16 mono 16
                            text " to " 232 28853 20 16 serif 16
                            text "<" 252 28853 8 16 mono 16
                            text "br" 260 28853 16 16 mono 16
                            text ">" 276 28853 8 16 mono 16
                            text ")." 284 28853 12 16 serif 16
                          marker "6. " 32 28833 16 16
                      block p 8 28887 384 140
                        line 8 28887 384 20 base 14
                          text "Those are the main changes necessary to translate a" 8 28889 344 16 serif 16
                        line 8 28907 384 20 base 14
                          text "document from XHTML 1.0 to HTML 4.01. To translate from" 8 28909 364 16 serif 16
                        line 8 28927 384 20 base 14
                          text "HTML to XHTML would also require the addition of any" 8 28929 348 16 serif 16
                        line 8 28947 384 20 base 14
                          text "omitted opening or closing tags. Whether coding in HTML or" 8 28949 384 16 serif 16
                        line 8 28967 384 20 base 14
                          text "XHTML it may just be best to always include the optional" 8 28969 368 16 serif 16
                        line 8 28987 384 20 base 14
                          text "tags within an HTML document rather than remembering" 8 28989 360 16 serif 16
                        line 8 29007 384 20 base 14
                          text "which tags can be omitted." 8 29009 176 16 serif 16
                      block p 8 29043 384 80
                        line 8 29043 384 20 base 14
                          text "A well-formed XHTML document adheres to all the syntax" 8 29045 372 16 serif 16
                        line 8 29063 384 20 base 14
                          text "requirements of XML. A valid document adheres to the" 8 29065 348 16 serif 16
                        line 8 29083 384 20 base 14
                          text "content specification for XHTML, which describes the" 8 29085 344 16 serif 16
                        line 8 29103 384 20 base 14
                          text "document structure." 8 29105 128 16 serif 16
                      block p 8 29139 384 80
                        line 8 29139 384 20 base 14
                          text "The W3C recommends several conventions to ensure an" 8 29141 364 16 serif 16
                        line 8 29159 384 20 base 14
                          span span 284 29163 7 13
                          span span 304 29163 6 13
                          span span 284 29163 26 13
                          span a 284 29163 26 13 link 644
                          span sup 284 29163 26 13
                          text "easy migration between HTML and XHTML." 8 29161 276 16 serif 16
                          text "[" 284 29163 7 13 serif 13 underline link 644
                          text "98" 291 29163 13 13 serif 13 underline link 644
                          text "]" 304 29163 6 13 serif 13 underline link 644
                          text " The" 310 29161 28 16 serif 16
                        line 8 29179 384 20 base 14
                          text "following steps can be applied to XHTML 1.0 documents" 8 29181 360 16 serif 16
                        line 8 29199 384 20 base 14
                          text "only:" 8 29201 32 16 serif 16
                      block ul 8 29235 384 200
                        block li 48 29235 344 40
                          line 48 29235 344 20 base 14
                            span code 136 29237 64 16
                            span code 232 29237 32 16
                            text "Include both " 48 29237 88 16 serif 16
                            text "xml:lang" 136 29237 64 16 mono 16
                            text " and " 200 29237 32 16 serif 16
                            text "lang" 232 29237 32 16 mono 16
                            text " attributes on any" 264 29237 112 16 serif 16
                          line 48 29255 344 20 base 14
                            text "elements assigning language." 48 29257 196 16 serif 16
                          marker "• " 36 29237 12 16
                        block li 48 29275 344 40
                          line 48 29275 344 20 base 14
                            text "Use the empty-element syntax only for elements" 48 29277 316 16 serif 16
                          line 48 29295 344 20 base 14
                            text "specified as empty in HTML." 48 29297 184 16 serif 16
                          marker "• " 36 29277 12 16
                        block li 48 29315 344 40
                          line 48 29315 344 20 base 14
                            text "Remove the closing slash in empty-element tags: for" 48 29317 344 16 serif 16
                          line 48 29335 344 20 base 14
                            span span 108 29337 8 16
                            span span 116 29337 16 16
                            span span 132 29337 8 16
                            span code 108 29337 32 16
                            span span 212 29337 8 16
                            span span 220 29337 16 16
                            span span 236 29337 16 16
                            span code 212 29337 40 16
                            text "example " 48 29337 60 16 serif 16
                            text "<" 108 29337 8 16 mono 16
                            text "br" 116 29337 16 16 mono 16
                            text ">" 132 29337 8 16 mono 16
                            text " instead of " 140 29337 72 16 serif 16
                            text "<" 212 29337 8 16 mono 16
                            text "br" 220 29337 16 16 mono 16
                            text "/>" 236 29337 16 16 mono 16
                            text "." 252 29337 4 16 serif 16
                          marker "• " 36 29317 12 16
                        block li 48 29355 344 60
                          line 48 29355 344 20 base 14
                            text "Include explicit close tags for elements that permit" 48 29357 332 16 serif 16
                          line 48 29375 344 20 base 14
                            span code 308 29377 0 16
                            span span 340 29377 8 16
                            span span 348 29377 24 16
                            span code 340 29377 32 16
                            text "content but are left empty (for example, " 48 29377 260 16 serif 16
                            text ", not " 308 29377 32 16 serif 16
                            text "<" 340 29377 8 16 mono 16
                            text "div" 348 29377 24 16 mono 16
                          line 48 29395 344 20 base 14
                            span span 48 29397 16 16
                            span code 48 29397 16 16
                            text "/>" 48 29397 16 16 mono 16
                            text ")." 64 29397 12 16 serif 16
                          marker "• " 36 29357 12 16
                        block li 48 29415 344 20
                          line 48 29415 344 20 base 14
                            text "Omit the XML declaration." 48 29417 164 16 serif 16
                          marker "• " 36 29417 12 16
                      block p 8 29451 384 200
                        line 8 29451 384 20 base 14
                          text "By carefully following the W3C's compatibility guidelines, a" 8 29453 384 16 serif 16
                        line 8 29471 384 20 base 14
                          text "user agent should be able to interpret the document equally" 8 29473 384 16 serif 16
                        line 8 29491 384 20 base 14
                          text "as HTML or XHTML. For documents that are XHTML 1.0 and" 8 29493 372 16 serif 16
                        line 8 29511 384 20 base 14
                          text "have been made compatible in this way, the W3C permits" 8 29513 372 16 serif 16
                        line 8 29531 384 20 base 14
                          span code 280 29533 72 16
                          text "them to be served either as HTML (with a " 8 29533 272 16 serif 16
                          text "text/html" 280 29533 72 16 mono 16
                        line 8 29551 384 20 base 14
                          span a 8 29553 72 16 link 645
                          text "MIME type" 8 29553 72 16 serif 16 underline link 645
                          text "), or as XHTML (with an" 80 29553 156 16 serif 16
                        line 8 29571 384 20 base 14
                          span code 8 29573 168 16
                          span code 196 29573 120 16
                          text "application/xhtml+xml" 8 29573 168 16 mono 16
                          text " or " 176 29573 20 16 serif 16
                          text "application/xml" 196 29573 120 16 mono 16
                          text " MIME" 316 29573 44 16 serif 16
                        line 8 29591 384 20 base 14
                          text "type). When delivered as XHTML, browsers should use an" 8 29593 376 16 serif 16
                        line 8 29611 384 20 base 14
                          text "XML parser, which adheres strictly to the XML" 8 29613 296 16 serif 16
                        line 8 29631 384 20 base 14
                          text "specifications for parsing the document's contents." 8 29633 332 16 serif 16
                    block section 8 29669 384 1871
                      block div 8 29669 384 24
                        block h3 8 29669 384 24
                          line 8 29669 384 24 base 17
                            text "Transitional versus strict" 8 29672 190 19 serif 19 bold
                      block p 8 29712 384 280
                        line 8 29712 384 20 base 14
                          text "HTML 4 defined three different versions of the language:" 8 29714 360 16 serif 16
                        line 8 29732 384 20 base 14
                          text "Strict, Transitional (once called Loose), and Frameset. The" 8 29734 384 16 serif 16
                        line 8 29752 384 20 base 14
                          text "Strict version is intended for new documents and is" 8 29754 332 16 serif 16
                        line 8 29772 384 20 base 14
                          text "considered best practice, while the Transitional and" 8 29774 336 16 serif 16
                        line 8 29792 384 20 base 14
                          text "Frameset versions were developed to make it easier to" 8 29794 356 16 serif 16
                        line 8 29812 384 20 base 14
                          text "transition documents that conformed to older HTML" 8 29814 328 16 serif 16
                        line 8 29832 384 20 base 14
                          text "specifications or did not conform to any specification to a" 8 29834 372 16 serif 16
                        line 8 29852 384 20 base 14
                          text "version of HTML 4. The Transitional and Frameset versions" 8 29854 380 16 serif 16
                        line 8 29872 384 20 base 14
                          text "allow for presentational markup, which is omitted in the" 8 29874 360 16 serif 16
                        line 8 29892 384 20 base 14
                          span a 160 29894 152 16 link 646
                          text "Strict version. Instead, " 8 29894 152 16 serif 16
                          text "cascading style sheets" 160 29894 152 16 serif 16 underline link 646
                          text " are" 312 29894 24 16 serif 16
                        line 8 29912 384 20 base 14
                          text "encouraged to improve the presentation of HTML" 8 29914 312 16 serif 16
                        line 8 29932 384 20 base 14
                          text "documents. Because XHTML 1 only defines an XML syntax" 8 29934 376 16 serif 16
                        line 8 29952 384 20 base 14
                          text "for the language defined by HTML 4, the same differences" 8 29954 372 16 serif 16
                        line 8 29972 384 20 base 14
                          text "apply to XHTML 1 as well." 8 29974 164 16 serif 16
