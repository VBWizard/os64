                      block p 8 31480 384 60
                        line 8 31480 384 20 base 14
                          text "The Frameset version includes everything in the" 8 31482 312 16 serif 16
                        line 8 31500 384 20 base 14
                          span code 240 31502 64 16
                          text "Transitional version, as well as the " 8 31502 232 16 serif 16
                          text "frameset" 240 31502 64 16 mono 16
                          text " element" 304 31502 56 16 serif 16
                        line 8 31520 384 20 base 14
                          span code 120 31522 32 16
                          span code 216 31522 40 16
                          text "(used instead of " 8 31522 112 16 serif 16
                          text "body" 120 31522 32 16 mono 16
                          text ") and the " 152 31522 64 16 serif 16
                          text "frame" 216 31522 40 16 mono 16
                          text " element." 256 31522 60 16 serif 16
                    block section 8 31559 384 142
                      block div 8 31559 384 23
                        block h3 8 31559 384 23
                          line 8 31559 384 23 base 16
                            text "Frameset versus transitional" 8 31561 219 19 serif 19 bold
                      block p 8 31601 384 100
                        line 8 31601 384 20 base 14
                          text "In addition to the above transitional differences, the" 8 31603 336 16 serif 16
                        line 8 31621 384 20 base 14
                          text "frameset specifications (whether XHTML 1.0 or HTML 4.01)" 8 31623 376 16 serif 16
                        line 8 31641 384 20 base 14
                          span code 260 31643 64 16
                          text "specify a different content model, with " 8 31643 252 16 serif 16
                          text "frameset" 260 31643 64 16 mono 16
                          text " replacing" 324 31643 64 16 serif 16
                        line 8 31661 384 20 base 14
                          span code 8 31663 32 16
                          span code 176 31663 40 16
                          text "body" 8 31663 32 16 mono 16
                          text ", that contains either " 40 31663 136 16 serif 16
                          text "frame" 176 31663 40 16 mono 16
                          text " elements, or optionally" 216 31663 152 16 serif 16
                        line 8 31681 384 20 base 14
                          span code 8 31683 64 16
                          span code 120 31683 32 16
                          text "noframes" 8 31683 64 16 mono 16
                          text " with a " 72 31683 48 16 serif 16
                          text "body" 120 31683 32 16 mono 16
                          text "." 152 31683 4 16 serif 16
                    block section 8 31720 384 638
                      block div 8 31720 384 24
                        block h3 8 31720 384 24
                          line 8 31720 384 24 base 16
                            text "Summary of specification versions" 8 31722 266 19 serif 19 bold
                      block p 8 31762 384 400
                        line 8 31762 384 20 base 14
                          text "As this list demonstrates, the loose versions of the" 8 31764 328 16 serif 16
                        line 8 31782 384 20 base 14
                          text "specification are maintained for legacy support. However," 8 31784 372 16 serif 16
                        line 8 31802 384 20 base 14
                          text "contrary to popular misconceptions, the move to XHTML" 8 31804 360 16 serif 16
                        line 8 31822 384 20 base 14
                          text "does not imply a removal of this legacy support. Rather the" 8 31824 380 16 serif 16
                        line 8 31842 384 20 base 14
                          text "X in XML stands for extensible and the W3C is modularizing" 8 31844 384 16 serif 16
                        line 8 31862 384 20 base 14
                          text "the entire specification and opens it up to independent" 8 31864 352 16 serif 16
                        line 8 31882 384 20 base 14
                          text "extensions. The primary achievement in the move from" 8 31884 356 16 serif 16
                        line 8 31902 384 20 base 14
                          text "XHTML 1.0 to XHTML 1.1 is the modularization of the entire" 8 31904 364 16 serif 16
                        line 8 31922 384 20 base 14
                          text "specification. The strict version of HTML is deployed in" 8 31924 356 16 serif 16
                        line 8 31942 384 20 base 14
                          text "XHTML 1.1 through a set of modular extensions to the base" 8 31944 372 16 serif 16
                        line 8 31962 384 20 base 14
                          text "XHTML 1.1 specification. Likewise, someone looking for the" 8 31964 380 16 serif 16
                        line 8 31982 384 20 base 14
                          text "loose (transitional) or frameset specifications will find" 8 31984 356 16 serif 16
                        line 8 32002 384 20 base 14
                          text "similar extended XHTML 1.1 support (much of it is contained" 8 32004 384 16 serif 16
                        line 8 32022 384 20 base 14
                          text "in the legacy or frame modules). Modularization also" 8 32024 344 16 serif 16
                        line 8 32042 384 20 base 14
                          text "allows for separate features to develop on their own" 8 32044 336 16 serif 16
                        line 8 32062 384 20 base 14
                          text "timetable. So for example, XHTML 1.1 will allow quicker" 8 32064 352 16 serif 16
                        line 8 32082 384 20 base 14
                          span a 308 32084 52 16 link 647
                          text "migration to emerging XML standards such as " 8 32084 300 16 serif 16
                          text "MathML" 308 32084 52 16 serif 16 underline link 647
                          text " (a" 360 32084 20 16 serif 16
                        line 8 32102 384 20 base 14
                          text "presentational and semantic math language based on" 8 32104 348 16 serif 16
                        line 8 32122 384 20 base 14
                          span a 76 32124 48 16 link 648
                          text "XML) and " 8 32124 68 16 serif 16
                          text "XForms" 76 32124 48 16 serif 16 underline link 648
                          text "—a new highly advanced web-form" 124 32124 228 16 serif 16
                        line 8 32142 384 20 base 14
                          text "technology to replace the existing HTML forms." 8 32144 304 16 serif 16
                      block p 8 32178 384 180
                        line 8 32178 384 20 base 14
                          text "In summary, the HTML 4 specification primarily reined in" 8 32180 368 16 serif 16
                        line 8 32198 384 20 base 14
                          text "all the various HTML implementations into a single clearly" 8 32200 376 16 serif 16
                        line 8 32218 384 20 base 14
                          text "written specification based on SGML. XHTML 1.0, ported this" 8 32220 384 16 serif 16
                        line 8 32238 384 20 base 14
                          text "specification, as is, to the new XML-defined specification." 8 32240 380 16 serif 16
                        line 8 32258 384 20 base 14
                          text "Next, XHTML 1.1 takes advantage of the extensible nature of" 8 32260 380 16 serif 16
                        line 8 32278 384 20 base 14
                          text "XML and modularizes the whole specification. XHTML 2.0" 8 32280 372 16 serif 16
                        line 8 32298 384 20 base 14
                          text "was intended to be the first step in adding new features to" 8 32300 376 16 serif 16
                        line 8 32318 384 20 base 14
                          text "the specification in a standards-body-based" 8 32320 292 16 serif 16
                        line 8 32338 384 20 base 14
                          span span 72 32343 7 13
                          span span 79 32343 78 13
                          span span 79 32343 78 13
                          span a 79 32343 78 13 link 649
