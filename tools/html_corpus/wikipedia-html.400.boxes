                          text "visible or audible web pages. Default characteristics for" 8 10187 360 16 serif 16
                        line 8 10205 384 20 base 14
                          text "every item of HTML markup are defined in the browser, and" 8 10207 380 16 serif 16
                        line 8 10225 384 20 base 14
                          text "these characteristics can be altered or enhanced by the" 8 10227 360 16 serif 16
                        line 8 10245 384 20 base 14
                          span a 260 10247 24 16 link 372
                          text "web page designer's additional use of " 8 10247 252 16 serif 16
                          text "CSS" 260 10247 24 16 serif 16 underline link 372
                          text ". Many of the" 284 10247 84 16 serif 16
                        line 8 10265 384 20 base 14
                          text "text elements are mentioned in the 1988 ISO technical" 8 10267 348 16 serif 16
                        line 8 10285 384 20 base 14
                          span i 104 10287 176 16
                          text "report TR 9537 " 8 10287 96 16 serif 16
                          text "Techniques for using SGML" 104 10287 176 16 serif 16 italic
                          text ", which" 280 10287 48 16 serif 16
                        line 8 10305 384 20 base 14
                          text "describes the features of early text formatting languages" 8 10307 364 16 serif 16
                        line 8 10325 384 20 base 14
                          span a 172 10327 116 16 link 373
                          text "such as that used by the " 8 10327 164 16 serif 16
                          text "RUNOFF command" 172 10327 116 16 serif 16 underline link 373
                          text " developed in" 288 10327 88 16 serif 16
                        line 8 10345 384 20 base 14
                          span a 152 10347 32 16 link 374
                          text "the early 1960s for the " 8 10347 144 16 serif 16
                          text "CTSS" 152 10347 32 16 serif 16 underline link 374
                          text " (Compatible Time-Sharing" 184 10347 176 16 serif 16
                        line 8 10365 384 20 base 14
                          text "System) operating system. These formatting commands" 8 10367 364 16 serif 16
                        line 8 10385 384 20 base 14
                          text "were derived from the commands used by typesetters to" 8 10387 364 16 serif 16
                        line 8 10405 384 20 base 14
                          text "manually format documents. However, the SGML concept of" 8 10407 384 16 serif 16
                        line 8 10425 384 20 base 14
                          text "generalized markup is based on elements (nested" 8 10427 328 16 serif 16
                        line 8 10445 384 20 base 14
                          text "annotated ranges with attributes) rather than merely print" 8 10447 368 16 serif 16
                        line 8 10465 384 20 base 14
                          text "effects, with separate structure and markup. HTML has" 8 10467 352 16 serif 16
                        line 8 10485 384 20 base 14
                          text "been progressively moved in this direction with CSS." 8 10487 340 16 serif 16
                      block p 8 10521 384 300
                        line 8 10521 384 20 base 14
                          text "Berners-Lee considered HTML to be an application of" 8 10523 344 16 serif 16
                        line 8 10541 384 20 base 14
                          span a 308 10543 52 16 link 375
                          text "SGML. It was formally defined as such by the " 8 10543 300 16 serif 16
                          text "Internet" 308 10543 52 16 serif 16 underline link 375
                        line 8 10561 384 20 base 14
                          span a 8 10563 152 16 link 375
                          text "Engineering Task Force" 8 10563 152 16 serif 16 underline link 375
                          text " (IETF) with the mid-1993" 160 10563 172 16 serif 16
                        line 8 10581 384 20 base 14
                          text "publication of the first proposal for an HTML specification," 8 10583 372 16 serif 16
                        line 8 10601 384 20 base 14
                          span a 288 10603 84 16 link 376
                          text "the \"Hypertext Markup Language (HTML)\" " 8 10603 280 16 serif 16
                          text "Internet Draft" 288 10603 84 16 serif 16 underline link 376
                          text " by" 372 10603 20 16 serif 16
                        line 8 10621 384 20 base 14
                          span a 120 10623 84 16 link 377
                          text "Berners-Lee and " 8 10623 112 16 serif 16
                          text "Dan Connolly" 120 10623 84 16 serif 16 underline link 377
                          text ", which included an SGML" 204 10623 168 16 serif 16
                        line 8 10641 384 20 base 14
                          span a 8 10643 160 16 link 378
                          span span 304 10645 7 13
                          span span 320 10645 7 13
                          span span 304 10645 23 13
                          span a 304 10645 23 13 link 379
                          span sup 304 10645 23 13
                          span span 327 10645 6 13
                          span span 340 10645 6 13
                          span span 327 10645 19 13
                          span a 327 10645 19 13 link 380
                          span sup 327 10645 19 13
                          text "document type definition" 8 10643 160 16 serif 16 underline link 378
                          text " to define the syntax." 168 10643 136 16 serif 16
                          text "[" 304 10645 7 13 serif 13 underline link 379
                          text "10" 311 10645 9 13 serif 13 underline link 379
                          text "]" 320 10645 7 13 serif 13 underline link 379
                          text "[" 327 10645 6 13 serif 13 underline link 380
                          text "11" 333 10645 7 13 serif 13 underline link 380
                          text "]" 340 10645 6 13 serif 13 underline link 380
                          text " The" 346 10643 28 16 serif 16
                        line 8 10661 384 20 base 14
                          text "draft expired after six months, but was notable for its" 8 10663 340 16 serif 16
                        line 8 10681 384 20 base 14
                          span a 164 10683 84 16 link 381
                          text "acknowledgment of the " 8 10683 156 16 serif 16
                          text "NCSA Mosaic" 164 10683 84 16 serif 16 underline link 381
                          text " browser's custom tag" 248 10683 144 16 serif 16
                        line 8 10701 384 20 base 14
                          text "for embedding in-line images, reflecting the IETF's" 8 10703 332 16 serif 16
                        line 8 10721 384 20 base 14
                          text "philosophy of basing standards on successful prototypes." 8 10723 376 16 serif 16
                        line 8 10741 384 20 base 14
                          span a 72 10743 84 16 link 382
                          text "Similarly, " 8 10743 64 16 serif 16
                          text "Dave Raggett" 72 10743 84 16 serif 16 underline link 382
                          text "'s competing Internet Draft, \"HTML+" 156 10743 232 16 serif 16
                        line 8 10761 384 20 base 14
                          text "(Hypertext Markup Format)\", from late 1993, suggested" 8 10763 356 16 serif 16
                        line 8 10781 384 20 base 14
                          text "standardizing already-implemented features like tables" 8 10783 360 16 serif 16
                        line 8 10801 384 20 base 14
                          span span 124 10805 7 13
                          span span 140 10805 7 13
                          span span 124 10805 23 13
                          span a 124 10805 23 13 link 383
                          span sup 124 10805 23 13
                          text "and fill-out forms." 8 10803 116 16 serif 16
                          text "[" 124 10805 7 13 serif 13 underline link 383
                          text "12" 131 10805 9 13 serif 13 underline link 383
                          text "]" 140 10805 7 13 serif 13 underline link 383
                      block p 8 10837 384 100
                        line 8 10837 384 20 base 14
                          text "After the HTML and HTML+ drafts expired in early 1994, the" 8 10839 372 16 serif 16
                        line 8 10857 384 20 base 14
                          text "IETF created an HTML Working Group. In 1995, this working" 8 10859 384 16 serif 16
                        line 8 10877 384 20 base 14
                          text "group completed \"HTML 2.0\", the first HTML specification" 8 10879 372 16 serif 16
                        line 8 10897 384 20 base 14
                          text "intended to be treated as a standard against which future" 8 10899 368 16 serif 16
                        line 8 10917 384 20 base 14
                          span span 232 10921 7 13
                          span span 248 10921 7 13
                          span span 232 10921 23 13
                          span a 232 10921 23 13 link 384
                          span sup 232 10921 23 13
                          text "implementations should be based." 8 10919 224 16 serif 16
                          text "[" 232 10921 7 13 serif 13 underline link 384
                          text "13" 239 10921 9 13 serif 13 underline link 384
                          text "]" 248 10921 7 13 serif 13 underline link 384
                      block p 8 10953 384 240
                        line 8 10953 384 20 base 14
                          text "Further development under the auspices of the IETF was" 8 10955 368 16 serif 16
                        line 8 10973 384 20 base 14
                          span span 212 10975 68 16
                          span span 280 10975 0 16
                          span span 280 10975 4 16
                          span span 284 10977 7 13
                          span span 326 10977 7 13
                          span a 284 10977 49 13 link 385
                          span sup 284 10977 49 13
                          span span 333 10975 0 16
                          text "stalled by competing interests. " 8 10975 204 16 serif 16
                          text "Since 1996" 212 10975 68 16 serif 16
                          text "," 280 10975 4 16 serif 16
                          text "[" 284 10977 7 13 serif 13 underline link 385
                          text "update" 291 10977 35 13 serif 13 underline link 385
                          text "]" 326 10977 7 13 serif 13 underline link 385
                          text " the" 333 10975 24 16 serif 16
                        line 8 10993 384 20 base 14
                          text "HTML specifications have been maintained, with input from" 8 10995 384 16 serif 16
                        line 8 11013 384 20 base 14
                          span a 252 11015 104 16 link 386
                          text "commercial software vendors, by the " 8 11015 244 16 serif 16
                          text "World Wide Web" 252 11015 104 16 serif 16 underline link 386
                        line 8 11033 384 20 base 14
                          span a 8 11035 72 16 link 386
                          span span 132 11037 7 13
                          span span 148 11037 7 13
                          span span 132 11037 23 13
                          span a 132 11037 23 13 link 387
                          span sup 132 11037 23 13
                          text "Consortium" 8 11035 72 16 serif 16 underline link 386
                          text " (W3C)." 80 11035 52 16 serif 16
                          text "[" 132 11037 7 13 serif 13 underline link 387
                          text "14" 139 11037 9 13 serif 13 underline link 387
                          text "]" 148 11037 7 13 serif 13 underline link 387
                          text " In 2000, HTML became an" 155 11035 176 16 serif 16
                        line 8 11053 384 20 base 14
                          span a 160 11055 24 16 link 388
                          span a 192 11055 24 16 link 389
                          text "international standard (" 8 11055 152 16 serif 16
                          text "ISO" 160 11055 24 16 serif 16 underline link 388
                          text "/" 184 11055 8 16 serif 16
                          text "IEC" 192 11055 24 16 serif 16 underline link 389
                          text " 15445:2000). HTML 4.01" 216 11055 156 16 serif 16
                        line 8 11073 384 20 base 14
                          text "was published in late 1999, with further errata published" 8 11075 360 16 serif 16
                        line 8 11093 384 20 base 14
                          text "through 2001. In 2004, development began on HTML5 in the" 8 11095 384 16 serif 16
                        line 8 11113 384 20 base 14
                          span a 8 11115 344 16 link 390
                          text "Web Hypertext Application Technology Working Group" 8 11115 344 16 serif 16 underline link 390
                        line 8 11133 384 20 base 14
                          text "(WHATWG), which became a joint deliverable with the W3C" 8 11135 384 16 serif 16
                        line 8 11153 384 20 base 14
                          text "in 2008, and was completed and standardized on 28" 8 11155 340 16 serif 16
                        line 8 11173 384 20 base 14
                          span span 92 11177 7 13
                          span span 108 11177 7 13
                          span span 92 11177 23 13
                          span a 92 11177 23 13 link 391
                          span sup 92 11177 23 13
                          text "October 2014." 8 11175 84 16 serif 16
                          text "[" 92 11177 7 13 serif 13 underline link 391
                          text "15" 99 11177 9 13 serif 13 underline link 391
                          text "]" 108 11177 7 13 serif 13 underline link 391
