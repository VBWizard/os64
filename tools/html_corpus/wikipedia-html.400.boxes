                    block p 8 32736 384 140
                      line 8 32736 384 20 base 14
                        span a 8 32738 64 16 link 654
                        span i 132 32738 192 16
                        text "WYSIWYG" 8 32738 64 16 serif 16 underline link 654
                        text " editors (" 72 32738 60 16 serif 16
                        text "what you see is what you get" 132 32738 192 16 serif 16 italic
                        text "), are" 324 32738 36 16 serif 16
                      line 8 32756 384 20 base 14
                        text "HTML editors in which the user lays out everything as it is" 8 32758 376 16 serif 16
                      line 8 32776 384 20 base 14
                        span a 272 32778 92 16 link 655
                        text "to appear in the HTML document using a " 8 32778 264 16 serif 16
                        text "graphical user" 272 32778 92 16 serif 16 underline link 655
                      line 8 32796 384 20 base 14
                        span a 8 32798 56 16 link 655
                        span a 172 32798 128 16 link 656
                        text "interface" 8 32798 56 16 serif 16 underline link 655
                        text " (GUI), such as " 64 32798 108 16 serif 16
                        text "Microsoft FrontPage" 172 32798 128 16 serif 16 underline link 656
                        text ", often similar" 300 32798 88 16 serif 16
                      line 8 32816 384 20 base 14
                        span a 24 32818 108 16 link 657
                        text "to " 8 32818 16 16 serif 16
                        text "word processors" 24 32818 108 16 serif 16 underline link 657
                        text ". The editor renders the document rather" 132 32818 256 16 serif 16
                      line 8 32836 384 20 base 14
                        text "than showing the code, so authors do not require extensive" 8 32838 384 16 serif 16
                      line 8 32856 384 20 base 14
                        text "knowledge of HTML." 8 32858 132 16 serif 16
                    block p 8 32892 384 80
                      line 8 32892 384 20 base 14
                        span span 324 32896 7 13
                        span span 344 32896 6 13
                        span span 324 32896 26 13
                        span a 324 32896 26 13 link 658
                        span sup 324 32896 26 13
                        span span 350 32896 7 13
                        span span 373 32896 6 13
                        span span 350 32896 29 13
                        span a 350 32896 29 13 link 659
                        span sup 350 32896 29 13
                        text "The WYSIWYG editing model has been criticized," 8 32894 316 16 serif 16
                        text "[" 324 32896 7 13 serif 13 underline link 658
                        text "99" 331 32896 13 13 serif 13 underline link 658
                        text "]" 344 32896 6 13 serif 13 underline link 658
                        text "[" 350 32896 7 13 serif 13 underline link 659
                        text "100" 357 32896 16 13 serif 13 underline link 659
                        text "]" 373 32896 6 13 serif 13 underline link 659
                      line 8 32912 384 20 base 14
                        text "primarily because of the low quality of the generated code;" 8 32914 380 16 serif 16
                      line 8 32932 384 20 base 14
                        text "there are various developers advocating a change to the" 8 32934 364 16 serif 16
                      line 8 32952 384 20 base 14
                        span a 8 32954 68 16 link 660
                        span i 132 32954 208 16
                        span span 352 32956 7 13
                        span span 372 32956 6 13
                        span span 352 32956 26 13
                        span a 352 32956 26 13 link 661
                        span sup 352 32956 26 13
                        text "WYSIWYM" 8 32954 68 16 serif 16 underline link 660
                        text " model (" 76 32954 56 16 serif 16
                        text "what you see is what you mean" 132 32954 208 16 serif 16 italic
                        text ")." 340 32954 12 16 serif 16
                        text "[" 352 32956 7 13 serif 13 underline link 661
                        text "101" 359 32956 13 13 serif 13 underline link 661
                        text "]" 372 32956 6 13 serif 13 underline link 661
                    block p 8 32988 384 40
                      line 8 32988 384 20 base 14
                        text "WYSIWYG editors remain a controversial topic because of" 8 32990 372 16 serif 16
                      line 8 33008 384 20 base 14
                        text "their perceived flaws such as:" 8 33010 196 16 serif 16
                    block ul 8 33044 384 240
                      block li 48 33044 344 60
                        line 48 33044 344 20 base 14
                          text "Relying mainly on the layout as opposed to meaning," 48 33046 344 16 serif 16
                        line 48 33064 344 20 base 14
                          text "often using markup that does not convey the" 48 33066 288 16 serif 16
                        line 48 33084 344 20 base 14
                          span span 356 33088 7 13
                          span span 379 33088 6 13
                          span span 356 33088 29 13
                          span a 356 33088 29 13 link 662
                          span sup 356 33088 29 13
                          text "intended meaning but simply copies the layout." 48 33086 308 16 serif 16
                          text "[" 356 33088 7 13 serif 13 underline link 662
                          text "102" 363 33088 16 13 serif 13 underline link 662
                          text "]" 379 33088 6 13 serif 13 underline link 662
                        marker "• " 36 33046 12 16
                      block li 48 33104 344 60
                        line 48 33104 344 20 base 14
                          text "Often producing extremely verbose and redundant" 48 33106 320 16 serif 16
                        line 48 33124 344 20 base 14
                          text "code that fails to make use of the cascading nature" 48 33126 332 16 serif 16
                        line 48 33144 344 20 base 14
                          span a 132 33146 24 16 link 663
                          text "of HTML and " 48 33146 84 16 serif 16
                          text "CSS" 132 33146 24 16 serif 16 underline link 663
                          text "." 156 33146 4 16 serif 16
                        marker "• " 36 33106 12 16
                      block li 48 33164 344 60
                        line 48 33164 344 20 base 14
                          span a 352 33166 20 16 link 664
                          text "Often producing ungrammatical markup, called " 48 33166 304 16 serif 16
                          text "tag" 352 33166 20 16 serif 16 underline link 664
                        line 48 33184 344 20 base 14
                          span a 48 33186 32 16 link 664
                          text "soup" 48 33186 32 16 serif 16 underline link 664
                          text " or semantically incorrect markup (such as" 80 33186 280 16 serif 16
                        line 48 33204 344 20 base 14
                          span span 48 33206 8 16
                          span span 56 33206 16 16
                          span span 72 33206 8 16
                          span code 48 33206 32 16
                          text "<" 48 33206 8 16 mono 16
                          text "em" 56 33206 16 16 mono 16
                          text ">" 72 33206 8 16 mono 16
                          text " for italics)." 80 33206 76 16 serif 16
                        marker "• " 36 33166 12 16
                      block li 48 33224 344 60
                        line 48 33224 344 20 base 14
                          text "As a great deal of the information in HTML documents" 48 33226 344 16 serif 16
                        line 48 33244 344 20 base 14
                          text "is not in the layout, the model has been criticized for" 48 33246 340 16 serif 16
                        line 48 33264 344 20 base 14
