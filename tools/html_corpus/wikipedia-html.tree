|                             href="#cite_note-W3C_transfer_HTML-68"
|                             id="mwAiM"
|                             <span>
|                               class="mw-reflink-text"
|                               id="mwAiQ"
|                               <span>
|                                 class="cite-bracket"
|                                 id="mwAiU"
|                                 "["
|                               "67"
|                               <span>
|                                 class="cite-bracket"
|                                 id="mwAiY"
|                                 "]"
|                         <sup>
|                           about="#mwt283"
|                           class="mw-ref reference"
|                           data-mw="{"name":"ref","attrs":{"name":"W3C transfer memo"},"body":{"id":"mw-reference-text-cite_note-W3C_transfer_memo-69"}}"
|                           id="cite_ref-W3C_transfer_memo_69-0"
|                           rel="dc:references"
