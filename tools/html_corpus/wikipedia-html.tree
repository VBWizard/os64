|                           id="mwAqI"
|                           "head"
|                         <span>
|                           class="p"
|                           id="mwAqM"
|                           ">"
|                       " and "
|                       <code>
|                         about="#mwt317"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"HTML","class":"","style":"","inline":"1"},"body":{"extsrc":"</head>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"1":{"wt":"</head>"},"2":{"wt":"HTML"}},"i":0}}]}"
