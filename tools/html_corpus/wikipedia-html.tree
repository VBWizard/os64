|                       data-mw-section-id="2"
|                       id="mwTQ"
|                       <div>
|                         class="mw-heading mw-heading3"
|                         <h3>
|                           id="Development"
|                           "Development"
|                       "
"
|                       <figure>
|                         class="mw-default-size mw-halign-left"
|                         id="mwTg"
|                         typeof="mw:File/Thumb"
|                         <a>
|                           class="mw-file-description"
|                           href="https://en.wikipedia.org/wiki/File:Tim_Berners-Lee_April_2009.jpg"
|                           id="mwTw"
|                           <img>
|                             alt="Photograph of Tim Berners-Lee in April 2009"
|                             class="mw-file-element mw-file-upright"
|                             data-file-height="1648"
|                             data-file-type="bitmap"
|                             data-file-width="1195"
|                             decoding="async"
|                             height="262"
|                             id="mwUA"
