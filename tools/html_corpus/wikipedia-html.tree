|                             src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/10/HTML_element_content_categories.svg/250px-HTML_element_content_categories.svg.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail"
|                             srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/10/HTML_element_content_categories.svg/500px-HTML_element_content_categories.svg.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x"
|                             width="250"
|                         <figcaption>
|                           id="mwAro"
|                           "HTML element content categories"
|                       "
"
|                       <p>
|                         id="mwArs"
|                         "HTML documents imply a structure of nested "
|                         <a>
|                           href="https://en.wikipedia.org/wiki/HTML_element"
|                           id="mwArw"
|                           rel="mw:WikiLink"
|                           title="HTML element"
|                           "HTML elements"
|                         ". These are indicated in the document by HTML "
|                         <i>
|                           id="mwAr0"
|                           "tags"
|                         ", enclosed in angle brackets."
|                         <sup>
|                           about="#mwt330"
|                           class="mw-ref reference"
|                           data-mw="{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-75"}}"
|                           id="cite_ref-75"
|                           rel="dc:references"
|                           typeof="mw:Extension/ref"
|                           <a>
|                             href="#cite_note-75"
|                             id="mwAr4"
|                             <span>
|                               class="mw-reflink-text"
|                               id="mwAr8"
|                               <span>
|                                 class="cite-bracket"
|                                 id="mwAsA"
|                                 "["
|                               "74"
|                               <span>
|                                 class="cite-bracket"
|                                 id="mwAsE"
|                                 "]"
|                         <link>
|                           about="#mwt327"
|                           data-mw="{"parts":[{"template":{"target":{"wt":"better source needed","href":"./Template:Better_source_needed"},"params":{"date":{"wt":"February 2019"}},"i":0}}]}"
|                           href="./Category:All_articles_lacking_reliable_references"
|                           id="mwAsI"
|                           rel="mw:PageProp/Category"
|                           typeof="mw:Transclusion"
|                         <link>
|                           about="#mwt327"
|                           href="./Category:Articles_lacking_reliable_references_from_February_2019"
|                           rel="mw:PageProp/Category"
|                         <sup>
|                           about="#mwt327"
|                           class="noprint Inline-Template noprint noexcerpt Template-Fact"
|                           id="mwAsM"
|                           style="white-space:nowrap;"
|                           <span>
|                             typeof="mw:Entity"
|                             "["
|                           <i>
|                             <a>
|                               href="https://en.wikipedia.org/wiki/Wikipedia:Verifiability#Questionable_sources"
|                               rel="mw:WikiLink"
|                               title="Wikipedia:Verifiability"
|                               <span>
|                                 title="This claim needs references to better sources. (February 2019)"
|                                 "better"
|                                 <span>
|                                   typeof="mw:Entity"
|                                   " "
|                                 "source"
|                                 <span>
|                                   typeof="mw:Entity"
|                                   " "
|                                 "needed"
|                           <span>
|                             typeof="mw:Entity"
|                             "]"
|                       "

"
|                       <p>
|                         id="mwAsQ"
|                         "In the simple, general case, the extent of an element is indicated by a pair of tags: a "start tag" "
|                         <code>
|                           about="#mwt331"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<p>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<p>"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAsU"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAsY"
|                             "<"
|                           <span>
|                             class="nt"
|                             id="mwAsc"
|                             "p"
|                           <span>
|                             class="p"
|                             id="mwAsg"
|                             ">"
|                         " and "end tag" "
|                         <code>
|                           about="#mwt333"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"</p>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"</p>"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAsk"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAso"
|                             "</"
|                           <span>
|                             class="nt"
|                             id="mwAss"
|                             "p"
|                           <span>
|                             class="p"
|                             id="mwAsw"
|                             ">"
|                         ". The text content of the element, if any, is placed between these tags."
|                       "

"
|                       <p>
|                         id="mwAs0"
|                         "Tags may also enclose further tag markup between the start and end, including a mixture of tags and text. This indicates further (nested) elements, as children of the parent element."
|                       "

"
|                       <p>
|                         id="mwAs4"
|                         "The start tag may also include the element's "
|                         <i>
|                           id="mwAs8"
|                           "attributes"
|                         " within the tag. These indicate other information, such as identifiers for sections within the document, identifiers used to bind style information to the presentation of the document, and for some tags such as the "
|                         <code>
|                           about="#mwt335"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<img>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<img>"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAtA"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAtE"
|                             "<"
|                           <span>
|                             class="nt"
|                             id="mwAtI"
|                             "img"
|                           <span>
|                             class="p"
|                             id="mwAtM"
|                             ">"
|                         " used to embed images, the reference to the image resource in the format like this: "
|                         <code>
|                           about="#mwt337"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<img src=\"example.com/example.jpg\">"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<img src=\"example.com/example.jpg\">"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAtQ"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAtU"
|                             "<"
|                           <span>
|                             class="nt"
|                             id="mwAtY"
|                             "img"
|                           " "
|                           <span>
|                             class="na"
|                             id="mwAtc"
|                             "src"
|                           <span>
|                             class="o"
|                             id="mwAtg"
|                             "="
|                           <span>
|                             class="s"
|                             id="mwAtk"
|                             ""example.com/example.jpg""
|                           <span>
|                             class="p"
|                             id="mwAto"
|                             ">"
|                       "

"
|                       <p>
|                         id="mwAts"
|                         "Some elements, such as the "
|                         <a>
|                           class="mw-redirect"
|                           href="https://en.wikipedia.org/wiki/Line_breaking_character"
|                           id="mwAtw"
|                           rel="mw:WikiLink"
|                           title="Line breaking character"
|                           "line break"
|                         " "
|                         <code>
|                           about="#mwt339"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<br>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<br>"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAt0"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAt4"
|                             "<"
|                           <span>
|                             class="nt"
|                             id="mwAt8"
|                             "br"
|                           <span>
|                             class="p"
|                             id="mwAuA"
|                             ">"
|                         " do not permit "
|                         <i>
|                           id="mwAuE"
|                           "any"
|                         " embedded content, either text or further tags. These require only a single empty tag (akin to a start tag) and do not use an end tag."
|                       "

"
|                       <p>
|                         id="mwAuI"
|                         "Many tags, particularly the closing end tag for the very commonly used paragraph element "
|                         <code>
|                           about="#mwt341"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<p>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<p>"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAuM"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAuQ"
|                             "<"
|                           <span>
|                             class="nt"
|                             id="mwAuU"
|                             "p"
|                           <span>
|                             class="p"
|                             id="mwAuY"
|                             ">"
|                         ", are optional. An HTML browser or other agent can infer the closure for the end of an element from the context and the structural rules defined by the HTML standard. These rules are complex and not widely understood by most HTML authors."
|                       "

"
|                       <p>
|                         id="mwAuc"
|                         "The general form of an HTML element is therefore: "
|                         <code>
|                           about="#mwt343"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<tag attribute1=\"value1\" attribute2=\"value2\">''content''</tag>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<tag attribute1=\"value1\" attribute2=\"value2\">''content''</tag>"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAug"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAuk"
|                             "<"
|                           <span>
|                             class="nt"
|                             id="mwAuo"
|                             "tag"
|                           " "
|                           <span>
|                             class="na"
|                             id="mwAus"
|                             "attribute1"
|                           <span>
|                             class="o"
|                             id="mwAuw"
|                             "="
|                           <span>
|                             class="s"
|                             id="mwAu0"
|                             ""value1""
|                           " "
|                           <span>
|                             class="na"
|                             id="mwAu4"
|                             "attribute2"
|                           <span>
|                             class="o"
|                             id="mwAu8"
|                             "="
|                           <span>
|                             class="s"
|                             id="mwAvA"
|                             ""value2""
|                           <span>
|                             class="p"
|                             id="mwAvE"
|                             ">"
|                           "''content''"
|                           <span>
|                             class="p"
|                             id="mwAvI"
|                             "</"
|                           <span>
|                             class="nt"
|                             id="mwAvM"
|                             "tag"
|                           <span>
|                             class="p"
|                             id="mwAvQ"
|                             ">"
|                         ". Some HTML elements are defined as "
|                         <i>
|                           id="mwAvU"
|                           "empty elements"
|                         " and take the form "
|                         <code>
|                           about="#mwt345"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<tag attribute1=\"value1\" attribute2=\"value2\">"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<tag attribute1=\"value1\" attribute2=\"value2\">"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAvY"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAvc"
|                             "<"
|                           <span>
|                             class="nt"
|                             id="mwAvg"
|                             "tag"
|                           " "
|                           <span>
|                             class="na"
|                             id="mwAvk"
|                             "attribute1"
|                           <span>
|                             class="o"
|                             id="mwAvo"
|                             "="
|                           <span>
|                             class="s"
|                             id="mwAvs"
|                             ""value1""
|                           " "
|                           <span>
|                             class="na"
|                             id="mwAvw"
|                             "attribute2"
|                           <span>
|                             class="o"
|                             id="mwAv0"
|                             "="
|                           <span>
|                             class="s"
|                             id="mwAv4"
|                             ""value2""
|                           <span>
|                             class="p"
|                             id="mwAv8"
|                             ">"
|                         ". Empty elements may enclose no content, for instance, the "
|                         <code>
|                           about="#mwt347"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<br>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<br>"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAwA"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAwE"
|                             "<"
|                           <span>
|                             class="nt"
|                             id="mwAwI"
|                             "br"
|                           <span>
|                             class="p"
|                             id="mwAwM"
|                             ">"
|                         " tag or the inline "
|                         <code>
|                           about="#mwt349"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                           data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<img>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<img>"}},"i":0}}]}"
|                           dir="ltr"
|                           id="mwAwQ"
|                           style=""
|                           typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                           <span>
|                             class="p"
|                             id="mwAwU"
|                             "<"
|                           <span>
|                             class="nt"
|                             id="mwAwY"
|                             "img"
|                           <span>
|                             class="p"
|                             id="mwAwc"
|                             ">"
|                         " tag.
The name of an HTML element is the name used in the tags.
The end tag's name is preceded by a slash character "
|                         <code>
|                           id="mwAwg"
|                           <span>
|                             id="mwAwk"
|                             typeof="mw:Entity"
|                             "/"
|                         ". If a tag has no content, an end tag is not allowed. If attributes are not mentioned, default values are used in each case."
|                       "

"
|                       <section>
|                         aria-labelledby="Element_examples"
|                         data-mw-section-id="13"
