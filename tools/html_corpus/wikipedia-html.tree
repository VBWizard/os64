|                         <section>
|                           aria-labelledby="Comments"
|                           data-mw-section-id="18"
|                           id="mwA9U"
|                           <div>
|                             class="mw-heading mw-heading5"
|                             <h5>
|                               id="Comments"
|                               "Comments"
|                           "
"
|                           <div>
|                             about="#mwt379"
|                             class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                             data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html"},"body":{"extsrc":"<!-- This is a comment -->"}}"
|                             dir="ltr"
|                             id="mwA9Y"
|                             typeof="mw:Extension/syntaxhighlight"
|                             <pre>
|                               id="mwA9c"
|                               <span>
|                                 id="mwA9g"
|                               <span>
|                                 class="cm"
|                                 id="mwA9k"
|                                 "<!-- This is a comment -->"
|                               "
"
|                           <p>
|                             id="mwA9o"
|                             " Comments can help in the understanding of the markup and do not display in the webpage."
|                           "

"
|                           <p>
|                             id="mwA9s"
|                             "There are several types of markup elements used in HTML:"
|                           "
"
|                           <ul>
|                             id="mwA9w"
|                             <li>
|                               id="mwA90"
|                               "Structural markup indicates the purpose of text: 
"
|                               <ul>
|                                 id="mwA94"
|                                 <li>
|                                   id="mwA98"
|                                   "For example, "
|                                   <code>
|                                     about="#mwt380"
|                                     class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                                     data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<h2>Golf</h2>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<h2>Golf</h2>"}},"i":0}}]}"
|                                     dir="ltr"
|                                     id="mwA-A"
|                                     style=""
|                                     typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                                     <span>
|                                       class="p"
|                                       id="mwA-E"
|                                       "<"
|                                     <span>
|                                       class="nt"
|                                       id="mwA-I"
|                                       "h2"
|                                     <span>
|                                       class="p"
|                                       id="mwA-M"
|                                       ">"
|                                     "Golf"
|                                     <span>
|                                       class="p"
|                                       id="mwA-Q"
|                                       "</"
|                                     <span>
|                                       class="nt"
|                                       id="mwA-U"
|                                       "h2"
|                                     <span>
|                                       class="p"
|                                       id="mwA-Y"
|                                       ">"
|                                   " establishes "Golf" as a second-level "
|                                   <a>
|                                     href="https://en.wikipedia.org/wiki/HTML_element#Basic_text"
|                                     id="mwA-c"
|                                     rel="mw:WikiLink"
|                                     title="HTML element"
|                                     "heading"
|                                   ". Structural markup does not denote any specific rendering, but most web browsers have default styles for element formatting. Content may be further styled using "
|                                   <a>
|                                     class="mw-redirect"
|                                     href="https://en.wikipedia.org/wiki/Cascading_Style_Sheets"
|                                     id="mwA-g"
|                                     rel="mw:WikiLink"
|                                     title="Cascading Style Sheets"
|                                     "Cascading Style Sheets"
|                                   " (CSS)."
|                                   <sup>
|                                     about="#mwt384"
|                                     class="mw-ref reference"
|                                     data-mw="{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-76"}}"
|                                     id="cite_ref-76"
|                                     rel="dc:references"
|                                     typeof="mw:Extension/ref"
|                                     <a>
|                                       href="#cite_note-76"
|                                       id="mwA-k"
|                                       <span>
|                                         class="mw-reflink-text"
|                                         id="mwA-o"
|                                         <span>
|                                           class="cite-bracket"
|                                           id="mwA-s"
|                                           "["
|                                         "75"
|                                         <span>
|                                           class="cite-bracket"
|                                           id="mwA-w"
|                                           "]"
|                             "
"
|                             <li>
|                               id="mwA-0"
|                               "Presentational markup indicates the appearance of the text, regardless of its purpose: 
"
|                               <ul>
|                                 id="mwA-4"
|                                 <li>
|                                   id="mwA-8"
|                                   "For example, "
|                                   <code>
|                                     about="#mwt385"
|                                     class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                                     data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<b>bold text</b>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<b>bold text</b>"}},"i":0}}]}"
|                                     dir="ltr"
|                                     id="mwA_A"
|                                     style=""
|                                     typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                                     <span>
|                                       class="p"
|                                       id="mwA_E"
|                                       "<"
|                                     <span>
|                                       class="nt"
|                                       id="mwA_I"
|                                       "b"
|                                     <span>
|                                       class="p"
|                                       id="mwA_M"
|                                       ">"
|                                     "bold text"
|                                     <span>
|                                       class="p"
|                                       id="mwA_Q"
|                                       "</"
|                                     <span>
|                                       class="nt"
|                                       id="mwA_U"
|                                       "b"
|                                     <span>
|                                       class="p"
|                                       id="mwA_Y"
|                                       ">"
|                                   " indicates that visual output devices should render "boldface" in bold text, but gives little indication what devices that are unable to do this (such as aural devices that read the text aloud) should do. In the case of both "
|                                   <code>
|                                     about="#mwt387"
|                                     class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                                     data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<b>bold text</b>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<b>bold text</b>"}},"i":0}}]}"
|                                     dir="ltr"
|                                     id="mwA_c"
|                                     style=""
|                                     typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                                     <span>
|                                       class="p"
|                                       id="mwA_g"
|                                       "<"
|                                     <span>
|                                       class="nt"
|                                       id="mwA_k"
|                                       "b"
|                                     <span>
|                                       class="p"
|                                       id="mwA_o"
|                                       ">"
|                                     "bold text"
|                                     <span>
|                                       class="p"
|                                       id="mwA_s"
|                                       "</"
|                                     <span>
|                                       class="nt"
|                                       id="mwA_w"
|                                       "b"
|                                     <span>
|                                       class="p"
|                                       id="mwA_0"
|                                       ">"
|                                   " and "
|                                   <code>
|                                     about="#mwt389"
|                                     class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                                     data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<i>italic text</i>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<i>italic text</i>"}},"i":0}}]}"
|                                     dir="ltr"
|                                     id="mwA_4"
|                                     style=""
|                                     typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                                     <span>
|                                       class="p"
|                                       id="mwA_8"
|                                       "<"
|                                     <span>
|                                       class="nt"
|                                       id="mwBAA"
|                                       "i"
|                                     <span>
|                                       class="p"
|                                       id="mwBAE"
|                                       ">"
|                                     "italic text"
|                                     <span>
|                                       class="p"
|                                       id="mwBAI"
|                                       "</"
|                                     <span>
|                                       class="nt"
|                                       id="mwBAM"
|                                       "i"
|                                     <span>
|                                       class="p"
|                                       id="mwBAQ"
|                                       ">"
|                                   ", there are other elements that may have equivalent visual renderings but that are more semantic in nature, such as "
|                                   <code>
|                                     about="#mwt391"
|                                     class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                                     data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<strong>strong text</strong>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<strong>strong text</strong>"}},"i":0}}]}"
|                                     dir="ltr"
|                                     id="mwBAU"
|                                     style=""
|                                     typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                                     <span>
|                                       class="p"
|                                       id="mwBAY"
|                                       "<"
|                                     <span>
|                                       class="nt"
|                                       id="mwBAc"
|                                       "strong"
|                                     <span>
|                                       class="p"
|                                       id="mwBAg"
|                                       ">"
|                                     "strong text"
|                                     <span>
|                                       class="p"
|                                       id="mwBAk"
|                                       "</"
|                                     <span>
|                                       class="nt"
|                                       id="mwBAo"
|                                       "strong"
|                                     <span>
|                                       class="p"
|                                       id="mwBAs"
|                                       ">"
|                                   " and "
|                                   <code>
|                                     about="#mwt393"
|                                     class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                                     data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<em>emphasized text</em>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<em>emphasized text</em>"}},"i":0}}]}"
|                                     dir="ltr"
|                                     id="mwBAw"
|                                     style=""
|                                     typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                                     <span>
|                                       class="p"
|                                       id="mwBA0"
|                                       "<"
