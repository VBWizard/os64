|                         <span>
|                           class="nt"
|                           id="mwAo0"
|                           "body"
|                         <span>
|                           class="p"
|                           id="mwAo4"
|                           ">"
|                       " and "
|                       <code>
|                         about="#mwt309"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"</body>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"</body>"}},"i":0}}]}"
|                         dir="ltr"
|                         id="mwAo8"
|                         style=""
|                         typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                         <span>
|                           class="p"
|                           id="mwApA"
|                           "</"
|                         <span>
|                           class="nt"
|                           id="mwApE"
|                           "body"
|                         <span>
|                           class="p"
|                           id="mwApI"
|                           ">"
|                       " is the visible page content. The markup text "
|                       <code>
|                         about="#mwt311"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<title>This is a title</title>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<title>This is a title</title>"}},"i":0}}]}"
|                         dir="ltr"
|                         id="mwApM"
|                         style=""
|                         typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                         <span>
|                           class="p"
|                           id="mwApQ"
|                           "<"
|                         <span>
|                           class="nt"
|                           id="mwApU"
|                           "title"
