|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwvw"
|                                     "["
|                                   "16"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwwA"
|                                     "]"
|                             " was published as a "
|                             <a>
|                               class="mw-redirect"
|                               href="https://en.wikipedia.org/wiki/W3C_Recommendation"
|                               id="mwwQ"
|                               rel="mw:WikiLink"
|                               title="W3C Recommendation"
|                               "W3C Recommendation"
|                             ". It was the first version developed and standardized exclusively by the W3C, as the IETF had closed its HTML Working Group on 12 September 1996."
|                             <sup>
|                               about="#mwt106"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-18"}}"
|                               id="cite_ref-18"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-18"
|                                 id="mwwg"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mwww"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwxA"
|                                     "["
|                                   "17"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwxQ"
|                                     "]"
|                           "
"
|                           <dd>
|                             id="mwxg"
|                             "Initially code-named "Wilbur","
|                             <sup>
|                               about="#mwt107"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{"name":"engelfriet"}}"
|                               id="cite_ref-engelfriet_19-0"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-engelfriet-19"
|                                 id="mwxw"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mwyA"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwyQ"
|                                     "["
|                                   "18"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwyg"
|                                     "]"
|                             " HTML 3.2 dropped math formulas entirely, reconciled overlap among various proprietary extensions and adopted most of "
|                             <a>
|                               href="https://en.wikipedia.org/wiki/Netscape"
|                               id="mwyw"
|                               rel="mw:WikiLink"
|                               title="Netscape"
|                               "Netscape"
|                             "'s visual markup tags. Netscape's "
|                             <a>
|                               href="https://en.wikipedia.org/wiki/Blink_element"
|                               id="mwzA"
|                               rel="mw:WikiLink"
|                               title="Blink element"
|                               "blink element"
|                             " and "
|                             <a>
|                               href="https://en.wikipedia.org/wiki/Microsoft"
|                               id="mwzQ"
|                               rel="mw:WikiLink"
|                               title="Microsoft"
|                               "Microsoft"
|                             "'s "
|                             <a>
|                               href="https://en.wikipedia.org/wiki/Marquee_element"
|                               id="mwzg"
|                               rel="mw:WikiLink"
|                               title="Marquee element"
|                               "marquee element"
|                             " were omitted due to a mutual agreement between the two companies."
|                             <sup>
|                               about="#mwt108"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{"name":"raggett"}}"
|                               id="cite_ref-raggett_15-1"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-raggett-15"
|                                 id="mwzw"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mw0A"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw0Q"
|                                     "["
|                                   "14"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw0g"
|                                     "]"
|                             " A markup for mathematical formulas similar to that of HTML was standardized 14 months later in "
|                             <a>
|                               href="https://en.wikipedia.org/wiki/MathML"
|                               id="mw0w"
|                               rel="mw:WikiLink"
|                               title="MathML"
|                               "MathML"
|                             "."
|                         "

"
|                       <section>
|                         aria-labelledby="HTML_4"
|                         data-mw-section-id="6"
|                         id="mw1A"
|                         <div>
|                           class="mw-heading mw-heading4"
|                           <h4>
|                             id="HTML_4"
|                             "HTML 4"
|                         "
"
|                         <dl>
|                           id="mw1Q"
|                           <dt>
|                             id="mw1g"
|                             "18 December 1997"
|                           <dd>
|                             id="mw1w"
|                             "HTML 4.0"
|                             <sup>
|                               about="#mwt111"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-20"}}"
|                               id="cite_ref-20"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-20"
|                                 id="mw2A"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mw2Q"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw2g"
|                                     "["
|                                   "19"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw2w"
|                                     "]"
|                             " was published as a W3C Recommendation. It offers three variations:
"
|                             <ul>
|                               id="mw3A"
|                               <li>
|                                 id="mw3Q"
|                                 "Strict, in which deprecated elements are forbidden"
|                               "
"
|                               <li>
|                                 id="mw3g"
|                                 "Transitional, in which deprecated elements are allowed"
|                               "
"
|                               <li>
|                                 id="mw3w"
|                                 "Frameset, in which mostly only "
|                                 <a>
|                                   class="mw-redirect"
|                                   href="https://en.wikipedia.org/wiki/Framing_(World_Wide_Web)"
|                                   id="mw4A"
|                                   rel="mw:WikiLink"
|                                   title="Framing (World Wide Web)"
|                                   "frame"
|                                 " related elements are allowed."
|                           "
"
|                           <dd>
|                             id="mw4Q"
|                             "Initially code-named "Cougar","
|                             <sup>
|                               about="#mwt114"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{"name":"engelfriet"},"body":{"id":"mw-reference-text-cite_note-engelfriet-19"}}"
|                               id="cite_ref-engelfriet_19-1"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-engelfriet-19"
|                                 id="mw4g"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mw4w"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw5A"
|                                     "["
|                                   "18"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw5Q"
|                                     "]"
|                             " HTML 4.0 adopted many browser-specific element types and attributes, but also sought to phase out Netscape's visual markup features by marking them as "
|                             <a>
|                               href="https://en.wikipedia.org/wiki/Deprecation"
|                               id="mw5g"
|                               rel="mw:WikiLink"
|                               title="Deprecation"
|                               "deprecated"
|                             " in favor of style sheets. HTML 4 is an SGML application conforming to ISO 8879"
|                             <span>
|                               id="mw5w"
|                               typeof="mw:Entity"
|                               " "
|                             "– SGML."
|                             <sup>
|                               about="#mwt117"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-21"}}"
|                               id="cite_ref-21"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-21"
|                                 id="mw6A"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mw6Q"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw6g"
|                                     "["
|                                   "20"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw6w"
|                                     "]"
|                           "
"
|                           <dt>
|                             id="mw7A"
|                             "24 April 1998"
|                           "
"
|                           <dd>
|                             id="mw7Q"
|                             "HTML 4.0"
|                             <sup>
|                               about="#mwt120"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-22"}}"
|                               id="cite_ref-22"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-22"
|                                 id="mw7g"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mw7w"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw8A"
|                                     "["
|                                   "21"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw8Q"
|                                     "]"
|                             " was reissued with minor edits without incrementing the version number."
|                           "
"
|                           <dt>
|                             id="mw8g"
|                             "24 December 1999"
|                           <dd>
|                             id="mw8w"
|                             "HTML 4.01"
|                             <sup>
|                               about="#mwt123"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-23"}}"
|                               id="cite_ref-23"
|                               rel="dc:references"
