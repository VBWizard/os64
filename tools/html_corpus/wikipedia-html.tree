|                               id="mwpA"
|                               <span>
|                                 class="cite-bracket"
|                                 id="mwpQ"
|                                 "["
|                               "15"
|                               <span>
|                                 class="cite-bracket"
|                                 id="mwpg"
|                                 "]"
|                       "

"
