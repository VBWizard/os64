|                           typeof="mw:Extension/templatestyles"
|                       <div>
|                         about="#mwt325"
|                         class="hatnote navigation-not-searchable"
|                         id="mwArY"
|                         role="note"
|                         "Main article: "
|                         <a>
|                           href="https://en.wikipedia.org/wiki/HTML_element"
|                           rel="mw:WikiLink"
|                           title="HTML element"
|                           "HTML element"
|                       "
"
|                       <figure>
|                         class="mw-default-size skin-invert-image"
|                         id="mwArc"
|                         typeof="mw:File/Thumb"
|                         <a>
|                           class="mw-file-description"
|                           href="https://en.wikipedia.org/wiki/File:HTML_element_content_categories.svg"
|                           id="mwArg"
|                           <img>
|                             class="mw-file-element"
|                             data-file-height="794"
|                             data-file-type="drawing"
|                             data-file-width="1123"
