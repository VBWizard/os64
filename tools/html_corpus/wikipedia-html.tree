|                           id="mwAok"
|                           "html"
|                         <span>
|                           class="p"
|                           id="mwAoo"
|                           ">"
|                       " describes the web page, and the text between "
|                       <code>
|                         about="#mwt307"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<body>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<body>"}},"i":0}}]}"
|                         dir="ltr"
