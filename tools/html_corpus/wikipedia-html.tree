|                         title="Markup language"
|                         "markup language"
|                       <sup>
|                         about="#mwt27"
|                         class="mw-ref reference"
|                         data-mw="{"name":"ref","attrs":{"group":"lower-alpha"},"body":{"id":"mw-reference-text-cite_note-3"},"parts":[{"template":{"target":{"wt":"efn ","href":"./Template:Efn"},"params":{"1":{"wt":"Even though HTML code can be executed in a browser, it is not viewed as a programming language in programming language discourse.<ref>{{Cite book |author-link=Felienne Hermans|last1=Hermans |first1=Felienne |last2=Schlesinger |first2=Ari |title=Proceedings of the 2024 ACM SIGPLAN International Symposium on New Ideas, New Paradigms, and Reflections on Programming and Software |chapter=A Case for Feminism in Programming Language Design |date=2024-10-17 |language=en |publisher=ACM |pages=205–222 |doi=10.1145/3689492.3689809 |isbn=979-8-4007-1215-9 |url=https://research.vu.nl/en/publications/a2c62236-5bd4-4351-b492-8a7b0d728ea5 }}</ref>"}},"i":0}}]}"
|                         id="cite_ref-3"
|                         rel="dc:references"
|                         typeof="mw:Transclusion mw:Extension/ref"
|                         <a>
|                           data-mw-group="lower-alpha"
|                           href="#cite_note-3"
|                           id="mwFg"
|                           <span>
|                             class="mw-reflink-text"
|                             id="mwFw"
|                             <span>
|                               class="cite-bracket"
|                               id="mwGA"
|                               "["
|                             "a"
|                             <span>
|                               class="cite-bracket"
|                               id="mwGQ"
|                               "]"
|                       " for documents designed to be displayed in a "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Web_browser"
|                         id="mwGg"
|                         rel="mw:WikiLink"
|                         title="Web browser"
|                         "web browser"
|                       ". It defines the content and structure of "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Web_content"
|                         id="mwGw"
|                         rel="mw:WikiLink"
|                         title="Web content"
|                         "web content"
|                       ". It is often assisted by technologies such as "
|                       <a>
|                         class="mw-redirect"
|                         href="https://en.wikipedia.org/wiki/Cascading_Style_Sheets"
|                         id="mwHA"
|                         rel="mw:WikiLink"
|                         title="Cascading Style Sheets"
|                         "Cascading Style Sheets"
|                       " (CSS) and "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Scripting_language"
|                         id="mwHQ"
|                         rel="mw:WikiLink"
|                         title="Scripting language"
|                         "scripting languages"
|                       " such as "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/JavaScript"
|                         id="mwHg"
|                         rel="mw:WikiLink"
|                         title="JavaScript"
|                         "JavaScript"
|                       "."
|                     "

"
|                     <p>
|                       id="mwHw"
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Web_browser"
|                         id="mwIA"
|                         rel="mw:WikiLink"
|                         title="Web browser"
|                         "Web browsers"
|                       " receive HTML documents from a "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Web_server"
|                         id="mwIQ"
|                         rel="mw:WikiLink"
|                         title="Web server"
|                         "web server"
|                       " or from local storage and "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Browser_engine"
|                         id="mwIg"
|                         rel="mw:WikiLink"
|                         title="Browser engine"
|                         "render"
|                       " the documents into "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Multimedia"
|                         id="mwIw"
|                         rel="mw:WikiLink"
|                         title="Multimedia"
|                         "multimedia"
|                       " web pages. HTML describes the structure of a "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Web_page"
|                         id="mwJA"
|                         rel="mw:WikiLink"
|                         title="Web page"
|                         "web page"
|                       " "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Semantic_Web"
|                         id="mwJQ"
|                         rel="mw:WikiLink"
|                         title="Semantic Web"
|                         "semantically"
|                       " and originally included cues for its appearance."
|                     "

"
|                     <p>
|                       id="mwJg"
|                       <a>
|                         href="https://en.wikipedia.org/wiki/HTML_element"
|                         id="mwJw"
|                         rel="mw:WikiLink"
|                         title="HTML element"
|                         "HTML elements"
|                       " are the building blocks of HTML pages. With HTML constructs, "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/HTML_element#Images_and_objects"
|                         id="mwKA"
|                         rel="mw:WikiLink"
|                         title="HTML element"
|                         "images"
|                       " and other objects such as "
|                       <a>
|                         class="mw-redirect"
|                         href="https://en.wikipedia.org/wiki/Fieldset"
|                         id="mwKQ"
|                         rel="mw:WikiLink"
|                         title="Fieldset"
|                         "interactive forms"
|                       " may be embedded into the rendered page. HTML provides a means to create "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Structured_document"
|                         id="mwKg"
|                         rel="mw:WikiLink"
|                         title="Structured document"
|                         "structured documents"
|                       " by denoting structural "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Semantics"
|                         id="mwKw"
|                         rel="mw:WikiLink"
|                         title="Semantics"
|                         "semantics"
|                       " for text such as headings, paragraphs, lists, "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Hyperlink"
|                         id="mwLA"
|                         rel="mw:WikiLink"
|                         title="Hyperlink"
|                         "links"
|                       ", quotes, and other items. HTML elements are delineated by "
|                       <i>
|                         id="mwLQ"
|                         "tags"
|                       ", written using "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Bracket#Angle_brackets"
|                         id="mwLg"
|                         rel="mw:WikiLink"
|                         title="Bracket"
|                         "angle brackets"
|                       ". Tags such as "
|                       <code>
|                         about="#mwt37"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<img>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<img>"}},"i":0}}]}"
|                         dir="ltr"
|                         id="mwLw"
|                         style=""
|                         typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                         <span>
|                           class="p"
|                           id="mwMA"
|                           "<"
|                         <span>
|                           class="nt"
|                           id="mwMQ"
|                           "img"
|                         <span>
|                           class="p"
|                           id="mwMg"
|                           ">"
|                       " and "
|                       <code>
|                         about="#mwt39"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<input>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"1":{"wt":"<input>"}},"i":0}}]}"
|                         dir="ltr"
|                         id="mwMw"
|                         style=""
|                         typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                         <span>
|                           class="p"
|                           id="mwNA"
|                           "<"
|                         <span>
|                           class="nt"
|                           id="mwNQ"
|                           "input"
|                         <span>
|                           class="p"
|                           id="mwNg"
|                           ">"
|                       " directly introduce content into the page. Other tags such as "
|                       <code>
|                         about="#mwt41"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<p>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<p>"}},"i":0}}]}"
|                         dir="ltr"
|                         id="mwNw"
|                         style=""
|                         typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                         <span>
|                           class="p"
|                           id="mwOA"
|                           "<"
|                         <span>
|                           class="nt"
|                           id="mwOQ"
|                           "p"
|                         <span>
|                           class="p"
|                           id="mwOg"
|                           ">"
|                       " and its corresponding closing tag "
|                       <code>
|                         about="#mwt43"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"</p>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"</p>"}},"i":0}}]}"
|                         dir="ltr"
|                         id="mwOw"
|                         style=""
|                         typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                         <span>
|                           class="p"
|                           id="mwPA"
|                           "</"
|                         <span>
|                           class="nt"
|                           id="mwPQ"
|                           "p"
|                         <span>
|                           class="p"
|                           id="mwPg"
|                           ">"
|                       " surround and provide information about document text and may include sub-element tags. "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Web_browser"
|                         id="mwPw"
|                         rel="mw:WikiLink"
|                         title="Web browser"
|                         "Browsers"
|                       " do not display the HTML tags, but use them to interpret the content of the page."
|                     "

"
|                     <p>
|                       id="mwQA"
|                       "HTML can embed programs written in a "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/Scripting_language"
|                         id="mwQQ"
|                         rel="mw:WikiLink"
|                         title="Scripting language"
|                         "scripting language"
|                       " such as "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/JavaScript"
|                         id="mwQg"
|                         rel="mw:WikiLink"
|                         title="JavaScript"
|                         "JavaScript"
|                       ", which affects the behavior and content of web pages. The inclusion of CSS defines the look and layout of content. The "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/World_Wide_Web_Consortium"
|                         id="mwQw"
|                         rel="mw:WikiLink"
|                         title="World Wide Web Consortium"
|                         "World Wide Web Consortium"
|                       " (W3C), former maintainer of the HTML and current maintainer of the CSS standards, has encouraged the use of "
|                       <a>
|                         href="https://en.wikipedia.org/wiki/CSS"
|                         id="mwRA"
|                         rel="mw:WikiLink"
|                         title="CSS"
|                         "CSS"
|                       " over explicit presentational HTML "
|                       <span>
|                         about="#mwt45"
|                         data-mw="{"parts":[{"template":{"target":{"wt":"as of","href":"./Template:As_of"},"params":{"1":{"wt":"1997"},"lc":{"wt":"y"},"since":{"wt":"y"},"post":{"wt":"."}},"i":0}}]}"
|                         id="mwRQ"
|                         typeof="mw:Transclusion"
|                         "since 1997"
|                       <span>
|                         about="#mwt45"
|                         typeof="mw:Nowiki"
|                       <span>
|                         about="#mwt45"
|                         "."
