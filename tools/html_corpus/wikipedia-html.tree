|                       <code>
|                         about="#mwt313"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<div>"},"parts":[{"template":{"target":{"wt":"code ","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<div>"}},"i":0}}]}"
|                         dir="ltr"
