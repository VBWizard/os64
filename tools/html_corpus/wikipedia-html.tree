"
|                   <section>
|                     aria-labelledby="Markup"
|                     data-mw-section-id="11"
|                     id="mwAjw"
|                     <div>
|                       class="mw-heading mw-heading2"
|                       <h2>
|                         id="Markup"
|                         "Markup"
|                     "
"
|                     <p>
|                       id="mwAj0"
|                       "HTML markup consists of several key components, including those called "
|                       <i>
|                         id="mwAj4"
|                         "tags"
|                       " (and their "
|                       <i>
|                         id="mwAj8"
|                         "attributes"
|                       "), character-based "
|                       <i>
|                         id="mwAkA"
|                         "data types"
|                       ", "
|                       <i>
|                         id="mwAkE"
|                         "character references"
|                       " and "
|                       <i>
|                         id="mwAkI"
|                         "entity references"
|                       ". HTML tags most commonly come in pairs like "
|                       <code>
|                         about="#mwt296"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<h1>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<h1>"}},"i":0}}]}"
|                         dir="ltr"
|                         id="mwAkM"
|                         style=""
|                         typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                         <span>
|                           class="p"
|                           id="mwAkQ"
|                           "<"
|                         <span>
|                           class="nt"
|                           id="mwAkU"
|                           "h1"
|                         <span>
|                           class="p"
|                           id="mwAkY"
|                           ">"
|                       " and "
|                       <code>
|                         about="#mwt298"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"</h1>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"</h1>"}},"i":0}}]}"
|                         dir="ltr"
|                         id="mwAkc"
|                         style=""
|                         typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                         <span>
|                           class="p"
|                           id="mwAkg"
|                           "</"
|                         <span>
|                           class="nt"
|                           id="mwAkk"
|                           "h1"
|                         <span>
|                           class="p"
|                           id="mwAko"
|                           ">"
|                       ", although some represent "
|                       <i>
|                         id="mwAks"
|                         "empty elements"
|                       " and so are unpaired, for example "
|                       <code>
|                         about="#mwt300"
|                         class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                         data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<img>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<img>"}},"i":0}}]}"
|                         dir="ltr"
|                         id="mwAkw"
|                         style=""
|                         typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                         <span>
|                           class="p"
|                           id="mwAk0"
|                           "<"
|                         <span>
|                           class="nt"
|                           id="mwAk4"
|                           "img"
|                         <span>
|                           class="p"
|                           id="mwAk8"
|                           ">"
|                       ". The first tag in such a pair is the "
|                       <i>
|                         id="mwAlA"
|                         "start tag"
|                       ", and the second is the "
|                       <i>
|                         id="mwAlE"
|                         "end tag"
|                       " (they are also called "
|                       <i>
|                         id="mwAlI"
|                         "opening tags"
|                       " and "
|                       <i>
|                         id="mwAlM"
|                         "closing tags"
|                       ")."
|                     "

"
|                     <p>
|                       id="mwAlQ"
|                       "Another important component is the HTML "
|                       <i>
|                         id="mwAlU"
|                         <a>
|                           href="https://en.wikipedia.org/wiki/Document_type_declaration"
|                           id="mwAlY"
|                           rel="mw:WikiLink"
|                           title="Document type declaration"
|                           "document type declaration"
|                       ", which triggers "
|                       <a>
|                         class="mw-redirect"
|                         href="https://en.wikipedia.org/wiki/Standards_mode"
|                         id="mwAlc"
|                         rel="mw:WikiLink"
|                         title="Standards mode"
|                         "standards mode"
|                       " rendering."
|                     "

"
