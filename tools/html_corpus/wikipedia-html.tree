|                               about="#mwt370"
|                               class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                               data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<p>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<p>"}},"i":0}}]}"
