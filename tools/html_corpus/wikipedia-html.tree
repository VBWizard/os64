|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mw9Q"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw9g"
|                                     "["
|                                   "22"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw9w"
|                                     "]"
|                             " was published as a W3C Recommendation. It offers the same three variations as HTML 4.0 and its last errata"
|                             <sup>
|                               about="#mwt126"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-24"}}"
|                               id="cite_ref-24"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
