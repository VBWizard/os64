"
|                         <p>
|                           id="mwAw0"
|                           "Header of the HTML document: "
|                           <code>
|                             about="#mwt353"
|                             class="mw-highlight mw-highlight-lang-html mw-content-ltr"
|                             data-mw="{"name":"syntaxhighlight","attrs":{"lang":"html","class":"","style":"","inline":"1"},"body":{"extsrc":"<head>...</head>"},"parts":[{"template":{"target":{"wt":"code","href":"./Template:Code"},"params":{"lang":{"wt":"html"},"code":{"wt":"<head>...</head>"}},"i":0}}]}"
|                             dir="ltr"
|                             id="mwAw4"
|                             style=""
|                             typeof="mw:Extension/syntaxhighlight mw:Transclusion"
|                             <span>
|                               class="p"
|                               id="mwAw8"
|                               "<"
|                             <span>
|                               class="nt"
|                               id="mwAxA"
|                               "head"
|                             <span>
|                               class="p"
|                               id="mwAxE"
|                               ">"
|                             "..."
|                             <span>
|                               class="p"
|                               id="mwAxI"
|                               "</"
|                             <span>
|                               class="nt"
|                               id="mwAxM"
|                               "head"
|                             <span>
|                               class="p"
|                               id="mwAxQ"
|                               ">"
|                           ". The title is included in the head, for example:"
|                         "
"
|                         <div>
|                           about="#mwt355"
|                           class="mw-highlight mw-highlight-lang-html mw-content-ltr"
