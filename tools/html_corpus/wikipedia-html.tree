|                                 id="mw-A"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mw-Q"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw-g"
|                                     "["
|                                   "23"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mw-w"
|                                     "]"
|                             " were published on 12 May 2001."
|                           "
"
|                           <dt>
|                             id="mw_A"
|                             "May 2000"
|                           <dd>
|                             id="mw_Q"
|                             "ISO/IEC 15445:2000"
|                             <sup>
|                               about="#mwt129"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{"name":"iso-html"},"body":{"id":"mw-reference-text-cite_note-iso-html-25"}}"
|                               id="cite_ref-iso-html_25-0"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-iso-html-25"
|                                 id="mw_g"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mw_w"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwAQA"
|                                     "["
|                                   "24"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwAQE"
|                                     "]"
|                             " (""
|                             <a>
|                               href="https://en.wikipedia.org/wiki/International_Organization_for_Standardization"
|                               id="mwAQI"
|                               rel="mw:WikiLink"
|                               title="International Organization for Standardization"
|                               "ISO"
|                             " HTML", based on HTML 4.01 Strict) was published as an ISO/IEC international standard."
|                             <sup>
|                               about="#mwt132"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-26"}}"
|                               id="cite_ref-26"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-26"
|                                 id="mwAQM"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mwAQQ"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwAQU"
|                                     "["
|                                   "25"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwAQY"
|                                     "]"
|                             " In the ISO, this standard is in the domain of the "
|                             <a>
|                               href="https://en.wikipedia.org/wiki/ISO/IEC_JTC_1/SC_34"
|                               id="mwAQc"
|                               rel="mw:WikiLink"
|                               title="ISO/IEC JTC 1/SC 34"
|                               "ISO/IEC JTC 1/SC 34"
|                             " (ISO/IEC Joint Technical Committee 1, Subcommittee 34"
|                             <span>
|                               id="mwAQg"
|                               typeof="mw:Entity"
|                               " "
|                             "– Document description and processing languages)."
|                             <sup>
|                               about="#mwt133"
|                               class="mw-ref reference"
|                               data-mw="{"name":"ref","attrs":{"name":"iso-html"}}"
|                               id="cite_ref-iso-html_25-1"
|                               rel="dc:references"
|                               typeof="mw:Extension/ref"
|                               <a>
|                                 href="#cite_note-iso-html-25"
|                                 id="mwAQk"
|                                 <span>
|                                   class="mw-reflink-text"
|                                   id="mwAQo"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwAQs"
|                                     "["
|                                   "24"
|                                   <span>
|                                     class="cite-bracket"
|                                     id="mwAQw"
|                                     "]"
|                             "
"
|                             <dl>
|                               id="mwAQ0"
|                               <dd>
|                                 id="mwAQ4"
|                                 "After HTML 4.01, there were no new versions of HTML for many years, as the development of the parallel, XML-based language XHTML occupied the W3C's HTML Working Group."
|                         "

"
