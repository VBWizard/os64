From b08a2eb0dd37f4a6c886fa5b0ecf5b3e1d27aac7 Mon Sep 17 00:00:00 2001
From: Alexei Podtelezhnikov <apodtele@gmail.com>
Date: Sun, 31 May 2026 14:06:45 -0400
Subject: [PATCH] * src/autofit/afgsub.c (af_validate_coverage): Use unsigned
 variables.

---
 src/autofit/afgsub.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/autofit/afgsub.c b/src/autofit/afgsub.c
index dfdb99641..3d6b231aa 100644
--- a/src/autofit/afgsub.c
+++ b/src/autofit/afgsub.c
@@ -67,8 +67,8 @@
     {
       FT_UInt   rangeCount = FT_NEXT_USHORT( p );
       FT_Byte*  limit      = p + rangeCount * 6;
-      FT_Int    startGlyphID;
-      FT_Int    endGlyphID = -1;
+      FT_UInt   startGlyphID;
+      FT_UInt   endGlyphID = 0;
 
 
       if ( table_limit < limit )
@@ -77,14 +77,14 @@
       while ( p < limit )
       {
         startGlyphID = FT_NEXT_USHORT( p );
-        if ( startGlyphID <= endGlyphID )
+        if ( startGlyphID < endGlyphID )
           return FALSE;
 
         endGlyphID = FT_NEXT_USHORT( p );
         if ( endGlyphID < startGlyphID )
           return FALSE;
 
-        count += endGlyphID - startGlyphID + 1;
+        count += ++endGlyphID - startGlyphID;
 
         /* We don't validate coverage indices. */
         p += 2;
