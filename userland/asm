#!/bin/bash
# asm — open an app's disassembly, optionally parked on a crash address.
#
# Usage:
#   asm <app>             browse <app>'s disassembly in vi
#   asm <app> <addr>      same, but positioned on the instruction at <addr>
#   asm <addr>            you have a RIP and don't know whose it is: every app
#                         links at its own 16MB window (tools/app_bases.py), so
#                         the address ALONE identifies the app — this looks it
#                         up, tells you, and opens the disassembly right there.
#
# <addr> is hex, 0x prefix optional. If the address isn't exactly an
# instruction start (mid-instruction RIP, byte-shifted garbage), the nearest
# preceding instruction is used and the difference reported.
#
# Piping works: with stdout not a tty there's no vi — plain-browse mode cats
# the whole disassembly (`asm hog | grep call`), address mode prints the
# neighborhood around the located instruction.
#
# Successor to the old apps/hog/asm three-liner, which was hardwired to hog.

set -u

USERLAND="$(cd "$(dirname "$0")" && pwd)"
BIN="$USERLAND/bin"
BASES="$BIN/app_bases.gdb"      # generated by the build: one line per app,
                                # "add-symbol-file <path> <base>" — the same
                                # numbers the binaries were actually linked at
SLOT_SIZE=$((0x01000000))       # 16MB per app window (tools/app_bases.py)

die() { echo "asm: $*" >&2; exit 1; }

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

# ---- argument shapes ------------------------------------------------------
# "Is it an app or an address?" — an existing apps/<name>/ dir wins (no app
# is named in pure hex today; if one ever is, its directory keeps winning and
# you can still reach the address form as `asm <hex-app> <addr>`).
is_hex() { [[ "${1#0x}" =~ ^[0-9a-fA-F]+$ ]]; }

app="" addr=""
case $# in
    1)  if [ -d "$USERLAND/apps/$1" ]; then app="$1"
        elif is_hex "$1"; then addr="$1"
        else die "'$1' is neither an app in apps/ nor a hex address"
        fi ;;
    2)  app="$1"; addr="$2"
        [ -d "$USERLAND/apps/$app" ] || die "no such app: $app"
        is_hex "$addr" || die "'$addr' is not a hex address" ;;
    *)  usage ;;
esac

[ -n "$addr" ] && addr=$((16#${addr#0x}))     # normalize to a plain number

# ---- address → app --------------------------------------------------------
# Walk the generated base map and find the window the address falls in.
if [ -n "$addr" ] && [ -z "$app" ]; then
    [ -r "$BASES" ] || die "$BASES not found — build userland first (make)"
    while read -r cmd path base; do
        [ "$cmd" = "add-symbol-file" ] || continue
        b=$((base))
        if [ "$addr" -ge "$b" ] && [ "$addr" -lt $((b + SLOT_SIZE)) ]; then
            app="$(basename "$path")"
            printf 'asm: 0x%x is %s (base %s, offset +0x%x)\n' \
                   "$addr" "$app" "$base" $((addr - b)) >&2
            break
        fi
    done < "$BASES"
    [ -n "$app" ] || die "$(printf '0x%x is in no app'\''s window' "$addr")"
fi

elf="$BIN/$app"
[ -r "$elf" ] || die "$elf not built — run make in userland/"

# ---- disassemble ----------------------------------------------------------
# Prefer the cross toolchain's objdump; the host's reads these ELFs fine too
# (the header names the architecture — no flag needed, it autodetects).
OBJDUMP="$(command -v x86_64-elf-objdump || command -v objdump)" \
    || die "no objdump on PATH"

tmp="$(mktemp "/tmp/asm.$app.XXXXXX.asm")" || die "mktemp failed"
trap 'rm -f "$tmp"' EXIT

"$OBJDUMP" -S -l -M intel "$elf" > "$tmp" || die "objdump failed on $elf"

# ---- no address: plain browse --------------------------------------------
if [ -z "$addr" ]; then
    if [ -t 1 ]; then vi "$tmp"; else cat "$tmp"; fi
    exit 0
fi

# ---- address: find the line ----------------------------------------------
# objdump instruction lines look like "  50400123:\t...". Exact match first
# (a faulting RIP is almost always an instruction start); otherwise take the
# nearest preceding instruction and say how far off we landed.
hex="$(printf '%x' "$addr")"
line="$(grep -n -m1 "^[[:space:]]*$hex:" "$tmp" | cut -d: -f1)"

if [ -z "$line" ]; then
    best_line="" best_a=0
    while IFS=: read -r n a; do
        v=$((16#$a))
        [ "$v" -le "$addr" ] || break     # addresses ascend; past it, done
        best_line="$n"; best_a="$v"
    done < <(grep -n "^[[:space:]]*[0-9a-f]\{1,16\}:" "$tmp" \
             | sed 's/^\([0-9]*\):[[:space:]]*\([0-9a-f]*\):.*/\1:\2/')
    [ -n "$best_line" ] || die "$(printf '0x%x precedes every instruction in %s' "$addr" "$app")"
    printf 'asm: no instruction starts at 0x%x — nearest preceding is 0x%x (-0x%x)\n' \
           "$addr" "$best_a" $((addr - best_a)) >&2
    line="$best_line"
fi

if [ -t 1 ]; then
    vi "+$line" -c 'normal zz' "$tmp"
else
    # Piped: print the neighborhood instead (10 lines above, 15 below).
    start=$((line > 10 ? line - 10 : 1))
    sed -n "${start},$((line + 15))p" "$tmp"
fi
