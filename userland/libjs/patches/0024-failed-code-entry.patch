+/* Engine wrapper links can be inspected without calling traps.
+   Unknown custom call classes and over-deep chains fail closed once a
+   context has failed. Revoked proxies have no executable path. */
+static BOOL js_failed_call_allowed(JSContext *ctx, JSValueConst function)
+{
+    JSObject *p;
+    unsigned hops = 0;
+    JSExecutionScopeInfo info;
+    if (!ctx->rt->executable_failure_seen)
+        return TRUE;
+    if (ctx->executable_failed)
+        return FALSE;
+    while (JS_IsObject(function)) {
+        p = JS_VALUE_GET_OBJ(function);
+        if (p->class_id == JS_CLASS_BOUND_FUNCTION) {
+            if (hops++ == 64)
+                return FALSE;
+            function = p->u.bound_function->func_obj;
+        } else if (p->class_id == JS_CLASS_PROXY) {
+            JSProxyData *proxy = p->u.opaque;
+            if (!proxy || proxy->is_revoked)
+                return TRUE;
+            if (hops++ == 64)
+                return FALSE;
+            function = proxy->target;
+        } else {
+            break;
+        }
+    }
+    info = js_execution_call_info(ctx, function, JS_EXECUTION_SCOPE_CALL);
+    return info.code_kind != JS_EXECUTION_CODE_UNKNOWN && info.code &&
+        !info.code->executable_failed;
+}
