+/* Owner-thread timing observer, for a profiler's ledger. Each pair brackets:
+   native, a C-function-with-data invocation (the function and magic it was
+   made with); script, a call into script from C through JS_Call,
+   JS_CallConstructor, JS_CallConstructor2 or JS_EvalFunction; collector, a
+   cycle collection. Pairs nest and always close in order, also when the
+   bracketed work throws. A hook must not call into the engine. A null hooks
+   pointer removes the observer; hooks and opaque must outlive its
+   installation. Unobserved, each site costs one pointer test. */
+typedef struct JSLedgerHooks {
+    void (*native_enter)(void *opaque, JSCFunctionData *func, int magic);
+    void (*native_leave)(void *opaque);
+    void (*script_enter)(void *opaque);
+    void (*script_leave)(void *opaque);
+    void (*collector_enter)(void *opaque);
+    void (*collector_leave)(void *opaque);
+} JSLedgerHooks;
+void JS_SetLedgerHooks(JSRuntime *rt, const JSLedgerHooks *hooks, void *opaque);
