+/* os64: a rejected promise whose result the engine itself took, made
+   handled as perform_promise_then makes one, and the tracker told so. */
+static void js_promise_mark_handled(JSContext *ctx, JSValueConst promise)
+{
+    JSPromiseData *s = JS_GetOpaque(promise, JS_CLASS_PROMISE);
+    if (s == NULL || s->is_handled)
+        return;
+    s->is_handled = TRUE;
+    if (s->promise_state == JS_PROMISE_REJECTED && ctx->rt->host_promise_rejection_tracker) {
+        ctx->rt->host_promise_rejection_tracker(ctx, promise, s->promise_result, TRUE,
+                                                ctx->rt->host_promise_rejection_tracker_opaque);
+    }
