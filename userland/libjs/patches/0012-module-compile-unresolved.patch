+/* os64: a failed resolve leaves nothing it marked resolved. Upstream
+   discards what a failure touched, but a host whose modules outlive a
+   failed run (a browser's module map, shared by its page's graphs)
+   reaches them again, and a module left marked is linked through
+   rme->module, which neither counts nor marks what it names: the NULL of
+   an import never found, or a module this failure freed — in a cycle,
+   the one whose import failed is the ancestor every member points back
+   at. So every module marked during the attempt is reset, wherever the
+   failure was. A loader that compiles one of the imports resolves it in
+   an attempt nested inside this one, whose modules may point into this
+   one's half-resolved set, and whose failure always fails this one, so
+   only the outermost attempt resets, and it resets what the nested ones
+   marked. The walk is over the loaded list because a module freed by
+   the failure has left it; the root is reset directly because a host's
+   handle may hold it after an earlier failure took it off the list. */
+static int js_resolve_module(JSContext *ctx, JSModuleDef *m)
+{
+    struct list_head *el;
+    int ret;
+
+    if (m->resolved)
+        return 0;
+    if (ctx->resolve_depth++ == 0 && ++ctx->resolve_attempt == 0)
+        ctx->resolve_attempt = 1;
+    ret = js_resolve_module_marking(ctx, m);
+    if (--ctx->resolve_depth == 0 && ret < 0) {
+        list_for_each(el, &ctx->loaded_modules) {
+            JSModuleDef *m1 = list_entry(el, JSModuleDef, link);
+            if (m1->resolved && m1->resolve_attempt == ctx->resolve_attempt)
+                m1->resolved = FALSE;
+        }
+        m->resolved = FALSE;
+    }
+    return ret;
+}
