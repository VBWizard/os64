+/* os64: with JS_EVAL_TYPE_MODULE and JS_EVAL_FLAG_COMPILE_ONLY, keep the
+   compiled module UNRESOLVED: its imports are not loaded, so a host whose
+   loader cannot answer yet (it has still to fetch them) can read them
+   (JS_GetModuleRequest) and call JS_ResolveModule once it can. Refused
+   with any other eval type, and without COMPILE_ONLY. */
+#define JS_EVAL_FLAG_NO_RESOLVE (1 << 8)
 
