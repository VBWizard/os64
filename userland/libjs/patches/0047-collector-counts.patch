+/* Cycle collections since the runtime was made, counted at every run (one
+   addition per GC object walked, two clock reads per run once a clock is
+   set): runs, by what asked (the allocation threshold, or anything else
+   through JS_RunGC); the GC objects the runs walked, and the objects,
+   function bytecodes, async functions and modules they freed from cycles
+   (what those hold goes with them, uncounted); the heap's malloc bytes
+   before and after each run, summed;
+   the threshold the next allocation-asked run waits for; the most one run
+   walked; and, with a clock (JS_SetCollectorClock), the runs' time in its
+   ticks and the longest. Owner thread. */
+typedef struct JSCollectorCounts {
+    uint64_t runs, runs_by_allocation;
+    uint64_t walked, freed, walked_most;
+    uint64_t bytes_before, bytes_after;
+    uint64_t threshold;
+    uint64_t ticks, ticks_most;
+} JSCollectorCounts;
+void JS_GetCollectorCounts(JSRuntime *rt, JSCollectorCounts *out);
+/* The clock the counts time runs with; NULL leaves them untimed. It must
+   not call into the engine. */
+void JS_SetCollectorClock(JSRuntime *rt, uint64_t (*now)(void));
