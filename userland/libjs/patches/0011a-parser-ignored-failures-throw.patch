# Three places where the parser ignored an allocation's failure and went
# on: a child definition whose constant-pool add failed (js_create_function
# asserted on its missing slot, ending the program), a closure-variable add
# in resolve_scope_var (its -1 used as an index, emitted as nothing, or
# taken by resolve_variables as the next position and read at bc_buf[-1]),
# and get_lvalue reading a failed bytecode buffer as a bad assignment target
# (a SyntaxError). Each now throws out of memory through the existing fail
# path. resolve_labels' output buffer, the tokenizer lookahead, the
# pseudo-variable adds and add_eval_variables are not covered (DEBTS.md).
--- a/quickjs.c
+++ b/quickjs.c
@@ -26097,6 +26097,14 @@
         depth = 3;
         break;
     default:
+        /* os64: get_prev_opcode answers OP_invalid once the bytecode
+           buffer has failed to grow, so the lvalue's opcode was never
+           written; upstream reported that out-of-memory as a SyntaxError
+           naming the script's assignment. */
+        if (dbuf_error(&fd->byte_code)) {
+            JS_ThrowOutOfMemory(s->ctx);
+            return -1;
+        }
     invalid_lvalue:
         if (tok == TOK_FOR) {
             return js_parse_error(s, "invalid for in/of left hand-side");
@@ -33034,6 +33042,11 @@
 }
 
