+   closure-variable array (out of memory, or too many closure variables),
+   and it has thrown when it does. Upstream used its -1 here as an index,
+   or emitted nothing (a later "stack underflow"); each call below now
+   returns -1, which resolve_variables takes to its fail path. */
 static int resolve_scope_var(JSContext *ctx, JSFunctionDef *s,
                              JSAtom var_name, int scope_level, int op,
                              DynBuf *bc, uint8_t *bc_buf,
@@ -33243,11 +33256,12 @@
