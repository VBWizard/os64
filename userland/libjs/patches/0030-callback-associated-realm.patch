+/* Callback associated realm, distinct from executable target discovery.
+   Bound functions inherit their target object's associated realm; a proxy
+   keeps the realm of its constructor, even after revocation. No properties,
+   traps, allocation or exception mutation are involved. Unknown native call
+   classes have no proven associated realm and are refused. */
+JSContext *JS_GetCallbackRealm(JSContext *ctx, JSValueConst function)
+{
+    for (;;) {
+        JSObject *p;
+        if (JS_VALUE_GET_TAG(function) != JS_TAG_OBJECT)
+            return NULL;
+        p = JS_VALUE_GET_OBJ(function);
+        switch (p->class_id) {
+        case JS_CLASS_BOUND_FUNCTION:
+            function = p->u.bound_function->func_obj;
+            break;
+        case JS_CLASS_PROXY: {
+            JSProxyData *s = p->u.opaque;
+            return s && s->is_func ? s->creation_realm : NULL;
+        }
+        case JS_CLASS_C_FUNCTION:
+        case JS_CLASS_C_FUNCTION_DATA:
+        case JS_CLASS_ASYNC_FUNCTION_RESOLVE:
+        case JS_CLASS_ASYNC_FUNCTION_REJECT:
+        case JS_CLASS_PROMISE_RESOLVE_FUNCTION:
+        case JS_CLASS_PROMISE_REJECT_FUNCTION:
+        case JS_CLASS_BYTECODE_FUNCTION:
+        case JS_CLASS_GENERATOR_FUNCTION:
+        case JS_CLASS_ASYNC_FUNCTION:
+        case JS_CLASS_ASYNC_GENERATOR_FUNCTION:
+            return js_function_realm(ctx, function, FALSE);
+        default:
+            return NULL;
         }
     }
 }
