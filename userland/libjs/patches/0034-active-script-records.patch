+/* The optional closure array has one trailing record pointer. Keeping this
+   edge out of the union avoids charging nonfunctions for source provenance. */
+static JSValue js_function_script_or_module(JSObject *p)
+{
+    if (!p->has_script_provenance || !p->u.func.var_refs)
+        return JS_UNDEFINED;
+    return JS_MKPTR(p->script_record_is_module ? JS_TAG_MODULE : JS_TAG_FUNCTION_BYTECODE,
+                    p->u.func.var_refs[p->u.func.function_bytecode->closure_var_count]);
+}
+
+static JSValueConst js_active_script_or_module(JSRuntime *rt)
+{
+    return rt->settings_script_frame ? rt->settings_script_frame->script_or_module : JS_UNDEFINED;
+}
+
+JSValue JS_GetActiveScriptOrModule(JSRuntime *rt)
+{
+    return JS_DupValueRT(rt, js_active_script_or_module(rt));
+}
+
+JSContext *JS_GetScriptOrModuleContext(JSValueConst record)
+{
+    if (JS_VALUE_GET_TAG(record) == JS_TAG_MODULE)
+        return ((JSModuleDef *)JS_VALUE_GET_PTR(record))->realm;
+    if (JS_VALUE_GET_TAG(record) == JS_TAG_FUNCTION_BYTECODE)
+        return ((JSFunctionBytecode *)JS_VALUE_GET_PTR(record))->realm;
+    return NULL;
+}
+
+static JSAtom js_script_or_module_name(JSValueConst record)
+{
+    if (JS_VALUE_GET_TAG(record) == JS_TAG_MODULE)
+        return ((JSModuleDef *)JS_VALUE_GET_PTR(record))->module_name;
+    if (JS_VALUE_GET_TAG(record) == JS_TAG_FUNCTION_BYTECODE)
+        return ((JSFunctionBytecode *)JS_VALUE_GET_PTR(record))->source_name;
+    return JS_ATOM_NULL;
+}
