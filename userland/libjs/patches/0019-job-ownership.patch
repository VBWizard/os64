+/* The head's contexts are borrowed until execution/discard. Inspection runs
+   no code; release uses the same retained values as ordinary job completion. */
+BOOL JS_PeekPendingJob(JSRuntime *rt, JSJobInfo *info)
+{
+    JSJobEntry *e;
+    if (list_empty(&rt->job_list))
+        return FALSE;
+    e = list_entry(rt->job_list.next, JSJobEntry, link);
+    *info = (JSJobInfo){ e->realm, e->owner, e->activity };
+    return TRUE;
+}
+
+int JS_DiscardPendingJob(JSRuntime *rt)
+{
+    JSJobEntry *e;
+    int i;
+    if (list_empty(&rt->job_list))
+        return 0;
+    e = list_entry(rt->job_list.next, JSJobEntry, link);
+    list_del(&e->link);
+    for (i = 0; i < e->argc; i++)
+        JS_FreeValueRT(rt, e->argv[i]);
+    if (e->owner) JS_FreeContext(e->owner);
+    if (e->activity) JS_FreeContext(e->activity);
+    JS_FreeContext(e->realm);
+    js_free_rt(rt, e);
+    return 1;
 }
 
