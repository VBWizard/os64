+/* Eligibility is separate from the native execution context. NULL owners
+ * explicitly represent neutral work; activity adds an owning-host gate.
+ * Contexts must belong to the same runtime. Queue entries retain them. */
+typedef struct JSJobInfo {
+    JSContext *context, *owner, *activity;
+} JSJobInfo;
+int JS_EnqueueJobOwned(JSContext *ctx, JSContext *owner, JSContext *activity,
+                      JSJobFunc *job_func, int argc, JSValueConst *argv);
+/* Peek allocates nothing and borrows until a queue mutation. Discard
+ * releases the head's holds (including native finalizers), not its body. */
+JS_BOOL JS_PeekPendingJob(JSRuntime *rt, JSJobInfo *info);
+int JS_DiscardPendingJob(JSRuntime *rt);
+
 JS_BOOL JS_IsJobPending(JSRuntime *rt);
