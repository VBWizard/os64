+/* Empty-handler reactions have no script entry. A custom capability can
+   nevertheless run code: expose its actual current/script incumbent without
+   borrowing an outer host scope or inventing an entry/backup realm. */
+static JSValue js_neutral_job_body(JSContext *ctx, JSJobEntry *e)
+{
+    JSRuntime *rt = ctx->rt;
+    if (rt->settings_depth == JS_SETTINGS_SCOPE_LIMIT)
+        return JS_ThrowInternalError(ctx, "Job settings nesting limit");
+    JSContext *entry = rt->settings_entry, *backup = rt->settings_backup;
+    JSContext *current = rt->settings_current;
+    JSSettingsFrame *script = rt->settings_script_frame;
+    rt->settings_entry = rt->settings_backup = rt->settings_current = NULL;
+    rt->settings_script_frame = NULL;
+    rt->settings_depth++;
+    JSValue result = js_job_settings_body(ctx, e);
+    assert(rt->settings_script_frame == NULL);
+    rt->settings_depth--;
+    rt->settings_script_frame = script;
+    rt->settings_current = current;
+    rt->settings_backup = backup;
+    rt->settings_entry = entry;
+    return result;
 }
 
