+/* Borrowed facts for the innermost active C-function/data invocation, including
+   across its JS reentry. Incoming is the dispatcher argument; defining is the
+   function's creation context. Neither is an HTML settings/security decision.
+   Query on the owner thread; results expire when that invocation returns.
+   Returns false and clears output outside a native invocation or for null rt.
+   A null output returns false. No allocation, exception or refcount changes. */
+typedef struct JSNativeCallContexts {
+    JSContext *incoming;
+    JSContext *defining;
+} JSNativeCallContexts;
+JS_BOOL JS_GetNativeCallContexts(JSRuntime *rt, JSNativeCallContexts *out);
