+/* os64: a browser's census of what pages reach for. The handler hears the
+   name a lookup on the global object did not find, before the lookup
+   answers as it always does (undefined, or the ReferenceError), and the
+   name is in a stack buffer, so hearing it allocates nothing and cannot
+   change what the page sees. It must not call into the engine. */
+void JS_SetGlobalMissHandler(JSContext *ctx,
+                             void (*handler)(void *opaque, const char *name),
+                             void *opaque)
+{
+    ctx->global_miss = handler;
+    ctx->global_miss_opaque = opaque;
+}
+
 /* set the new value and free the old value after (freeing the value
