+/* os64: a lookup that ran off the end of `obj`'s prototype chain. When
+   `obj` is the global object and a handler asked, it hears the name. A
+   symbol or an index is not a name a page reached for. The lookup has two
+   ends that say "not found": JS_GetPropertyInternal's, and the inline
+   field read in JS_CallInternal (GET_FIELD_INLINE), which never calls it
+   when the chain is plain. Both come here. */
+static void js_hear_global_miss(JSContext *ctx, JSValueConst obj, JSAtom prop)
+{
+    char buf[ATOM_GET_STR_BUF_SIZE];
+    if (JS_VALUE_GET_OBJ(obj) != JS_VALUE_GET_OBJ(ctx->global_obj) ||
+        __JS_AtomIsTaggedInt(prop) || JS_AtomGetKind(ctx, prop) != JS_ATOM_KIND_STRING)
+        return;
+    ctx->global_miss(ctx->global_miss_opaque, JS_AtomGetStr(ctx, buf, sizeof(buf), prop));
+}
