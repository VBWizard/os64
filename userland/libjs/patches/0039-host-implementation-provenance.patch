+/* Preparation walks only compiled constant-pool edges, before closures exist.
+   The validation pass makes depth/sharing/realm refusal atomic. Serialized
+   code loses this privilege and must be admitted again by its native host. */
+static BOOL js_host_implementation_tree(JSContext *ctx, JSFunctionBytecode *b,
+                                        unsigned depth, BOOL commit)
+{
+    int i;
+    if (depth == 128 || b->realm != ctx || js_rc(b)->ref_count != 1)
+        return FALSE;
+    for (i = 0; i < b->cpool_count; i++) {
+        if (JS_VALUE_GET_TAG(b->cpool[i]) == JS_TAG_FUNCTION_BYTECODE &&
+            !js_host_implementation_tree(ctx, JS_VALUE_GET_PTR(b->cpool[i]),
+                                         depth + 1, commit))
+            return FALSE;
+    }
+    if (commit)
+        b->is_host_implementation = TRUE;
+    return TRUE;
+}
+
+JS_BOOL JS_PrepareHostImplementation(JSContext *ctx, JSValueConst compiled)
+{
+    if (!ctx || JS_VALUE_GET_TAG(compiled) != JS_TAG_FUNCTION_BYTECODE)
+        return FALSE;
+    JSFunctionBytecode *b = JS_VALUE_GET_PTR(compiled);
+    if (!js_host_implementation_tree(ctx, b, 0, FALSE))
+        return FALSE;
+    return js_host_implementation_tree(ctx, b, 0, TRUE);
 }
 
