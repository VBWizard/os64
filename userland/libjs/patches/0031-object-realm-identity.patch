+/* Live creation identity for non-callable objects, and the established
+   associated callable policy for functions. The identifier does not keep an
+   otherwise unreachable context alive. Embeddings that retain contexts can
+   map the borrowed result to their own lifecycle handles. After context
+   collection, refuse instead of inferring a replacement from a prototype. */
+JSContext *JS_GetObjectRealm(JSContext *ctx, JSValueConst object)
+{
+    struct list_head *el;
+    JSObject *p;
+    if (!JS_IsObject(object))
+        return NULL;
+    if (JS_IsFunction(ctx, object))
+        return JS_GetCallbackRealm(ctx, object);
+    p = JS_VALUE_GET_OBJ(object);
+    list_for_each(el, &ctx->rt->context_list) {
+        JSContext *candidate = list_entry(el, JSContext, link);
+        if (candidate->creation_id == p->creation_context_id)
+            return candidate;
+    }
+    return NULL;
 }
 
