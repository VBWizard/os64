+
+/* HTML creates inline handlers without an associated ScriptOrModule.
+   Match the complete expected function text before changing its marker:
+   source concatenation must not let a malformed body select another closure. */
+JS_BOOL JS_ClearFunctionScriptProvenance(JSValueConst function,
+                                       const char *source, size_t length)
+{
+    JSObject *p;
+    JSFunctionBytecode *b;
+    if (!source || JS_VALUE_GET_TAG(function) != JS_TAG_OBJECT)
+        return FALSE;
+    p = JS_VALUE_GET_OBJ(function);
+    if (!js_class_has_bytecode(p->class_id))
+        return FALSE;
+    b = p->u.func.function_bytecode;
+    if (!b->has_debug || !b->debug.source || b->debug.source_len != length ||
+        memcmp(b->debug.source, source, length))
+        return FALSE;
+    p->has_script_provenance = 0;
+    return TRUE;
 }
 
