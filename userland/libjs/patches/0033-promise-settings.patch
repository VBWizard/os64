+
+static JSValue js_call_promise_callback(JSContext *ctx, JSValueConst function,
+                                       JSValueConst self, int argc, JSValueConst *argv)
+{
+    JSPromiseCallbackCall call = {function, self, argc, argv};
+    JSValue result;
+    if (!ctx->rt->promise_job_incumbent)
+        return js_promise_callback_body(ctx, &call);
