+/* Owner-thread Promise opt-in, configured before author execution. Capture
+ * runs without author code: return 0 with a borrowed incumbent, 0/null for
+ * explicitly trusted bootstrap, or -1 to refuse. The engine retains and
+ * traces captures through pending reactions and queued jobs. Entry follows
+ * enqueue-time GetFunctionRealm, not WebIDL callback association. Exact
+ * ScriptOrModule restoration and finalization jobs are separate contracts. */
+typedef int JSHostPromiseIncumbent(JSContext *ctx, JSContext **incumbent, void *opaque);
+void JS_SetHostPromiseIncumbent(JSRuntime *rt, JSHostPromiseIncumbent *capture, void *opaque);
+/* Read-only borrowed settings for the selected head. False for legacy/neutral
