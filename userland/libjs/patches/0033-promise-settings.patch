+static int js_promise_capture_incumbent(JSContext *ctx, JSValueConst handler, JSContext **out)
+{
+    *out = NULL;
+    /* Neutral engine continuations and empty handlers have no author callback. */
+    if (!ctx->rt->promise_incumbent_capture || !js_job_function_realm(ctx, handler))
+        return 0;
+    if (JS_ENGINE_CALLBACK(ctx->rt, ctx->rt->promise_incumbent_capture(
+            ctx, out, ctx->rt->promise_incumbent_opaque)) < 0) {
+        JS_ThrowTypeError(ctx, "Promise callback incumbent settings unavailable");
+        return -1;
+    }
+    if (*out) *out = JS_DupContext(*out);
+    return 0;
+}
