+/* Groups are caller-owned stable storage; queued entries borrow the group.
+   The second linkage permits bounded candidate-only drains without walking
+   or reordering an arbitrarily long sibling queue. */
+void JS_InitJobGroup(JSJobGroup *group, JSContext *owner)
+{
+    *group = (JSJobGroup){ .runtime = owner->rt, .owner = owner };
+}
+
+JSJobGroup *JS_SetJobGroup(JSRuntime *rt, JSJobGroup *group)
+{
+    JSJobGroup *previous = rt->job_group;
+    assert(!group || group->runtime == rt);
+    rt->job_group = group;
+    return previous;
+}
+
+static void js_job_unlink(JSJobEntry *e)
+{
+    list_del(&e->link);
+    if (e->group) {
+        if (e->group_prev) e->group_prev->group_next = e->group_next;
+        else e->group->first = e->group_next;
+        if (e->group_next) e->group_next->group_prev = e->group_prev;
+        else e->group->last = e->group_prev;
+    }
+}
+
+static JSJobEntry *js_job_first(JSRuntime *rt, JSJobGroup *group)
+{
+    assert(!group || group->runtime == rt);
+    if (group) return group->first;
+    if (list_empty(&rt->job_list)) return NULL;
+    return list_entry(rt->job_list.next, JSJobEntry, link);
+}
