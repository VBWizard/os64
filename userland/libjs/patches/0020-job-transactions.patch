+/* Caller-owned, zero-allocation transaction queue. Initialize with a live
+ * owner and keep the group and owner alive until its entries are released.
+ * NULL group selects the global queue. SetJobGroup scopes future enqueues;
+ * executing a group does not implicitly change the enqueue scope. */
+typedef struct JSJobGroup {
+    JSRuntime *runtime;
+    JSContext *owner;
+    struct JSJobEntry *first, *last;
+} JSJobGroup;
+void JS_InitJobGroup(JSJobGroup *group, JSContext *owner);
+JSJobGroup *JS_SetJobGroup(JSRuntime *rt, JSJobGroup *group);
+JS_BOOL JS_PeekJobGroup(JSRuntime *rt, JSJobGroup *group, JSJobInfo *info);
+int JS_DiscardJobGroup(JSRuntime *rt, JSJobGroup *group);
+int JS_ExecuteJobGroup(JSRuntime *rt, JSJobGroup *group, JSContext **pctx);
+
