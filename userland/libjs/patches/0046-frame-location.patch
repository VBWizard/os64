# Report the bytecode function at a depth of the stack (identity, name, defining file,
# line and column) without allocating, for a sampling profiler inside the interrupt
# handler; a native frame reports "[native]".
--- a/quickjs.h
+++ b/quickjs.h
@@ -506,6 +506,21 @@
     void (*collector_leave)(void *opaque);
 } JSLedgerHooks;
 void JS_SetLedgerHooks(JSRuntime *rt, const JSLedgerHooks *hooks, void *opaque);
+/* What runs at a depth of the stack, for a sampling profiler: depth 0 is the
+   innermost frame, each step its caller. A bytecode function is reported by
+   its identity (valid only while it lives, and only as a table key), its
+   name and the file, line and column it was defined at; a native frame by
+   function NULL and name "[native]". Owner thread; no allocation, exception
+   or refcount change, so it may run inside the interrupt handler. Returns
+   false and clears out past the outermost frame or for a null argument. */
+typedef struct JSFrameLocation {
+    const void *function;
+    char name[64];
+    char file[128];
+    int line;
+    int column;
+} JSFrameLocation;
+JS_BOOL JS_GetFrameLocation(JSContext *ctx, int depth, JSFrameLocation *out);
 /* Trusted owner-thread scope. entry and optional callback incumbent must stay
    alive through body and belong to the same runtime. A non-null incumbent
    selects callback preparation (including suppression of the caller's script
--- a/quickjs.c
+++ b/quickjs.c
@@ -8322,6 +8322,49 @@
