 }
 
+/* An atom's text into buf: JS_AtomGetStrRT answers an ASCII atom with its
+   own bytes and writes buf only otherwise. */
+static void js_frame_location_text(JSRuntime *rt, char *buf, int buf_size, JSAtom atom)
+{
+    const char *text = JS_AtomGetStrRT(rt, buf, buf_size, atom);
+    if (text != buf)
+        pstrcpy(buf, buf_size, text);
+}
+
+JS_BOOL JS_GetFrameLocation(JSContext *ctx, int depth, JSFrameLocation *out)
+{
+    JSStackFrame *sf;
+    if (!out)
+        return FALSE;
+    memset(out, 0, sizeof(*out));
+    if (!ctx || depth < 0)
+        return FALSE;
+    sf = ctx->rt->current_stack_frame;
+    while (sf != NULL && depth-- > 0)
+        sf = sf->prev_frame;
+    if (sf == NULL)
+        return FALSE;
+    if (JS_VALUE_GET_TAG(sf->cur_func) == JS_TAG_OBJECT) {
+        JSObject *p = JS_VALUE_GET_OBJ(sf->cur_func);
+        if (js_class_has_bytecode(p->class_id)) {
+            JSFunctionBytecode *b = p->u.func.function_bytecode;
+            int column = 0;
+            out->function = b;
+            if (b->func_name != JS_ATOM_NULL)
+                js_frame_location_text(ctx->rt, out->name, sizeof(out->name), b->func_name);
+            else
+                snprintf(out->name, sizeof(out->name), "<anonymous>");
+            js_frame_location_text(ctx->rt, out->file, sizeof(out->file),
+                                   b->has_debug ? b->debug.filename : b->source_name);
+            out->line = find_line_num(ctx, b, -1, &column);
+            out->column = column;
+            return TRUE;
+        }
+    }
+    snprintf(out->name, sizeof(out->name), "[native]");
+    return TRUE;
+}
