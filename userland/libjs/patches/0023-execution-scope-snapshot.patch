+void JS_EnableExecutionScopeTracking(JSRuntime *rt)
+{
+    assert(!rt->current_stack_frame && !rt->execution_scopes);
+    rt->execution_scope_tracking = TRUE;
+}
+
+BOOL JS_VisitExecutionScopes(JSRuntime *rt, JSExecutionScopeVisitor *visitor,
+                             void *opaque)
+{
+    JSExecutionScope *scope;
+    if (!rt->execution_scope_tracking)
+        return FALSE;
+    for (scope = rt->execution_scopes; scope; scope = scope->previous)
+        visitor(opaque, &scope->info);
+    return TRUE;
+}
+
+static void js_execution_scope_enter(JSRuntime *rt, JSExecutionScope *scope,
+                                     JSExecutionScopeInfo info)
+{
+    scope->info = info;
+    scope->previous = rt->execution_scopes;
+    rt->execution_scopes = scope;
+}
+
+static void js_execution_scope_leave(JSRuntime *rt, JSExecutionScope *scope)
+{
+    assert(rt->execution_scopes == scope);
+    rt->execution_scopes = scope->previous;
+}
