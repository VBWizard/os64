+       interpreter frame chain at that interrupt boundary. */
+    js_execution_scope_enter(rt, &scope, info);
+    result = JS_CallInternalImpl(ctx, func_obj, this_obj, new_target, argc, argv, flags);
+    js_execution_scope_leave(rt, &scope);
+    return result;
+}
