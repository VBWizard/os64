+                                                  JSExecutionScopeKind kind)
+{
+    JSExecutionScopeInfo info = { ctx, NULL, kind, JS_EXECUTION_CODE_UNKNOWN };
+    JSObject *p;
+    unsigned bound_hops = 0;
+    while (JS_IsObject(function)) {
+        p = JS_VALUE_GET_OBJ(function);
