+/* Dormant execution attribution, independent of browser security settings.
+   Enable once, on the owner thread outside engine entry, before executing
+   code to be observed. Enabling does not make interruption recoverable. */
+typedef enum {
+    JS_EXECUTION_SCOPE_CALL,
+    JS_EXECUTION_SCOPE_CONSTRUCT,
+    JS_EXECUTION_SCOPE_RESUME,
+    JS_EXECUTION_SCOPE_EVAL,
+    JS_EXECUTION_SCOPE_EVAL_FUNCTION,
+    JS_EXECUTION_SCOPE_JOB,
+} JSExecutionScopeKind;
+typedef enum {
+    JS_EXECUTION_CODE_UNKNOWN,
+    JS_EXECUTION_CODE_BYTECODE,
+    JS_EXECUTION_CODE_NATIVE,
+} JSExecutionCodeKind;
+typedef struct {
+    JSContext *caller; /* engine entry context, not a security caller */
+    JSContext *code; /* candidate; authoritative only for a known code_kind */
+    JSExecutionScopeKind kind;
+    JSExecutionCodeKind code_kind;
+} JSExecutionScopeInfo;
+typedef void JSExecutionScopeVisitor(void *opaque, const JSExecutionScopeInfo *info);
+void JS_EnableExecutionScopeTracking(JSRuntime *rt);
+/* Allocation-free, innermost first, including pending pre-interrupt calls.
+   Info/contexts are borrowed for the visit. The visitor must not allocate,
+   execute engine code, release values, or change runtime state. Returns false
+   when tracking is disabled; true with zero visits means no tracked scope.
+   Scope facts do not certify native invariants or complete recovery coverage.
+   Wrapper/proxy dispatch may report UNKNOWN while nested calls report code. */
+JS_BOOL JS_VisitExecutionScopes(JSRuntime *rt, JSExecutionScopeVisitor *visitor,
+                               void *opaque);
