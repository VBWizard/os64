+/* The threshold the next allocation-asked run waits for, set after every
+   run: half as much again as the run left, as upstream, but held below the
+   memory limit, so the collector runs while there is room and is not the
+   reason an allocation fails. With a limit L:
+   - never above L - L/16, the margin;
+   - where that lowers it, never less than L/64 above what the run left, so
+     a heap whose live part is inside the margin is walked again only after
+     it has grown by that step;
+   - never above L - L/256, so the last stretch before the limit still has
+     a run.
+   A run the limit scheduled also waits for the heap to have grown by L/256
+   since the last run (js_trigger_gc): one that found the heap all live is
+   not repeated at every object made. So a heap that is all live reaches
+   the limit in at most L/16 / (L/64) + (L/64) / (L/256) = 8 runs once it is
+   inside the margin. */
+static void gc_schedule(JSRuntime *rt)
+{
+    const size_t size = rt->malloc_ctx.malloc_state.malloc_size;
+    const size_t limit = rt->malloc_ctx.malloc_state.malloc_limit;
+    size_t next = size + (size >> 1);
+    BOOL by_limit = FALSE;
+    rt->malloc_after_gc = size;
+    if (limit != (size_t)-1 && limit != 0) {
+        const size_t margin = limit >> 4, step = limit >> 6, last = limit >> 8;
+        if (next > limit - margin) {
+            next = limit - margin;
+            by_limit = TRUE;
+            if (next < size + step)
+                next = size + step;
+        }
+        if (next > limit - last) {
+            next = limit - last;
+            by_limit = TRUE;
+        }
+    }
+    rt->malloc_gc_threshold = next;
+    rt->threshold_by_limit = by_limit;
+}
