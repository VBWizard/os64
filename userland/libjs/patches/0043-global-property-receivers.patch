+/* Global environment storage remains global_obj. Accessor and exotic
+   callbacks use the receiver's own embedding context, not the caller's or
+   getter's realm. The global traces that context while configured. */
+static JSValueConst js_global_receiver(JSValueConst receiver)
+{
+    if (JS_IsObject(receiver)) {
+        JSObject *p = JS_VALUE_GET_OBJ(receiver);
+        if (p->class_id == JS_CLASS_GLOBAL_OBJECT &&
+            p->u.global_object.receiver_context)
+            return p->u.global_object.receiver_context->global_this;
+    }
+    return receiver;
+}
+
+/* Proxy exotics also implement trapless internal forwarding. Keep their
+   storage receiver until an author trap is invoked; other native exotics
+   are embedding callbacks. */
+static JSValueConst js_exotic_receiver(JSObject *object, JSValueConst receiver)
+{
+    return object->class_id == JS_CLASS_PROXY ? receiver : js_global_receiver(receiver);
+}
