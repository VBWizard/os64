+JSContext *JS_GetEntryContext(JSRuntime *rt)
+{
+    return rt ? rt->settings_entry : NULL;
+}
+
+JSContext *JS_GetIncumbentContext(JSRuntime *rt)
+{
+    JSSettingsFrame *frame;
+    if (!rt || !rt->settings_entry)
+        return NULL;
+    frame = rt->settings_script_frame;
+    return frame && !frame->skip ? frame->context : rt->settings_backup;
+}
+
+JS_BOOL JS_RunWithSettings(JSContext *entry, JSContext *incumbent,
+                          JSSettingsBody *body, void *opaque, JSValue *out)
+{
+    JSRuntime *rt;
+    JSContext *previous_entry, *previous_backup;
+    JSSettingsFrame *skipped;
+    JSValue result;
+    if (!entry || !body || !out || (incumbent && incumbent->rt != entry->rt))
+        return FALSE;
+    rt = entry->rt;
+    if (rt->settings_depth == JS_SETTINGS_SCOPE_LIMIT)
+        return FALSE;
+    previous_entry = rt->settings_entry;
+    previous_backup = rt->settings_backup;
+    skipped = incumbent ? rt->settings_script_frame : NULL;
+    rt->settings_entry = entry;
+    rt->settings_depth++;
+    if (incumbent)
+        rt->settings_backup = incumbent;
+    if (skipped)
+        skipped->skip++;
+    result = body(entry, opaque);
+    /* Engine reentry must have unwound before the native body returns. */
+    if (skipped) {
+        assert(rt->settings_script_frame == skipped && skipped->skip > 0);
+        skipped->skip--;
+    }
+    rt->settings_backup = previous_backup;
+    rt->settings_entry = previous_entry;
+    rt->settings_depth--;
+    *out = result;
+    return TRUE;
+}
+
+static void js_settings_script_enter(JSRuntime *rt, JSSettingsFrame *frame,
+                                      JSContext *context, BOOL has_script)
+{
+    frame->previous = rt->settings_script_frame;
+    frame->context = context;
+    frame->skip = 0;
+    if (has_script)
+        rt->settings_script_frame = frame;
+}
+
+static void js_settings_script_leave(JSRuntime *rt, JSSettingsFrame *frame)
+{
+    assert(frame->skip == 0);
+    rt->settings_script_frame = frame->previous;
+}
