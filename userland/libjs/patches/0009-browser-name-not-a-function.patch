 /* argv[] is modified if (flags & JS_CALL_FLAG_COPY_ARGV) = 0. */
+/* os64: a method fetched for a call (OP_get_field2) was not a function:
+   remember its name, so the call's "not a function" can say which. Any
+   later method found callable forgets it, so a name is never told of a
+   call it did not make; the held atom cannot outlive its bytecode. */
+static void js_note_not_callable(JSContext *ctx, JSAtom atom)
+{
+    JS_FreeAtom(ctx, ctx->not_callable);
+    ctx->not_callable = atom != JS_ATOM_NULL ? JS_DupAtom(ctx, atom) : JS_ATOM_NULL;
+}
+
+/* os64: "not a function", by the method's name when the call was to one
+   just fetched and found not callable. */
+static JSValue js_throw_not_a_function(JSContext *ctx)
+{
+    char buf[ATOM_GET_STR_BUF_SIZE];
+    JSAtom atom = ctx->not_callable;
+    if (atom == JS_ATOM_NULL)
+        return JS_ThrowTypeError(ctx, "not a function");
+    ctx->not_callable = JS_ATOM_NULL;
+    JS_ThrowTypeError(ctx, "'%s' is not a function", JS_AtomGetStr(ctx, buf, sizeof(buf), atom));
+    JS_FreeAtom(ctx, atom);
+    return JS_EXCEPTION;
+}
+
 static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
                                JSValueConst this_obj, JSValueConst new_target,
                                int argc, JSValue *argv, int flags)
