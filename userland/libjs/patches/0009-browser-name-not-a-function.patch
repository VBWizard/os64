 /* argv[] is modified if (flags & JS_CALL_FLAG_COPY_ARGV) = 0. */
+/* os64: the record of a method fetched for a call and found not callable
+   (JSContext.nc_atom), set and forgotten. */
+static void js_forget_not_callable(JSContext *ctx)
+{
+    JS_FreeAtom(ctx, ctx->nc_atom);
+    ctx->nc_atom = JS_ATOM_NULL;
+}
+
+static void js_note_not_callable(JSContext *ctx, JSAtom atom, void *frame, JSValue *slot,
+                                 JSValueConst value, const uint8_t *after)
+{
+    js_forget_not_callable(ctx);
+    ctx->nc_atom = JS_DupAtom(ctx, atom);
+    ctx->nc_frame = frame;
+    ctx->nc_slot = slot;
+    ctx->nc_value = value;
+    ctx->nc_after = after;
+}
+
+static BOOL js_fetch_reaches_call(const uint8_t *p, const uint8_t *end, int argc);
+
+/* Whether the call at `call`, with `argc` arguments, whose callee is
+   `callee` in `slot` of `frame`, is the call the record's fetch was for.
+   It must be the same frame, slot and value, AND the bytecode from the end
+   of the fetch to the call must prove the FETCHED VALUE is this callee
+   (js_fetch_reaches_call): straight-line, so the only way here is through
+   the fetch, and never popping that value, which then sits under exactly
+   the call's arguments. Anything less proves nothing (Quinn, #239: a
+   skipped optional call's slot refilled by another callee; an increment's
+   fetch consumed and its slot refilled), and the call keeps the plain
+   message. */
+static BOOL js_is_noted_call(JSContext *ctx, void *frame, JSValue *slot, JSValueConst callee,
+                             const uint8_t *call, int argc)
+{
+    JSValueConst v = ctx->nc_value;
+    int tag = JS_VALUE_GET_TAG(callee);
+    if (ctx->nc_atom == JS_ATOM_NULL || ctx->nc_frame != frame || ctx->nc_slot != slot ||
+        JS_VALUE_GET_TAG(v) != tag || ctx->nc_after > call)
+        return FALSE;
+    /* Compared by kind: a value with a pointer by it, a double by its bits,
+       the rest (undefined, null, a boolean, an integer) by their int. */
+    if (JS_VALUE_HAS_REF_COUNT(callee)) {
+        if (JS_VALUE_GET_PTR(v) != JS_VALUE_GET_PTR(callee))
+            return FALSE;
+    } else if (tag == JS_TAG_FLOAT64) {
+        double a = JS_VALUE_GET_FLOAT64(v), b = JS_VALUE_GET_FLOAT64(callee);
+        if (memcmp(&a, &b, sizeof(a)) != 0)
+            return FALSE;
+    } else if (JS_VALUE_GET_INT(v) != JS_VALUE_GET_INT(callee)) {
+        return FALSE;
+    }
+    return js_fetch_reaches_call(ctx->nc_after, call, argc);
+}
