 /* argv[] is modified if (flags & JS_CALL_FLAG_COPY_ARGV) = 0. */
+/* os64: the record of a method fetched for a call and found not callable
+   (JSContext.nc_atom), set, and forgotten. A callable fetch leaves it be:
+   the call it belongs to is told apart by its frame, slot and value, so
+   `o.missing(el.real())` still names `missing`. Every other way a call's
+   callee is produced, and every exception, forgets it. */
+static void js_forget_not_callable(JSContext *ctx)
+{
+    JS_FreeAtom(ctx, ctx->nc_atom);
+    ctx->nc_atom = JS_ATOM_NULL;
+}
+
+static void js_note_not_callable(JSContext *ctx, JSAtom atom, void *frame, JSValue *slot,
+                                 JSValueConst value)
+{
+    js_forget_not_callable(ctx);
+    ctx->nc_atom = JS_DupAtom(ctx, atom);
+    ctx->nc_frame = frame;
+    ctx->nc_slot = slot;
+    ctx->nc_value = value;
+}
+
+/* Whether a call whose callee is `callee`, in `slot` of `frame`, is the
+   call the record was made for: same frame, same slot, the same value. */
+static BOOL js_is_noted_call(JSContext *ctx, void *frame, JSValue *slot, JSValueConst callee)
+{
+    JSValueConst v = ctx->nc_value;
+    int tag = JS_VALUE_GET_TAG(callee);
+    if (ctx->nc_atom == JS_ATOM_NULL || ctx->nc_frame != frame || ctx->nc_slot != slot ||
+        JS_VALUE_GET_TAG(v) != tag)
+        return FALSE;
+    /* Compared by kind: a value with a pointer by it, a double by its bits,
+       the rest (undefined, null, a boolean, an integer) by their int. */
+    if (JS_VALUE_HAS_REF_COUNT(callee))
+        return JS_VALUE_GET_PTR(v) == JS_VALUE_GET_PTR(callee);
+    if (tag == JS_TAG_FLOAT64) {
+        double a = JS_VALUE_GET_FLOAT64(v), b = JS_VALUE_GET_FLOAT64(callee);
+        return memcmp(&a, &b, sizeof(a)) == 0;
+    }
+    return JS_VALUE_GET_INT(v) == JS_VALUE_GET_INT(callee);
+}
+
