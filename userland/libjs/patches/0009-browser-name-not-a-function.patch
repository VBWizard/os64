 #define short_opcode_info(op) opcode_info[op]
 #endif
 
+/* os64: whether the value a method fetch pushed, its bytecode ending at
+   `p`, is the callee of the call at `end` with `argc` arguments. The code
+   between must run straight through, with no jump (every label format)
+   and no op that calls, returns, throws, enters or leaves a handler,
+   iterates or suspends, or fetches another method, so the only way to
+   `end` is from `p`. And the fetched value must survive it: the stack is
+   followed from `p` by each op's pops and pushes (compute_stack_size's
+   arithmetic), any op that would pop the value proves nothing (an
+   increment's fetch is consumed; a swap or a dup counts as touching it),
+   and at the call the value must sit under exactly `argc` arguments. */
+static BOOL js_fetch_reaches_call(const uint8_t *p, const uint8_t *end, int argc)
+{
+    int above = 1;              /* the fetched value and what sits over it */
+    while (p < end) {
+        int op = *p, n_pop;
+        const JSOpCode *oi = &short_opcode_info(op);
+        switch (oi->fmt) {
+        case OP_FMT_label8:
+        case OP_FMT_label16:
+        case OP_FMT_label:
+        case OP_FMT_atom_label_u8:
+        case OP_FMT_atom_label_u16:
+        case OP_FMT_label_u16:
+            return FALSE;
+        default:
+            break;
+        }
+        switch (op) {
+        case OP_call_constructor: case OP_call: case OP_tail_call: case OP_call_method:
+        case OP_tail_call_method: case OP_apply: case OP_eval: case OP_apply_eval:
+        case OP_return: case OP_return_undef: case OP_return_async: case OP_check_ctor_return:
+        case OP_throw: case OP_throw_error: case OP_ret: case OP_nip_catch:
+        case OP_for_in_start: case OP_for_of_start: case OP_for_await_of_start:
+        case OP_for_in_next: case OP_for_of_next: case OP_for_await_of_next:
+        case OP_iterator_check_object: case OP_iterator_get_value_done: case OP_iterator_close:
+        case OP_iterator_next: case OP_iterator_call: case OP_initial_yield: case OP_yield:
+        case OP_yield_star: case OP_async_yield_star: case OP_await:
+        case OP_get_field2: case OP_get_array_el2:
+#if SHORT_OPCODES
+        case OP_call0: case OP_call1: case OP_call2: case OP_call3:
+#endif
+            return FALSE;
+        default:
+            break;
+        }
+        n_pop = oi->n_pop;
+        if (oi->fmt == OP_FMT_npop || oi->fmt == OP_FMT_npop_u16)
+            n_pop += get_u16(p + 1);
+        if (n_pop >= above)
+            return FALSE;
+        above += oi->n_push - n_pop;
+        p += oi->size;
+    }
+    return p == end && above == argc + 1;
+}
