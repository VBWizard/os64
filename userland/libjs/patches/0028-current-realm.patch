+/* Bound/proxy dispatch does not create an execution context. Native C/data
+   functions establish their realm at their own dispatcher. Other built-in
+   call classes have known function realms; custom classes have no such proof. */
+static JSValue js_call_class(JSContext *ctx, JSValueConst function,
+                             JSValueConst receiver, int argc,
+                             JSValueConst *argv, int flags, JSClassCall *call)
+{
+    JSRuntime *rt = ctx->rt;
+    JSContext *previous = rt->settings_current;
+    JSValue result;
+    switch (JS_VALUE_GET_OBJ(function)->class_id) {
+    case JS_CLASS_C_FUNCTION:
+    case JS_CLASS_C_FUNCTION_DATA:
+    case JS_CLASS_BOUND_FUNCTION:
+    case JS_CLASS_PROXY:
+        return call(ctx, function, receiver, argc, argv, flags);
+    case JS_CLASS_GENERATOR_FUNCTION:
+    case JS_CLASS_ASYNC_FUNCTION:
+    case JS_CLASS_ASYNC_GENERATOR_FUNCTION:
+    case JS_CLASS_ASYNC_FUNCTION_RESOLVE:
+    case JS_CLASS_ASYNC_FUNCTION_REJECT:
+    case JS_CLASS_PROMISE_RESOLVE_FUNCTION:
+    case JS_CLASS_PROMISE_REJECT_FUNCTION:
+        rt->settings_current = JS_GetFunctionRealm(ctx, function);
+        break;
+    default:
+        rt->settings_current = NULL;
+        break;
+    }
+    result = call(ctx, function, receiver, argc, argv, flags);
+    rt->settings_current = previous;
+    return result;
 }
 
