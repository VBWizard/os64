+
+/* Native-only host continuations keep their data/context holds and ordinary
+   function realm, but promise job discovery gives them neutral ownership.
+   Callers must gate any author callback reached by the continuation. */
+JSValue JS_NewCFunctionDataNeutral(JSContext *ctx, JSCFunctionData *func,
+                                  int length, int magic, int data_len,
+                                  JSValueConst *data)
+{
+    JSValue function = JS_NewCFunctionData(ctx, func, length, magic, data_len, data);
+    if (!JS_IsException(function)) {
+        JSCFunctionDataRecord *s = JS_GetOpaque(function, JS_CLASS_C_FUNCTION_DATA);
+        s->neutral_job = TRUE;
+    }
+    return function;
 }
 
