+/* These markers cover engine-dispatched execution and native callouts.
+   The owner must separately exclude native work outside the engine. */
+static BOOL js_execution_idle(JSRuntime *rt)
+{
+    return !rt->execution_scopes && !rt->current_stack_frame &&
+        !rt->native_call_contexts && !rt->settings_depth &&
+        !rt->native_callback_depth && !rt->recovery_gc_depth && rt->gc_phase == JS_GC_PHASE_NONE;
+}
+
+JS_BOOL JS_GetExecutionState(JSRuntime *rt, JSExecutionState *out)
+{
+    if (!out)
+        return FALSE;
+    *out = (JSExecutionState){0};
+    if (!rt)
+        return FALSE;
+    out->tracking = rt->execution_scope_tracking;
+    out->callback_depth = rt->native_callback_depth;
+    out->scopes = rt->execution_scopes != NULL;
+    out->interpreter = rt->current_stack_frame != NULL;
+    out->native_callbacks = rt->native_call_contexts != NULL || rt->native_callback_depth != 0;
+    out->settings = rt->settings_depth != 0;
+    out->gc = rt->recovery_gc_depth != 0 || rt->gc_phase != JS_GC_PHASE_NONE;
+    out->blocked = rt->recovery_barrier;
+    return TRUE;
+}
+
+JS_BOOL JS_BeginRecoveryBarrier(JSRuntime *rt, JSRecoveryBarrier *out)
+{
+    if (!rt || !out || !rt->execution_scope_tracking || rt->recovery_barrier ||
+        !js_execution_idle(rt) || rt->recovery_generation == UINT64_MAX)
+        return FALSE;
+    rt->recovery_generation++;
+    rt->recovery_barrier = TRUE;
+    *out = (JSRecoveryBarrier){rt, rt->recovery_generation};
+    return TRUE;
+}
+
+JS_BOOL JS_EndRecoveryBarrier(JSRuntime *rt, const JSRecoveryBarrier *barrier)
+{
+    if (!rt || !barrier || barrier->runtime != rt || !rt->recovery_barrier ||
+        barrier->generation != rt->recovery_generation || !js_execution_idle(rt))
+        return FALSE;
+    rt->recovery_barrier = FALSE;
+    return TRUE;
+}
+
+/* Instrument opt-in native callouts without changing their callback context
+   or adding script/settings provenance. Native callbacks must return in C. */
+#define JS_ENGINE_CALLBACK(rt_arg, call)                         \
+    ({ JSRuntime *const cb_rt = (rt_arg);                        \
+       const BOOL cb_track = cb_rt->execution_scope_tracking;    \
+       if (cb_track) cb_rt->native_callback_depth++;             \
+       __auto_type cb_result = (call);                          \
+       if (cb_track) cb_rt->native_callback_depth--;             \
+       cb_result; })
+#define JS_ENGINE_CALLBACK_VOID(rt_arg, call) do {               \
+    JSRuntime *const cb_rt = (rt_arg);                           \
+    const BOOL cb_track = cb_rt->execution_scope_tracking;       \
+    if (cb_track) cb_rt->native_callback_depth++;                \
+    (call);                                                     \
+    if (cb_track) cb_rt->native_callback_depth--;                \
+} while (0)
