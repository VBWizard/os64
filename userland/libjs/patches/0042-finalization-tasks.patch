+/* One cleared cell per host task. Keep cells in the registry until delivery
+   so unregister can cancel collected targets between GC and task execution. */
+static JSValue js_finrec_task(JSContext *ctx, int argc, JSValueConst *argv)
+{
+    JSFinalizationRegistryData *frd = JS_GetOpaque(argv[0], JS_CLASS_FINALIZATION_REGISTRY);
+    struct list_head *el;
+    list_for_each(el, &frd->entries) {
+        JSFinRecEntry *fre = list_entry(el, JSFinRecEntry, link);
+        if (!JS_IsUndefined(fre->target)) continue;
+        JSValue held = fre->held_val;
+        list_del(&fre->link);
+        js_weakref_free(ctx->rt, fre->token);
+        js_free(ctx, fre);
+        JSValue result = js_call_job_callback(ctx, frd->cb, JS_UNDEFINED, 1, &held);
+        JS_FreeValue(ctx, held);
+        return result;
+    }
+    return JS_UNDEFINED;
+}
